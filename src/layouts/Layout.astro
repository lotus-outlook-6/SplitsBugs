---
import '../styles/global.css';

export interface Props {
  hideNav?: boolean;
}

const { hideNav = false } = Astro.props;
const pathname = Astro.url.pathname;
const isActivity = pathname.includes('/activity');
const isAccount = pathname.includes('/account') || pathname.includes('/edit-profile') || pathname.includes('/security') || pathname.includes('/email-settings') || pathname.includes('/appearance') || pathname.includes('/contact-support') || pathname.includes('/notification-settings');
const isGroups = pathname.includes('/dashboard') || pathname.includes('/group') || pathname === '/' || pathname === '' || pathname === '/index.html';

let initialIndex = 0;
if (isActivity) initialIndex = 1;
else if (isAccount) initialIndex = 2;
else if (isGroups) initialIndex = 0;
else initialIndex = -1;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0" />
		<link rel="icon" type="image/svg+xml" href="/SplitBugs-Brand/favicon/favicon.svg?v=3" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet">
		<link rel="manifest" href="/manifest.json">
		<meta name="apple-mobile-web-app-capable" content="yes">
		<meta name="apple-mobile-web-app-status-bar-style" content="default">
		<meta name="apple-mobile-web-app-title" content="SplitsBug">
		<link rel="apple-touch-icon" href="/favicon.png">
		<meta name="theme-color" content="#5b21b6">
		<title>SplitBugs</title>
		<script src="/js/categories.js" is:inline></script>
		<script is:inline>
			// Apply Theme
			const savedTheme = localStorage.getItem('splitbug_theme') || 'dark-grey';
			window.applyTheme = (theme) => {
				document.documentElement.className = '';
				if (theme === 'system') {
					if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
						document.documentElement.classList.add('theme-dark-grey');
					} else {
						document.documentElement.classList.add('theme-light-white');
					}
				} else if (theme === 'splitsbug') {
					const hour = new Date().getHours();
					let activeTheme = 'light-white';
					if (hour >= 5 && hour < 7) activeTheme = 'light-cream';
					else if (hour >= 7 && hour < 17) activeTheme = 'light-white';
					else if (hour >= 17 && hour < 18) activeTheme = 'light-cream';
					else if (hour >= 18 && hour < 21) activeTheme = 'dark-grey';
					else activeTheme = 'dark-amoled';
					document.documentElement.classList.add(`theme-${activeTheme}`);
				} else {
					document.documentElement.classList.add(`theme-${theme}`);
				}
				window.dispatchEvent(new CustomEvent('themeChanged', { detail: { theme: document.documentElement.className } }));
			};
			window.applyTheme(savedTheme);

			// Automatically re-apply theme if system preference changes or if splitsbug theme is active
			window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
				if (localStorage.getItem('splitbug_theme') === 'system') {
					window.applyTheme('system');
				}
			});

			setInterval(() => {
				if (localStorage.getItem('splitbug_theme') === 'splitsbug') {
					window.applyTheme('splitsbug');
				}
			}, 60000);

			// Global Name Definition
			window.MY_NAME = localStorage.getItem('splitbug_userName') || 'Name';
			window.MY_DISPLAY_NAME = `${window.MY_NAME} (You)`;

			// Auth Check
			const isLoggedIn = localStorage.getItem('splitbug_loggedIn') === 'true';
			const isAuthPage = window.location.pathname === '/login' || window.location.pathname === '/signup';
			const isGoogleFlow = window.location.search.includes('google=true');
			if (!isLoggedIn && !isAuthPage) {
				window.location.href = '/login';
			} else if (isLoggedIn && isAuthPage && !isGoogleFlow) {
				window.location.href = '/dashboard';
			} else if (isLoggedIn && window.location.pathname === '/') {
				window.location.href = '/dashboard';
			}

			// Native Push Notifications Listener (Cross-tab)
			window.addEventListener('storage', (e) => {
				if (e.key === 'splitsbug_notifications') {
					const userEmail = localStorage.getItem('splitbug_userEmail');
					if (!userEmail) return;
					
					try {
						const oldData = e.oldValue ? JSON.parse(e.oldValue) : {};
						const newData = e.newValue ? JSON.parse(e.newValue) : {};
						
						const oldUserNotifs = oldData[userEmail] || [];
						const newUserNotifs = newData[userEmail] || [];
						
						if (newUserNotifs.length > oldUserNotifs.length) {
							const addedNotifs = newUserNotifs.filter((n) => !oldUserNotifs.some((old) => old.id === n.id));
							
							if (Notification.permission === 'granted') {
								addedNotifs.forEach((notif) => {
									new Notification("SplitsBug", {
										body: notif.message || notif.text || 'You have a new notification',
										icon: '/SplitBugs-Brand/favicon/icon-rounded.png'
									});
								});
							}
						}
					} catch(err) {}
				}
			});
		</script>
	</head>
	<body class="pb-28">
		<slot />

		{ !hideNav && (
		<nav transition:persist="bottom-nav" id="bottomNav" class="fixed bottom-0 left-0 w-full bg-canvas border-t border-hairline pb-safe z-50">
			<div class="relative flex items-center justify-between h-16 max-w-md mx-auto px-1">
				<!-- Sleek Compact Light Purple Pill Indicator -->
				<div id="navPill" style={`transform: translateX(${initialIndex >= 0 ? initialIndex * 100 : 0}%); opacity: ${initialIndex >= 0 ? 1 : 0};`} class="absolute inset-y-0 left-0 w-1/3 flex justify-center items-center pointer-events-none transition-transform duration-250 ease-out z-0">
					<div class="w-4/5 h-12 bg-brand/10 border border-brand/20 rounded-full shadow-sm"></div>
				</div>
				
				<a href="/dashboard" data-index="0" data-path="/dashboard" class={`relative z-10 flex flex-col items-center justify-center flex-1 h-full transition-colors nav-item ${isGroups ? 'active text-brand font-semibold' : 'text-mute hover:text-ink'}`}>
					<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mb-0.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
					<span class="text-[10px] font-medium">Groups</span>
				</a>
				<a href="/activity" data-index="1" data-path="/activity" class={`relative z-10 flex flex-col items-center justify-center flex-1 h-full transition-colors nav-item ${isActivity ? 'active text-brand font-semibold' : 'text-mute hover:text-ink'}`}>
					<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mb-0.5"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
					<span class="text-[10px] font-medium">Activity</span>
				</a>
				<a href="/account" data-index="2" data-path="/account" class={`relative z-10 flex flex-col items-center justify-center flex-1 h-full transition-colors group nav-item ${isAccount ? 'active text-brand font-semibold' : 'text-mute hover:text-ink'}`}>
					<div id="navAccountIcon" class="flex flex-col items-center justify-center mb-0.5 min-h-[22px]">
						<script is:inline>
							(function() {
								var icon = document.currentScript.parentElement;
								var avatar = localStorage.getItem('splitbug_userAvatar');
								var userName = localStorage.getItem('splitbug_userName');
								var themeColor = localStorage.getItem('splitbug_userThemeColor');
								var gradientTheme = localStorage.getItem('splitbug_userGradientTheme');
								var isAccountPath = window.location.pathname === '/account' || window.location.pathname.startsWith('/edit-profile');

								if (avatar && avatar !== 'undefined' && avatar !== 'null') {
									icon.innerHTML = '<img src="' + avatar + '" loading="eager" decoding="sync" class="w-5 h-5 rounded-full object-cover ring-2 ' + (isAccountPath ? 'ring-brand' : 'ring-transparent') + '" />';
								} else if (gradientTheme && gradientTheme !== '-1' && gradientTheme.startsWith('special-art-')) {
									icon.innerHTML = '<div class="w-5 h-5 rounded-full overflow-hidden ring-2 ' + (isAccountPath ? 'ring-brand' : 'ring-transparent') + '">' + (window.renderAbstractArt ? window.renderAbstractArt(gradientTheme) : '') + '</div>';
								} else if (themeColor && themeColor.startsWith('special-art-')) {
									icon.innerHTML = '<div class="w-5 h-5 rounded-full overflow-hidden ring-2 ' + (isAccountPath ? 'ring-brand' : 'ring-transparent') + '">' + (window.renderAbstractArt ? window.renderAbstractArt(themeColor) : '') + '</div>';
								} else if (userName) {
									var parts = userName.trim().split(' ').filter(Boolean);
									var initials = parts.length > 1 ? (parts[0][0] + parts[parts.length - 1][0]).toUpperCase() : (parts[0] ? parts[0][0].toUpperCase() : 'U');
									icon.innerHTML = '<div class="w-5 h-5 rounded-full bg-purple-600 text-white flex items-center justify-center text-[9px] font-bold ring-2 ' + (isAccountPath ? 'ring-purple-600' : 'ring-transparent') + '">' + initials + '</div>';
								} else {
									icon.innerHTML = '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>';
								}
							})();
						</script>
					</div>
					<span class="text-[10px] font-medium">Account</span>
				</a>
			</div>
		</nav>
		)}

		<!-- Global App Lock Overlay -->
		<div id="globalAppLockOverlay" class="fixed inset-0 z-[99999] bg-canvas/98 backdrop-blur-2xl flex items-center justify-center p-4 hidden">
			<!-- PIN View -->
			<div id="appLockPinView" class="w-full max-w-sm bg-canvas border border-hairline rounded-3xl p-6 sm:p-8 shadow-2xl flex flex-col items-center text-center animate-in zoom-in-95 duration-200">
				<div class="w-16 h-16 rounded-full bg-brand/10 text-brand flex items-center justify-center mb-4">
					<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
				</div>
				<h2 class="text-xl font-bold text-ink mb-1">App Locked</h2>
				<p id="appLockSubtext" class="text-xs text-mute mb-6">Enter your 4-digit passcode to unlock</p>

				<!-- 4 Square Digit Box UI -->
				<div id="pinDigitContainer" class="flex gap-3 justify-center mb-6">
					<input type="password" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="new-password" spellcheck="false" class="app-lock-digit w-12 h-14 text-center text-2xl font-bold rounded-2xl border border-hairline bg-canvas-soft focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none text-ink transition-all shadow-sm" autofocus />
					<input type="password" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="new-password" spellcheck="false" class="app-lock-digit w-12 h-14 text-center text-2xl font-bold rounded-2xl border border-hairline bg-canvas-soft focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none text-ink transition-all shadow-sm" />
					<input type="password" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="new-password" spellcheck="false" class="app-lock-digit w-12 h-14 text-center text-2xl font-bold rounded-2xl border border-hairline bg-canvas-soft focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none text-ink transition-all shadow-sm" />
					<input type="password" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="new-password" spellcheck="false" class="app-lock-digit w-12 h-14 text-center text-2xl font-bold rounded-2xl border border-hairline bg-canvas-soft focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none text-ink transition-all shadow-sm" />
				</div>

				<p id="appLockError" class="text-xs font-semibold text-danger hidden mb-2"></p>
			</div>

			<!-- Account Password Recovery View (Triggered after 5 failed attempts) -->
			<div id="appLockRecoveryView" class="w-full max-w-sm bg-canvas border border-hairline rounded-3xl p-6 sm:p-8 shadow-2xl flex flex-col items-center text-center hidden animate-in zoom-in-95 duration-200">
				<div class="w-16 h-16 rounded-full bg-amber-500/10 text-amber-500 flex items-center justify-center mb-4">
					<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
				</div>
				<h2 class="text-xl font-bold text-ink mb-1">Too Many Failed Attempts</h2>
				<p class="text-xs text-mute mb-6">Enter your SplitsBug account password to verify your identity and unlock the app.</p>

				<div class="w-full mb-4">
					<input type="password" id="appLockAccountPassInput" class="w-full p-3.5 rounded-xl border border-hairline bg-canvas-soft text-ink focus:border-brand focus:outline-none text-sm" placeholder="Account Password" />
				</div>

				<p id="appLockRecoveryError" class="text-xs font-semibold text-danger hidden mb-4"></p>

				<button id="appLockRecoveryBtn" class="w-full py-3 bg-brand text-white rounded-xl font-bold hover:bg-brand-deep transition-colors shadow-md text-sm cursor-pointer">
					Unlock with Account Password
				</button>
			</div>
		</div>
		
		<script is:inline>
			function updateBottomNav() {
				const nav = document.getElementById('bottomNav');
				if (!nav) return;
				
				const path = window.location.pathname;
				const items = Array.from(nav.querySelectorAll('.nav-item'));
				const pill = document.getElementById('navPill');
				
				let normalizedPath = path.toLowerCase();
				
				let activeIndex = -1;
				if (normalizedPath.includes('/dashboard') || normalizedPath.includes('/group') || normalizedPath === '/' || normalizedPath.includes('/index')) {
					activeIndex = 0;
				} else if (normalizedPath.includes('/activity')) {
					activeIndex = 1;
				} else if (normalizedPath.includes('/account') || normalizedPath.includes('/edit-profile') || normalizedPath.includes('/security') || normalizedPath.includes('/email-settings') || normalizedPath.includes('/appearance') || normalizedPath.includes('/contact-support') || normalizedPath.includes('/notification-settings')) {
					activeIndex = 2;
				}
				
				items.forEach((item, index) => {
					if (index === activeIndex) {
						item.classList.add('active', 'text-brand');
						item.classList.remove('text-mute', 'hover:text-ink');
					} else {
						item.classList.remove('active', 'text-brand');
						item.classList.add('text-mute', 'hover:text-ink');
					}
				});
				
				if (pill) {
					if (activeIndex >= 0) {
						pill.style.opacity = '1';
						pill.style.transform = `translateX(${activeIndex * 100}%)`;
					} else {
						pill.style.opacity = '0';
					}
				}
			}

			function renderAbstractArt(type) {
				if (type === 'special-art-1') return '<div class="w-full h-full" style="background: conic-gradient(from 45deg, #FF6B6B, #4ECDC4, #45B7D1, #FF6B6B);"></div>';
				if (type === 'special-art-2') return '<div class="w-full h-full" style="background: linear-gradient(135deg, #FF9A9E 0%, #FECFEF 99%, #FECFEF 100%);"><div class="w-1/2 h-1/2 bg-white/30 rounded-br-full backdrop-blur-md"></div></div>';
				if (type === 'special-art-3') return '<div class="w-full h-full flex"><div class="w-1/2 h-full bg-indigo-500"></div><div class="w-1/2 h-full bg-rose-400 rounded-tl-full"></div></div>';
				return '';
			}

			function loadNavAvatar() {
				const navAccountIcon = document.getElementById('navAccountIcon');
				if (!navAccountIcon) return;

				const userAvatar = localStorage.getItem('splitbug_userAvatar');
				const userName = localStorage.getItem('splitbug_userName');
				const userThemeColor = localStorage.getItem('splitbug_userThemeColor');
				const userGradientTheme = localStorage.getItem('splitbug_userGradientTheme');
				const isAccountPath = window.location.pathname === '/account' || window.location.pathname.startsWith('/edit-profile');

				if (userAvatar && userAvatar !== 'undefined' && userAvatar !== 'null') {
					navAccountIcon.innerHTML = `<img src="${userAvatar}" loading="lazy" decoding="async" class="w-5 h-5 rounded-full object-cover ring-2 ${isAccountPath ? 'ring-purple-600' : 'ring-transparent'} transition-all" />`;
				} else if (userGradientTheme && userGradientTheme !== '-1' && userGradientTheme.startsWith('special-art-')) {
					navAccountIcon.innerHTML = `<div class="w-5 h-5 rounded-full overflow-hidden ring-2 ${isAccountPath ? 'ring-purple-600' : 'ring-transparent'} transition-all">${renderAbstractArt(userGradientTheme)}</div>`;
				} else if (userThemeColor && userThemeColor.startsWith('special-art-')) {
					navAccountIcon.innerHTML = `<div class="w-5 h-5 rounded-full overflow-hidden ring-2 ${isAccountPath ? 'ring-purple-600' : 'ring-transparent'} transition-all">${renderAbstractArt(userThemeColor)}</div>`;
				} else if (userName) {
					const parts = userName.trim().split(' ').filter(Boolean);
					let initials = 'U';
					if (parts.length > 0 && parts[0]) {
						if (parts.length === 1) initials = parts[0].charAt(0).toUpperCase();
						else initials = (parts[0].charAt(0) + parts[parts.length - 1].charAt(0)).toUpperCase();
					}
					navAccountIcon.innerHTML = `<div class="w-5 h-5 rounded-full bg-purple-600 text-white flex items-center justify-center text-[9px] font-bold ring-2 ${isAccountPath ? 'ring-purple-600' : 'ring-transparent'} transition-all">${initials}</div>`;
				}
			}
			
			// Load immediately and on events
			updateBottomNav();
			loadNavAvatar();
			document.addEventListener('DOMContentLoaded', () => { updateBottomNav(); loadNavAvatar(); });
			document.addEventListener('astro:page-load', () => { updateBottomNav(); loadNavAvatar(); });
			window.addEventListener('storage', loadNavAvatar);
			window.loadNavAvatar = loadNavAvatar;
			window.updateBottomNav = updateBottomNav;

			// Prevent full reload and instantly animate pill when clicking the bottom nav link
			document.querySelector('nav#bottomNav')?.addEventListener('click', (e) => {
				const link = (e.target).closest('a');
				if (link) {
					const index = parseInt(link.getAttribute('data-index'), 10);
					const pill = document.getElementById('navPill');
					if (pill && !isNaN(index)) {
						pill.style.opacity = '1';
						pill.style.transform = `translateX(${index * 100}%)`;
					}
					
					const href = link.getAttribute('href');
					if (href === window.location.pathname) {
						e.preventDefault();
					} else {
						e.preventDefault();
						setTimeout(() => {
							window.location.href = href;
						}, 200);
					}
				}
			});
		</script>
		<script>
			import { auth, db } from '../firebase';
			import { onAuthStateChanged } from 'firebase/auth';
			import { doc, getDoc, updateDoc, collection, query, where, onSnapshot } from 'firebase/firestore';

			// Register Service Worker for PWA
			if ('serviceWorker' in navigator) {
				window.addEventListener('load', () => {
					navigator.serviceWorker.register('/sw.js').catch(err => console.log('SW registration failed: ', err));
				});
			}

			// Request Notification Permission
			if ('Notification' in window && Notification.permission === 'default') {
				Notification.requestPermission();
			}

			let heartbeatInterval: number | null = null;
			let notificationsUnsubscribe: any = null;
			let initialNotifLoad = true;

			onAuthStateChanged(auth, async (user) => {
				const isAuthPage = window.location.pathname === '/login' || window.location.pathname === '/signup';
				if (user) {
					localStorage.setItem('splitbug_loggedIn', 'true');
					localStorage.setItem('splitbug_userEmail', user.email || '');
					
					let userDocExists = false;
					try {
						const userDoc = await getDoc(doc(db, 'users', user.uid));
						userDocExists = userDoc.exists();
						if (userDocExists) {
							const data = userDoc.data();
							localStorage.setItem('splitbug_userName', data.name || user.email?.split('@')[0] || 'User');
							if (data.themeColor) localStorage.setItem('splitbug_userThemeColor', data.themeColor);
							localStorage.setItem('splitbug_userGradientTheme', data.gradientTheme || '-1');
							let ava = data.avatar || data.dp || user.photoURL;
							if (ava) {
								if (ava.includes('=s96-c')) ava = ava.replace('=s96-c', '=s960-c');
								localStorage.setItem('splitbug_userAvatar', ava);
							}
							// Sync app theme from Firestore (cross-device support)
							if (data.appTheme) {
								const storedTheme = localStorage.getItem('splitbug_theme');
								if (data.appTheme !== storedTheme) {
									localStorage.setItem('splitbug_theme', data.appTheme);
									if (typeof (window as any).applyTheme === 'function') {
										(window as any).applyTheme(data.appTheme);
									}
								}
							}
							window.dispatchEvent(new Event('storage'));
							if (typeof window.loadNavAvatar === 'function') window.loadNavAvatar();
						}

						// Live Users tracking based on interactions
						if (!(window as any).activityTrackerInitialized) {
							(window as any).activityTrackerInitialized = true;
							let lastActivityUpdate = 0;
							
							const updateActivity = () => {
								const now = Date.now();
								// Throttle to 1 write every 30 seconds max
								if (now - lastActivityUpdate > 30000 && auth.currentUser) {
									lastActivityUpdate = now;
									updateDoc(doc(db, 'users', auth.currentUser.uid), { lastActiveAt: now }).catch(() => {});
								}
							};

							// Track various interactions
							window.addEventListener('click', updateActivity, { passive: true });
							window.addEventListener('scroll', updateActivity, { passive: true });
							window.addEventListener('keydown', updateActivity, { passive: true });
							window.addEventListener('touchstart', updateActivity, { passive: true });
							
							// Trigger initial update on load
							updateActivity();
						}

						// Listen for new notifications to show browser alerts
						if (!notificationsUnsubscribe && user.email && 'Notification' in window && Notification.permission === 'granted') {
							const q = query(collection(db, 'users', user.email, 'notifications'), where('read', '==', false));
							notificationsUnsubscribe = onSnapshot(q, (snapshot) => {
								if (initialNotifLoad) {
									initialNotifLoad = false;
									return;
								}
								snapshot.docChanges().forEach((change) => {
									if (change.type === 'added') {
										const notif = change.doc.data();
										// Only send native browser notification if user is NOT on the active page
										if (document.hidden) {
											new Notification('SplitsBug', {
												body: notif.message || notif.text || 'You have a new notification',
												icon: '/SplitBugs-Brand/favicon/icon-rounded.png'
											});
										}
									}
								});
							});
						}
					} catch(e) {}
					
					if (userDocExists) {
						if (isAuthPage || window.location.pathname === '/') {
							window.location.href = '/dashboard';
						}
					} else {
						// User authenticated via Google but hasn't completed signup
						if (window.location.pathname !== '/signup') {
							window.location.href = '/signup?google=true';
						}
					}
				} else {
					localStorage.removeItem('splitbug_loggedIn');
					localStorage.removeItem('splitbug_userEmail');
					localStorage.removeItem('splitbug_userName');
					
					if (heartbeatInterval) {
						clearInterval(heartbeatInterval);
						heartbeatInterval = null;
					}
					if (notificationsUnsubscribe) {
						notificationsUnsubscribe();
						notificationsUnsubscribe = null;
						initialNotifLoad = true;
					}
					
					if (!isAuthPage) {
						window.location.href = '/login';
					}
				}
			});
		</script>

		<script>
			import { auth } from '../firebase';
			import { EmailAuthProvider, reauthenticateWithCredential } from 'firebase/auth';

			let failedPinAttempts = 0;

			function checkAppLockState() {
				const isPinEnabled = localStorage.getItem('splitsbug_pin_enabled') === 'true';
				const savedPin = localStorage.getItem('splitsbug_pin_val');
				const isAuthPage = window.location.pathname === '/login' || window.location.pathname === '/signup';

				if (!isPinEnabled || !savedPin || isAuthPage) {
					return;
				}

				const isExplicitlyLocked = localStorage.getItem('splitsbug_app_locked') === 'true';
				const intervalMins = parseInt(localStorage.getItem('splitsbug_autolock_interval') || '0', 10);
				const unlockedAt = parseInt(localStorage.getItem('splitsbug_unlocked_at') || '0', 10);
				
				// Detect if this is a fresh page reload/refresh or fresh session
				const navEntries = performance.getEntriesByType('navigation');
				const isReload = navEntries.length > 0 && (navEntries[0] as PerformanceNavigationTiming).type === 'reload';
				const isFreshSession = !sessionStorage.getItem('splitsbug_session_unlocked');

				let shouldLock = isExplicitlyLocked;

				if (!shouldLock) {
					if (intervalMins === 0) {
						// Immediately mode: locks ONLY on page reload or fresh tab session, NOT on menu navigation
						if (isReload || isFreshSession) {
							shouldLock = true;
						}
					} else if (unlockedAt > 0 && (isReload || isFreshSession)) {
						// Timer mode: check elapsed time since unlock ONLY on page reload / fresh session
						const elapsedMins = (Date.now() - unlockedAt) / (1000 * 60);
						if (elapsedMins >= intervalMins) {
							shouldLock = true;
						}
					}
				}

				if (shouldLock) {
					localStorage.setItem('splitsbug_app_locked', 'true');
					showAppLockOverlay();
				}
			}

			function showAppLockOverlay() {
				const overlay = document.getElementById('globalAppLockOverlay');
				if (overlay) {
					overlay.classList.remove('hidden');
					document.body.style.overflow = 'hidden';
					
					const digits = Array.from(overlay.querySelectorAll('.app-lock-digit')) as HTMLInputElement[];
					digits.forEach(d => {
						d.value = '';
						d.classList.remove('border-danger', 'text-danger', 'bg-danger/10', 'ring-2', 'ring-danger/30');
					});
					
					const pinBoxContainer = document.getElementById('pinDigitContainer');
					if (pinBoxContainer) pinBoxContainer.classList.remove('animate-shake');
					
					const errorEl = document.getElementById('appLockError');
					if (errorEl) errorEl.classList.add('hidden');
					
					setTimeout(() => digits[0]?.focus(), 50);
				}
			}

			function unlockApp() {
				failedPinAttempts = 0;
				localStorage.setItem('splitsbug_app_locked', 'false');
				localStorage.setItem('splitsbug_unlocked_at', Date.now().toString());
				sessionStorage.setItem('splitsbug_session_unlocked', 'true');

				const overlay = document.getElementById('globalAppLockOverlay');
				if (overlay) {
					overlay.classList.add('hidden');
					document.body.style.overflow = '';
				}
				const digits = Array.from(document.querySelectorAll('.app-lock-digit')) as HTMLInputElement[];
				digits.forEach(d => {
					d.value = '';
					d.classList.remove('border-danger', 'text-danger', 'bg-danger/10', 'ring-2', 'ring-danger/30');
				});
				
				const pinBoxContainer = document.getElementById('pinDigitContainer');
				if (pinBoxContainer) pinBoxContainer.classList.remove('animate-shake');

				const errorEl = document.getElementById('appLockError');
				if (errorEl) errorEl.classList.add('hidden');
			}

			(window as any).lockAppManually = function() {
				localStorage.setItem('splitsbug_app_locked', 'true');
				sessionStorage.removeItem('splitsbug_session_unlocked');
				showAppLockOverlay();
			};

			document.addEventListener('DOMContentLoaded', () => {
				checkAppLockState();

				const digits = Array.from(document.querySelectorAll('.app-lock-digit')) as HTMLInputElement[];
				const errorEl = document.getElementById('appLockError');
				const pinBoxContainer = document.getElementById('pinDigitContainer');

				digits.forEach((digit, idx) => {
					digit.addEventListener('input', () => {
						// Remove red error state and shake animation as soon as user types
						digits.forEach(d => d.classList.remove('border-danger', 'text-danger', 'bg-danger/10', 'ring-2', 'ring-danger/30'));
						if (pinBoxContainer) pinBoxContainer.classList.remove('animate-shake');
						if (errorEl) errorEl.classList.add('hidden');

						const val = digit.value.replace(/[^0-9]/g, '');
						digit.value = val ? val.slice(-1) : '';
						
						if (digit.value && idx < digits.length - 1) {
							digits[idx + 1].focus();
						}
						
						if (digits.every(d => d.value.length === 1)) {
							verifyPin();
						}
					});

					digit.addEventListener('keydown', (e) => {
						if (e.key === 'Backspace' && !digit.value && idx > 0) {
							digits[idx - 1].focus();
						} else if (e.key === 'Enter') {
							verifyPin();
						}
					});
				});

				async function verifyPin() {
					const enteredPin = digits.map(d => d.value).join('');
					const savedPin = localStorage.getItem('splitsbug_pin_val');

					if (enteredPin === savedPin) {
						unlockApp();
					} else {
						failedPinAttempts++;
						
						// Highlight boxes red and shake
						digits.forEach(d => {
							d.value = '';
							d.classList.add('border-danger', 'text-danger', 'bg-danger/10', 'ring-2', 'ring-danger/30');
						});

						if (pinBoxContainer) {
							pinBoxContainer.classList.remove('animate-shake');
							void pinBoxContainer.offsetWidth; // Trigger reflow to restart animation
							pinBoxContainer.classList.add('animate-shake');
						}

						digits[0]?.focus();

						if (failedPinAttempts >= 5) {
							document.getElementById('appLockPinView')?.classList.add('hidden');
							document.getElementById('appLockRecoveryView')?.classList.remove('hidden');
						} else if (errorEl) {
							errorEl.textContent = `Incorrect passcode. ${5 - failedPinAttempts} attempt(s) remaining.`;
							errorEl.classList.remove('hidden');
						}
					}
				}

				// Account Password Recovery unlock
				const recoveryBtn = document.getElementById('appLockRecoveryBtn');
				const recoveryInput = document.getElementById('appLockAccountPassInput') as HTMLInputElement;
				const recoveryError = document.getElementById('appLockRecoveryError');

				const handleRecoverySubmit = async () => {
					if (!recoveryInput || !recoveryInput.value) return;
					if (recoveryBtn) {
						(recoveryBtn as HTMLButtonElement).disabled = true;
						recoveryBtn.textContent = 'Verifying...';
					}

					try {
						const user = auth.currentUser;
						if (user && user.email) {
							const cred = EmailAuthProvider.credential(user.email, recoveryInput.value);
							await reauthenticateWithCredential(user, cred);
							
							document.getElementById('appLockRecoveryView')?.classList.add('hidden');
							document.getElementById('appLockPinView')?.classList.remove('hidden');
							recoveryInput.value = '';
							unlockApp();
						} else {
							throw new Error('User session not found.');
						}
					} catch (err: any) {
						if (recoveryError) {
							recoveryError.textContent = "Incorrect account password. Please try again.";
							recoveryError.classList.remove('hidden');
						}
					} finally {
						if (recoveryBtn) {
							(recoveryBtn as HTMLButtonElement).disabled = false;
							recoveryBtn.textContent = 'Unlock with Account Password';
						}
					}
				};

				recoveryBtn?.addEventListener('click', handleRecoverySubmit);
				recoveryInput?.addEventListener('keydown', (e) => {
					if (e.key === 'Enter') handleRecoverySubmit();
				});
			});
		</script>
	</body>
</html>

