---
import '../styles/global.css';

export interface Props {
  hideNav?: boolean;
}

const { hideNav = false } = Astro.props;
const pathname = Astro.url.pathname;
const isActivity = pathname === '/activity';
const isAccount = pathname === '/account';
const isGroups = pathname === '/dashboard' || pathname === '/';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0" />
		<link rel="icon" type="image/svg+xml" href="/SplitBugs-Brand/favicon/favicon.svg?v=3" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet">
		<title>SplitBugs</title>
		<script src="/js/categories.js" is:inline></script>
		<script is:inline>
			// Apply Theme
			const savedTheme = localStorage.getItem('splitbug_theme') || 'dark-grey';
			window.applyTheme = (theme) => {
				document.documentElement.className = '';
				if (theme === 'system') {
					if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
						document.documentElement.classList.add('theme-dark-grey');
					} else {
						document.documentElement.classList.add('theme-light-white');
					}
				} else if (theme === 'splitsbug') {
					const hour = new Date().getHours();
					let activeTheme = 'light-white';
					if (hour >= 5 && hour < 7) activeTheme = 'light-cream';
					else if (hour >= 7 && hour < 17) activeTheme = 'light-white';
					else if (hour >= 17 && hour < 18) activeTheme = 'light-cream';
					else if (hour >= 18 && hour < 21) activeTheme = 'dark-grey';
					else activeTheme = 'dark-amoled';
					document.documentElement.classList.add(`theme-${activeTheme}`);
				} else {
					document.documentElement.classList.add(`theme-${theme}`);
				}
				window.dispatchEvent(new CustomEvent('themeChanged', { detail: { theme: document.documentElement.className } }));
			};
			window.applyTheme(savedTheme);

			// Automatically re-apply theme if system preference changes or if splitsbug theme is active
			window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
				if (localStorage.getItem('splitbug_theme') === 'system') {
					window.applyTheme('system');
				}
			});

			setInterval(() => {
				if (localStorage.getItem('splitbug_theme') === 'splitsbug') {
					window.applyTheme('splitsbug');
				}
			}, 60000);

			// Global Name Definition
			window.MY_NAME = localStorage.getItem('splitbug_userName') || 'Name';
			window.MY_DISPLAY_NAME = `${window.MY_NAME} (You)`;

			// Auth Check
			const isLoggedIn = localStorage.getItem('splitbug_loggedIn') === 'true';
			const isAuthPage = window.location.pathname === '/login' || window.location.pathname === '/signup';
			if (!isLoggedIn && !isAuthPage) {
				window.location.href = '/login';
			} else if (isLoggedIn && isAuthPage) {
				window.location.href = '/dashboard';
			} else if (isLoggedIn && window.location.pathname === '/') {
				window.location.href = '/dashboard';
			}

			// Native Push Notifications Listener (Cross-tab)
			window.addEventListener('storage', (e) => {
				if (e.key === 'splitsbug_notifications') {
					const userEmail = localStorage.getItem('splitbug_userEmail');
					if (!userEmail) return;
					
					try {
						const oldData = e.oldValue ? JSON.parse(e.oldValue) : {};
						const newData = e.newValue ? JSON.parse(e.newValue) : {};
						
						const oldUserNotifs = oldData[userEmail] || [];
						const newUserNotifs = newData[userEmail] || [];
						
						if (newUserNotifs.length > oldUserNotifs.length) {
							const addedNotifs = newUserNotifs.filter((n) => !oldUserNotifs.some((old) => old.id === n.id));
							
							if (Notification.permission === 'granted') {
								addedNotifs.forEach((notif) => {
									new Notification("SplitsBug", {
										body: notif.message,
										icon: '/SplitBugs-Brand/favicon/favicon.svg'
									});
								});
							}
						}
					} catch(err) {}
				}
			});
		</script>
	</head>
	<body class="pb-28">
		<slot />

		{ !hideNav && (
		<nav class="fixed bottom-0 left-0 w-full bg-canvas border-t border-hairline pb-safe z-50">
			<div class="flex items-center justify-around h-16 max-w-md mx-auto">
				<a href="/dashboard" class={`flex flex-col items-center justify-center w-16 h-full transition-colors ${isGroups ? 'text-brand' : 'text-mute hover:text-ink'}`}>
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mb-1"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
					<span class="text-[10px] font-medium">Groups</span>
				</a>
				<a href="/activity" class={`flex flex-col items-center justify-center w-16 h-full transition-colors ${isActivity ? 'text-brand' : 'text-mute hover:text-ink'}`}>
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mb-1"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
					<span class="text-[10px] font-medium">Activity</span>
				</a>
				<a href="/account" class={`flex flex-col items-center justify-center w-16 h-full transition-colors group ${isAccount ? 'text-brand' : 'text-mute hover:text-ink'}`}>
					<div id="navAccountIcon" class="flex flex-col items-center justify-center mb-1">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
					</div>
					<span class="text-[10px] font-medium">Account</span>
				</a>
			</div>
		</nav>
		)}
		
		<script>
			function renderAbstractArt(type: string) {
				if (type === 'special-art-1') return '<div class="w-full h-full" style="background: conic-gradient(from 45deg, #FF6B6B, #4ECDC4, #45B7D1, #FF6B6B);"></div>';
				if (type === 'special-art-2') return '<div class="w-full h-full" style="background: linear-gradient(135deg, #FF9A9E 0%, #FECFEF 99%, #FECFEF 100%);"><div class="w-1/2 h-1/2 bg-white/30 rounded-br-full backdrop-blur-md"></div></div>';
				if (type === 'special-art-3') return '<div class="w-full h-full flex"><div class="w-1/2 h-full bg-indigo-500"></div><div class="w-1/2 h-full bg-rose-400 rounded-tl-full"></div></div>';
				return '';
			}

			const navAccountIcon = document.getElementById('navAccountIcon');
			if (navAccountIcon && localStorage.getItem('splitbug_loggedIn')) {
				const userAvatar = localStorage.getItem('splitbug_userAvatar');
				const userName = localStorage.getItem('splitbug_userName') || 'User';
				const userThemeColor = localStorage.getItem('splitbug_userThemeColor') || 'special-art-1';
				const isAccountPath = window.location.pathname === '/account';
				
				if (userAvatar) {
					navAccountIcon.innerHTML = `<img src="${userAvatar}" class="w-6 h-6 rounded-full object-cover ring-2 ${isAccountPath ? 'ring-brand' : 'ring-transparent group-hover:ring-brand/30'} transition-all" />`;
				} else if (userThemeColor.startsWith('special-art-')) {
					navAccountIcon.innerHTML = `<div class="w-6 h-6 rounded-full overflow-hidden ring-2 ${isAccountPath ? 'ring-brand' : 'ring-transparent group-hover:ring-brand/30'} transition-all">${renderAbstractArt(userThemeColor)}</div>`;
				} else {
					const parts = userName.trim().split(' ').filter(Boolean);
					let initials = 'U';
					if (parts.length > 0 && parts[0]) {
						if (parts.length === 1) initials = parts[0].charAt(0).toUpperCase();
						else initials = (parts[0].charAt(0) + parts[parts.length - 1].charAt(0)).toUpperCase();
					}
					navAccountIcon.innerHTML = `<div class="w-6 h-6 rounded-full ${userThemeColor} text-white flex items-center justify-center text-[10px] font-bold ring-2 ${isAccountPath ? 'ring-brand' : 'ring-transparent group-hover:ring-brand/30'} transition-all">${initials}</div>`;
				}
			}
		</script>
		<script>
			import { auth, db } from '../firebase';
			import { onAuthStateChanged } from 'firebase/auth';
			import { doc, getDoc } from 'firebase/firestore';

			onAuthStateChanged(auth, async (user) => {
				const isAuthPage = window.location.pathname === '/login' || window.location.pathname === '/signup';
				if (user) {
					localStorage.setItem('splitbug_loggedIn', 'true');
					localStorage.setItem('splitbug_userEmail', user.email || '');
					
					// Fetch user doc to get name and theme if not already set correctly
					if (!localStorage.getItem('splitbug_userName')) {
						try {
							const userDoc = await getDoc(doc(db, 'users', user.uid));
							if (userDoc.exists()) {
								const data = userDoc.data();
								localStorage.setItem('splitbug_userName', data.name || user.email?.split('@')[0] || 'User');
								if (data.themeColor) localStorage.setItem('splitbug_userThemeColor', data.themeColor);
								window.dispatchEvent(new Event('storage'));
							}
						} catch(e) {}
					}
					
					if (isAuthPage || window.location.pathname === '/') {
						window.location.href = '/dashboard';
					}
				} else {
					localStorage.removeItem('splitbug_loggedIn');
					localStorage.removeItem('splitbug_userEmail');
					localStorage.removeItem('splitbug_userName');
					
					if (!isAuthPage) {
						window.location.href = '/login';
					}
				}
			});
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
