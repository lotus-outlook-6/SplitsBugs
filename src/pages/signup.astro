---
import Layout from '../layouts/Layout.astro';
---
<Layout hideNav={true}>
  <div class="min-h-screen w-full flex flex-col justify-center items-center p-0 sm:p-6 bg-canvas sm:bg-canvas-soft overflow-y-auto">
    <div class="w-full max-w-xl bg-canvas p-4 sm:p-8 sm:rounded-2xl sm:shadow-lg sm:border sm:border-hairline relative">
      <div class="text-center mb-6">
        <h1 class="text-2xl font-bold text-ink mb-1">Create an account</h1>
        <p class="text-mute text-sm">Join SplitBugs to track expenses</p>
      </div>
      
      <form id="signupForm" class="flex flex-col gap-3">
        <div id="errorBox" class="hidden bg-danger/10 border border-danger/20 text-danger p-3 rounded-md text-sm font-medium"></div>

        <!-- First Name -->
        <div>
          <label class="block text-sm font-medium text-ink mb-1">First Name</label>
          <input type="text" required id="nameInput" autocomplete="off" class="w-full p-3 rounded-md border border-hairline bg-canvas focus:outline-none focus:border-brand transition-colors text-ink placeholder:text-mute" placeholder="e.g. John Doe" />
        </div>
        
        <!-- Email -->
        <div class="relative">
          <label class="block text-sm font-medium text-ink mb-1">Email address</label>
          <input type="text" required id="emailInput" class="w-full p-3 rounded-md border border-hairline bg-canvas focus:outline-none focus:border-brand transition-colors text-ink placeholder:text-mute" placeholder="john@example.com" />
          
          <!-- Email Autocomplete Dropdown -->
          <div id="emailSuggestions" class="hidden absolute left-0 right-0 mt-1 bg-canvas border border-hairline rounded-md shadow-lg z-10 overflow-hidden">
            <!-- Populated by JS -->
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <!-- Date of Birth -->
          <div>
            <label class="block text-sm font-medium text-ink mb-1">Date of Birth</label>
            <div class="relative">
              <input type="text" required id="dobInput" autocomplete="off" class="w-full p-3 pr-10 rounded-md border border-hairline bg-canvas focus:outline-none focus:border-brand transition-colors text-ink placeholder:text-mute" placeholder="dd/mm/yyyy" />
              <button type="button" id="dobCalBtn" class="absolute right-2 top-2 p-1.5 hover:bg-canvas-soft rounded-md transition-colors text-mute hover:text-brand focus:outline-none">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              </button>
            </div>
          </div>

          <!-- Contact Number -->
          <div>
            <label class="block text-sm font-medium text-ink mb-1">Contact Number</label>
            <div class="flex border border-hairline rounded-md focus-within:border-brand transition-colors bg-canvas overflow-hidden">
              <button type="button" id="countryCodeBtn" class="px-3 rounded-l-md flex items-center gap-1 border-r border-hairline hover:bg-canvas-soft transition-colors text-ink">
                <span id="countryCodeLabel">+91</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
              <input type="text" required id="phoneInput" autocomplete="off" maxlength="10" class="flex-1 p-3 w-full bg-transparent focus:outline-none text-ink placeholder:text-mute" placeholder="XXXXXXXXXX" />
            </div>
          </div>
        </div>

        <!-- Password -->
        <div>
          <label class="block text-sm font-medium text-ink mb-1">Password</label>
          <input type="password" required id="passwordInput" class="w-full p-3 rounded-md border border-hairline bg-canvas focus:outline-none focus:border-brand transition-colors text-ink placeholder:text-mute" placeholder="••••••••" />
          <ul class="text-xs text-mute mt-2 space-y-1">
            <li id="rule-length" class="flex items-center gap-1"><span class="icon-placeholder w-3 h-3"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg></span> At least 8 characters</li>
            <li id="rule-upper" class="flex items-center gap-1"><span class="icon-placeholder w-3 h-3"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg></span> 1 uppercase & 1 lowercase</li>
            <li id="rule-num" class="flex items-center gap-1"><span class="icon-placeholder w-3 h-3"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg></span> 1 number</li>
            <li id="rule-spec" class="flex items-center gap-1"><span class="icon-placeholder w-3 h-3"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg></span> 1 special character</li>
          </ul>
        </div>
        
        <button type="submit" id="submitBtn" class="w-full py-2.5 mt-2 bg-brand text-white rounded-md font-bold hover:bg-brand-deep transition-colors shadow-sm disabled:opacity-50 disabled:cursor-not-allowed">
          Sign up
        </button>
      </form>

      <p class="text-center text-sm text-mute mt-6">
        Already have an account? <a href="/login" class="text-brand font-medium hover:underline">Log in</a>
      </p>
    </div>
  </div>

  <!-- Shared Calendar Picker Dialog (top layer) -->
  <dialog id="calPickerDialog" class="backdrop:bg-black/50 text-ink p-0 rounded-2xl shadow-2xl w-[320px] bg-canvas border border-hairline m-auto overflow-hidden">
    <div class="p-4">
      <!-- Header: Month + Year clickable -->
      <div class="flex items-center justify-between mb-4">
        <button type="button" id="calPrevMonth" class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-canvas-soft transition-colors text-ink">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <div class="flex items-center gap-2">
          <button type="button" id="calMonthBtn" class="text-sm font-bold text-ink hover:text-brand transition-colors"></button>
          <button type="button" id="calYearBtn" class="text-sm font-bold text-brand hover:opacity-70 transition-opacity"></button>
        </div>
        <button type="button" id="calNextMonth" class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-canvas-soft transition-colors text-ink">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>

      <!-- Day grid view -->
      <div id="calDayView">
        <div class="grid grid-cols-7 mb-2">
          <span class="text-[10px] font-semibold text-mute text-center">Su</span>
          <span class="text-[10px] font-semibold text-mute text-center">Mo</span>
          <span class="text-[10px] font-semibold text-mute text-center">Tu</span>
          <span class="text-[10px] font-semibold text-mute text-center">We</span>
          <span class="text-[10px] font-semibold text-mute text-center">Th</span>
          <span class="text-[10px] font-semibold text-mute text-center">Fr</span>
          <span class="text-[10px] font-semibold text-mute text-center">Sa</span>
        </div>
        <div id="calDayGrid" class="grid grid-cols-7 gap-y-1"></div>
      </div>

      <!-- Month picker view -->
      <div id="calMonthView" class="hidden">
        <div id="calMonthGrid" class="grid grid-cols-3 gap-2"></div>
      </div>

      <!-- Year picker view -->
      <div id="calYearView" class="hidden">
        <div id="calYearList" class="h-48 overflow-y-auto space-y-1 pr-1"></div>
      </div>
    </div>

    <!-- Footer -->
    <div class="px-4 pb-4 flex justify-end gap-2">
      <button type="button" id="calCancelBtn" class="px-4 py-1.5 text-sm font-medium text-mute hover:text-ink transition-colors">Cancel</button>
      <button type="button" id="calOkBtn" class="px-4 py-1.5 text-sm font-medium text-white bg-brand rounded-full hover:opacity-90 transition-opacity">OK</button>
    </div>
  </dialog>

  <!-- Country Code Dialog -->
  <dialog id="countryCodeDialog" class="backdrop:bg-black/50 text-ink p-0 rounded-xl shadow-2xl w-[90vw] max-w-sm bg-canvas border border-hairline m-auto overflow-hidden">
    <div class="flex flex-col h-[70vh] w-full">
      <div class="p-4 border-b border-hairline flex items-center justify-between">
        <h3 class="font-bold text-ink">Select Country</h3>
        <button type="button" id="closeCountryBtn" class="text-mute hover:text-ink">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
      <div class="p-3 border-b border-hairline bg-canvas-soft">
        <input type="text" id="countrySearch" class="w-full p-2 rounded-md border border-hairline bg-canvas focus:outline-none focus:border-brand text-sm" placeholder="Search country..." />
      </div>
      <div id="countryList" class="flex-1 overflow-y-auto p-2 space-y-1">
        <!-- Populated by JS -->
      </div>
    </div>
  </dialog>

  <script>
    import { auth, db } from '../firebase';
    import { createUserWithEmailAndPassword, updateProfile } from 'firebase/auth';
    import { doc, setDoc } from 'firebase/firestore';

    // Elements
    const form = document.getElementById('signupForm') as HTMLFormElement;
    const nameInput = document.getElementById('nameInput') as HTMLInputElement;
    const emailInput = document.getElementById('emailInput') as HTMLInputElement;
    const emailSuggestions = document.getElementById('emailSuggestions') as HTMLDivElement;
    const passwordInput = document.getElementById('passwordInput') as HTMLInputElement;
    const dobInput = document.getElementById('dobInput') as HTMLInputElement;
    const phoneInput = document.getElementById('phoneInput') as HTMLInputElement;
    const errorBox = document.getElementById('errorBox') as HTMLDivElement;
    
    dobInput.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement;
      let v = target.value.replace(/[^\d]/g, '');
      if (v.length > 8) v = v.substring(0, 8);
      if (v.length > 4) {
        v = v.substring(0, 2) + '/' + v.substring(2, 4) + '/' + v.substring(4);
      } else if (v.length > 2) {
        v = v.substring(0, 2) + '/' + v.substring(2);
      }
      target.value = v;
    });

    // Country Code
    const countryCodeBtn = document.getElementById('countryCodeBtn') as HTMLButtonElement;
    const countryCodeLabel = document.getElementById('countryCodeLabel') as HTMLSpanElement;
    const countryCodeDialog = document.getElementById('countryCodeDialog') as HTMLDialogElement;
    const closeCountryBtn = document.getElementById('closeCountryBtn') as HTMLButtonElement;
    const countryList = document.getElementById('countryList') as HTMLDivElement;
    const countrySearch = document.getElementById('countrySearch') as HTMLInputElement;
    const COUNTRIES = [
      { name: 'United States', code: '+1', max: 10 },
      { name: 'United Kingdom', code: '+44', max: 10 },
      { name: 'India', code: '+91', max: 10 },
      { name: 'Canada', code: '+1', max: 10 },
      { name: 'Australia', code: '+61', max: 9 },
      { name: 'Germany', code: '+49', max: 11 },
      { name: 'France', code: '+33', max: 9 },
      { name: 'Japan', code: '+81', max: 10 },
      { name: 'China', code: '+86', max: 11 },
      { name: 'Brazil', code: '+55', max: 11 },
      { name: 'Mexico', code: '+52', max: 10 },
      { name: 'South Africa', code: '+27', max: 9 },
      { name: 'Spain', code: '+34', max: 9 },
      { name: 'Italy', code: '+39', max: 10 },
      { name: 'Russia', code: '+7', max: 10 },
      { name: 'Netherlands', code: '+31', max: 9 },
      { name: 'Singapore', code: '+65', max: 8 },
      { name: 'New Zealand', code: '+64', max: 9 }
    ].sort((a, b) => a.name.localeCompare(b.name));

    function renderCountries(filter = '') {
      countryList.innerHTML = '';
      const filtered = COUNTRIES.filter(c => c.name.toLowerCase().includes(filter.toLowerCase()) || c.code.includes(filter));
      filtered.forEach(c => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'w-full flex items-center justify-between p-3 rounded-md hover:bg-canvas-soft transition-colors text-left';
        btn.innerHTML = `<span class="text-ink">${c.name}</span><span class="text-mute font-medium">${c.code}</span>`;
        btn.onclick = () => {
          countryCodeLabel.textContent = c.code;
          phoneInput.maxLength = c.max;
          phoneInput.placeholder = 'X'.repeat(c.max);
          countryCodeDialog.close();
        };
        countryList.appendChild(btn);
      });
    }

    countryCodeBtn?.addEventListener('click', () => {
      renderCountries();
      countrySearch.value = '';
      countryCodeDialog.showModal();
    });
    closeCountryBtn?.addEventListener('click', () => countryCodeDialog.close());
    countrySearch?.addEventListener('input', (e) => renderCountries((e.target as HTMLInputElement).value));

    // First Name Restriction
    nameInput.addEventListener('input', () => {
      nameInput.value = nameInput.value.replace(/[^a-zA-Z\s]/g, '');
    });

    // Contact Number Restriction
    phoneInput.addEventListener('input', () => {
      phoneInput.value = phoneInput.value.replace(/[^0-9]/g, '');
    });

    // Email Validation & Autocomplete
    const DOMAINS = ['gmail.com', 'outlook.com', 'proton.me', 'icloud.com', 'yahoo.com'];
    
    let emailSelectedIndex = -1;
    let emailOriginalText = '';

    function updateEmailSelection(suggestions: NodeListOf<Element>) {
      suggestions.forEach((el, index) => {
        if (index === emailSelectedIndex) {
          el.classList.add('bg-canvas-soft');
          emailInput.value = el.getAttribute('data-val') || '';
        } else {
          el.classList.remove('bg-canvas-soft');
        }
      });
      if (emailSelectedIndex === -1) {
        emailInput.value = emailOriginalText;
      }
    }

    emailInput.addEventListener('keydown', (e) => {
      const suggestions = emailSuggestions.querySelectorAll('.email-suggestion');
      if (suggestions.length === 0 || emailSuggestions.classList.contains('hidden')) {
        emailSelectedIndex = -1;
        return;
      }
      
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (emailSelectedIndex === -1) {
          emailOriginalText = emailInput.value;
        }
        emailSelectedIndex++;
        if (emailSelectedIndex >= suggestions.length) {
          emailSelectedIndex = suggestions.length - 1;
        }
        updateEmailSelection(suggestions);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (emailSelectedIndex > -1) {
          emailSelectedIndex--;
          updateEmailSelection(suggestions);
        }
      } else if (e.key === 'Enter') {
        if (emailSelectedIndex > -1) {
          e.preventDefault();
          const selected = suggestions[emailSelectedIndex] as HTMLElement;
          emailInput.value = selected.getAttribute('data-val') || '';
          emailSuggestions.classList.add('hidden');
        }
      }
    });

    emailInput.addEventListener('input', () => {
      emailSelectedIndex = -1;
      let val = emailInput.value;
      
      // Real-time stripping/validation
      const atIndex = val.indexOf('@');
      
      if (atIndex === -1) {
        // Before @
        val = val.replace(/[^a-z0-9]/g, ''); // lowercase alphabets and numbers only
        emailInput.value = val;
        emailSuggestions.classList.add('hidden');
      } else {
        // After @
        let beforeAt = val.slice(0, atIndex);
        let afterAt = val.slice(atIndex + 1);
        
        beforeAt = beforeAt.replace(/[^a-z0-9]/g, '');
        
        const dotIndex = afterAt.indexOf('.');
        if (dotIndex === -1) {
          // Between @ and .
          afterAt = afterAt.replace(/[^a-zA-Z]/g, '');
          
          // Suggestions
          if (afterAt.length >= 0) {
            const matches = DOMAINS.filter(d => d.startsWith(afterAt));
            if (matches.length > 0) {
              emailSuggestions.innerHTML = matches.map(m => 
                `<button type="button" class="w-full text-left p-3 hover:bg-canvas-soft text-ink transition-colors border-b border-hairline last:border-b-0 email-suggestion" data-val="${beforeAt}@${m}">
                  ${beforeAt}@<span class="font-bold">${m}</span>
                </button>`
              ).join('');
              emailSuggestions.classList.remove('hidden');
              
              document.querySelectorAll('.email-suggestion').forEach(btn => {
                btn.addEventListener('click', (e) => {
                  emailInput.value = (e.currentTarget as HTMLElement).getAttribute('data-val');
                  emailSuggestions.classList.add('hidden');
                });
              });
            } else {
              emailSuggestions.classList.add('hidden');
            }
          }
        } else {
          // After .
          let domain = afterAt.slice(0, dotIndex).replace(/[^a-zA-Z]/g, '');
          let tld = afterAt.slice(dotIndex + 1).replace(/[^a-zA-Z]/g, '');
          afterAt = `${domain}.${tld}`;
          emailSuggestions.classList.add('hidden');
        }
        
        emailInput.value = `${beforeAt}@${afterAt}`;
      }
    });

    // Hide suggestions on blur
    document.addEventListener('click', (e) => {
      if (!emailInput.contains(e.target as Node) && !emailSuggestions.contains(e.target as Node)) {
        emailSuggestions.classList.add('hidden');
      }
    });

    // Password Validation
    const ruleLength = document.getElementById('rule-length') as HTMLElement;
    const ruleUpper = document.getElementById('rule-upper') as HTMLElement;
    const ruleNum = document.getElementById('rule-num') as HTMLElement;
    const ruleSpec = document.getElementById('rule-spec') as HTMLElement;

    const checkIcon = `<svg class="w-4 h-4 text-success" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>`;
    const crossIcon = `<svg class="w-4 h-4 text-danger" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>`;
    const circleIcon = `<svg class="w-3 h-3 text-mute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>`;

    let hasStartedTyping = false;
    let isPasswordValid = false;

    function updateRule(element: HTMLElement, isValid: boolean) {
      const iconSpan = element.querySelector('.icon-placeholder');
      if (!hasStartedTyping) {
        element.classList.remove('text-success', 'text-error');
        element.classList.add('text-mute');
        if (iconSpan) iconSpan.innerHTML = circleIcon;
        return;
      }

      if (isValid) {
        element.classList.remove('text-mute', 'text-danger');
        element.classList.add('text-success');
        if (iconSpan) iconSpan.innerHTML = checkIcon;
      } else {
        element.classList.remove('text-success', 'text-mute');
        element.classList.add('text-danger');
        if (iconSpan) iconSpan.innerHTML = crossIcon;
      }
    }

    passwordInput.addEventListener('input', () => {
      const val = passwordInput.value;
      hasStartedTyping = val.length > 0;
      
      const lengthValid = val.length >= 8;
      const upperLowerValid = /[a-z]/.test(val) && /[A-Z]/.test(val);
      const numValid = /[0-9]/.test(val);
      const specValid = /[^a-zA-Z0-9]/.test(val);

      updateRule(ruleLength, lengthValid);
      updateRule(ruleUpper, upperLowerValid);
      updateRule(ruleNum, numValid);
      updateRule(ruleSpec, specValid);

      isPasswordValid = lengthValid && upperLowerValid && numValid && specValid;
    });

    // Final Form Submission Validation
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const email = emailInput.value.trim();
      const emailRegex = /^[a-z0-9]+@[a-zA-Z]+\.[a-zA-Z]+$/;

      if (!emailRegex.test(email)) {
        errorBox.textContent = "Please enter a valid email address (e.g. name@domain.com).";
        errorBox.classList.remove('hidden');
        return;
      }

      if (!isPasswordValid) {
        errorBox.textContent = "Please ensure your password meets all requirements.";
        errorBox.classList.remove('hidden');
        return;
      }

      const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Creating account...';
      }

      // Format phone
      const phone = `${countryCodeLabel.textContent} ${phoneInput.value}`;

      try {
        const userCredential = await createUserWithEmailAndPassword(auth, email, passwordInput.value);
        const user = userCredential.user;

        await updateProfile(user, {
          displayName: nameInput.value.trim()
        });

        // Save additional details to Firestore
        await setDoc(doc(db, "users", user.uid), {
          email: email,
          name: nameInput.value.trim(),
          dob: dobInput.value,
          phone: phone,
          themeColor: 'special-art-1',
          createdAt: new Date().toISOString()
        });

        window.location.href = '/login?registered=true';
      } catch (error: any) {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Sign up';
        }
        errorBox.textContent = error.message || "An error occurred during signup.";
        errorBox.classList.remove('hidden');
      }
    });

    // ----------------------------------------------------
    // Calendar Picker Dialog
    // ----------------------------------------------------
    const calDialog    = document.getElementById('calPickerDialog') as HTMLDialogElement;
    const calPrevBtn   = document.getElementById('calPrevMonth')!;
    const calNextBtn   = document.getElementById('calNextMonth')!;
    const calMonthBtn  = document.getElementById('calMonthBtn')!;
    const calYearBtn   = document.getElementById('calYearBtn')!;
    const calDayView   = document.getElementById('calDayView')!;
    const calDayGrid   = document.getElementById('calDayGrid')!;
    const calMonthView = document.getElementById('calMonthView')!;
    const calMonthGrid = document.getElementById('calMonthGrid')!;
    const calYearView  = document.getElementById('calYearView')!;
    const calYearList  = document.getElementById('calYearList')!;
    const calCancelBtn = document.getElementById('calCancelBtn')!;
    const calOkBtn     = document.getElementById('calOkBtn')!;

    const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
    const SHORT_MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

    let calYear  = new Date().getFullYear();
    let calMonth = new Date().getMonth();
    let calSelectedDate: Date | null = null;
    let calView: 'day' | 'month' | 'year' = 'day';

    function calShowView(v: 'day' | 'month' | 'year') {
      calView = v;
      calDayView.classList.toggle('hidden', v !== 'day');
      calMonthView.classList.toggle('hidden', v !== 'month');
      calYearView.classList.toggle('hidden', v !== 'year');
      calPrevBtn.style.visibility = v === 'day' ? 'visible' : 'hidden';
      calNextBtn.style.visibility = v === 'day' ? 'visible' : 'hidden';
    }

    function calUpdateHeader() {
      calMonthBtn.textContent = MONTHS[calMonth];
      calYearBtn.textContent  = String(calYear);
    }

    function calRenderDays() {
      calUpdateHeader();
      const today    = new Date();
      const firstDay = new Date(calYear, calMonth, 1).getDay();
      const daysInM  = new Date(calYear, calMonth + 1, 0).getDate();
      calDayGrid.innerHTML = '';
      let totalCells = 0;
      for (let i = 0; i < firstDay; i++) {
        const empty = document.createElement('div');
        empty.className = 'h-8';
        calDayGrid.appendChild(empty);
        totalCells++;
      }
      for (let d = 1; d <= daysInM; d++) {
        const btn = document.createElement('button');
        btn.type = 'button';
        const thisDate = new Date(calYear, calMonth, d);
        const isToday    = thisDate.toDateString() === today.toDateString();
        const isSelected = calSelectedDate && thisDate.toDateString() === calSelectedDate.toDateString();
        btn.textContent = String(d);
        btn.className = [
          'w-8 h-8 mx-auto flex items-center justify-center rounded-full text-xs font-medium transition-all cursor-pointer',
          isSelected ? 'bg-brand text-white shadow-sm'
          : isToday  ? 'border border-brand text-brand hover:bg-brand/10'
                     : 'text-ink hover:bg-canvas-soft'
        ].join(' ');
        btn.addEventListener('click', () => {
          calSelectedDate = thisDate;
          calRenderDays();
        });
        calDayGrid.appendChild(btn);
        totalCells++;
      }
      while (totalCells < 42) {
        const empty = document.createElement('div');
        empty.className = 'h-8';
        calDayGrid.appendChild(empty);
        totalCells++;
      }
    }

    function calRenderMonths() {
      calUpdateHeader();
      calMonthGrid.innerHTML = '';
      SHORT_MONTHS.forEach((m, i) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = m;
        btn.className = [
          'py-2 rounded-lg text-sm font-medium transition-colors cursor-pointer',
          i === calMonth ? 'bg-brand text-white' : 'text-ink hover:bg-canvas-soft'
        ].join(' ');
        btn.addEventListener('click', () => {
          calMonth = i;
          calRenderDays();
          calShowView('day');
        });
        calMonthGrid.appendChild(btn);
      });
    }

    function calRenderYears() {
      calUpdateHeader();
      calYearList.innerHTML = '';
      const startYear = calYear - 100;
      for (let y = startYear; y <= calYear + 20; y++) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = String(y);
        btn.className = [
          'w-full text-center py-1.5 rounded-lg text-sm font-medium transition-colors cursor-pointer',
          y === calYear ? 'bg-brand text-white' : 'text-ink hover:bg-canvas-soft'
        ].join(' ');
        btn.addEventListener('click', () => {
          calYear = y;
          calRenderDays();
          calShowView('day');
        });
        calYearList.appendChild(btn);
        if (y === calYear) {
          setTimeout(() => btn.scrollIntoView({ block: 'center' }), 10);
        }
      }
    }

    calPrevBtn.addEventListener('click', () => {
      calMonth--; if (calMonth < 0) { calMonth = 11; calYear--; }
      calRenderDays();
    });
    calNextBtn.addEventListener('click', () => {
      calMonth++; if (calMonth > 11) { calMonth = 0; calYear++; }
      calRenderDays();
    });
    calMonthBtn.addEventListener('click', () => { calRenderMonths(); calShowView('month'); });
    calYearBtn.addEventListener('click',  () => { calRenderYears();  calShowView('year');  });

    calCancelBtn.addEventListener('click', () => calDialog.close());
    calOkBtn.addEventListener('click', () => {
      if (!calSelectedDate) { calDialog.close(); return; }
      const d = calSelectedDate.getDate(), mo = calSelectedDate.getMonth() + 1, y = calSelectedDate.getFullYear();
      dobInput.value = `${String(d).padStart(2,'0')}/${String(mo).padStart(2,'0')}/${y}`;
      calDialog.close();
    });

    document.getElementById('dobCalBtn')?.addEventListener('click', () => {
      if (dobInput.value) {
        const parts = dobInput.value.split('/');
        if (parts.length === 3) {
          const d = new Date(parseInt(parts[2]), parseInt(parts[1]) - 1, parseInt(parts[0]));
          if (!isNaN(d.getTime())) { calSelectedDate = d; calYear = d.getFullYear(); calMonth = d.getMonth(); }
        }
      } else {
        calSelectedDate = null;
        const now = new Date(); calYear = now.getFullYear(); calMonth = now.getMonth();
      }
      calShowView('day');
      calRenderDays();
      calDialog.showModal();
    });

  </script>
</Layout>
