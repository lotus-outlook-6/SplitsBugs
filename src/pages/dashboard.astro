      'Z': { dark: '#2563eb', light: 'bg-[#eff6ff] text-[#2563eb]' },
    };

    function getGroupColor(type: string, name: string) {
      const validTypes = ['Trip', 'Couple', 'Home'];
      if (!type || !validTypes.includes(type)) {
        const firstLetter = (name || 'G').trim().charAt(0).toUpperCase();
        if (alphabetMap[firstLetter]) return alphabetMap[firstLetter];
        return { dark: '#d97706', light: 'bg-[#fffbeb] text-[#d97706]' };
      }
      return {
        dark: typeColorMap[type] ? typeColorMap[type].match(/bg-\[([^\]]+)\]/)?.[1] || '#2563eb' : '#2563eb',
        light: typeLightColorMap[type] || 'bg-[#eff6ff] text-[#2563eb]'
      };
    }

    const memberEmailInput = document.getElementById('memberEmailInput') as HTMLInputElement;
    const addMemberBtn = document.getElementById('addMemberBtn');
    const membersTags = document.getElementById('membersTags');
    
    let currentMembers: string[] = [(window as any).MY_DISPLAY_NAME || 'You'];

    function renderTags() {
      if (!membersTags) return;
      membersTags.innerHTML = '';
      currentMembers.forEach((m, idx) => {
        const isYou = idx === 0;
        const item = document.createElement('div');
        
        let borderClass = isYou ? 'border-brand shadow-sm' : 'border-hairline';
        let cursorClass = isYou ? 'cursor-default' : 'cursor-pointer hover:bg-hairline hover:text-error transition-colors';
        
        item.className = `flex items-center gap-1.5 bg-canvas-soft border ${borderClass} text-ink rounded-pill px-4 py-1.5 text-sm font-medium whitespace-nowrap select-none flex-shrink-0 ${cursorClass}`;
        item.innerHTML = `<span>${m}</span>`;
        
        if (!isYou) {
          item.setAttribute('onclick', `removeMember(${idx})`);
        }
        membersTags.appendChild(item);
      });
    }

    (window as any).removeMember = function(idx: number) {
      currentMembers.splice(idx, 1);
      renderTags();
    };

    function addMemberAction() {
      if (!memberEmailInput) return;
      let name = memberEmailInput.value.trim();
      
      if (name) {
        if (currentMembers.find(m => m.toLowerCase() === name.toLowerCase())) {
          showToast("This name is already added.", true);
          return;
        }
        
        currentMembers.push(name);
        memberEmailInput.value = '';
        renderTags();
      }
    }

    if (addMemberBtn) {
      addMemberBtn.addEventListener('click', addMemberAction);
    }
    
    if (memberEmailInput) {
      memberEmailInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          addMemberAction();
        }
      });
    }

    function resetModal() {
      const nameInput = document.getElementById('groupName') as HTMLInputElement;
      if (nameInput) nameInput.value = '';
      if (memberEmailInput) memberEmailInput.value = '';
      currentMembers = [(window as any).MY_DISPLAY_NAME || 'You'];
      renderTags();
      
      const typeInput = document.getElementById('groupType') as HTMLInputElement;
      if (typeInput) typeInput.value = 'Trip';

      document.querySelectorAll('.group-type-btn').forEach(btn => {
        const type = btn.getAttribute('data-type');
        if (type === 'Trip') {
          btn.className = `group-type-btn flex flex-col items-center justify-center p-3 rounded-lg border transition-colors ${typeColorMap['Trip']}`;
        } else {
          btn.className = 'group-type-btn flex flex-col items-center justify-center p-3 rounded-lg border border-hairline bg-canvas text-mute transition-colors hover:bg-canvas-soft';
        }
      });
      
      const dateToggle = document.getElementById('addDatesToggle') as HTMLInputElement;
      if (dateToggle) dateToggle.checked = false;
      const datesContainerWrapper = document.getElementById('datesContainerWrapper');
      if (datesContainerWrapper) {
        datesContainerWrapper.classList.remove('grid-rows-[1fr]');
        datesContainerWrapper.classList.add('grid-rows-[0fr]');
      }
      
      const iconBox = document.getElementById('groupIconBox');
      if (iconBox) {
        iconBox.innerHTML = `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-mute"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>`;
        iconBox.classList.remove('bg-[#b2dfdb]');
        iconBox.classList.add('bg-canvas-soft');
      }
    }

    if (newGroupBtn && newGroupModal) {
      newGroupBtn.addEventListener('click', () => {
        resetModal();
        if (window.innerWidth >= 640) {
          newGroupModal.showModal();
        } else {
          newGroupModal.show();
        }
        history.pushState({ modalOpen: true }, '');
      });

      closeGroupBtn?.addEventListener('click', () => {
        newGroupModal.close();
      });

      // Handle click outside to close
      newGroupModal.addEventListener('click', (e) => {
        const d = newGroupModal.getBoundingClientRect();
        if (e.clientX < d.left || e.clientX > d.right || e.clientY < d.top || e.clientY > d.bottom) {
          newGroupModal.close();
        }
      });

      // Handle native close (ESC key) or manual close
      newGroupModal.addEventListener('close', () => {
        resetModal();
        // Only back out of history if we are still in the modalOpen state
        if (history.state?.modalOpen) {
          history.back();
        }
      });

      window.addEventListener('popstate', () => {
        if (newGroupModal.open) {
          newGroupModal.close();
        }
      });
      
      // Dynamic icon based on input
      const groupNameInput = document.getElementById('groupName') as HTMLInputElement;
      const groupIconBox = document.getElementById('groupIconBox');
      if (groupNameInput && groupIconBox) {
        groupNameInput.addEventListener('input', () => {
          const val = groupNameInput.value.trim();
          const typeInput = document.getElementById('groupType') as HTMLInputElement;
          const currentType = typeInput ? typeInput.value : 'Trip';
          if (val.length > 0) {
            const colors = getGroupColor(currentType, val);
            groupIconBox.innerHTML = val.charAt(0).toUpperCase();
            groupIconBox.className = `w-16 h-16 shrink-0 rounded-xl border border-hairline flex items-center justify-center text-2xl font-bold transition-colors`;
            groupIconBox.style.backgroundColor = colors.dark + '20';
            groupIconBox.style.color = colors.dark;
          } else {
            groupIconBox.innerHTML = `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-mute"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>`;
            groupIconBox.className = 'w-16 h-16 shrink-0 rounded-xl border border-hairline flex items-center justify-center bg-canvas-soft text-2xl font-bold text-ink transition-colors';
            groupIconBox.style.backgroundColor = '';
            groupIconBox.style.color = '';
          }
        });
      }

      // Group Type selection logic
      const typeButtons = document.querySelectorAll('.group-type-btn');
      const groupTypeInput = document.getElementById('groupType') as HTMLInputElement;
      typeButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const selectedType = btn.getAttribute('data-type');
          if (selectedType && groupTypeInput) {
            groupTypeInput.value = selectedType;
          }
          typeButtons.forEach(b => {
            const t = b.getAttribute('data-type') || 'Other';
            if (b === btn) {
              b.className = `group-type-btn flex flex-col items-center justify-center p-3 rounded-lg border transition-colors ${typeColorMap[t]}`;
            } else {
              b.className = 'group-type-btn flex flex-col items-center justify-center p-3 rounded-lg border border-hairline bg-canvas text-mute transition-colors hover:bg-canvas-soft';
            }
          });
          
          // Update modal icon box if name is entered
          const val = groupNameInput?.value.trim();
          if (val && val.length > 0 && groupIconBox && selectedType) {
            const colors = getGroupColor(selectedType, val);
            groupIconBox.style.backgroundColor = colors.dark + '20';
            groupIconBox.style.color = colors.dark;
          }
        });
      });

      // Date toggle logic
      const dateToggle = document.getElementById('addDatesToggle') as HTMLInputElement;
      const datesContainerWrapper = document.getElementById('datesContainerWrapper');
      if (dateToggle && datesContainerWrapper) {
        dateToggle.addEventListener('change', () => {
          if (dateToggle.checked) {
            datesContainerWrapper.classList.remove('grid-rows-[0fr]');
            datesContainerWrapper.classList.add('grid-rows-[1fr]');
          } else {
            datesContainerWrapper.classList.remove('grid-rows-[1fr]');
            datesContainerWrapper.classList.add('grid-rows-[0fr]');
          }
        });
      }

      // Date formatting logic
      const formatGroupDateInput = (e: Event) => {
        const target = e.target as HTMLInputElement;
        if (target.value.toLowerCase() === 'today') return;
        let v = target.value.replace(/[^\d]/g, '');
        if (v.length > 8) v = v.substring(0, 8);
        if (v.length > 4) {
          v = v.substring(0, 2) + '/' + v.substring(2, 4) + '/' + v.substring(4);
        } else if (v.length > 2) {
          v = v.substring(0, 2) + '/' + v.substring(2);
        }
        target.value = v;
      };
      
      const startDisplay = document.getElementById('startCalDisplay') as HTMLInputElement;
      const endDisplay = document.getElementById('endCalDisplay') as HTMLInputElement;
      if (startDisplay) startDisplay.addEventListener('input', formatGroupDateInput);
      if (endDisplay) endDisplay.addEventListener('input', formatGroupDateInput);
    }

    function renderGroups(searchQuery = '') {
      if (!groupsGrid) return;
      const dataStr = localStorage.getItem(GLOBAL_GROUPS_KEY);
      if (!dataStr) {
        groupsGrid.innerHTML = `<div class="col-span-full p-12 text-center border border-hairline border-dashed rounded-lg bg-canvas-soft text-mute">No groups yet. Create one to get started!</div>`;
        return;
      }

      const data = JSON.parse(dataStr);
      let allGroups = Object.values(data.groups || {});
      
      // FILTER BY MEMBERSHIP (must have accepted invite or be creator)
      let groups = allGroups.filter((g: any) => g.roles && g.roles[currentUserEmail]);

      // Calculate Global Balance
      let globalNetBalance = 0;
      const exchangeRates: Record<string, number> = {
        '$': 83.5, // USD to INR
        '€': 90.0, // EUR to INR
        '£': 105.0, // GBP to INR
        '₹': 1.0,
        'INR': 1.0
      };

      groups.forEach((group: any) => {
        let groupNet = 0;
        const exps = group.expenses || [];
        
        exps.forEach((exp: any) => {
          const isPaidByMe = exp.paidBy === 'You' || exp.paidBy === (window as any).MY_DISPLAY_NAME || exp.paidBy === currentUserEmail;
          const amount = exp.amount;
          const participants = exp.participants || group.members;
          const isParticipant = participants.includes('You') || participants.includes((window as any).MY_DISPLAY_NAME) || participants.includes(currentUserEmail);
          
          const myShare = isParticipant ? (amount / participants.length) : 0;
          
          if (isPaidByMe) {
            groupNet += (amount - myShare); 
          } else if (isParticipant) {
            groupNet -= myShare; 
          }
        });

        const rate = exchangeRates[group.currency] || 80.0;
        globalNetBalance += (groupNet * rate);
      });

      // Update Global Balance UI
      const balanceEl = document.getElementById('globalBalanceText');
      if (balanceEl) {
        if (Math.abs(globalNetBalance) < 0.01) {
          balanceEl.innerHTML = `You are all settled up!`;
        } else if (globalNetBalance > 0) {
          balanceEl.innerHTML = `Overall, you are owed <span class="text-success font-bold">₹${globalNetBalance.toFixed(2)}</span>`;
        } else {
          balanceEl.innerHTML = `Overall, you owe <span class="text-danger font-bold">₹${Math.abs(globalNetBalance).toFixed(2)}</span>`;
        }
      }

      if (searchQuery) {
        const query = searchQuery.toLowerCase();
        groups = groups.filter((g: any) => g.name.toLowerCase().includes(query));
      }

      if (groups.length === 0) {
        groupsGrid.innerHTML = `<div class="col-span-full p-12 text-center border border-hairline border-dashed rounded-lg bg-canvas-soft text-mute">No groups yet. Create one to get started!</div>`;
        return;
      }

      groupsGrid.innerHTML = '';
      groups.forEach((group: any) => {
        // Calculate total balances for this user to show owes/owed status (Simplified)
        // For phase 2, we just render a simple card to prove it works dynamically.
        
        let membersHTML = '';
        const bgColors = ['bg-brand/20 text-brand', 'bg-success/20 text-success', 'bg-warning/20 text-warning', 'bg-danger/20 text-danger'];
        
        group.members.slice(0, 4).forEach((m: string, i: number) => {
          const letter = m.charAt(0).toUpperCase();
          const color = bgColors[i % bgColors.length];
          const margin = i > 0 ? '-ml-1 border border-canvas' : '';
          membersHTML += `<div class="w-6 h-6 rounded-full ${color} flex items-center justify-center text-[10px] font-bold ${margin}">${letter}</div>`;
        });
        if (group.members.length > 4) {
          membersHTML += `<div class="w-6 h-6 rounded-full bg-canvas-soft border border-hairline flex items-center justify-center text-[10px] font-medium text-mute -ml-1 border-canvas">+${group.members.length - 4}</div>`;
        }

        const typeIcons: any = {
          'Trip': `<svg width="20" height="20" viewBox="0 -1 24 26" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.2-1.1.6l-1 2c-.3.6.1 1.2.7 1.5l5.5 2.5-3.5 3.5-3.1-.8c-.4-.1-.8.2-1 .5L0 18l5.5 1.5L7 25l2-1c.3-.2.6-.6.5-1l-.8-3.1 3.5-3.5 2.5 5.5c.3.6 1 .9 1.5.7l2-1c.4-.2.7-.6.6-1.1z"/></svg>`,
          'Home': `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
          'Couple': `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`,
          'Other': `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>`
        };
        const typeIcon = typeIcons[group.type] || typeIcons['Other'];

        const colors = getGroupColor(group.type, group.name);
        const accentHex = colors.dark;

        const card = `
          <a href="/group?id=${group.id}" style="background-color: ${accentHex}10;" class="group block p-6 border border-hairline rounded-md hover:border-brand transition-colors shadow-sm hover:shadow-md flex flex-col justify-between">
            <div class="flex justify-between items-start mb-4">
              <div class="flex items-center gap-4">
                <div style="background-color: ${accentHex}20; color: ${accentHex};" class="w-12 h-12 shrink-0 rounded-lg border border-hairline/50 flex items-center justify-center text-xl font-bold bg-white/60">
                  ${(group.name || 'G').charAt(0).toUpperCase()}
                </div>
                <h2 class="text-xl font-bold text-ink group-hover:opacity-80 transition-opacity">${group.name}</h2>
              </div>
              <div class="text-mute group-hover:text-brand transition-colors" title="${group.type || 'Other'}">
                ${typeIcon}
              </div>
            </div>
            <div class="mt-2">
              <p class="text-body text-sm mb-3">${group.members.length} members</p>
              <div class="flex items-center gap-2">
                ${membersHTML}
              </div>
            </div>
          </a>
        `;
        groupsGrid.insertAdjacentHTML('beforeend', card);
      });
    }

    if (newGroupForm) {
      newGroupForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const nameInput = document.getElementById('groupName') as HTMLInputElement;
        const currencySelect = document.getElementById('groupCurrency') as HTMLSelectElement;
        
        const name = nameInput.value.trim();
        const currency = currencySelect.value;
        
        if (currentMembers.length <= 1) {
          showToast("Please add at least one more member.", true);
          return;
        }

        const groupId = name.toLowerCase().replace(/[^a-z0-9]+/g, '-') + '-' + Date.now();

        const typeInput = document.getElementById('groupType') as HTMLInputElement;
        const addDatesToggle = document.getElementById('addDatesToggle') as HTMLInputElement;
        const startDateInput = document.getElementById('tripStartDate') as HTMLInputElement;
        const endDateInput = document.getElementById('tripEndDate') as HTMLInputElement;
        
        const groupType = typeInput ? typeInput.value : 'Trip';
        const addDates = addDatesToggle ? addDatesToggle.checked : false;
        
        const parseDateDisplay = (id: string) => {
          const el = document.getElementById(id) as HTMLInputElement;
          if (!el || !el.value) return null;
          if (el.value.toLowerCase() === 'today') {
            const today = new Date();
            return `${today.getFullYear()}-${String(today.getMonth()+1).padStart(2,'0')}-${String(today.getDate()).padStart(2,'0')}`;
          }
          const parts = el.value.split('/');
          if (parts.length === 3) {
            return `${parts[2]}-${parts[1]}-${parts[0]}`;
          }
          return null;
        };

        const startDate = addDates ? parseDateDisplay('startCalDisplay') : null;
        const endDate = addDates ? parseDateDisplay('endCalDisplay') : null;

        const newGroup = {
          id: groupId,
          name: name,
          currency: currency,
          type: groupType,
          startDate: startDate,
          endDate: endDate,
          createdBy: (window as any).MY_DISPLAY_NAME,
          members: currentMembers.map((m, i) => i === 0 ? currentUserEmail : m),
          roles: { [currentUserEmail]: 'owner' },
          expenses: [],
          createdAt: Date.now()
        };

        let dataStr = localStorage.getItem(GLOBAL_GROUPS_KEY);
        let data = dataStr ? JSON.parse(dataStr) : { groups: {} };
        
        data.groups[groupId] = newGroup;
        localStorage.setItem(GLOBAL_GROUPS_KEY, JSON.stringify(data));

        // Create notification for creating the group
        const notifsDataStr = localStorage.getItem('splitsbug_notifications');
        let allNotifs = notifsDataStr ? JSON.parse(notifsDataStr) : {};
        if (!allNotifs[currentUserEmail]) allNotifs[currentUserEmail] = [];
        allNotifs[currentUserEmail].push({
          id: Date.now().toString() + Math.random().toString(36).substring(7),
          groupId: groupId,
          message: `You created the group "${name}".`,
          timestamp: Date.now()
        });
        if (allNotifs[currentUserEmail].length > 20) allNotifs[currentUserEmail] = allNotifs[currentUserEmail].slice(-20);
        localStorage.setItem('splitsbug_notifications', JSON.stringify(allNotifs));

        // Add persistent activity
        const activitiesDataStr = localStorage.getItem('splitsbug_global_activities');
        let allActivities = activitiesDataStr ? JSON.parse(activitiesDataStr) : [];
        allActivities.push({
          id: Date.now().toString() + Math.random().toString(36).substring(7),
          groupId: groupId,
          groupName: name,
          type: 'group_created',
          description: 'Created group',
          amount: 0,
          currency: currency,
          paidBy: currentUserEmail,
          participants: newGroup.members,
          timestamp: Date.now()
        });
        localStorage.setItem('splitsbug_global_activities', JSON.stringify(allActivities));

        nameInput.value = '';
        currentMembers = [(window as any).MY_DISPLAY_NAME];
        renderTags();
        newGroupModal.close();
        renderGroups();
      });
    }

    // Search Logic
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const searchBtn = document.getElementById('searchBtn');
    const mobileSearchBtn = document.getElementById('mobileSearchBtn');
    const searchContainer = document.getElementById('searchContainer');
    const searchInner = document.getElementById('searchInner');

    if (mobileSearchBtn && searchContainer && searchInput && searchInner) {
      mobileSearchBtn.addEventListener('click', () => {
        searchContainer.classList.remove('hidden', 'sm:flex', 'left-1/2', '-translate-x-1/2', 'pointer-events-none');
        searchContainer.classList.add('flex', 'inset-0', 'bg-canvas', 'pointer-events-auto');
        
        let cancelBtn = document.getElementById('cancelSearchBtn');
        if (!cancelBtn) {
          cancelBtn = document.createElement('button');
          cancelBtn.id = 'cancelSearchBtn';
          cancelBtn.className = 'ml-3 text-brand font-medium text-sm shrink-0 hover:text-brand-deep transition-colors';
          cancelBtn.textContent = 'Cancel';
          searchContainer.appendChild(cancelBtn);
          
          cancelBtn.addEventListener('click', () => {
            searchContainer.classList.add('hidden', 'sm:flex', 'left-1/2', '-translate-x-1/2', 'pointer-events-none');
            searchContainer.classList.remove('flex', 'inset-0', 'bg-canvas', 'pointer-events-auto');
            searchInput.value = '';
            searchInput.dispatchEvent(new Event('input'));
          });
        }
        searchInput.focus();
      });
    }

    if (searchInput && searchBtn) {
      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          renderGroups(searchInput.value.trim());
        }
      });

      searchBtn.addEventListener('click', () => {
        renderGroups(searchInput.value.trim());
      });
    }

    // Logo Theme Switcher
    const desktopLogo = document.getElementById('desktopLogo') as HTMLImageElement;
    if (desktopLogo) {
      const updateLogo = (themeClass: string) => {
        if (themeClass.includes('theme-dark-grey')) {
          desktopLogo.src = '/SplitBugs-Brand/logos/SplitsBug-dark-theme-softgray.svg';
        } else if (themeClass.includes('theme-dark-amoled')) {
          desktopLogo.src = '/SplitBugs-Brand/logos/SplitsBug-dark-theme-white.svg';
        } else if (themeClass.includes('theme-light-cream')) {
          desktopLogo.src = '/SplitBugs-Brand/logos/SplitsBug-light-theme-navy.svg';
        } else {
          desktopLogo.src = '/SplitBugs-Brand/logos/logo-wordmark.svg'; // light-white or unknown
        }
      };
      // Init
      updateLogo(document.documentElement.className);
      // Listen for changes
      window.addEventListener('themeChanged', (e: any) => {
        updateLogo(e.detail.theme);
      });
    }

    // Custom Currency Dropdown Logic
    const currencyToggle = document.getElementById('currencyToggle');
    const currencyMenu = document.getElementById('currencyMenu');
    const currencySelectedText = document.getElementById('currencySelectedText');
    const groupCurrencyInput = document.getElementById('groupCurrency') as HTMLInputElement;
    const currencyOptions = document.querySelectorAll('.currency-option');

    if (currencyToggle && currencyMenu) {
      currencyToggle.addEventListener('click', (e) => {
        e.preventDefault();
        currencyMenu.classList.toggle('hidden');
      });

      // Close when clicking outside
      document.addEventListener('click', (e) => {
        if (!currencyToggle.contains(e.target as Node) && !currencyMenu.contains(e.target as Node)) {
          currencyMenu.classList.add('hidden');
        }
      });

      currencyOptions.forEach(btn => {
        btn.addEventListener('click', () => {
          const val = btn.getAttribute('data-value');
          const label = btn.getAttribute('data-label');
          if (val && label && currencySelectedText && groupCurrencyInput) {
            groupCurrencyInput.value = val;
            currencySelectedText.textContent = label;
            // Reset highlighting
            currencyOptions.forEach(b => b.classList.remove('bg-canvas-soft', 'font-medium'));
            btn.classList.add('bg-canvas-soft', 'font-medium');
            currencyMenu.classList.add('hidden');
          }
        });
      });
    }

    // --- Notifications & Invites Logic ---
    const notificationBtn = document.getElementById('notificationBtn');
    const notificationsModal = document.getElementById('notificationsModal') as HTMLDialogElement;
    const closeNotificationsBtn = document.getElementById('closeNotificationsBtn');
    const notificationBadge = document.getElementById('notificationBadge');
    const invitesList = document.getElementById('invitesList');

    function renderNotifications() {
      const invitesDataStr = localStorage.getItem(GLOBAL_INVITES_KEY);
      const invitesData = invitesDataStr ? JSON.parse(invitesDataStr) : { invites: [] };
      
      const myPendingInvites = invitesData.invites.filter((inv: any) => inv.inviteeEmail === currentUserEmail && inv.status === 'pending');
      
      const notifsDataStr = localStorage.getItem('splitsbug_notifications');
      let myNotifs: any[] = [];
      if (notifsDataStr) {
        try {
          const allNotifs = JSON.parse(notifsDataStr);
          myNotifs = allNotifs[currentUserEmail] || [];
        } catch(e) {}
      }

      const unreadNotifs = myNotifs.filter((n: any) => !n.read);
      const totalNotifsCount = myPendingInvites.length + unreadNotifs.length;
      
      const markAllReadBtn = document.getElementById('markAllReadBtn');
      if (markAllReadBtn) {
        if (unreadNotifs.length > 0) {
          markAllReadBtn.classList.remove('hidden');
        } else {
          markAllReadBtn.classList.add('hidden');
        }
      }

      if (notificationBadge) {
        if (totalNotifsCount > 0) {
          notificationBadge.textContent = totalNotifsCount >= 99 ? ':)' : totalNotifsCount.toString();
          notificationBadge.classList.remove('hidden');
        } else {
          notificationBadge.classList.add('hidden');
        }
      }

      if (invitesList) {
        if (totalNotifsCount === 0) {
          invitesList.innerHTML = '<div class="p-4 text-center text-xs text-mute">No new notifications</div>';
          return;
        }

        invitesList.innerHTML = '';
        
        if (Notification.permission !== 'granted' && Notification.permission !== 'denied') {
          const banner = document.createElement('div');
          banner.className = 'p-3 bg-brand/10 border-b border-brand/20 flex flex-col gap-2 items-start';
          banner.innerHTML = `
            <span class="text-xs text-brand font-medium">Enable push notifications to never miss an invite or expense.</span>
            <button id="enableNotifsBtn" class="bg-brand text-white px-3 py-1.5 rounded text-xs font-bold hover:bg-brand-deep transition-colors cursor-pointer">Enable Notifications</button>
          `;
          invitesList.appendChild(banner);

          // Need timeout since we just appended it
          setTimeout(() => {
            const btn = document.getElementById('enableNotifsBtn');
            if (btn) {
              btn.addEventListener('click', () => {
                Notification.requestPermission().then(permission => {
                  if (permission === 'granted') {
                    banner.remove();
                    showToast("Notifications enabled!", false);
                  }
                });
              });
            }
          }, 0);
        }

        myPendingInvites.forEach((inv: any) => {
          const item = document.createElement('div');
          item.className = 'p-3 border-b border-hairline hover:bg-canvas-soft transition-colors';
          item.innerHTML = `
            <p class="text-sm text-ink mb-3 leading-snug">
              <span class="font-bold">${inv.inviterName}</span> invited you to join <span class="font-bold">${inv.groupName}</span> as a ${inv.role}.
            </p>
            <div class="flex gap-3">
              <button class="join-invite-btn flex-1 bg-brand text-white px-4 py-2 text-sm font-medium rounded-md hover:bg-brand-deep transition-colors text-center cursor-pointer" data-id="${inv.id}">Join</button>
              <button class="reject-invite-btn flex-1 bg-canvas text-ink border border-hairline px-4 py-2 text-sm font-medium rounded-md hover:bg-canvas-soft transition-colors text-center cursor-pointer" data-id="${inv.id}">Decline</button>
            </div>
          `;
          invitesList.appendChild(item);
        });

        myNotifs.forEach((notif: any) => {
          const item = document.createElement('div');
          const isUnread = !notif.read;
          const bgClass = isUnread ? 'bg-brand/5' : '';
          item.className = `p-3 border-b border-hairline hover:bg-canvas-soft transition-colors flex items-start justify-between group ${bgClass}`;
          
          let actionUrl = notif.groupId ? `/group?id=${notif.groupId}` : '#';
          
          // Try to extract an initial
          let initial = 'N';
          const match = notif.message.match(/^[A-Za-z]/);
          if (match) initial = match[0].toUpperCase();

          const unreadDot = isUnread ? `<div class="w-2 h-2 rounded-full bg-brand shrink-0 mt-1 hidden sm:block"></div>` : '';
          
          item.innerHTML = `
            <a href="${actionUrl}" class="flex-1 pr-2 flex items-start gap-3 notif-link" data-id="${notif.id}">
              <div class="flex flex-col items-center gap-1 shrink-0">
                <div class="w-10 h-10 rounded-full bg-brand/10 text-brand flex items-center justify-center font-bold">
                  ${initial}
                </div>
                ${unreadDot}
              </div>
              <div>
                <p class="text-sm text-ink mb-1 leading-snug ${isUnread ? 'font-medium' : ''}">${notif.message}</p>
                <p class="text-xs text-mute">${new Date(notif.timestamp).toLocaleString()}</p>
              </div>
            </a>
            <button class="dismiss-notif-btn text-mute hover:text-danger opacity-100 sm:opacity-0 group-hover:opacity-100 transition-opacity p-1 cursor-pointer shrink-0" data-id="${notif.id}" title="Dismiss">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          `;
          invitesList.appendChild(item);
        });

        document.querySelectorAll('.join-invite-btn').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const inviteId = (e.currentTarget as HTMLElement).getAttribute('data-id');
            handleInviteAction(inviteId, 'accepted');
          });
        });

        document.querySelectorAll('.reject-invite-btn').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const inviteId = (e.currentTarget as HTMLElement).getAttribute('data-id');
            handleInviteAction(inviteId, 'rejected');
          });
        });

        document.querySelectorAll('.dismiss-notif-btn').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            const notifId = (e.currentTarget as HTMLElement).getAttribute('data-id');
            dismissNotification(notifId);
          });
        });

        document.querySelectorAll('.notif-link').forEach(link => {
          link.addEventListener('click', (e) => {
            const notifId = (e.currentTarget as HTMLElement).getAttribute('data-id');
            if (notifId) markNotificationAsRead(notifId);
          });
        });
      }
    }

    const markAllReadBtn = document.getElementById('markAllReadBtn');
    if (markAllReadBtn) {
      markAllReadBtn.addEventListener('click', () => {
        const notifsDataStr = localStorage.getItem('splitsbug_notifications');
        if (notifsDataStr) {
          let allNotifs = JSON.parse(notifsDataStr);
          if (allNotifs[currentUserEmail]) {
            allNotifs[currentUserEmail].forEach((n: any) => n.read = true);
            localStorage.setItem('splitsbug_notifications', JSON.stringify(allNotifs));
            renderNotifications();
          }
        }
      });
    }

    function markNotificationAsRead(notifId: string) {
      const notifsDataStr = localStorage.getItem('splitsbug_notifications');
      if (!notifsDataStr) return;
      let allNotifs = JSON.parse(notifsDataStr);
      if (allNotifs[currentUserEmail]) {
        const notif = allNotifs[currentUserEmail].find((n: any) => n.id === notifId);
        if (notif && !notif.read) {
          notif.read = true;
          localStorage.setItem('splitsbug_notifications', JSON.stringify(allNotifs));
        }
      }
    }

    function dismissNotification(notifId: string | null) {
      if (!notifId) return;
      const notifsDataStr = localStorage.getItem('splitsbug_notifications');
      if (!notifsDataStr) return;
      
      let allNotifs = JSON.parse(notifsDataStr);
      if (allNotifs[currentUserEmail]) {
        allNotifs[currentUserEmail] = allNotifs[currentUserEmail].filter((n: any) => n.id !== notifId);
        localStorage.setItem('splitsbug_notifications', JSON.stringify(allNotifs));
        renderNotifications();
      }
    }


    function handleInviteAction(inviteId: string | null, newStatus: string) {
      if (!inviteId) return;
      
      // Update invite status
      const invitesDataStr = localStorage.getItem(GLOBAL_INVITES_KEY);
      if (!invitesDataStr) return;
      let invitesData = JSON.parse(invitesDataStr);
      
      const inviteIndex = invitesData.invites.findIndex((i: any) => i.id === inviteId);
      if (inviteIndex === -1) return;
      
      const invite = invitesData.invites[inviteIndex];

      if (newStatus === 'rejected') {
        // Delete invite completely so it can be resent later
        invitesData.invites.splice(inviteIndex, 1);
      } else {
        invite.status = newStatus;
      }
      
      localStorage.setItem(GLOBAL_INVITES_KEY, JSON.stringify(invitesData));

      if (newStatus === 'accepted') {
        // Add to group
        const groupsDataStr = localStorage.getItem(GLOBAL_GROUPS_KEY);
        if (groupsDataStr) {
          let groupsData = JSON.parse(groupsDataStr);
          let group = groupsData.groups[invite.groupId];
          if (group) {
            if (!group.members) group.members = [];
            if (!group.roles) group.roles = {};
            
            const oldId = invite.memberId;
            const newId = currentUserEmail;
            
            if (oldId && group.members.includes(oldId)) {
              // Replace in members array
              const idx = group.members.indexOf(oldId);
              group.members[idx] = newId;
              
              // Replace in roles
              if (group.roles && group.roles[oldId]) {
                group.roles[newId] = invite.role || group.roles[oldId];
                delete group.roles[oldId];
              } else {
                group.roles[newId] = invite.role || 'viewer';
              }
              
              // Replace in expenses
              if (group.expenses) {
                group.expenses.forEach((exp: any) => {
                  if (exp.paidBy === oldId) exp.paidBy = newId;
                  if (exp.participants) {
                    const pIdx = exp.participants.indexOf(oldId);
                    if (pIdx > -1) exp.participants[pIdx] = newId;
                  }
                });
              }
            } else {
              if (!group.members.includes(newId)) {
                group.members.push(newId);
              }
              group.roles[newId] = invite.role || 'viewer';
            }
            localStorage.setItem(GLOBAL_GROUPS_KEY, JSON.stringify(groupsData));
            showToast(`Joined ${invite.groupName}!`);
            
            // Create notification for joining the group
            const notifsDataStr = localStorage.getItem('splitsbug_notifications');
            let allNotifs = notifsDataStr ? JSON.parse(notifsDataStr) : {};
            if (!allNotifs[currentUserEmail]) allNotifs[currentUserEmail] = [];
            allNotifs[currentUserEmail].push({
              id: Date.now().toString() + Math.random().toString(36).substring(7),
              groupId: group.id,
              message: `You joined the group "${group.name}".`,
              timestamp: Date.now()
            });
            if (allNotifs[currentUserEmail].length > 20) allNotifs[currentUserEmail] = allNotifs[currentUserEmail].slice(-20);
            localStorage.setItem('splitsbug_notifications', JSON.stringify(allNotifs));

            renderGroups();
          }
        }
      }

      renderNotifications();
    }

    if (notificationBtn && notificationsModal) {
      notificationBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (window.innerWidth >= 640) {
          notificationsModal.showModal();
        } else {
          notificationsModal.show();
        }
        renderNotifications();
      });

      closeNotificationsBtn?.addEventListener('click', () => {
        notificationsModal.close();
      });

      notificationsModal.addEventListener('click', (e) => {
        const d = notificationsModal.getBoundingClientRect();
        if (e.clientX < d.left || e.clientX > d.right || e.clientY < d.top || e.clientY > d.bottom) {
          notificationsModal.close();
        }
      });
    }

    // Initial render
    renderGroups();
    renderNotifications();

    // Cross-tab syncing
    window.addEventListener('storage', (e) => {
      if (e.key === GLOBAL_GROUPS_KEY) {
        renderGroups();
      } else if (e.key === GLOBAL_INVITES_KEY) {
        renderNotifications();
      }
    });
  </script>
</Layout>
