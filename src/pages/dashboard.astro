---
import Layout from '../layouts/Layout.astro';
---

<style is:global>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<Layout>
  <div class="min-h-screen flex flex-col">
    <!-- Mock Nav Bar -->
    <header class="h-16 px-4 lg:px-6 flex items-center justify-between border-b border-hairline bg-canvas sticky top-0 z-40 relative">
      <!-- Left: Logo -->
      <a href="/dashboard" class="flex items-center z-10">
        <img src="/SplitBugs-Brand/logos/logo-wordmark.svg" alt="SplitBugs" class="h-6 hidden sm:block transition-opacity" id="desktopLogo" />
        <img src="/SplitBugs-Brand/favicon/favicon.svg" alt="SB" class="h-8 sm:hidden" />
      </a>
      
      <!-- Center: Search Bar -->
      <div id="searchContainer" class="absolute left-1/2 -translate-x-1/2 flex items-center w-full max-w-xl px-4 z-50 pointer-events-none hidden sm:flex">
        <div id="searchInner" class="flex items-center w-full pointer-events-auto shadow-sm rounded-full h-10">
          <input type="text" id="searchInput" placeholder="Search" autocomplete="off" class="flex-1 h-full bg-canvas border border-hairline rounded-l-full py-2 pl-6 pr-4 text-sm focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand transition-colors z-10" />
          <button id="searchBtn" class="w-16 h-full flex items-center justify-center text-ink bg-canvas-soft border border-hairline border-l-0 rounded-r-full hover:bg-hairline transition-colors cursor-pointer shrink-0 z-0">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </button>
        </div>
      </div>
      
      <!-- Right: New Group Button -->
      <div class="flex items-center gap-2 z-10" id="headerActions">
        <button id="mobileSearchBtn" class="sm:hidden bg-canvas-soft text-ink hover:bg-hairline p-2 rounded-full transition-colors cursor-pointer flex items-center justify-center border border-hairline shrink-0" title="Search">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </button>

        <!-- Notification Bell -->
        <button id="notificationBtn" class="bg-canvas-soft text-ink hover:bg-hairline p-2 rounded-full transition-colors cursor-pointer flex items-center justify-center border border-hairline shrink-0 relative" title="Notifications">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
          <span id="notificationBadge" class="absolute -top-1 -right-1 flex h-4 w-4 items-center justify-center rounded-full bg-danger text-[10px] font-bold text-white hidden"></span>
        </button>

        <button id="newGroupBtn" class="bg-canvas-soft text-ink hover:bg-hairline p-2 rounded-full transition-colors cursor-pointer flex items-center justify-center border border-hairline shrink-0" title="New Group">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
        </button>
      </div>
    </header>

    <main class="flex-1 max-w-[1400px] w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12 pb-28">
      <!-- Dynamic Global Balance Header -->
      <div class="flex items-center justify-between mb-8">
        <h1 id="globalBalanceText" class="text-xl sm:text-2xl font-medium tracking-tight text-ink">
          <!-- Populated via JS -->
          Dashboard
        </h1>
      </div>

      <!-- Dynamic Groups Grid -->
      <div id="groupsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Groups will be populated here via JS -->
      </div>
    </main>



    <!-- Notifications Modal -->
    <dialog id="notificationsModal" class="backdrop:bg-black/50 text-ink fixed inset-0 z-40 w-full h-full max-w-none max-h-none m-0 p-0 bg-canvas border-0 overflow-hidden open:flex flex-col pb-[calc(4rem+env(safe-area-inset-bottom))] sm:pb-0 sm:m-auto sm:w-[95vw] sm:max-w-sm sm:h-auto sm:max-h-[80vh] sm:rounded-xl sm:border sm:border-hairline shadow-xl">
      <div class="px-4 py-3 flex items-center justify-between border-b border-hairline bg-canvas shrink-0">
        <h2 class="text-lg font-medium text-ink">Notifications</h2>
        <div class="flex items-center gap-2">
          <button type="button" id="markAllReadBtn" class="text-xs font-medium text-brand hover:text-brand-deep cursor-pointer hidden">Mark all read</button>
          <button type="button" id="closeNotificationsBtn" class="p-1 hover:bg-canvas-soft rounded-full transition-colors cursor-pointer">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-ink"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
      </div>
      <div id="invitesList" class="flex-1 overflow-y-auto bg-canvas p-4 min-h-0 space-y-3">
        <div class="text-center text-sm text-mute mt-4">No new notifications</div>
      </div>
    </dialog>

    <!-- New Group Modal -->
    <dialog id="newGroupModal" class="backdrop:bg-black/50 text-ink fixed inset-0 z-40 w-full h-full max-w-none max-h-none m-0 p-0 bg-canvas border-0 overflow-hidden open:flex open:flex-col pb-[calc(4rem+env(safe-area-inset-bottom))] sm:pb-0 sm:m-auto sm:w-[95vw] sm:max-w-md sm:h-auto sm:max-h-[90vh] sm:rounded-xl sm:border sm:border-hairline shadow-xl">
      <form id="newGroupForm" class="flex flex-col h-full" method="dialog">
        <!-- Header -->
        <div class="px-4 py-3 flex items-center justify-between border-b border-hairline bg-canvas shrink-0">
          <button type="button" id="closeGroupBtn" class="p-1 hover:bg-canvas-soft rounded-full transition-colors">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-ink"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
          <h2 class="text-lg font-medium text-ink">Create a group</h2>
          <button type="submit" class="text-ink font-medium px-2 py-1 hover:text-brand transition-colors cursor-pointer">Done</button>
        </div>

        <div class="flex-1 overflow-y-auto p-5 pb-6 min-h-0">
          <!-- Image and Name -->
          <div class="flex items-center gap-4 mb-6">
            <div id="groupIconBox" class="w-16 h-16 shrink-0 rounded-xl border border-hairline flex items-center justify-center bg-canvas-soft text-2xl font-bold text-ink">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-mute"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            </div>
            <div class="flex-1">
              <label class="block text-xs font-medium text-ink mb-1">Group name</label>
              <input type="text" id="groupName" autocomplete="off" required placeholder="" class="w-full bg-transparent text-ink border-0 border-b-2 border-brand px-0 py-1 text-base focus:outline-none focus:ring-0" />
            </div>
          </div>

          <!-- Type Selection -->
          <div class="mb-6">
            <label class="block text-xs font-medium text-ink mb-3">Type</label>
            <div class="grid grid-cols-4 gap-2">
              <button type="button" class="group-type-btn flex flex-col items-center justify-center p-3 rounded-lg border border-brand bg-brand text-canvas transition-colors" data-type="Trip">
                <svg width="24" height="24" viewBox="0 -1 24 26" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mb-1"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.2-1.1.6l-1 2c-.3.6.1 1.2.7 1.5l5.5 2.5-3.5 3.5-3.1-.8c-.4-.1-.8.2-1 .5L0 18l5.5 1.5L7 25l2-1c.3-.2.6-.6.5-1l-.8-3.1 3.5-3.5 2.5 5.5c.3.6 1 .9 1.5.7l2-1c.4-.2.7-.6.6-1.1z"/></svg>
                <span class="text-xs font-medium">Trip</span>
              </button>
              <button type="button" class="group-type-btn flex flex-col items-center justify-center p-3 rounded-lg border border-hairline bg-canvas text-mute transition-colors hover:bg-canvas-soft" data-type="Home">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mb-1"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                <span class="text-xs font-medium">Home</span>
              </button>
              <button type="button" class="group-type-btn flex flex-col items-center justify-center p-3 rounded-lg border border-hairline bg-canvas text-mute transition-colors hover:bg-canvas-soft" data-type="Couple">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mb-1"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                <span class="text-xs font-medium">Couple</span>
              </button>
              <button type="button" class="group-type-btn flex flex-col items-center justify-center p-3 rounded-lg border border-hairline bg-canvas text-mute transition-colors hover:bg-canvas-soft" data-type="Other">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mb-1"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                <span class="text-xs font-medium">Other</span>
              </button>
            </div>
            <input type="hidden" id="groupType" value="Trip" />
          </div>

          <!-- Trip Dates -->
          <div class="mb-6">
            <div class="flex items-center justify-between mb-2">
              <span class="text-sm font-medium text-ink">Add trip dates</span>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" id="addDatesToggle" class="sr-only peer">
                <div class="w-11 h-6 bg-hairline peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-brand"></div>
              </label>
            </div>
            <p class="text-xs text-mute mb-4 leading-relaxed">Splitwise will remind friends to join, add expenses, and settle up.</p>
            
            <!-- Date pickers: simple trigger buttons, calendar opens as a separate dialog -->
            <div id="datesContainerWrapper" class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out">
              <div class="overflow-hidden">
                <div id="datesContainer" class="flex items-start gap-4 pt-4">

                  <!-- Start Date -->
                  <div class="flex-1">
                    <label class="block text-xs font-medium text-ink mb-1">Start</label>
                    <div class="flex items-center justify-between border-b border-hairline focus-within:border-brand transition-colors pb-1 bg-transparent">
                      <input type="text" id="startCalDisplay" autocomplete="off" class="w-full text-sm text-ink bg-transparent focus:outline-none placeholder:text-mute" placeholder="Today" />
                      <button type="button" id="startCalToggle" class="cursor-pointer focus:outline-none ml-2 rounded-sm transition-colors hover:text-brand text-mute">
                        <svg class="shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                      </button>
                    </div>
                    <input type="hidden" id="tripStartDate" />
                  </div>

                  <!-- End Date -->
                  <div class="flex-1">
                    <label class="block text-xs font-medium text-ink mb-1">End</label>
                    <div class="flex items-center justify-between border-b border-hairline focus-within:border-brand transition-colors pb-1 bg-transparent">
                      <input type="text" id="endCalDisplay" autocomplete="off" class="w-full text-sm text-ink bg-transparent focus:outline-none placeholder:text-mute" placeholder="dd/mm/yyyy" />
                      <button type="button" id="endCalToggle" class="cursor-pointer focus:outline-none ml-2 rounded-sm transition-colors hover:text-brand text-mute">
                        <svg class="shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                      </button>
                    </div>
                    <input type="hidden" id="tripEndDate" />
                  </div>

                </div>
              </div>
            </div>
          </div>

          <!-- Group Members (Simple Names) -->
          <div class="mb-6">
            <label class="block text-xs font-medium text-ink mb-1">Group members</label>
            <div class="flex gap-2 mb-3">
              <input type="text" id="memberEmailInput" autocomplete="off" placeholder="Add a person by name..." class="flex-1 bg-transparent text-ink border border-hairline rounded-md px-3 h-10 text-sm focus:outline-none focus:border-brand transition-colors" />
              <button type="button" id="addMemberBtn" class="bg-canvas-soft text-ink border border-hairline px-4 h-10 rounded-md font-medium text-sm hover:bg-hairline transition-colors">Add</button>
            </div>
            
            <div id="membersTags" class="flex flex-wrap gap-2">
              <!-- Tags added via JS -->
            </div>
          </div>

          <!-- Currency (Custom Dropdown) -->
          <div class="mb-6">
            <label class="block text-xs font-medium text-ink mb-1">Currency</label>
            <div class="relative" id="currencyDropdown">
              <button type="button" id="currencyToggle" class="w-full bg-canvas text-ink border border-hairline rounded-md px-3 h-10 text-sm flex items-center justify-between focus:outline-none focus:border-brand transition-colors cursor-pointer">
                <span id="currencySelectedText">INR (₹)</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
              </button>
              <div id="currencyMenu" class="absolute z-50 w-full mt-1 bg-canvas border border-hairline rounded-md shadow-lg hidden">
                <div class="py-1">
                  <button type="button" class="currency-option w-full text-left px-3 py-2 text-sm text-ink hover:bg-canvas-soft transition-colors" data-value="$" data-label="USD ($)">USD ($)</button>
                  <button type="button" class="currency-option w-full text-left px-3 py-2 text-sm text-ink hover:bg-canvas-soft transition-colors" data-value="€" data-label="EUR (€)">EUR (€)</button>
                  <button type="button" class="currency-option w-full text-left px-3 py-2 text-sm text-ink hover:bg-canvas-soft transition-colors" data-value="£" data-label="GBP (£)">GBP (£)</button>
                  <button type="button" class="currency-option w-full text-left px-3 py-2 text-sm text-ink hover:bg-canvas-soft bg-canvas-soft font-medium transition-colors" data-value="₹" data-label="INR (₹)">INR (₹)</button>
                </div>
              </div>
              <input type="hidden" id="groupCurrency" value="₹" />
            </div>
          </div>
          
        </div>
      </form>
    </dialog>

    <!-- ======================================================
         Shared Calendar Picker Dialog (top layer, above all)
         ====================================================== -->
    <dialog id="calPickerDialog" class="backdrop:bg-black/50 text-ink p-0 rounded-2xl shadow-2xl w-[320px] bg-canvas border border-hairline m-auto overflow-hidden">
      <div class="p-4">
        <!-- Header: Month + Year clickable -->
        <div class="flex items-center justify-between mb-4">
          <button type="button" id="calPrevMonth" class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-canvas-soft transition-colors text-ink">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <div class="flex items-center gap-2">
            <button type="button" id="calMonthBtn" class="text-sm font-bold text-ink hover:text-brand transition-colors"></button>
            <button type="button" id="calYearBtn" class="text-sm font-bold text-brand hover:opacity-70 transition-opacity"></button>
          </div>
          <button type="button" id="calNextMonth" class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-canvas-soft transition-colors text-ink">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>

        <!-- Day grid view -->
        <div id="calDayView">
          <div class="grid grid-cols-7 mb-2">
            <span class="text-[10px] font-semibold text-mute text-center">Su</span>
            <span class="text-[10px] font-semibold text-mute text-center">Mo</span>
            <span class="text-[10px] font-semibold text-mute text-center">Tu</span>
            <span class="text-[10px] font-semibold text-mute text-center">We</span>
            <span class="text-[10px] font-semibold text-mute text-center">Th</span>
            <span class="text-[10px] font-semibold text-mute text-center">Fr</span>
            <span class="text-[10px] font-semibold text-mute text-center">Sa</span>
          </div>
          <div id="calDayGrid" class="grid grid-cols-7 gap-y-1"></div>
        </div>

        <!-- Month picker view -->
        <div id="calMonthView" class="hidden">
          <div id="calMonthGrid" class="grid grid-cols-3 gap-2"></div>
        </div>

        <!-- Year picker view -->
        <div id="calYearView" class="hidden">
          <div id="calYearList" class="h-48 overflow-y-auto space-y-1 pr-1"></div>
        </div>
      </div>

      <!-- Footer -->
      <div class="px-4 pb-4 flex justify-end gap-2">
        <button type="button" id="calCancelBtn" class="px-4 py-1.5 text-sm font-medium text-mute hover:text-ink transition-colors">Cancel</button>
        <button type="button" id="calOkBtn" class="px-4 py-1.5 text-sm font-medium text-white bg-brand rounded-full hover:opacity-90 transition-opacity">OK</button>
      </div>
    </dialog>

    <!-- Custom Toast Notification -->
    <div id="toastNotification" class="fixed bottom-4 left-1/2 -translate-x-1/2 bg-ink text-canvas px-4 py-3 rounded-md shadow-lg text-sm font-medium transition-all duration-300 translate-y-20 opacity-0 pointer-events-none z-50 flex items-center gap-2">
      <svg id="toastIconSuccess" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success hidden"><path d="M20 6L9 17l-5-5"/></svg>
      <svg id="toastIconError" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-error hidden"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <span id="toastMessage">Success</span>
    </div>

  </div>
  
  <script>
    const currentUserEmail = localStorage.getItem('splitbug_userEmail') || 'user@example.com';
    const GLOBAL_GROUPS_KEY = 'splitsbug_global_groups';
    const GLOBAL_INVITES_KEY = 'splitsbug_global_invites';
    function showToast(message: string, isError = false) {
      const toast = document.getElementById('toastNotification');
      const toastMsg = document.getElementById('toastMessage');
      const iconSuccess = document.getElementById('toastIconSuccess');
      const iconError = document.getElementById('toastIconError');
      if (toast && toastMsg && iconSuccess && iconError) {
        
        const activeDialog = document.querySelector('dialog[open]');
        if (activeDialog) {
          activeDialog.appendChild(toast);
        } else {
          document.body.appendChild(toast);
        }

        toastMsg.textContent = message;
        if (isError) {
          iconSuccess.classList.add('hidden');
          iconError.classList.remove('hidden');
        } else {
          iconError.classList.add('hidden');
          iconSuccess.classList.remove('hidden');
        }
        toast.classList.remove('translate-y-20', 'opacity-0');
        setTimeout(() => {
          toast.classList.add('translate-y-20', 'opacity-0');
        }, 3000);
      }
    }
    const newGroupBtn = document.getElementById('newGroupBtn');
    const newGroupModal = document.getElementById('newGroupModal') as HTMLDialogElement;
    const closeGroupBtn = document.getElementById('closeGroupBtn');
    const cancelGroupBtn = document.getElementById('cancelGroupBtn');
    const newGroupForm = document.getElementById('newGroupForm') as HTMLFormElement;
    const groupsGrid = document.getElementById('groupsGrid');
    
    // ============================================================
    // Compact Android-style Calendar Picker Dialog
    // ============================================================
    const calDialog    = document.getElementById('calPickerDialog') as HTMLDialogElement;
    const calPrevBtn   = document.getElementById('calPrevMonth')!;
    const calNextBtn   = document.getElementById('calNextMonth')!;
    const calMonthBtn  = document.getElementById('calMonthBtn')!;
    const calYearBtn   = document.getElementById('calYearBtn')!;
    const calDayView   = document.getElementById('calDayView')!;
    const calDayGrid   = document.getElementById('calDayGrid')!;
    const calMonthView = document.getElementById('calMonthView')!;
    const calMonthGrid = document.getElementById('calMonthGrid')!;
    const calYearView  = document.getElementById('calYearView')!;
    const calYearList  = document.getElementById('calYearList')!;
    const calCancelBtn = document.getElementById('calCancelBtn')!;
    const calOkBtn     = document.getElementById('calOkBtn')!;

    const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
    const SHORT_MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

    let calTargetDisplay: HTMLInputElement | null = null;
    let calTargetInput: HTMLInputElement | null = null;
    let calYear  = new Date().getFullYear();
    let calMonth = new Date().getMonth();
    let calSelectedDate: Date | null = null;
    let calView: 'day' | 'month' | 'year' = 'day';

    function calShowView(v: 'day' | 'month' | 'year') {
      calView = v;
      calDayView.classList.toggle('hidden', v !== 'day');
      calMonthView.classList.toggle('hidden', v !== 'month');
      calYearView.classList.toggle('hidden', v !== 'year');
      calPrevBtn.style.visibility = v === 'day' ? 'visible' : 'hidden';
      calNextBtn.style.visibility = v === 'day' ? 'visible' : 'hidden';
    }

    function calUpdateHeader() {
      calMonthBtn.textContent = MONTHS[calMonth];
      calYearBtn.textContent  = String(calYear);
    }

    function calRenderDays() {
      calUpdateHeader();
      const today    = new Date();
      const firstDay = new Date(calYear, calMonth, 1).getDay();
      const daysInM  = new Date(calYear, calMonth + 1, 0).getDate();
      calDayGrid.innerHTML = '';
      let totalCells = 0;
      for (let i = 0; i < firstDay; i++) {
        const empty = document.createElement('div');
        empty.className = 'h-8';
        calDayGrid.appendChild(empty);
        totalCells++;
      }
      for (let d = 1; d <= daysInM; d++) {
        const btn = document.createElement('button');
        btn.type = 'button';
        const thisDate = new Date(calYear, calMonth, d);
        const isToday    = thisDate.toDateString() === today.toDateString();
        const isSelected = calSelectedDate && thisDate.toDateString() === calSelectedDate.toDateString();
        btn.textContent = String(d);
        btn.className = [
          'w-8 h-8 mx-auto flex items-center justify-center rounded-full text-xs font-medium transition-all cursor-pointer',
          isSelected ? 'bg-brand text-white shadow-sm'
          : isToday  ? 'border border-brand text-brand hover:bg-brand/10'
                     : 'text-ink hover:bg-canvas-soft'
        ].join(' ');
        btn.addEventListener('click', () => {
          calSelectedDate = thisDate;
          calRenderDays();
        });
        calDayGrid.appendChild(btn);
        totalCells++;
      }
      while (totalCells < 42) {
        const empty = document.createElement('div');
        empty.className = 'h-8';
        calDayGrid.appendChild(empty);
        totalCells++;
      }
    }

    function calRenderMonths() {
      calUpdateHeader();
      calMonthGrid.innerHTML = '';
      SHORT_MONTHS.forEach((m, i) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = m;
        btn.className = [
          'py-2 rounded-lg text-sm font-medium transition-colors cursor-pointer',
          i === calMonth ? 'bg-brand text-white' : 'text-ink hover:bg-canvas-soft'
        ].join(' ');
        btn.addEventListener('click', () => {
          calMonth = i;
          calRenderDays();
          calShowView('day');
        });
        calMonthGrid.appendChild(btn);
      });
    }

    function calRenderYears() {
      calUpdateHeader();
      calYearList.innerHTML = '';
      const startYear = calYear - 50;
      for (let y = startYear; y <= calYear + 20; y++) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = String(y);
        btn.className = [
          'w-full text-center py-1.5 rounded-lg text-sm font-medium transition-colors cursor-pointer',
          y === calYear ? 'bg-brand text-white' : 'text-ink hover:bg-canvas-soft'
        ].join(' ');
        btn.addEventListener('click', () => {
          calYear = y;
          calRenderDays();
          calShowView('day');
        });
        calYearList.appendChild(btn);
        if (y === calYear) {
          setTimeout(() => btn.scrollIntoView({ block: 'center' }), 10);
        }
      }
    }

    calPrevBtn.addEventListener('click', () => {
      calMonth--; if (calMonth < 0) { calMonth = 11; calYear--; }
      calRenderDays();
    });
    calNextBtn.addEventListener('click', () => {
      calMonth++; if (calMonth > 11) { calMonth = 0; calYear++; }
      calRenderDays();
    });
    calMonthBtn.addEventListener('click', () => { calRenderMonths(); calShowView('month'); });
    calYearBtn.addEventListener('click',  () => { calRenderYears();  calShowView('year');  });

    calCancelBtn.addEventListener('click', () => calDialog.close());
    calOkBtn.addEventListener('click', () => {
      if (!calSelectedDate || !calTargetDisplay || !calTargetInput) { calDialog.close(); return; }
      const today = new Date();
      const isToday = calSelectedDate.toDateString() === today.toDateString();
      const d = calSelectedDate.getDate(), mo = calSelectedDate.getMonth() + 1, y = calSelectedDate.getFullYear();
      calTargetInput.value = `${y}-${String(mo).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
      calTargetDisplay.value = isToday ? 'Today' : `${String(d).padStart(2,'0')}/${String(mo).padStart(2,'0')}/${y}`;
      calTargetDisplay.classList.remove('text-mute');
      calTargetDisplay.classList.add('text-ink');
      calDialog.close();
    });

    function openCalPicker(displayId: string, hiddenId: string) {
      calTargetDisplay = document.getElementById(displayId) as HTMLInputElement;
      calTargetInput   = document.getElementById(hiddenId) as HTMLInputElement;
      // Pre-select from existing value
      if (calTargetInput?.value) {
        const d = new Date(calTargetInput.value);
        if (!isNaN(d.getTime())) { calSelectedDate = d; calYear = d.getFullYear(); calMonth = d.getMonth(); }
      } else {
        calSelectedDate = null;
        const now = new Date(); calYear = now.getFullYear(); calMonth = now.getMonth();
      }
      calShowView('day');
      calRenderDays();
      calDialog.showModal();
    }

    document.getElementById('startCalToggle')!.addEventListener('click', () => openCalPicker('startCalDisplay', 'tripStartDate'));
    document.getElementById('endCalToggle')!.addEventListener('click',   () => openCalPicker('endCalDisplay',   'tripEndDate'));
    // ============================================================

    const typeColorMap: Record<string, string> = {
      'Trip': 'border-[#2563eb] bg-[#2563eb] text-white',
      'Couple': 'border-[#db2777] bg-[#db2777] text-white',
      'Other': 'border-[#ea580c] bg-[#ea580c] text-white',
      'Home': 'border-[#65a30d] bg-[#65a30d] text-white'
    };

