---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Export Account Data - SplitsBug">
  <div class="min-h-screen flex flex-col bg-canvas-soft pb-32">
    <!-- Header -->
    <header class="h-16 px-4 lg:px-6 flex items-center gap-4 border-b border-hairline bg-canvas sticky top-0 z-40">
      <a href="/account" class="w-10 h-10 flex items-center justify-center rounded-full bg-canvas-soft hover:bg-hairline transition-colors text-ink">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      </a>
      <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-ink">Export Account Data</h1>
    </header>

    <!-- Main Content -->
    <main class="flex-1 w-full max-w-3xl mx-auto p-4 sm:p-6 lg:p-8">
      
      <!-- Info Overview Banner -->
      <div class="bg-canvas border border-hairline p-8 rounded-xl text-center shadow-sm mb-8">
        <div class="w-16 h-16 mx-auto rounded-full bg-brand/10 text-brand flex items-center justify-center mb-4">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        </div>
        
        <h2 class="text-2xl font-bold text-ink mb-2">Your Personal Data Archive</h2>
        <p class="text-mute mb-8 max-w-md mx-auto">SplitsBug allows you to download all information associated with your account from the moment you joined.</p>

        <div class="flex flex-col gap-4 max-w-md mx-auto">
          
          <div class="flex items-center gap-4 p-4 border border-hairline rounded-xl text-left bg-canvas-soft">
            <div class="w-10 h-10 rounded-full bg-blue-500/10 flex items-center justify-center text-blue-500 shrink-0">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <div>
              <p class="font-medium text-ink">Personal Profile Data</p>
              <p class="text-xs text-mute mt-0.5">Name, Email, Profile Picture Link, Phone Number, Date of Birth, App Theme, and Account Creation Date.</p>
            </div>
          </div>

          <div class="flex items-center gap-4 p-4 border border-hairline rounded-xl text-left bg-canvas-soft">
            <div class="w-10 h-10 rounded-full bg-purple-500/10 flex items-center justify-center text-purple-500 shrink-0">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div>
              <p class="font-medium text-ink">Groups & Memberships</p>
              <p class="text-xs text-mute mt-0.5">Group Names, Descriptions, Member Lists, Your Roles, Base Currencies, and Group Timestamps.</p>
            </div>
          </div>

          <div class="flex items-center gap-4 p-4 border border-hairline rounded-xl text-left bg-canvas-soft">
            <div class="w-10 h-10 rounded-full bg-emerald-500/10 flex items-center justify-center text-emerald-500 shrink-0">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <div>
              <p class="font-medium text-ink">Expenses & Settlements</p>
              <p class="text-xs text-mute mt-0.5">Exact Amounts, Paid By, Split Methods, Participants, Transaction Categories, and Timestamps.</p>
            </div>
          </div>

        </div>
      </div>

      <!-- Action Box -->
      <div class="bg-canvas border border-hairline rounded-xl p-6 shadow-sm">
        <h3 class="text-xs font-bold text-mute uppercase tracking-wider mb-4">Request Data Delivery</h3>

        <div class="flex items-start gap-3 select-none mb-4">
          <input type="checkbox" id="requestDataConsent" class="mt-1 w-4 h-4 text-brand rounded border-hairline focus:ring-brand accent-brand cursor-pointer shrink-0" />
          <span class="text-sm text-ink font-medium leading-relaxed">
            I request my complete account data to be exported and sent to my registered email address.
          </span>
        </div>

        <!-- Request Button -->
        <button type="button" id="requestDataBtn" disabled class="w-full py-3 bg-brand text-white font-bold rounded-xl transition-all shadow-sm text-sm disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer hover:bg-brand-deep flex items-center justify-center gap-2">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          Request Data Over Email
        </button>
      </div>

    </main>
  </div>

  <!-- Email Sent Confirmation Modal with Fast Flying Speed Animation -->
  <dialog id="emailSentModal" class="backdrop:bg-black/60 text-ink fixed inset-0 z-50 m-auto w-[90vw] max-w-sm p-6 sm:p-8 bg-canvas border border-hairline rounded-2xl shadow-2xl">
    <div class="flex flex-col items-center gap-4 text-center">
      
      <!-- Speed Email Animation Container -->
      <div class="relative w-24 h-24 flex items-center justify-center">
        <div class="absolute inset-0 rounded-full bg-brand/10 animate-ping opacity-75"></div>
        <div class="w-16 h-16 rounded-full bg-brand text-white flex items-center justify-center shadow-lg relative z-10 overflow-hidden">
          
          <!-- Moving envelope and speed lines -->
          <div class="flex items-center gap-1 animate-[flyRight_1.2s_linear_infinite]">
            <div class="flex flex-col gap-1 opacity-70 mt-1">
              <div class="w-3 h-0.5 bg-white rounded"></div>
              <div class="w-5 h-0.5 bg-white rounded -translate-x-1"></div>
              <div class="w-2 h-0.5 bg-white rounded"></div>
            </div>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          
        </div>
      </div>

      <div>
        <h3 class="text-xl font-bold text-ink">Request Submitted!</h3>
        <p class="text-sm text-mute mt-2 leading-relaxed">
          You will receive an email within 12 hours with your complete data bundle and organized Excel (.xlsx) sheet.
        </p>
      </div>

      <button type="button" id="closeModalBtn" class="w-full py-3 bg-canvas-soft hover:bg-hairline text-ink font-semibold rounded-xl text-sm transition-colors border border-hairline cursor-pointer mt-2">
        Done
      </button>
    </div>
  </dialog>

  <script>
    import { auth, db } from '../firebase';
    import { doc, getDoc, collection, getDocs, query, where } from 'firebase/firestore';

    const consentCheckbox = document.getElementById('requestDataConsent') as HTMLInputElement;
    const requestDataBtn = document.getElementById('requestDataBtn') as HTMLButtonElement;
    const emailSentModal = document.getElementById('emailSentModal') as HTMLDialogElement;
    const closeModalBtn = document.getElementById('closeModalBtn');

    consentCheckbox?.addEventListener('change', () => {
      requestDataBtn.disabled = !consentCheckbox.checked;
    });

    requestDataBtn?.addEventListener('click', async () => {
      const user = auth.currentUser;
      const userEmail = user?.email || localStorage.getItem('splitbug_userEmail');

      if (!userEmail) {
        alert('User email session not found. Please login again.');
        return;
      }

      requestDataBtn.disabled = true;
      requestDataBtn.innerHTML = `
        <div class="flex items-center justify-center gap-2">
          <div class="flex items-center gap-1 animate-[flyRight_1.2s_linear_infinite]">
            <div class="flex flex-col gap-[2px] opacity-70 mt-[2px]">
              <div class="w-2 h-[2px] bg-white rounded"></div>
              <div class="w-3 h-[2px] bg-white rounded -translate-x-1"></div>
              <div class="w-1.5 h-[2px] bg-white rounded"></div>
            </div>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          Gathering & Exporting...
        </div>
      `;

      try {
        // Fetch User profile doc
        const userDocRef = doc(db, 'users', userEmail);
        const userSnap = await getDoc(userDocRef);
        const userData = userSnap.exists() ? userSnap.data() : { email: userEmail };

        // Fetch user groups safely (Fix for Missing Permissions)
        const groupsRef = collection(db, 'groups');
        const groupsQuery = query(groupsRef, where('members', 'array-contains', userEmail));
        const groupsSnap = await getDocs(groupsQuery);
        const userGroups = groupsSnap.docs.map(d => ({ id: d.id, ...d.data() }));

        // Fetch user activities safely (replaces root collection expenses query)
        const actRef = collection(db, 'activities');
        const actQuery = query(actRef, where('participants', 'array-contains', userEmail));
        const actSnap = await getDocs(actQuery);
        
        // Filter out expenses from activities
        const allExpenses = actSnap.docs
          .map(d => ({ id: d.id, ...d.data() }))
          .filter(a => a.type === 'expense_added' || a.type === 'expense_updated');

        // Fetch notifications
        const notifRef = collection(db, 'users', userEmail, 'notifications');
        const notifSnap = await getDocs(notifRef).catch(() => ({ docs: [] }));
        const notifications = notifSnap.docs.map(d => d.data());

        // Send API request to send export email
        const res = await fetch('/api/send-account-data', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            to: userEmail,
            userData,
            userGroups,
            allExpenses,
            notifications
          })
        });

        const result = await res.json();
        if (!res.ok) throw new Error(result.error || 'Failed to dispatch email');

        // Show confirmation popup modal
        emailSentModal?.showModal();

      } catch (err: any) {
        console.error('Export Error:', err);
        alert(err.message || 'Failed to send data export email. Please try again.');
      } finally {
        requestDataBtn.disabled = false;
        requestDataBtn.innerHTML = `
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          Request Data Over Email
        `;
      }
    });

    closeModalBtn?.addEventListener('click', () => {
      emailSentModal?.close();
      window.location.href = '/account';
    });
  </script>
</Layout>

<style>
  @keyframes flyRight {
    0% { transform: translateX(-15px); opacity: 0; }
    20% { opacity: 1; }
    80% { opacity: 1; }
    100% { transform: translateX(15px); opacity: 0; }
  }
</style>
