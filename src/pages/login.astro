---
import Layout from '../layouts/Layout.astro';
---
<Layout hideNav={true}>
  <div class="min-h-screen flex flex-col justify-center items-center p-6 bg-canvas-soft">
    <div class="w-full max-w-sm bg-canvas p-8 rounded-2xl shadow-lg border border-hairline relative overflow-hidden">
      
      <!-- Loading Overlay -->
      <div id="loadingOverlay" class="hidden absolute inset-0 z-50 bg-canvas/80 backdrop-blur-sm flex flex-col items-center justify-center">
        <svg class="animate-spin h-8 w-8 text-brand mb-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <p class="text-ink font-medium animate-pulse">Authenticating...</p>
      </div>

      <div class="text-center mb-8">
        <h1 class="text-2xl font-bold text-ink mb-2">Welcome Back</h1>
        <p class="text-mute text-sm">Log in to your SplitBugs account</p>
      </div>
      
      <form id="loginForm" class="flex flex-col gap-4">
        
        <div id="successBox" class="hidden bg-success/10 border border-success/20 text-success p-3 rounded-md text-sm font-medium"></div>
        <div id="errorBox" class="hidden bg-danger/10 border border-danger/20 text-danger p-3 rounded-md text-sm font-medium"></div>

        <div>
          <label class="block text-sm font-medium text-ink mb-1">Email address</label>
          <input type="email" required id="emailInput" class="w-full p-3 rounded-md border border-hairline bg-canvas focus:outline-none focus:border-brand transition-colors text-ink placeholder:text-mute" placeholder="john@example.com" />
        </div>
        <div>
          <label class="block text-sm font-medium text-ink mb-1">Password</label>
          <div class="relative">
            <input type="password" required id="passwordInput" class="w-full p-3 rounded-md border border-hairline bg-canvas focus:outline-none focus:border-brand transition-colors text-ink placeholder:text-mute pr-10" placeholder="••••••••" />
            <button type="button" id="togglePasswordBtn" class="absolute inset-y-0 right-0 px-3 flex items-center text-mute hover:text-ink focus:outline-none transition-colors">
              <svg id="eyeIconOpen" class="hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              <svg id="eyeIconClosed" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
            </button>
          </div>
        </div>
        
        <button type="submit" id="submitBtn" class="w-full py-3 mt-4 bg-brand text-white rounded-md font-bold hover:bg-brand-deep transition-colors shadow-sm">
          Log in
        </button>

        <div class="relative flex items-center py-2">
          <div class="flex-grow border-t border-hairline"></div>
          <span class="shrink-0 px-3 text-xs text-mute uppercase font-medium">Or continue with</span>
          <div class="flex-grow border-t border-hairline"></div>
        </div>
        
        <button type="button" id="googleLoginBtn" class="w-full flex items-center justify-center gap-2 py-3 bg-canvas border border-hairline text-ink rounded-md font-medium hover:bg-canvas-soft transition-colors shadow-sm">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
          Google
        </button>
      </form>

      <div class="mt-6 text-center text-sm">
        <span class="text-mute">Don't have an account?</span>
        <a href="/signup" class="text-brand font-medium hover:underline ml-1">Sign up</a>
      </div>
    </div>
  </div>

  <script>
    import { auth, googleProvider } from '../firebase';
    import { signInWithEmailAndPassword, signInWithPopup } from 'firebase/auth';

    const form = document.getElementById('loginForm');
    const emailInput = document.getElementById('emailInput') as HTMLInputElement;
    const passwordInput = document.getElementById('passwordInput') as HTMLInputElement;
    const errorBox = document.getElementById('errorBox') as HTMLDivElement;
    const successBox = document.getElementById('successBox') as HTMLDivElement;
    const googleBtn = document.getElementById('googleLoginBtn');
    const loadingOverlay = document.getElementById('loadingOverlay') as HTMLDivElement;

    // Password Toggle
    const togglePasswordBtn = document.getElementById('togglePasswordBtn');
    const eyeIconOpen = document.getElementById('eyeIconOpen');
    const eyeIconClosed = document.getElementById('eyeIconClosed');
    
    togglePasswordBtn?.addEventListener('click', () => {
      if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        eyeIconOpen?.classList.remove('hidden');
        eyeIconClosed?.classList.add('hidden');
      } else {
        passwordInput.type = 'password';
        eyeIconOpen?.classList.add('hidden');
        eyeIconClosed?.classList.remove('hidden');
      }
    });

    // Check if redirected from signup
    const params = new URLSearchParams(window.location.search);
    if (params.get('registered') === 'true') {
      successBox.textContent = 'Account created successfully! Please log in.';
      successBox.classList.remove('hidden');
    }

    import { db } from '../firebase';
    import { doc, getDoc } from 'firebase/firestore';

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      errorBox.classList.add('hidden');
      successBox.classList.add('hidden');
      loadingOverlay.classList.remove('hidden');

      const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
      if (submitBtn) submitBtn.disabled = true;

      const email = emailInput.value.trim();
      const password = passwordInput.value;

      try {
        await signInWithEmailAndPassword(auth, email, password);
        window.location.href = '/dashboard';
      } catch (error: any) {
        if (submitBtn) submitBtn.disabled = false;
        loadingOverlay.classList.add('hidden');
        errorBox.textContent = "Email and password doesn't match";
        errorBox.classList.remove('hidden');
      }
    });

    googleBtn?.addEventListener('click', async () => {
      errorBox.classList.add('hidden');
      loadingOverlay.classList.remove('hidden');
      try {
        const result = await signInWithPopup(auth, googleProvider);
        const user = result.user;
        
        // Check if user exists in Firestore
        const userDocRef = doc(db, "users", user.uid);
        const userDoc = await getDoc(userDocRef);
        
        if (!userDoc.exists()) {
          // If user does not exist, redirect to signup page to complete registration
          window.location.href = '/signup?google=true';
        } else {
          // Returning user
          window.location.href = '/dashboard';
        }
      } catch (error: any) {
        if (error.code === 'auth/popup-closed-by-user') {
          errorBox.textContent = 'Google signup popup closed';
        } else if (error.message && (error.message.includes('closing') || error.message.includes('hidden'))) {
          errorBox.textContent = 'Refreshing connection...';
          setTimeout(() => window.location.reload(), 1000);
        } else {
          errorBox.textContent = error.message || 'Google login failed.';
        }
        loadingOverlay.classList.add('hidden');
        errorBox.className = 'bg-danger/10 border border-danger/20 text-danger p-3 rounded-md text-sm font-medium mb-4';
        errorBox.classList.remove('hidden');
      }
    });
  </script>
</Layout>
