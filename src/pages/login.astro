---
import Layout from '../layouts/Layout.astro';
---
<Layout hideNav={true}>
  <div class="min-h-screen flex flex-col justify-center items-center p-6 bg-canvas-soft">
    <div class="w-full max-w-sm bg-canvas p-8 rounded-xl shadow-sm border border-hairline">
      <div class="text-center mb-8">
        <h1 class="text-2xl font-bold text-ink mb-2">Welcome Back</h1>
        <p class="text-mute text-sm">Log in to your SplitBugs account</p>
      </div>
      
      <form id="loginForm" class="flex flex-col gap-4">
        
        <div id="successBox" class="hidden bg-success/10 border border-success/20 text-success p-3 rounded-md text-sm font-medium"></div>
        <div id="errorBox" class="hidden bg-danger/10 border border-danger/20 text-danger p-3 rounded-md text-sm font-medium"></div>

        <div>
          <label class="block text-sm font-medium text-ink mb-1">Email address</label>
          <input type="email" required id="emailInput" class="w-full p-3 rounded-md border border-hairline bg-canvas focus:outline-none focus:border-brand transition-colors text-ink placeholder:text-mute" placeholder="john@example.com" />
        </div>
        <div>
          <label class="block text-sm font-medium text-ink mb-1">Password</label>
          <input type="password" required id="passwordInput" class="w-full p-3 rounded-md border border-hairline bg-canvas focus:outline-none focus:border-brand transition-colors text-ink placeholder:text-mute" placeholder="••••••••" />
        </div>
        
        <button type="submit" class="w-full py-3 mt-4 bg-brand text-white rounded-md font-bold hover:bg-brand-deep transition-colors shadow-sm">
          Log in
        </button>

        <div class="relative flex items-center py-2">
          <div class="flex-grow border-t border-hairline"></div>
          <span class="shrink-0 px-3 text-xs text-mute uppercase font-medium">Or continue with</span>
          <div class="flex-grow border-t border-hairline"></div>
        </div>
        
        <button type="button" class="w-full flex items-center justify-center gap-2 py-3 bg-canvas border border-hairline text-ink rounded-md font-medium hover:bg-canvas-soft transition-colors shadow-sm">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
          Google
        </button>
      </form>

      <div class="mt-6 text-center text-sm">
        <span class="text-mute">Don't have an account?</span>
        <a href="/signup" class="text-brand font-medium hover:underline ml-1">Sign up</a>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('loginForm');
    const emailInput = document.getElementById('emailInput') as HTMLInputElement;
    const passwordInput = document.getElementById('passwordInput') as HTMLInputElement;
    const errorBox = document.getElementById('errorBox') as HTMLDivElement;
    const successBox = document.getElementById('successBox') as HTMLDivElement;

    // Check if redirected from signup
    const params = new URLSearchParams(window.location.search);
    if (params.get('registered') === 'true') {
      successBox.textContent = 'Account created successfully! Please log in.';
      successBox.classList.remove('hidden');
    }

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      
      errorBox.classList.add('hidden');
      successBox.classList.add('hidden');

      const email = emailInput.value.trim();
      const password = passwordInput.value;

      let users = {};
      try {
        const usersStr = localStorage.getItem('splitbug_users');
        if (usersStr) users = JSON.parse(usersStr);
      } catch (e) {}

      const user = users[email];

      // In a real application, this would be an API call to a backend
      if (!user) {
        errorBox.textContent = 'No account found with this email. Please sign up.';
        errorBox.classList.remove('hidden');
        return;
      }

      if (password !== user.password) {
        errorBox.textContent = 'Invalid email or password.';
        errorBox.classList.remove('hidden');
        return;
      }

      // Login successful, set as current user
      localStorage.setItem('splitbug_userName', user.name);
      localStorage.setItem('splitbug_userEmail', email);
      localStorage.setItem('splitbug_userPassword', user.password);
      localStorage.setItem('splitbug_userDob', user.dob || '');
      localStorage.setItem('splitbug_userPhone', user.phone || '');
      localStorage.setItem('splitbug_userThemeColor', user.themeColor || 'special-art-1');
      
      if (user.avatar) {
        localStorage.setItem('splitbug_userAvatar', user.avatar);
      } else {
        localStorage.removeItem('splitbug_userAvatar');
      }
      
      localStorage.setItem('splitbug_loggedIn', 'true');
      window.location.href = '/dashboard';
    });
  </script>
</Layout>
