  </div>

  <script>
    const currentUserEmail = localStorage.getItem('splitbug_userEmail') || 'user@example.com';
    const DATA_KEY = 'splitsbug_data_' + currentUserEmail;
    const typeColorMap: Record<string, string> = {
      'Trip': 'border-[#2563eb] bg-[#2563eb] text-white',
      'Couple': 'border-[#db2777] bg-[#db2777] text-white',
      'Other': 'border-[#ea580c] bg-[#ea580c] text-white',
      'Home': 'border-[#65a30d] bg-[#65a30d] text-white'
    };

    const typeLightColorMap: Record<string, string> = {
      'Trip': 'bg-[#eff6ff] text-[#2563eb]',
      'Couple': 'bg-[#fdf2f8] text-[#db2777]',
      'Other': 'bg-[#fffbeb] text-[#d97706]',
      'Home': 'bg-[#f7fee7] text-[#65a30d]'
    };

    const alphabetMap: Record<string, {dark: string, light: string}> = {
      'A': { dark: '#e11d48', light: 'bg-[#fff1f2] text-[#e11d48]' },
      'B': { dark: '#2563eb', light: 'bg-[#eff6ff] text-[#2563eb]' },
      'C': { dark: '#9333ea', light: 'bg-[#faf5ff] text-[#9333ea]' },
      'D': { dark: '#4f46e5', light: 'bg-[#eef2ff] text-[#4f46e5]' },
      'E': { dark: '#db2777', light: 'bg-[#fdf2f8] text-[#db2777]' },
      'F': { dark: '#d97706', light: 'bg-[#fffbeb] text-[#d97706]' },
      'G': { dark: '#059669', light: 'bg-[#ecfdf5] text-[#059669]' },
      'H': { dark: '#0d9488', light: 'bg-[#f0fdfa] text-[#0d9488]' },
      'I': { dark: '#0891b2', light: 'bg-[#ecfeff] text-[#0891b2]' },
      'J': { dark: '#e11d48', light: 'bg-[#fff1f2] text-[#e11d48]' },
      'K': { dark: '#059669', light: 'bg-[#ecfdf5] text-[#059669]' },
      'L': { dark: '#65a30d', light: 'bg-[#f7fee7] text-[#65a30d]' },
      'M': { dark: '#e11d48', light: 'bg-[#fff1f2] text-[#e11d48]' },
      'N': { dark: '#059669', light: 'bg-[#ecfdf5] text-[#059669]' },
      'O': { dark: '#9333ea', light: 'bg-[#faf5ff] text-[#9333ea]' },
      'P': { dark: '#4f46e5', light: 'bg-[#eef2ff] text-[#4f46e5]' },
      'Q': { dark: '#db2777', light: 'bg-[#fdf2f8] text-[#db2777]' },
      'R': { dark: '#d97706', light: 'bg-[#fffbeb] text-[#d97706]' },
      'S': { dark: '#059669', light: 'bg-[#ecfdf5] text-[#059669]' },
      'T': { dark: '#0d9488', light: 'bg-[#f0fdfa] text-[#0d9488]' },
      'U': { dark: '#0891b2', light: 'bg-[#ecfeff] text-[#0891b2]' },
      'V': { dark: '#e11d48', light: 'bg-[#fff1f2] text-[#e11d48]' },
      'W': { dark: '#c026d3', light: 'bg-[#fdf4ff] text-[#c026d3]' },
      'X': { dark: '#65a30d', light: 'bg-[#f7fee7] text-[#65a30d]' },
      'Y': { dark: '#e11d48', light: 'bg-[#fff1f2] text-[#e11d48]' },
      'Z': { dark: '#2563eb', light: 'bg-[#eff6ff] text-[#2563eb]' },
    };

    function getGroupColor(type: string, name: string) {
      const validTypes = ['Trip', 'Couple', 'Home'];
      if (!type || !validTypes.includes(type)) {
        const firstLetter = (name || 'G').trim().charAt(0).toUpperCase();
        if (alphabetMap[firstLetter]) return alphabetMap[firstLetter];
        return { dark: '#d97706', light: 'bg-[#fffbeb] text-[#d97706]' };
      }
      return {
        dark: typeColorMap[type] ? typeColorMap[type].match(/bg-\[([^\]]+)\]/)?.[1] || '#2563eb' : '#2563eb',
        light: typeLightColorMap[type] || 'bg-[#eff6ff] text-[#2563eb]'
      };
    }
    function showErrorModal(message: string) {
      const modal = document.getElementById('errorModal') as HTMLDialogElement;
      const msg = document.getElementById('errorModalMsg');
      const btn = document.getElementById('errorModalOkBtn');
      if (modal && msg && btn) {
        msg.textContent = message;
        modal.showModal();
        btn.onclick = () => modal.close();
      }
    }

    function showToast(message: string, isError = false) {
      const toast = document.getElementById('toastNotification');
      const toastMsg = document.getElementById('toastMessage');
      const iconSuccess = document.getElementById('toastIconSuccess');
      const iconError = document.getElementById('toastIconError');
      if (toast && toastMsg && iconSuccess && iconError) {
        
        const activeDialog = document.querySelector('dialog[open]');
        if (activeDialog) {
          activeDialog.appendChild(toast);
        } else {
          document.body.appendChild(toast);
        }

        toastMsg.textContent = message;
        if (isError) {
          iconSuccess.classList.add('hidden');
          iconError.classList.remove('hidden');
        } else {
          iconError.classList.add('hidden');
          iconSuccess.classList.remove('hidden');
        }
        toast.classList.remove('translate-y-20', 'opacity-0');
        setTimeout(() => {
          toast.classList.add('translate-y-20', 'opacity-0');
        }, 3000);
      }
    }

    // Client-side UI wiring
    const addExpenseBtn = document.getElementById('addExpenseBtn');
    const addExpenseModal = document.getElementById('addExpenseModal') as HTMLDialogElement;
    const closeExpenseBtn = document.getElementById('closeExpenseBtn');
    const cancelExpenseBtn = document.getElementById('cancelExpenseBtn');

    function resetAddExpenseModal() {
      const desc = document.getElementById('expenseDescription') as HTMLInputElement;
      const amt = document.getElementById('expenseAmount') as HTMLInputElement;
      if (desc) desc.value = '';
      if (amt) amt.value = '';

      const expenseCategoryValue = document.getElementById('expenseCategoryValue') as HTMLInputElement;
      const expenseCategoryBtn = document.getElementById('expenseCategoryBtn');
      if (expenseCategoryValue) expenseCategoryValue.value = 'Uncategorized.General';
      if (expenseCategoryBtn) {
        expenseCategoryBtn.className = 'w-10 h-10 flex items-center justify-center border border-hairline rounded-sm flex-shrink-0 transition-colors bg-slate-100 text-slate-600';
        expenseCategoryBtn.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>`;
      }

