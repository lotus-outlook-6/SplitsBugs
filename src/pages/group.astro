        const d = deleteGroupModal.getBoundingClientRect();
        if (e.clientX < d.left || e.clientX > d.right || e.clientY < d.top || e.clientY > d.bottom) deleteGroupModal.close();
      });
      confirmDeleteBtn.addEventListener('click', () => {
        // Trigger Animation
        if (deleteNormalState) deleteNormalState.classList.remove('flex');
        if (deleteNormalState) deleteNormalState.classList.add('hidden');
        if (deleteAnimState) deleteAnimState.classList.remove('hidden');
        if (deleteAnimState) deleteAnimState.classList.add('flex');
        if (deleteModalContent) deleteModalContent.classList.add('scale-95');

        setTimeout(async () => {
          try {
            const { deleteDoc } = await import('firebase/firestore');
            await deleteDoc(groupDocRef);

            // Add persistent activity
            await addDoc(collection(db, "activities"), {
              groupId: groupId,
              groupName: groupData.name,
              type: 'group_deleted',
              description: 'Deleted group',
              amount: 0,
              currency: groupData.currency || '$',
              paidBy: currentUserEmail,
              participants: groupData.members,
              timestamp: Date.now()
            });

            window.location.href = '/dashboard';
          } catch (e) {
            console.error("Error deleting group", e);
