---
import Layout from '../layouts/Layout.astro';
---

<style is:global>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .is-equally .split-participant-label {
    pointer-events: none;
    opacity: 0.5;
  }
</style>

<Layout>
  <!-- Sticky Top Bar (Animates in on scroll) -->
  <div id="stickyTopBar" class="fixed top-0 left-0 w-full h-16 bg-[#0a6c51] z-[60] flex items-center justify-between px-4 sm:px-6 lg:px-8 transition-all duration-300 -translate-y-full opacity-0 pointer-events-none shadow-md">
    <a href="/dashboard" class="w-10 h-10 flex items-center justify-center rounded-full bg-ink/10 hover:bg-ink/20 transition-colors text-white">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
    </a>
    <button id="stickySettingsBtn" class="w-10 h-10 flex items-center justify-center rounded-full bg-ink/10 hover:bg-ink/20 transition-colors text-white">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="3"></circle>
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
      </svg>
    </button>
  </div>

  <div class="min-h-screen flex flex-col bg-canvas-soft">
    <!-- Unified Header Banner (like Android app) -->
    <header id="mainHeader" class="relative bg-[#0a6c51] text-white overflow-hidden transition-colors">
      <!-- Watermark Background Icon Container -->
      <div id="headerWatermark" class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-1/4 opacity-10 pointer-events-none text-white">
        <svg width="240" height="240" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.2-1.1.6l-1 2c-.3.6.1 1.2.7 1.5l5.5 2.5-3.5 3.5-3.1-.8c-.4-.1-.8.2-1 .5L0 18l5.5 1.5L7 25l2-1c.3-.2.6-.6.5-1l-.8-3.1 3.5-3.5 2.5 5.5c.3.6 1 .9 1.5.7l2-1c.4-.2.7-.6.6-1.1z"/></svg>
      </div>

      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-12 relative z-10">
        
        <!-- Top Nav (Back & Settings) -->
        <div class="flex items-center justify-between mb-8">
          <a href="/dashboard" class="w-10 h-10 flex items-center justify-center rounded-full bg-ink/20 hover:bg-ink/30 transition-colors backdrop-blur-sm text-white" title="Go back">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
          </a>
          <button id="groupSettingsBtn" class="w-10 h-10 flex items-center justify-center rounded-full bg-ink/20 hover:bg-ink/30 transition-colors backdrop-blur-sm text-white" title="Settings">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
          </button>
        </div>
        
        <!-- Group Title -->
        <h1 id="groupTitle" class="text-4xl lg:text-5xl font-bold tracking-tight mb-4">Loading...</h1>
        
        <!-- Info Pills -->
        <div class="flex flex-wrap items-center gap-3">
          <div id="datePill" class="hidden items-center gap-2 px-3 py-1.5 bg-ink/20 rounded-full text-sm font-medium backdrop-blur-sm border border-canvas/10">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <span id="dateText"></span>
          </div>
          <div class="flex items-center gap-2 px-3 py-1.5 bg-ink/20 rounded-full text-sm font-medium backdrop-blur-sm border border-canvas/10">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            <span id="memberCountText">0 people</span>
          </div>
        </div>
      </div>
    </header>

    <main class="flex-1 max-w-[1200px] w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 -mt-6 pb-40">
      
      <!-- Action Buttons Toolbar -->
      <div class="flex flex-wrap items-center justify-end gap-3 mb-6 relative z-20">
        <button id="settleUpBtn" class="bg-canvas-soft text-ink border border-hairline px-4 py-2 rounded-pill font-medium hover:bg-hairline transition-colors shadow-sm">
          Settle Up
        </button>
        <button id="addExpenseBtn" class="bg-ink text-canvas px-4 py-2 rounded-pill font-medium hover:opacity-80 transition-opacity shadow-sm flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
          Add Expense
        </button>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Main Activity Feed (2/3 width on desktop) -->
        <div class="order-2 lg:order-1 lg:col-span-2 space-y-6">
          <section class="bg-canvas border border-hairline rounded-lg shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-hairline bg-canvas-soft flex justify-between items-center">
              <h2 class="text-lg font-bold">Activity</h2>
              <span class="text-xs font-medium text-mute uppercase tracking-wider">August 2026</span>
            </div>
            
            <div id="activityFeed" class="divide-y divide-hairline">
              <!-- Activities will be added here via JS -->
            </div>
          </section>
        </div>
        
        <!-- Sidebar: Balances (1/3 width on desktop) -->
        <div class="order-1 lg:order-2 lg:col-span-1 space-y-6">
          <section class="bg-canvas border border-hairline rounded-lg shadow-sm p-6">
            <h2 class="text-lg font-bold mb-4">Balances</h2>
            
            <div id="balancesContainer" class="space-y-4">
              <!-- Balances will be added here via JS -->
            </div>
            
            
          </section>
        </div>
      </div>
    </main>

    <!-- Add Expense Modal -->
    <dialog id="addExpenseModal" class="bg-transparent p-0 m-auto backdrop:bg-black/50 text-ink open:flex flex-col items-center justify-center w-[92vw] sm:w-full max-w-lg">
      <div class="bg-canvas border border-hairline rounded-lg shadow-lg w-full p-6 text-left">
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-xl font-bold">Add an expense</h2>
          <button id="closeExpenseBtn" class="text-mute hover:text-ink transition-colors">✕</button>
        </div>
        
        <form id="addExpenseForm" class="space-y-4" method="dialog" novalidate>
          <div>
            <label id="descLabel" class="block text-sm font-medium text-ink mb-1 transition-colors">Description</label>
            <div class="flex gap-2 items-center">
              <button type="button" id="expenseCategoryBtn" class="w-10 h-10 flex items-center justify-center border border-hairline rounded-sm flex-shrink-0 transition-colors bg-slate-100 text-slate-600">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
              </button>
              <input type="text" id="expenseDescription" autocomplete="off" placeholder="e.g. Dinner, Taxi, Groceries" class="flex-1 bg-canvas text-ink border border-hairline rounded-sm px-3 h-10 text-sm focus:outline-none focus:border-hairline-strong transition-colors" />
              <!-- Hidden input to store selected category -->
              <input type="hidden" id="expenseCategoryValue" value="Uncategorized.General" />
            </div>
          </div>
          
          <div>
            <label id="amountLabel" class="block text-sm font-medium text-ink mb-1 transition-colors">Amount</label>
            <div class="relative flex h-10">
              <!-- Custom Currency Dropdown -->
              <div class="relative h-full" id="currencyDropdown">
                <button type="button" id="currencyBtn" class="flex items-center gap-1.5 h-full bg-canvas-soft border-y border-l border-r border-hairline text-ink text-sm px-3 rounded-l-sm focus:outline-none font-medium hover:bg-canvas transition-colors">
                  <span id="currencySymbol">$</span>
                  <svg width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-mute">
                    <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
                
                <div id="currencyMenu" class="hidden absolute left-0 top-full mt-1 w-20 bg-canvas border border-hairline rounded-md shadow-lg z-50 py-1">
                  <button type="button" class="currency-option w-full text-left px-3 py-1.5 text-sm hover:bg-canvas-soft transition-colors" data-symbol="$">USD ($)</button>
                  <button type="button" class="currency-option w-full text-left px-3 py-1.5 text-sm hover:bg-canvas-soft transition-colors" data-symbol="€">EUR (€)</button>
                  <button type="button" class="currency-option w-full text-left px-3 py-1.5 text-sm hover:bg-canvas-soft transition-colors" data-symbol="£">GBP (£)</button>
                  <button type="button" class="currency-option w-full text-left px-3 py-1.5 text-sm hover:bg-canvas-soft transition-colors" data-symbol="₹">INR (₹)</button>
                </div>
              </div>
              
              <input type="number" id="expenseAmount" min="0.01" placeholder="0.00" step="0.01" onkeydown="if(['e','E','+','-'].includes(event.key)) event.preventDefault();" class="w-full bg-canvas text-ink border-y border-r border-hairline rounded-r-sm px-3 h-full text-sm focus:outline-none focus:border-hairline-strong transition-colors" />
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-ink mb-1">Paid by</label>
              <div class="relative h-full" id="paidByMenuContainer">
                <button type="button" id="paidByBtn" class="w-full bg-canvas-soft border border-hairline rounded-sm px-3 h-10 text-sm text-left flex items-center justify-between hover:bg-hairline transition-colors">
                  <span id="paidByText">Loading...</span>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-mute"><path d="m6 9 6 6 6-6"/></svg>
                </button>
                <div id="paidByMenu" class="hidden absolute top-full left-0 w-full mt-1 bg-canvas border border-hairline rounded-sm shadow-md z-10 py-1">
                  <!-- Members populated via JS -->
                </div>
              </div>
            </div>
            <div>
              <label class="block text-sm font-medium text-ink mb-1">Split</label>
              <div class="relative h-10" id="splitDropdown">
                <button type="button" id="splitBtn" class="flex items-center justify-between w-full h-full bg-canvas text-ink border border-hairline rounded-sm px-3 text-sm focus:outline-none focus:border-hairline-strong transition-colors hover:bg-canvas-soft">
                  <span id="splitText">Equally</span>
                  <svg width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-mute">
                    <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
                <div id="splitMenu" class="hidden absolute left-0 top-full mt-1 w-full bg-canvas border border-hairline rounded-md shadow-lg z-50 py-1">
                  <button type="button" class="split-option w-full text-left px-3 py-1.5 text-sm hover:bg-canvas-soft transition-colors" data-value="Equally">Equally</button>
                  <button type="button" class="split-option w-full text-left px-3 py-1.5 text-sm hover:bg-canvas-soft transition-colors" data-value="Exactly">Exactly</button>
                </div>
              </div>
            </div>
          </div>

          <div id="splitParticipantsContainer" class="group mt-4 pt-4 border-t border-hairline">
            <label class="block text-sm font-medium text-ink mb-2">Split with:</label>
            <div id="splitParticipantsList" class="flex flex-wrap gap-2 mt-2">
              <!-- Checkboxes populated via JS -->
            </div>
          </div>

          <div class="mt-8 flex justify-end gap-3 pt-4 border-t border-hairline">
            <button type="button" id="cancelExpenseBtn" class="bg-canvas text-ink px-4 py-2 rounded-pill font-medium border border-hairline hover:bg-canvas-soft transition-colors">Cancel</button>
            <button type="submit" class="bg-primary text-on-primary px-4 py-2 rounded-pill font-medium hover:opacity-90 transition-opacity">Save Expense</button>
          </div>
        </form>
      </div>
    </dialog>

    <!-- Category Picker Modal -->
    <dialog id="categoryPickerModal" class="bg-transparent p-0 m-auto backdrop:bg-black/50 text-ink open:flex flex-col items-center justify-center w-[92vw] sm:w-full max-w-md max-h-[80vh] z-[9999]">
      <div class="bg-canvas border border-hairline rounded-xl shadow-2xl w-full flex flex-col h-full max-h-[80vh] overflow-hidden">
        <!-- Header -->
        <div class="px-4 py-3 border-b border-hairline flex gap-3 items-center shrink-0 bg-canvas sticky top-0 z-10">
          <button id="closeCategoryPickerBtn" class="text-mute hover:text-ink transition-colors p-1 rounded-full hover:bg-canvas-soft">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          </button>
          <div class="flex-1 relative">
            <input type="text" id="categorySearchInput" autocomplete="off" placeholder="Search or select a category" class="w-full bg-transparent text-ink text-base focus:outline-none h-10" />
          </div>
        </div>
        
        <!-- Category List -->
        <div id="categoryListContainer" class="flex-1 overflow-y-auto p-4 space-y-6">
          <!-- Populated by JS -->
        </div>
      </div>
    </dialog>

    <!-- Settle Up Modal -->
    <dialog id="settleUpModal" class="bg-transparent p-0 m-auto backdrop:bg-black/50 text-ink open:flex flex-col items-center justify-center w-[92vw] sm:w-full max-w-sm">
      <div id="settleUpCard" class="bg-canvas border border-hairline rounded-lg shadow-lg w-full transition-all duration-300 overflow-hidden">
        <!-- Main Content -->
        <div id="settleUpContent" class="p-6 text-center transition-opacity duration-300">
          <div class="w-12 h-12 bg-success/10 text-success rounded-full flex items-center justify-center text-xl mx-auto mb-4">
            💸
          </div>
          <h2 class="text-xl font-bold mb-2">Settle Up</h2>
          <p class="text-body text-sm mb-4 text-mute">Record a cash or online payment to settle a debt.</p>
          
          <form id="settleUpForm" class="flex flex-col gap-3" method="dialog">
            <div class="text-left mb-4">
              <label class="block text-sm font-medium text-ink mb-2">Select debt to settle:</label>
              <div id="settleDebtList" class="flex flex-col gap-2 max-h-48 overflow-y-auto">
                <div class="text-sm text-mute text-center py-4">Loading...</div>
              </div>
              <input type="hidden" id="settleDebtValue" required />
            </div>
            
            <button type="submit" class="w-full bg-primary text-on-primary px-4 py-2 rounded-pill font-medium hover:opacity-90 transition-opacity cursor-pointer">Record Payment</button>
            <button type="button" id="cancelSettleBtn" class="w-full bg-canvas text-ink px-4 py-2 rounded-pill font-medium border border-hairline hover:bg-canvas-soft transition-colors cursor-pointer">Cancel</button>
          </form>
        </div>

        <!-- Success Animation State -->
        <div id="settleUpSuccess" class="hidden flex-col items-center justify-center p-8 text-center h-48 opacity-0 transition-opacity duration-300">
          <div class="w-16 h-16 bg-success rounded-full flex items-center justify-center text-white mb-4 shadow-md animate-[scale-in_0.3s_ease-out]">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
          </div>
          <h3 id="settleUpSuccessText" class="font-bold text-lg text-ink">Payment recorded!</h3>
        </div>
      </div>
    </dialog>

    <!-- Delete Group Modal -->
    <dialog id="deleteGroupModal" class="bg-transparent p-0 m-auto backdrop:bg-black/50 text-ink open:flex flex-col items-center justify-center w-[92vw] sm:w-full max-w-sm z-[9999]">
      <div id="deleteModalContent" class="bg-canvas border border-hairline rounded-lg shadow-lg w-full p-6 text-center transition-all duration-300">
        
        <!-- Normal State -->
        <div id="deleteNormalState" class="flex flex-col items-center">
          <h2 class="text-xl font-bold mb-2 text-ink">Delete Group?</h2>
          <p class="text-body text-sm mb-6 text-mute">Are you sure you want to delete this group? This action cannot be undone and all expenses will be lost.</p>
          <div class="flex gap-3 w-full">
            <button type="button" id="cancelDeleteBtn" class="flex-1 bg-canvas text-ink px-4 py-2 rounded-pill font-medium border border-hairline hover:bg-canvas-soft transition-colors cursor-pointer">Cancel</button>
            <button type="button" id="confirmDeleteBtn" class="flex-1 bg-danger text-white px-4 py-2 rounded-pill font-medium hover:opacity-90 transition-opacity cursor-pointer">Delete</button>
          </div>
        </div>

        <!-- Animation State -->
        <div id="deleteAnimState" class="hidden flex-col items-center justify-center py-4">
          <div class="animate-bounce">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2M10 11v6M14 11v6"/></svg>
          </div>
          <p class="text-danger font-bold mt-4 animate-pulse">Deleting group...</p>
        </div>

      </div>
    </dialog>

    <!-- Group Settings Modal -->
    <dialog id="groupSettingsModal" class="bg-canvas text-ink p-0 m-0 w-full h-full max-w-none max-h-none md:w-[480px] md:h-[90vh] md:m-auto md:rounded-2xl shadow-2xl backdrop:bg-black/50 text-ink overflow-y-auto">
      <!-- Settings Header -->
      <div class="sticky top-0 bg-canvas z-10 border-b border-hairline">
        <div class="flex items-center px-4 h-16">
          <button id="closeSettingsBtn" class="w-10 h-10 flex items-center justify-center -ml-2 rounded-full hover:bg-canvas-soft transition-colors text-ink">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          </button>
          <h2 class="text-lg font-bold ml-2">Group settings</h2>
        </div>
      </div>
      
      <!-- Group Info (Dark Banner) -->
      <div class="bg-[#2C2C2E] p-4 flex items-center justify-between">
        <div class="flex items-center gap-4 text-white">
          <div id="settingsGroupIcon" class="w-14 h-14 rounded-lg bg-[#0a6c51] text-white flex items-center justify-center font-bold text-2xl overflow-hidden relative shadow-sm border border-canvas/20">
            <!-- Icon/Letter inserted via JS -->
          </div>
          <div>
            <h3 id="settingsGroupName" class="text-xl font-bold tracking-tight">Group Name</h3>
            <p id="settingsGroupDate" class="text-sm text-white/70 font-medium">Dates</p>
          </div>
        </div>
