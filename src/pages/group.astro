    // --- Delete Group Logic ---
    const deleteGroupModal = document.getElementById('deleteGroupModal') as HTMLDialogElement;
    const settingsDeleteGroupBtn = document.getElementById('settingsDeleteGroupBtn');
    const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
    const cancelDeleteBtn = document.getElementById('cancelDeleteBtn');
    const deleteModalContent = document.getElementById('deleteModalContent');
    const deleteNormalState = document.getElementById('deleteNormalState');
    const deleteAnimState = document.getElementById('deleteAnimState');

    if (settingsDeleteGroupBtn && deleteGroupModal && confirmDeleteBtn && cancelDeleteBtn) {
      settingsDeleteGroupBtn.addEventListener('click', () => {
        // Reset animation state if any
        if (deleteNormalState) deleteNormalState.classList.remove('hidden');
        if (deleteNormalState) deleteNormalState.classList.add('flex');
        if (deleteAnimState) deleteAnimState.classList.remove('flex');
        if (deleteAnimState) deleteAnimState.classList.add('hidden');
        if (deleteModalContent) deleteModalContent.classList.remove('scale-95');
        
        deleteGroupModal.showModal();
      });
      cancelDeleteBtn.addEventListener('click', () => deleteGroupModal.close());
