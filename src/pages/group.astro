    function renderFeed() {
      if (!activityFeed || !groupData) return;
      const exps = groupData.expenses || [];
      if (exps.length === 0) {
        const emptyHTML = `<div class="p-8 text-center text-mute text-sm">No expenses yet. Add one above!</div>`;
        if (activityFeed.innerHTML !== emptyHTML) {
          activityFeed.innerHTML = emptyHTML;
        }
        return;
      }

      let newHTML = '';
      // Render items
      exps.forEach((exp: any) => {
        const letter = exp.description.charAt(0).toUpperCase();
        
        const paidByName = (window as any).getDisplayName(exp.paidBy);
        let whoPaidText = `<span class="font-medium text-ink">${paidByName}</span> paid ${exp.currency}${exp.amount.toFixed(2)}`;
        
        const participants = exp.participants || groupData.members;
        let splitTextInfo = '';
        if (participants.length === groupData.members.length) {
          splitTextInfo = 'Split for the whole group';
        } else if (participants.length <= 2) {
          splitTextInfo = participants.map((p:string) => (window as any).getDisplayName(p)).join(' and ');
        } else {
          splitTextInfo = `${(window as any).getDisplayName(participants[0])}, ${(window as any).getDisplayName(participants[1])} + ${participants.length - 2} more`;
        }

        const splitAmount = (exp.amount / participants.length).toFixed(2);
        
        let detailsHTML = `<div class="px-6 pb-4 pt-2 bg-canvas-soft border-t border-hairline flex flex-col gap-2 text-sm">`;
        participants.forEach((p: string) => {
          detailsHTML += `
            <div class="flex justify-between items-center text-body">
              <span>${(window as any).getDisplayName(p)}</span>
              <span class="font-medium">${exp.currency}${splitAmount}</span>
            </div>
          `;
        });
        detailsHTML += `</div>`;

        const expDate = new Date(exp.timestamp || Date.now());
        const monthStr = expDate.toLocaleString('default', { month: 'short' });
        const dayStr = expDate.getDate().toString().padStart(2, '0');

        let catIconHTML = `<div class="w-10 h-10 rounded-md bg-canvas border border-hairline flex items-center justify-center text-ink font-bold text-xl shadow-sm shrink-0">${letter}</div>`;
        const categoryData = exp.category || 'Uncategorized.General';
        const [pName, sName] = categoryData.split('.');
        const SPLITWISE_CATEGORIES = (window as any).SPLITWISE_CATEGORIES || [];
        const pCat = SPLITWISE_CATEGORIES.find((c:any) => c.name === pName);
        const sCat = pCat?.subcategories.find((s:any) => s.name === sName);
        if (pCat && sCat) {
          catIconHTML = `<div class="w-10 h-10 rounded-sm border flex items-center justify-center shrink-0 shadow-sm ${pCat.color}"><div class="w-5 h-5">${sCat.icon}</div></div>`;
        }

        const newItemHTML = `
          <details class="group hover:bg-canvas-soft transition-colors cursor-pointer border-b border-hairline last:border-b-0">
            <summary class="p-6 flex items-center justify-between list-none [&::-webkit-details-marker]:hidden">
              <div class="flex items-center gap-3 sm:gap-4">
                <div class="flex flex-col items-center justify-center text-center w-8 shrink-0">
                  <span class="text-[10px] font-bold text-mute uppercase tracking-wider">${monthStr}</span>
                  <span class="text-lg font-medium text-ink leading-none mt-0.5">${dayStr}</span>
                </div>
                ${catIconHTML}
                <div>
                  <h3 class="font-bold text-ink">${exp.description}</h3>
                  <p class="text-sm text-body">${whoPaidText}</p>
                </div>
              </div>
              <div class="text-right">
                <p class="text-xs text-mute font-medium">${splitTextInfo}</p>
                <div class="text-mute group-open:rotate-180 transition-transform mt-1 inline-block">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
                </div>
              </div>
            </summary>
            ${detailsHTML}
          </details>
        `;
        // Since original used insertAdjacentHTML('afterbegin'), prepend to newHTML
        newHTML = newItemHTML + newHTML;
      });
      
      if (activityFeed.innerHTML !== newHTML) {
        activityFeed.innerHTML = newHTML;
      }
    }

    function renderBalances() {
      if (!balancesContainer || !groupData) return;
      const exps = groupData.expenses || [];
      
      // Exact Pairwise Debt Tracking (No simplification)
      const owes: Record<string, Record<string, number>> = {};
      groupData.members.forEach((m: string) => {
        owes[m] = {};
        groupData.members.forEach((n: string) => owes[m][n] = 0);
      });

      exps.forEach((exp: any) => {
        const payer = exp.paidBy;
        const participants = exp.participants || groupData.members;
        const splitAmount = exp.amount / participants.length;
        participants.forEach((m: string) => {
          if (m !== payer && owes[m] && owes[m][payer] !== undefined) {
             owes[m][payer] += splitAmount;
          }
        });
      });

      const transactions: { from: string, to: string, amount: number }[] = [];
      const processedPairs = new Set<string>();

      groupData.members.forEach((m1: string) => {
        groupData.members.forEach((m2: string) => {
          if (m1 !== m2) {
             const pairKey = [m1, m2].sort().join('|');
             if (!processedPairs.has(pairKey)) {
                processedPairs.add(pairKey);
                const m1OwesM2 = owes[m1][m2];
                const m2OwesM1 = owes[m2][m1];
                const net = m1OwesM2 - m2OwesM1;

                if (net > 0.01) {
                   transactions.push({ from: m1, to: m2, amount: net });
                } else if (net < -0.01) {
                   transactions.push({ from: m2, to: m1, amount: -net });
                }
             }
          }
        });
      });

      const myRole = (groupData.roles && groupData.roles[currentUserEmail]) ? groupData.roles[currentUserEmail] : 'viewer';
      const myDisplayName = (window as any).MY_DISPLAY_NAME;

      let settleTransactions = transactions;
      if (myRole !== 'owner') {
        settleTransactions = transactions.filter(t => 
          t.from === myDisplayName || t.to === myDisplayName ||
          t.from === 'You' || t.to === 'You' ||
          t.from === currentUserEmail || t.to === currentUserEmail
        );
      }

      // Populate Settle Up Debt List
      const settleDebtList = document.getElementById('settleDebtList');
      if (settleDebtList) {
        settleDebtList.innerHTML = '';
        if (settleTransactions.length === 0) {
          if (transactions.length > 0) {
            settleDebtList.innerHTML = '<div class="text-sm text-mute text-center py-4">You have no personal debts to settle. Only the group creator can settle debts for others.</div>';
          } else {
            settleDebtList.innerHTML = '<div class="text-sm text-mute text-center py-4">No debts to settle!</div>';
          }
        } else {
          settleTransactions.forEach((t, idx) => {
            const valStr = JSON.stringify(t);
            const label = document.createElement('label');
            label.className = 'cursor-pointer select-none';
            label.innerHTML = `
              <input type="checkbox" name="settleDebtOption" value='${valStr}' class="hidden peer" />
              <div class="px-4 py-3 rounded-md text-sm font-medium border transition-colors
                          border-hairline bg-canvas text-body peer-checked:bg-ink peer-checked:text-canvas peer-checked:border-ink">
                  ${(window as any).getDisplayName(t.from)} pays ${(window as any).getDisplayName(t.to)} <strong>${groupData.currency || '$'}${t.amount.toFixed(2)}</strong>
              </div>
            `;
            settleDebtList.appendChild(label);
          });
        }
      }

      balancesContainer.innerHTML = '';
      if (transactions.length === 0) {
         balancesContainer.innerHTML = `<div class="text-sm text-mute">All settled up!</div>`;
         return;
      }

      transactions.forEach((t) => {
        const isYou = t.to === currentUserEmail; // Someone owes you
        const isFromYou = t.from === currentUserEmail; // You owe someone

        let colorClass = 'text-ink';
        let bgClass = 'bg-canvas-soft border-hairline';
        let letter = t.from.charAt(0).toUpperCase();

        if (isYou) {
          colorClass = 'text-success';
          bgClass = 'bg-success/20 text-success';
          letter = t.from.charAt(0).toUpperCase();
        } else if (isFromYou) {
          colorClass = 'text-danger';
          bgClass = 'bg-danger/20 text-danger';
          letter = t.to.charAt(0).toUpperCase();
        }

        const fromName = (window as any).getDisplayName(t.from);
        const toName = (window as any).getDisplayName(t.to);
        const textHTML = isYou
          ? `<span class="font-medium">${fromName}</span> owes you <span class="${colorClass} font-bold">${groupData.currency || '$'}${t.amount.toFixed(2)}</span>`
          : isFromYou
            ? `You owe <span class="font-medium">${toName}</span> <span class="${colorClass} font-bold">${groupData.currency || '$'}${t.amount.toFixed(2)}</span>`
            : `<span class="font-medium">${fromName}</span> owes <span class="font-medium">${toName}</span> <span class="font-bold">${groupData.currency || '$'}${t.amount.toFixed(2)}</span>`;

        balancesContainer.innerHTML += `
          <div class="flex items-center justify-between text-sm py-1">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full ${bgClass} flex items-center justify-center text-xs font-bold border border-transparent border-opacity-10">${letter}</div>
              <span class="text-ink">${textHTML}</span>
            </div>
          </div>
        `;
      });
    }

    async function syncUsers() {
      try {
        const snap = await getDocs(collection(db, 'users'));
        const usersMap: Record<string, any> = {};
        snap.forEach(d => {
          const data = d.data();
          if (data.email) {
            usersMap[data.email.toLowerCase()] = {
              name: data.name,
              avatar: data.hq_avatar || data.avatar || data.dp || '',
              themeColor: data.themeColor || 'special-art-1',
              gradientTheme: data.gradientTheme || '-1'
            };
          }
        });
        localStorage.setItem('splitbug_users', JSON.stringify(usersMap));
        // Force a UI refresh once the data lands
        if (isGroupLoaded && groupData) {
          initGroupData();
        }
      } catch (e) {
        console.error("Error syncing users:", e);
      }
    }

    // Run user profiles synchronization on page load
    syncUsers();

    if (groupId) {
      groupDocRef = doc(db, 'groups', groupId);
      onSnapshot(groupDocRef, (docSnap) => {
        if (docSnap.exists()) {
          groupData = { id: docSnap.id, ...docSnap.data() };
          isGroupLoaded = true;
          initGroupData();
        } else {
          const t = document.getElementById('groupTitle')!;
          t.textContent = "Group not found";
          t.classList.remove('hidden');
          const s = document.getElementById('groupTitleSkeleton');
          if (s) s.style.display = 'none';
        }
      });
    }

    if (addExpenseForm && activityFeed) {
      addExpenseForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const descInput = document.getElementById('expenseDescription') as HTMLInputElement;
        const amtInput = document.getElementById('expenseAmount') as HTMLInputElement;
        const descLabel = document.getElementById('descLabel');
        const amtLabel = document.getElementById('amountLabel');

        let hasError = false;

        const showError = (input: HTMLElement, label: HTMLElement | null) => {
          input.classList.add('shake-error', '!border-red-500');
          if (label) label.classList.add('!text-red-500', 'shake-error');
          setTimeout(() => {
            input.classList.remove('shake-error', '!border-red-500');
            if (label) label.classList.remove('!text-red-500', 'shake-error');
          }, 3000);
        };

        if (!descInput.value.trim()) {
          showError(descInput, descLabel);
          hasError = true;
        }
        if (!amtInput.value || parseFloat(amtInput.value) <= 0) {
          showError(amtInput.parentElement || amtInput, amtLabel);
          hasError = true;
        }

        if (hasError) return;

        const desc = descInput.value.trim();
        const amount = parseFloat(amtInput.value);
        const curr = currencySymbol?.textContent || '$';
        const paidByBtn = document.getElementById('paidByBtn');
        const paidBy = paidByBtn?.dataset.value || groupData.members[0];

        // Gather participants from checkboxes
        const checkboxes = document.querySelectorAll('.split-participant-checkbox:checked') as NodeListOf<HTMLInputElement>;
        let participants: string[] = [];
        checkboxes.forEach(cb => participants.push(cb.value));

        if (participants.length === 0) {
          showToast('You must select at least one person to split with.', true);
          return;
        }

        const expenseCategoryValue = document.getElementById('expenseCategoryValue') as HTMLInputElement;

        // Save to Firestore
        const newExpense = {
          id: Date.now().toString(),
          description: desc,
          category: expenseCategoryValue ? expenseCategoryValue.value : 'Uncategorized.General',
          amount: amount,
          paidBy: paidBy,
          participants: participants,
          splitAmong: participants.length,
          currency: curr,
          timestamp: Date.now()
        };

        const submitBtn = addExpenseForm.querySelector('button[type="submit"]') as HTMLButtonElement;
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Saving...';
        }

        (async () => {
          try {
            await updateDoc(groupDocRef, {
              expenses: arrayUnion(newExpense)
            });

            // Add notifications for involved participants
            const payerName = paidBy === currentUserEmail || paidBy === (window as any).MY_DISPLAY_NAME || paidBy === 'You' ? (window as any).MY_DISPLAY_NAME : (window as any).getDisplayName(paidBy);
            
            for (const p of participants) {
              if (p === currentUserEmail || p === paidBy || p === (window as any).MY_DISPLAY_NAME || p === 'You') continue;
              await addDoc(collection(db, "users", p, "notifications"), {
                groupId: groupId,
                message: `${payerName} added the expense "${desc}" in "${groupData.name}".`,
                timestamp: Date.now(),
                read: false
              });
            }

            // Add persistent activity
            await addDoc(collection(db, "activities"), {
              groupId: groupId,
              groupName: groupData.name,
              type: 'expense_added',
              description: desc,
              amount: amount,
              currency: curr,
              paidBy: paidBy,
              participants: participants,
              timestamp: Date.now()
            });

            // Reset and close
            resetAddExpenseModal();
            addExpenseModal?.close();
            showToast('Expense added successfully!', false);
          } catch (error) {
            console.error("Error adding expense:", error);
            showToast('Failed to add expense.', true);
          } finally {
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = 'Add Expense';
            }
          }
        })();
      });
    }

    // --- Category Picker JS ---
    const expenseCategoryBtn = document.getElementById('expenseCategoryBtn') as HTMLButtonElement;
    const categoryPickerModal = document.getElementById('categoryPickerModal') as HTMLDialogElement;
    const closeCategoryPickerBtn = document.getElementById('closeCategoryPickerBtn');
    const categorySearchInput = document.getElementById('categorySearchInput') as HTMLInputElement;
    const categoryListContainer = document.getElementById('categoryListContainer');
    const expenseCategoryValue = document.getElementById('expenseCategoryValue') as HTMLInputElement;

    const SPLITWISE_CATEGORIES = (window as any).SPLITWISE_CATEGORIES || [];
    let flatCategories: any[] = [];
    SPLITWISE_CATEGORIES.forEach((cat: any) => {
      cat.subcategories.forEach((sub: any) => {
        flatCategories.push({
          parentName: cat.name,
          color: cat.color,
          name: sub.name,
          icon: sub.icon,
          id: `${cat.name}.${sub.name}`
        });
      });
    });

    function renderCategoryList(filterText = '') {
      if (!categoryListContainer) return;
      categoryListContainer.innerHTML = '';
      const filter = filterText.toLowerCase();

      SPLITWISE_CATEGORIES.forEach((cat: any) => {
        const matchingSubs = cat.subcategories.filter((sub: any) => 
          sub.name.toLowerCase().includes(filter) || cat.name.toLowerCase().includes(filter)
        );
        if (matchingSubs.length === 0) return;

        const groupDiv = document.createElement('div');
        groupDiv.innerHTML = `<h3 class="text-sm font-bold text-mute uppercase tracking-wider mb-2">${cat.name}</h3>`;
        
        const listDiv = document.createElement('div');
        listDiv.className = 'flex flex-col gap-1';
        matchingSubs.forEach((sub: any) => {
          const itemBtn = document.createElement('button');
          itemBtn.type = 'button';
          itemBtn.className = 'w-full flex items-center gap-4 p-2 hover:bg-canvas-soft rounded-lg transition-colors text-left';
          itemBtn.innerHTML = `
            <div class="w-10 h-10 rounded-sm flex items-center justify-center shrink-0 border ${cat.color}">
              <div class="w-5 h-5">${sub.icon}</div>
            </div>
            <span class="text-ink text-base">${sub.name}</span>
          `;
          itemBtn.addEventListener('click', () => {
            selectCategory(cat, sub, true);
            categoryPickerModal.close();
          });
          listDiv.appendChild(itemBtn);
        });
        groupDiv.appendChild(listDiv);
        categoryListContainer.appendChild(groupDiv);
      });
    }

    function selectCategory(cat: any, sub: any, updateDescription = false) {
      if (expenseCategoryValue) expenseCategoryValue.value = `${cat.name}.${sub.name}`;
      if (expenseCategoryBtn) {
        expenseCategoryBtn.className = `w-10 h-10 flex items-center justify-center border rounded-sm flex-shrink-0 transition-colors ${cat.color}`;
        expenseCategoryBtn.innerHTML = `<div class="w-5 h-5">${sub.icon}</div>`;
      }
      if (updateDescription && expenseDescription) {
        expenseDescription.value = sub.name;
      }
    }

    if (expenseCategoryBtn && categoryPickerModal) {
      expenseCategoryBtn.addEventListener('click', () => {
        categorySearchInput.value = '';
        renderCategoryList();
        categoryPickerModal.showModal();
      });
    }
    if (closeCategoryPickerBtn) {
      closeCategoryPickerBtn.addEventListener('click', () => categoryPickerModal.close());
    }
    if (categorySearchInput) {
      categorySearchInput.addEventListener('input', (e) => {
        renderCategoryList((e.target as HTMLInputElement).value);
      });
    }

    // Auto-detect category on typing
    if (expenseDescription) {
      function resetToUncategorized() {
        const parent = SPLITWISE_CATEGORIES.find((c: any) => c.name === 'Uncategorized');
        if (parent) {
          const sub = parent.subcategories.find((s: any) => s.name === 'General');
          if (sub) selectCategory(parent, sub, false);
        }
      }

      expenseDescription.addEventListener('input', (e) => {
        const val = (e.target as HTMLInputElement).value.toLowerCase().trim();
        if (val.length < 2) {
          resetToUncategorized();
          return; 
        }
        
        // Find exact match first, then partial match
        let match = flatCategories.find(c => val === c.name.toLowerCase());
        if (!match) {
          match = flatCategories.find(c => {
            const n = c.name.toLowerCase();
            if (val.includes(n)) return true;
            if (n.includes('/')) {
              return n.split('/').some(p => p.length >= 2 && val.includes(p));
            }
            return false;
          });
        }
        
        if (match) {
          const parent = SPLITWISE_CATEGORIES.find((c: any) => c.name === match.parentName);
          const sub = parent.subcategories.find((s: any) => s.name === match.name);
          selectCategory(parent, sub, false);
        } else {
          resetToUncategorized();
        }
      });
    }

    // --- Group Settings JS ---
    const groupSettingsBtn = document.getElementById('groupSettingsBtn');
    const groupSettingsModal = document.getElementById('groupSettingsModal') as HTMLDialogElement;
    const closeSettingsBtn = document.getElementById('closeSettingsBtn');
    
    function renderSettings() {
      if (!groupData) return;
      document.getElementById('settingsGroupName')!.textContent = groupData.name;
      
      const dateText = document.getElementById('settingsGroupDate')!;
      if (groupData.startDate && groupData.endDate) {
        const s = new Date(groupData.startDate);
        const e = new Date(groupData.endDate);
        const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
        let dateStr = `${monthNames[s.getMonth()]} ${s.getDate()}`;
        if (s.getMonth() === e.getMonth() && s.getFullYear() === e.getFullYear()) {
          dateStr += ` - ${e.getDate()}`;
        } else {
          dateStr += ` - ${monthNames[e.getMonth()]} ${e.getDate()}`;
        }
        if (s.getFullYear() !== new Date().getFullYear()) dateStr += `, ${s.getFullYear()}`;
        dateText.textContent = dateStr;
        dateText.classList.remove('hidden');
      } else {
        dateText.classList.add('hidden');
      }

      // Watermark/Icon
      const settingsIcon = document.getElementById('settingsGroupIcon')!;
      const typeIcons: any = {
        'Trip': `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.2-1.1.6l-1 2c-.3.6.1 1.2.7 1.5l5.5 2.5-3.5 3.5-3.1-.8c-.4-.1-.8.2-1 .5L0 18l5.5 1.5L7 25l2-1c.3-.2.6-.6.5-1l-.8-3.1 3.5-3.5 2.5 5.5c.3.6 1 .9 1.5.7l2-1c.4-.2.7-.6.6-1.1z"/></svg>`,
        'Home': `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
        'Couple': `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`
      };
      if (groupData.type && typeIcons[groupData.type]) {
        settingsIcon.innerHTML = typeIcons[groupData.type];
      } else {
        settingsIcon.innerHTML = groupData.name.charAt(0).toUpperCase();
      }

      // Calculate individual balances
      let balances: any = {};
      groupData.members.forEach((m: string) => balances[m] = 0);
      const exps = groupData.expenses || [];
      exps.forEach((exp: any) => {
        balances[exp.paidBy] += exp.amount;
        const participants = exp.participants || groupData.members;
        const splitAmount = exp.amount / participants.length;
        participants.forEach((m: string) => {
          balances[m] -= splitAmount;
        });
      });

      const membersList = document.getElementById('settingsMembersList')!;
      membersList.innerHTML = '';
      
      const curr = groupData.currency || '$';
      const bgColors = ['bg-[#b2dfdb] text-ink', 'bg-success/20 text-success', 'bg-warning/20 text-warning', 'bg-danger/20 text-danger'];

      // Setup global click listener for member dropdowns
      if (!(window as any).clickListenerAdded) {
        document.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          if (target && !target.closest('.member-dropdown-container')) {
             document.querySelectorAll('.member-dropdown-menu').forEach(menu => menu.classList.add('hidden'));
          }
        });
        (window as any).clickListenerAdded = true;
      }

      // Prepare pending invites map for quick lookup
      const GLOBAL_INVITES_KEY = 'splitsbug_global_invites';
      const invitesDataStr = localStorage.getItem(GLOBAL_INVITES_KEY);
      const invitesData = invitesDataStr ? JSON.parse(invitesDataStr) : { invites: [] };
      const pendingInvitesMap: Record<string, any> = {};
      invitesData.invites.forEach((inv: any) => {
        if (inv.groupId === groupId && inv.status === 'pending') {
          pendingInvitesMap[inv.memberId] = inv;
        }
      });

      const getDisplayNameStr = (m: string) => {
        const isYou = m === currentUserEmail;
        return isYou ? (window as any).MY_DISPLAY_NAME || 'You' : (window as any).getDisplayName(m);
      };

      const sortedMembers = [...groupData.members].sort((a, b) => {
        const roleA = groupData.roles?.[a] || 'member';
        const roleB = groupData.roles?.[b] || 'member';
        
        const isAdminA = roleA === 'owner';
        const isAdminB = roleB === 'owner';
        
        if (isAdminA && !isAdminB) return -1;
        if (!isAdminA && isAdminB) return 1;

        const isJoinedA = a.includes('@') && !pendingInvitesMap[a];
        const isJoinedB = b.includes('@') && !pendingInvitesMap[b];

        if (isJoinedA && !isJoinedB) return -1;
        if (!isJoinedA && isJoinedB) return 1;

        const nameA = getDisplayNameStr(a).toLowerCase();
        const nameB = getDisplayNameStr(b).toLowerCase();
        return nameA.localeCompare(nameB);
      });

      sortedMembers.forEach((m: string) => {
        const i = groupData.members.indexOf(m);
        const bal = balances[m] || 0;
        const isYou = m === currentUserEmail;
        const displayName = isYou ? (window as any).MY_DISPLAY_NAME || 'You' : (window as any).getDisplayName(m);
        
        const isRegisteredUser = m.includes('@');
        
        let avatarHtml = '';
        if (isRegisteredUser) {
          const tempDiv = document.createElement('div');
          (window as any).updateAvatarNode(tempDiv, m, displayName, "w-10 h-10 text-sm");
          avatarHtml = tempDiv.outerHTML;
        } else {
          const letter = displayName.charAt(0).toUpperCase();
          const colorClass = bgColors[i % bgColors.length];
          avatarHtml = `<div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm ${colorClass} shrink-0 uppercase">${letter}</div>`;
        }
        
        let statusHtml = `<span class="text-xs font-medium text-mute uppercase">settled up</span><span class="font-bold text-ink">${curr}0.00</span>`;
        if (bal > 0.01) {
          statusHtml = `<span class="text-[10px] font-bold text-success uppercase">gets back</span><span class="font-bold text-success">${curr}${bal.toFixed(2)}</span>`;
        } else if (bal < -0.01) {
          statusHtml = `<span class="text-[10px] font-bold text-warning uppercase">owes</span><span class="font-bold text-warning">${curr}${Math.abs(bal).toFixed(2)}</span>`;
        }

        let actionsHtml = '';
        let roleText = groupData.roles?.[m] || 'Member';
        if (roleText === 'owner') roleText = 'Admin';
        
        let memberRoleText = `<span class="text-xs text-mute mt-0.5 capitalize">${roleText}</span>`;
        const myDisplayName = (window as any).MY_DISPLAY_NAME;
        const resolvedMyRole = groupData.roles?.[currentUserEmail] || (myDisplayName && groupData.roles?.[myDisplayName]);

        if (isYou && resolvedMyRole) {
           let displayRole = resolvedMyRole;
           if (displayRole === 'owner') displayRole = 'Admin';
           memberRoleText = `<span class="text-xs text-mute mt-0.5 capitalize">${displayRole}</span>`;
        }
        
        const currentUserRole = resolvedMyRole || 'editor';
        const canManageMembers = groupData.memberPermissions === 'all' || currentUserRole === 'owner' || currentUserRole === 'admin';

        if (!isYou && canManageMembers) {
          // Check for pending invites
          const pendingInvite = pendingInvitesMap[m];

          if (pendingInvite) {
            memberRoleText = `<span class="text-xs text-mute mt-0.5 capitalize">${pendingInvite.role}</span>`;
            actionsHtml = `
              <div class="relative ml-2">
                <button onclick="window.openInviteModal('${m}', '${pendingInvite.inviteeEmail}', '${pendingInvite.role}', 'reinvite')" class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-brand/10 text-mute hover:text-brand transition-colors" title="Options">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
                </button>
              </div>
            `;
          } else if (isRegisteredUser) {
            actionsHtml = `
              <div class="relative ml-2">
                <button onclick="window.openInviteModal('${m}', '${m}', '${groupData.roles?.[m] || 'viewer'}', 'manage')" class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-brand/10 text-mute hover:text-brand transition-colors" title="Options">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
                </button>
              </div>
            `;
          } else {
            actionsHtml = `
              <div class="relative ml-2">
                <button onclick="window.openInviteModal('${m}', '', '', 'invite')" class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-brand/10 text-mute hover:text-brand transition-colors" title="Invite">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
                </button>
              </div>
            `;
          }
        }

        membersList.innerHTML += `
          <div class="flex items-center gap-4 px-2 py-3 hover:bg-canvas-soft rounded-lg transition-colors group">
            ${avatarHtml}
            <div class="flex-1 flex flex-col justify-center">
              <span class="text-body font-bold text-ink leading-tight">${displayName}</span>
              ${memberRoleText}
            </div>
            <div class="flex flex-col items-end justify-center leading-tight">
              ${statusHtml}
            </div>
            ${actionsHtml}
          </div>
        `;
      });

      // Attach dropdown listeners now that HTML is set
      membersList.querySelectorAll('.member-dropdown-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          document.querySelectorAll('.member-dropdown-menu').forEach(menu => {
            if (menu !== btn.nextElementSibling) menu.classList.add('hidden');
          });
          btn.nextElementSibling?.classList.toggle('hidden');
        });
      });
    }

    if (groupSettingsBtn && groupSettingsModal) {
      groupSettingsBtn.addEventListener('click', () => {
        renderSettings();
        groupSettingsModal.showModal();
      });
      closeSettingsBtn?.addEventListener('click', () => groupSettingsModal.close());
    }

    const stickySettingsBtn = document.getElementById('stickySettingsBtn');
    if (stickySettingsBtn && groupSettingsModal) {
      stickySettingsBtn.addEventListener('click', () => {
        renderSettings();
        groupSettingsModal.showModal();
      });
    }

    // Scroll listener for sticky top bar
    window.addEventListener('scroll', () => {
      const stickyTopBar = document.getElementById('stickyTopBar');
      if (stickyTopBar) {
        if (window.scrollY > 80) {
          stickyTopBar.classList.remove('-translate-y-full', 'opacity-0', 'pointer-events-none');
          stickyTopBar.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
        } else {
          stickyTopBar.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
          stickyTopBar.classList.add('-translate-y-full', 'opacity-0', 'pointer-events-none');
        }
      }
    });

    // --- Manage Members JS ---
    const addPeopleBtn = document.getElementById('addPeopleBtn');
    const addMemberModal = document.getElementById('addMemberModal') as HTMLDialogElement;
    const addMemberForm = document.getElementById('addMemberForm') as HTMLFormElement;
    const newMemberName = document.getElementById('newMemberName') as HTMLInputElement;
    const manageMembersTags = document.getElementById('manageMembersTags');
    
    let tempMembers: string[] = [];
    let displayMembers: string[] = [];

    function renderManageMembersTags() {
      if (!manageMembersTags || !groupData) return;
      manageMembersTags.innerHTML = '';
      
      // Calculate balances to know if we can remove someone
      let balances: any = {};
      groupData.members.forEach((m: string) => balances[m] = 0);
      const exps = groupData.expenses || [];
      exps.forEach((exp: any) => {
        balances[exp.paidBy] = (balances[exp.paidBy] || 0) + exp.amount;
        const participants = exp.participants || groupData.members;
        const splitAmount = exp.amount / participants.length;
        participants.forEach((m: string) => {
          balances[m] = (balances[m] || 0) - splitAmount;
        });
      });

      displayMembers.forEach((member) => {
        const isYou = member === (window as any).MY_DISPLAY_NAME || member === 'You';
        const isOldMember = groupData.members.includes(member);
        const isActive = tempMembers.includes(member);
        
        const pill = document.createElement('button');
        pill.type = 'button';
        
        // If active, normal black. If inactive (deselected old member), white/grey styling.
        if (isActive) {
          pill.className = 'flex items-center gap-1.5 px-4 py-2 bg-[#1A1A1A] text-white border border-[#1A1A1A] rounded-full text-[15px] font-medium hover:opacity-90 transition-opacity shrink-0';
        } else {
          pill.className = 'flex items-center gap-1.5 px-4 py-2 bg-canvas text-mute border border-hairline rounded-full text-[15px] font-medium hover:bg-canvas-soft transition-colors shrink-0';
        }
        
        // NO cross icon for new members or old members per user request. 
        // Deselected members just change color.
        pill.innerHTML = `<span>${isYou ? (window as any).MY_DISPLAY_NAME : member}</span>`;

        if (!isYou) {
          pill.addEventListener('click', () => {
            if (isOldMember) {
              if (isActive) {
                // Trying to deselect
                const bal = balances[member] || 0;
                if (Math.abs(bal) > 0.01) {
                  const errModal = document.getElementById('errorModal') as HTMLDialogElement;
                  const errMsg = document.getElementById('errorModalMsg');
                  if (errModal && errMsg) {
                    errMsg.textContent = `Cannot remove ${member} because they have an outstanding balance.`;
                    errModal.showModal();
                  }
                  return;
                }
                tempMembers = tempMembers.filter(m => m !== member);
              } else {
                // Reselecting an old member
                tempMembers.push(member);
              }
            } else {
              // New member, completely remove them instantly
              tempMembers = tempMembers.filter(m => m !== member);
              displayMembers = displayMembers.filter(m => m !== member);
            }
            renderManageMembersTags();
          });
        }
        
        manageMembersTags.appendChild(pill);
      });
    }

    if (addPeopleBtn && addMemberModal) {
      addPeopleBtn.addEventListener('click', () => {
        if (!groupData) return;
        tempMembers = [...groupData.members];
        displayMembers = [...groupData.members];
        if (newMemberName) newMemberName.value = '';
        renderManageMembersTags();
        addMemberModal.showModal();
      });
      
      addMemberModal.addEventListener('click', (e) => {
        const d = addMemberModal.getBoundingClientRect();
        if (e.clientX < d.left || e.clientX > d.right || e.clientY < d.top || e.clientY > d.bottom) addMemberModal.close();
      });

      const handleAddMember = () => {
        let name = newMemberName.value.trim();
        if (name) {
          let baseName = name;
          let counter = 2;
          while (displayMembers.includes(name)) {
            name = `${baseName} (${counter})`;
            counter++;
          }
          displayMembers.push(name);
          tempMembers.push(name);
          newMemberName.value = '';
          renderManageMembersTags();
        }
      };

      if (newMemberName) {
        newMemberName.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            handleAddMember();
          }
        });
      }

      addMemberForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        handleAddMember();

        if (groupData) {
          const submitBtn = addMemberForm.querySelector('button[type="submit"]') as HTMLButtonElement;
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = 'Adding...';
          }

          try {
            await updateDoc(groupDocRef, {
              members: [...tempMembers]
            });
            showToast("Members updated successfully!", false);
          } catch (error) {
            console.error("Error updating members:", error);
            showToast("Failed to update members.", true);
          } finally {
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = 'Add Member';
            }
            addMemberModal.close();
          }
        }
      });
    }

    // --- Edit Group JS ---
    const editGroupBtn = document.getElementById('editGroupBtn');
    const editGroupModal = document.getElementById('editGroupModal') as HTMLDialogElement;
    const closeEditGroupBtn = document.getElementById('closeEditGroupBtn');
    const editGroupForm = document.getElementById('editGroupForm') as HTMLFormElement;
    const editGroupNameInput = document.getElementById('editGroupName') as HTMLInputElement;
    const editGroupTypeInput = document.getElementById('editGroupType') as HTMLInputElement;
    const editTypeButtons = document.querySelectorAll('.edit-group-type-btn');
    const editIconBox = document.getElementById('editGroupIconBox');

    // Dates for Edit
    const editAddDatesToggle = document.getElementById('editAddDatesToggle') as HTMLInputElement;
    const editDatesContainerWrapper = document.getElementById('editDatesContainerWrapper');
    const editTripStartDate = document.getElementById('editTripStartDate') as HTMLInputElement;
    const editTripEndDate = document.getElementById('editTripEndDate') as HTMLInputElement;
    const editStartCalDisplay = document.getElementById('editStartCalDisplay');
    const editEndCalDisplay = document.getElementById('editEndCalDisplay');

    if (editAddDatesToggle && editDatesContainerWrapper) {
      editAddDatesToggle.addEventListener('change', (e) => {
        const isChecked = (e.target as HTMLInputElement).checked;
        if (isChecked) {
          editDatesContainerWrapper.classList.remove('grid-rows-[0fr]');
          editDatesContainerWrapper.classList.add('grid-rows-[1fr]');
          if (!editTripStartDate.value) editTripStartDate.value = new Date().toISOString().split('T')[0];
        } else {
          editDatesContainerWrapper.classList.remove('grid-rows-[1fr]');
          editDatesContainerWrapper.classList.add('grid-rows-[0fr]');
          editTripStartDate.value = '';
          editTripEndDate.value = '';
          if(editStartCalDisplay) editStartCalDisplay.value = 'Today';
          if(editEndCalDisplay) editEndCalDisplay.value = '';
        }
      });
    }

    // Auto-formatting for date inputs
    function formatGroupDateInput(e: Event) {
      const input = e.target as HTMLInputElement;
      let val = input.value;
      
      // Allow 'Today' bypass for start date
      if (val.toLowerCase() === 'today') return;

      // Remove non-digits
      let clean = val.replace(/\D/g, '');
      if (clean.length > 8) clean = clean.slice(0, 8);
      
      let formatted = clean;
      if (clean.length >= 3) {
        formatted = clean.slice(0, 2) + '/' + clean.slice(2);
      }
      if (clean.length >= 5) {
        formatted = formatted.slice(0, 5) + '/' + clean.slice(4);
      }
      input.value = formatted;
      
      // Sync to hidden inputs if full date is entered (DD/MM/YYYY)
      if (clean.length === 8) {
        const dd = clean.slice(0,2);
        const mm = clean.slice(2,4);
        const yyyy = clean.slice(4,8);
        const hiddenInputId = input.id === 'editStartCalDisplay' ? 'editTripStartDate' : 'editTripEndDate';
        const hiddenInput = document.getElementById(hiddenInputId) as HTMLInputElement;
        if (hiddenInput) {
          hiddenInput.value = `${yyyy}-${mm}-${dd}`;
        }
      }
    }

    if (editStartCalDisplay) {
      editStartCalDisplay.addEventListener('input', formatGroupDateInput);
      editStartCalDisplay.addEventListener('change', (e) => {
        const val = (e.target as HTMLInputElement).value;
        if (val.toLowerCase() === 'today') {
          editTripStartDate.value = new Date().toISOString().split('T')[0];
        }
      });
    }
    if (editEndCalDisplay) editEndCalDisplay.addEventListener('input', formatGroupDateInput);

    if (editGroupNameInput && editIconBox) {
      editGroupNameInput.addEventListener('input', () => {
        const val = editGroupNameInput.value.trim();
        const type = editGroupTypeInput ? editGroupTypeInput.value : 'Trip';
        if (val.length > 0) {
          const colors = getGroupColor(type, val);
          editIconBox.innerHTML = val.charAt(0).toUpperCase();
          editIconBox.className = 'w-16 h-16 shrink-0 rounded-xl border border-hairline flex items-center justify-center text-2xl font-bold transition-colors shadow-sm';
          editIconBox.style.backgroundColor = colors.dark + '30'; // slightly transparent dark color for light background
          editIconBox.style.color = colors.dark;
        } else {
          editIconBox.innerHTML = `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-mute"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>`;
          editIconBox.className = 'w-16 h-16 shrink-0 rounded-xl border border-hairline bg-canvas-soft flex items-center justify-center text-2xl font-bold text-mute transition-colors shadow-sm';
          editIconBox.style.backgroundColor = '';
          editIconBox.style.color = '';
        }
      });
    }

    editTypeButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const selectedType = btn.getAttribute('data-type');
        if (selectedType && editGroupTypeInput) editGroupTypeInput.value = selectedType;
        
        editTypeButtons.forEach(b => {
          const t = b.getAttribute('data-type') || 'Other';
          if (b === btn) {
            b.className = `edit-group-type-btn flex flex-col items-center justify-center p-3 rounded-lg border transition-colors ${typeColorMap[t]}`;
          } else {
            b.className = 'edit-group-type-btn flex flex-col items-center justify-center p-3 rounded-lg border border-hairline bg-canvas text-mute transition-colors hover:bg-canvas-soft';
          }
        });
        
        editGroupNameInput.dispatchEvent(new Event('input')); // trigger icon color update
      });
    });

    if (editGroupBtn && editGroupModal) {
      editGroupBtn.addEventListener('click', () => {
        if (!groupData) return;
        editGroupNameInput.value = groupData.name;
        editGroupTypeInput.value = groupData.type || 'Trip';
        
        // Trigger visual update for name icon
        editGroupNameInput.dispatchEvent(new Event('input'));
        
        // Trigger visual update for type buttons
        const typeBtn = document.querySelector(`.edit-group-type-btn[data-type="${groupData.type || 'Trip'}"]`) as HTMLButtonElement;
        if(typeBtn) typeBtn.click();

        if (groupData.startDate) {
          editAddDatesToggle.checked = true;
          editDatesContainerWrapper?.classList.remove('grid-rows-[0fr]');
          editDatesContainerWrapper?.classList.add('grid-rows-[1fr]');
          editTripStartDate.value = groupData.startDate;
          editTripEndDate.value = groupData.endDate || '';
          // We could parse these to make them pretty, but for MVP just showing the ISO date string is okay
          if(editStartCalDisplay) (editStartCalDisplay as HTMLInputElement).value = groupData.startDate.split('-').reverse().join('/') || '';
          if(editEndCalDisplay) (editEndCalDisplay as HTMLInputElement).value = groupData.endDate ? groupData.endDate.split('-').reverse().join('/') : '';
        } else {
          editAddDatesToggle.checked = false;
          editDatesContainerWrapper?.classList.remove('grid-rows-[1fr]');
          editDatesContainerWrapper?.classList.add('grid-rows-[0fr]');
          editTripStartDate.value = '';
          editTripEndDate.value = '';
        }

        editGroupModal.showModal();
      });
      closeEditGroupBtn?.addEventListener('click', () => editGroupModal.close());
      
      editGroupForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if(!groupData) return;
        
        const newName = editGroupNameInput.value.trim();
        const newType = editGroupTypeInput.value;
        let newStart = null;
        let newEnd = null;
        
        if (editAddDatesToggle.checked) {
          newStart = editTripStartDate.value;
          newEnd = editTripEndDate.value;
        }

        const submitBtn = editGroupForm.querySelector('button[type="submit"]') as HTMLButtonElement;
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Saving...';
        }

        try {
          await updateDoc(groupDocRef, {
            name: newName,
            type: newType,
            startDate: newStart,
            endDate: newEnd
          });

          // Add persistent activity
          await addDoc(collection(db, "activities"), {
            groupId: groupId,
            groupName: newName,
            type: 'group_edited',
            description: 'Updated group details',
            amount: 0,
            currency: '',
            paidBy: currentUserEmail,
            participants: [],
            timestamp: Date.now()
          });

          editGroupModal.close();
          showToast("Group updated successfully!", false);
        } catch (error) {
          console.error("Error updating group:", error);
          showToast("Failed to update group.", true);
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Save Changes';
          }
        }
        
        initGroupData();
        renderSettings(); // update the modal underneath
      });
    }

    const editStartCalToggle = document.getElementById('editStartCalToggle');
    const editEndCalToggle = document.getElementById('editEndCalToggle');

    // Calendar Picker Dialog logic reused from dashboard
    const calDialog    = document.getElementById('calPickerDialog') as HTMLDialogElement;
    const calPrevBtn   = document.getElementById('calPrevMonth')!;
    const calNextBtn   = document.getElementById('calNextMonth')!;
    const calMonthBtn  = document.getElementById('calMonthBtn')!;
    const calYearBtn   = document.getElementById('calYearBtn')!;
    const calDayView   = document.getElementById('calDayView')!;
    const calDayGrid   = document.getElementById('calDayGrid')!;
    const calMonthView = document.getElementById('calMonthView')!;
    const calMonthGrid = document.getElementById('calMonthGrid')!;
    const calYearView  = document.getElementById('calYearView')!;
    const calYearList  = document.getElementById('calYearList')!;
    const calCancelBtn = document.getElementById('calCancelBtn')!;
    const calOkBtn     = document.getElementById('calOkBtn')!;

    const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
    const SHORT_MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

    let calTargetDisplay: HTMLElement | null = null;
    let calTargetInput: HTMLInputElement | null = null;
    let calYear  = new Date().getFullYear();
    let calMonth = new Date().getMonth();
    let calSelectedDate: Date | null = null;
    let calView: 'day' | 'month' | 'year' = 'day';

    function calShowView(v: 'day' | 'month' | 'year') {
      calView = v;
      if(calDayView) calDayView.classList.toggle('hidden', v !== 'day');
      if(calMonthView) calMonthView.classList.toggle('hidden', v !== 'month');
      if(calYearView) calYearView.classList.toggle('hidden', v !== 'year');
      if(calPrevBtn) calPrevBtn.style.visibility = v === 'day' ? 'visible' : 'hidden';
      if(calNextBtn) calNextBtn.style.visibility = v === 'day' ? 'visible' : 'hidden';
    }

    function calUpdateHeader() {
      if(calMonthBtn) calMonthBtn.textContent = MONTHS[calMonth];
      if(calYearBtn) calYearBtn.textContent  = String(calYear);
    }

    function calRenderDays() {
      calUpdateHeader();
      const today    = new Date();
      const firstDay = new Date(calYear, calMonth, 1).getDay();
      const daysInM  = new Date(calYear, calMonth + 1, 0).getDate();
      if(calDayGrid) calDayGrid.innerHTML = '';
      for (let i = 0; i < firstDay; i++) {
        calDayGrid?.appendChild(document.createElement('div'));
      }
      for (let d = 1; d <= daysInM; d++) {
        const btn = document.createElement('button');
        btn.type = 'button';
        const thisDate = new Date(calYear, calMonth, d);
        const isToday    = thisDate.toDateString() === today.toDateString();
        const isSelected = calSelectedDate && thisDate.toDateString() === calSelectedDate.toDateString();
        btn.textContent = String(d);
        btn.className = [
          'w-8 h-8 mx-auto flex items-center justify-center rounded-full text-xs font-medium transition-all cursor-pointer cal-day-btn',
          isSelected ? 'bg-brand text-white shadow-sm'
          : isToday  ? 'border border-brand text-brand hover:bg-brand/10'
                     : 'text-ink hover:bg-canvas-soft'
        ].join(' ');
        
        // Add data attributes for OK button to read
        btn.setAttribute('data-year', String(calYear));
        btn.setAttribute('data-month', String(calMonth + 1));
        btn.setAttribute('data-day', String(d));
        
        btn.addEventListener('click', () => {
          calSelectedDate = thisDate;
          calRenderDays();
        });
        calDayGrid?.appendChild(btn);
      }
    }

    function calRenderMonths() {
      calUpdateHeader();
      if(calMonthGrid) calMonthGrid.innerHTML = '';
      SHORT_MONTHS.forEach((m, i) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = m;
        btn.className = [
          'py-2 rounded-lg text-sm font-medium transition-colors cursor-pointer',
          i === calMonth ? 'bg-brand text-white' : 'text-ink hover:bg-canvas-soft'
        ].join(' ');
        btn.addEventListener('click', () => {
          calMonth = i;
          calRenderDays();
          calShowView('day');
        });
        calMonthGrid?.appendChild(btn);
      });
    }

    function calRenderYears() {
      calUpdateHeader();
      if(calYearList) calYearList.innerHTML = '';
      const startYear = calYear - 50;
      for (let y = startYear; y <= calYear + 20; y++) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = String(y);
        btn.className = [
          'w-full text-center py-1.5 rounded-lg text-sm font-medium transition-colors cursor-pointer',
          y === calYear ? 'bg-brand text-white' : 'text-ink hover:bg-canvas-soft'
        ].join(' ');
        btn.addEventListener('click', () => {
          calYear = y;
          calRenderDays();
          calShowView('day');
        });
        calYearList?.appendChild(btn);
        if (y === calYear) {
          setTimeout(() => btn.scrollIntoView({ block: 'center' }), 10);
        }
      }
    }

    if(calPrevBtn) calPrevBtn.addEventListener('click', () => {
      calMonth--; if (calMonth < 0) { calMonth = 11; calYear--; }
      calRenderDays();
    });
    if(calNextBtn) calNextBtn.addEventListener('click', () => {
      calMonth++; if (calMonth > 11) { calMonth = 0; calYear++; }
      calRenderDays();
    });
    if(calMonthBtn) calMonthBtn.addEventListener('click', () => { calRenderMonths(); calShowView('month'); });
    if(calYearBtn) calYearBtn.addEventListener('click',  () => { calRenderYears();  calShowView('year');  });
    if(calCancelBtn) calCancelBtn.addEventListener('click', () => calDialog?.close());
    
    if (calOkBtn) {
      calOkBtn.addEventListener('click', () => {
        if (!calSelectedDate || !calTargetDisplay || !calTargetInput) { calDialog?.close(); return; }
        const today = new Date();
        const isToday = calSelectedDate.toDateString() === today.toDateString();
        const d = calSelectedDate.getDate(), mo = calSelectedDate.getMonth() + 1, y = calSelectedDate.getFullYear();
        calTargetInput.value = `${y}-${String(mo).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
        calTargetDisplay.textContent = isToday ? 'Today' : `${String(d).padStart(2,'0')}/${String(mo).padStart(2,'0')}/${y}`;
        calTargetDisplay.classList.remove('text-mute');
        calTargetDisplay.classList.add('text-ink');
        calDialog?.close();
      });
    }

    function openCalPicker(displayId: string, hiddenId: string) {
      calTargetDisplay = document.getElementById(displayId);
      calTargetInput   = document.getElementById(hiddenId) as HTMLInputElement;
      if (calTargetInput?.value) {
        const d = new Date(calTargetInput.value);
        if (!isNaN(d.getTime())) { calSelectedDate = d; calYear = d.getFullYear(); calMonth = d.getMonth(); }
      } else {
        calSelectedDate = null;
        const now = new Date(); calYear = now.getFullYear(); calMonth = now.getMonth();
      }
      calShowView('day');
      calRenderDays();
      calDialog?.showModal();
    }

    // Attach to Edit Group toggles
    if (editStartCalToggle && editEndCalToggle) {
      editStartCalToggle.addEventListener('click', () => {
        openCalPicker('editStartCalDisplay', 'editTripStartDate');
      });
      editEndCalToggle.addEventListener('click', () => {
        openCalPicker('editEndCalDisplay', 'editTripEndDate');
      });
    }

    // Wiring errorModalOkBtn
    const errorModalOkBtn = document.getElementById('errorModalOkBtn');
    if (errorModalOkBtn) {
      errorModalOkBtn.addEventListener('click', () => {
        const errModal = document.getElementById('errorModal') as HTMLDialogElement;
        errModal?.close();
      });
    }

    // --- Invite Member Logic ---
    const openInviteMemberBtn = document.getElementById('openInviteMemberBtn');
    const closeInviteMemberBtn = document.getElementById('closeInviteMemberBtn');
    const cancelInviteMemberBtn = document.getElementById('cancelInviteMemberBtn');
    const inviteMemberModal = document.getElementById('inviteMemberModal') as HTMLDialogElement;
    const inviteMemberForm = document.getElementById('inviteMemberForm') as HTMLFormElement;

    // Custom Role Dropdown Logic
    const inviteRoleBtn = document.getElementById('inviteRoleBtn');
    const inviteRoleDropdown = document.getElementById('inviteRoleDropdown');
    const inviteRoleText = document.getElementById('inviteRoleText');
    const inviteRoleInput = document.getElementById('inviteRole') as HTMLInputElement;
    const inviteRoleOptions = document.querySelectorAll('.invite-role-option');

    if (inviteRoleBtn && inviteRoleDropdown) {
      inviteRoleBtn.addEventListener('click', (e) => {
        e.preventDefault();
        inviteRoleDropdown.classList.toggle('hidden');
      });

      inviteRoleOptions.forEach(opt => {
        opt.addEventListener('click', () => {
          const val = opt.getAttribute('data-value') || 'viewer';
          const text = opt.querySelector('span')?.textContent || '';
          
          if (inviteRoleInput) inviteRoleInput.value = val;
          if (inviteRoleText) inviteRoleText.textContent = text;
          
          // Update checkmarks
          inviteRoleOptions.forEach(o => o.querySelector('.check-icon')?.classList.add('hidden'));
          opt.querySelector('.check-icon')?.classList.remove('hidden');
          
          inviteRoleDropdown.classList.add('hidden');
        });
      });

      document.addEventListener('click', (e) => {
        if (!inviteRoleBtn.contains(e.target as Node) && !inviteRoleDropdown.contains(e.target as Node)) {
          inviteRoleDropdown.classList.add('hidden');
        }
      });
    }

    let currentInviteMemberId = '';
    let currentInviteState = 'invite';
    (window as any).openInviteModal = function(memberId: string, prefillEmail = '', prefillRole = '', state = 'invite') {
      currentInviteMemberId = memberId;
      currentInviteState = state;
      const emailInput = document.getElementById('inviteEmail') as HTMLInputElement;
      if (emailInput) {
        emailInput.value = prefillEmail;
        emailInput.classList.remove('border-danger', 'focus:border-danger', 'border-2');
        emailInput.classList.add('border-hairline', 'focus:border-brand');
      }
      
      if (prefillRole && inviteRoleOptions.length > 0) {
        const option = Array.from(inviteRoleOptions).find(o => o.getAttribute('data-value') === prefillRole);
        if (option) (option as HTMLElement).click();
      } else {
        // default to editor
        (inviteRoleOptions[1] as HTMLElement)?.click();
      }
      
      const title = document.getElementById('inviteModalTitle');
      const submitBtn = document.getElementById('inviteSubmitBtn');
      const removeBtn = document.getElementById('inviteRemoveBtn');
      
      if (title) {
        if (state === 'invite') title.textContent = 'Invite Member';
        else if (state === 'reinvite') title.textContent = 'Reinvite Member';
        else if (state === 'manage') title.textContent = 'Manage Member';
      }
      
      if (submitBtn) {
        if (state === 'invite') submitBtn.textContent = 'Send Invite';
        else if (state === 'reinvite') submitBtn.textContent = 'Reinvite';
        else if (state === 'manage') submitBtn.textContent = 'Save Changes';
      }
      
      if (emailInput && removeBtn) {
        if (state === 'manage') {
          emailInput.readOnly = true;
          emailInput.classList.add('bg-canvas-soft', 'text-mute');
          emailInput.classList.remove('bg-canvas', 'text-ink');
        } else {
          emailInput.readOnly = false;
          emailInput.classList.remove('bg-canvas-soft', 'text-mute');
          emailInput.classList.add('bg-canvas', 'text-ink');
        }
        
        removeBtn.classList.remove('hidden');
        removeBtn.onclick = function() {
          (window as any).removeMemberFromGroup(memberId);
          inviteMemberModal?.close();
        };
      }

      inviteMemberModal?.showModal();
    };

    if (openInviteMemberBtn) {
      openInviteMemberBtn.addEventListener('click', () => inviteMemberModal?.showModal());
    }
    if (closeInviteMemberBtn) {
      closeInviteMemberBtn.addEventListener('click', () => inviteMemberModal?.close());
    }
    if (cancelInviteMemberBtn) {
      cancelInviteMemberBtn.addEventListener('click', () => inviteMemberModal?.close());
    }

    if (inviteMemberForm) {
      inviteMemberForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const emailInput = document.getElementById('inviteEmail') as HTMLInputElement;
        const roleValue = inviteRoleInput ? inviteRoleInput.value : 'viewer';
        const email = emailInput.value.trim().toLowerCase();
        
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          showToast("Please enter a valid email address.", true);
          return;
        }

        const usersStr = localStorage.getItem('splitbug_users');
        let allUsers: Record<string, any> = {};
        if (usersStr) {
          try { allUsers = JSON.parse(usersStr); } catch (e) {}
        }

        if (!allUsers[email]) {
          const modalContent = inviteMemberModal?.querySelector('.bg-canvas') as HTMLElement;
          if (modalContent) {
            // highlight the email input border
            const emailInputElem = document.getElementById('inviteEmail');
            if (emailInputElem) {
              emailInputElem.classList.remove('border-hairline', 'focus:border-brand');
              emailInputElem.classList.add('border-danger', 'focus:border-danger', 'border-2');
            }
            
            modalContent.animate([
              { transform: 'translateX(0)' },
              { transform: 'translateX(-20px)' },
              { transform: 'translateX(20px)' },
              { transform: 'translateX(-20px)' },
              { transform: 'translateX(20px)' },
              { transform: 'translateX(0)' }
            ], { duration: 400, easing: 'ease-in-out' });
          }
          showToast("No account exists with this email.", true);
          return;
        }

        if (currentInviteState === 'manage') {
          if (!groupData) return;
          try {
            await updateDoc(groupDocRef, {
              [`roles.${email}`]: roleValue
            });
            showToast("Role updated successfully.");
            inviteMemberModal?.close();
          } catch (e) {
            console.error("Error updating role:", e);
            showToast("Failed to update role.", true);
          }
          return;
        }

        if (groupData && groupData.members.includes(email)) {
          showToast("User is already in this group.", true);
          return;
        }
        
        try {
          const submitBtn = inviteMemberForm?.querySelector('button[type="submit"]') as HTMLButtonElement;
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = 'Sending...';
          }
          
          await addDoc(collection(db, "invites"), {
            groupId: groupId,
            groupName: groupData.name,
            memberId: currentInviteMemberId,
            inviterEmail: currentUserEmail,
            inviterName: (window as any).MY_DISPLAY_NAME,
            inviteeEmail: email,
            status: 'pending',
            role: roleValue,
            createdAt: Date.now()
          });
          
          // Show success state
          const inviteForm = document.getElementById('inviteMemberForm');
          const inviteSuccessState = document.getElementById('inviteSuccessState');
          const inviteSuccessTitle = document.getElementById('inviteSuccessTitle');
          if (inviteSuccessTitle) {
            inviteSuccessTitle.textContent = currentInviteState === 'reinvite' ? 'Invitation Resent' : 'Invitation Sent';
          }
          
          if (inviteForm && inviteSuccessState) {
            inviteForm.classList.add('hidden');
            inviteSuccessState.classList.remove('hidden');
            inviteSuccessState.classList.add('flex');
            
            setTimeout(() => {
              inviteMemberModal?.close();
              // Reset for next time
              inviteForm.classList.remove('hidden');
              inviteSuccessState.classList.add('hidden');
              inviteSuccessState.classList.remove('flex');
              emailInput.value = '';
              if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.textContent = 'Send Invite';
              }
            }, 2000);
          } else {
            showToast("Invite sent successfully!");
            emailInput.value = '';
            inviteMemberModal?.close();
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = 'Send Invite';
            }
          }
        } catch (error) {
          console.error("Error sending invite:", error);
          showToast("Failed to send invite.", true);
          const submitBtn = inviteMemberForm?.querySelector('button[type="submit"]') as HTMLButtonElement;
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Send Invite';
          }
        }
      });
    }

    (window as any).removeMemberFromGroup = async function(email: string) {
      if (confirm(`Are you sure you want to remove ${email} from this group?`)) {
        if (!groupData) return;
        
        try {
          await updateDoc(groupDocRef, {
            members: arrayRemove(email),
            [`roles.${email}`]: deleteField()
          });
          showToast("Member removed successfully.");
        } catch (error) {
          console.error("Error removing member:", error);
          showToast("Failed to remove member.", true);
        }
      }
    };

    // --- Comments Logic ---
    const commentForm = document.getElementById('commentForm') as HTMLFormElement;
    const commentInput = document.getElementById('commentInput') as HTMLInputElement;
    const commentsContainer = document.getElementById('commentsContainer');

    function renderAbstractArt(type: string) {
      if (type === 'special-art-1') return '<div class="w-full h-full" style="background: conic-gradient(from 45deg, #FF6B6B, #4ECDC4, #45B7D1, #FF6B6B);"></div>';
      if (type === 'special-art-2') return '<div class="w-full h-full" style="background: linear-gradient(135deg, #FF9A9E 0%, #FECFEF 99%, #FECFEF 100%);"><div class="w-1/2 h-1/2 bg-white/30 rounded-br-full backdrop-blur-md"></div></div>';
      if (type === 'special-art-3') return '<div class="w-full h-full flex"><div class="w-1/2 h-full bg-indigo-500"></div><div class="w-1/2 h-full bg-rose-400 rounded-tl-full"></div></div>';
      return '';
    }

    (window as any).updateAvatarNode = function(node: HTMLElement, email: string, displayName: string, sizeClass: string) {
      const usersStr = localStorage.getItem('splitbug_users');
      const allUsers = usersStr ? JSON.parse(usersStr) : {};
      const user = allUsers[email] || {};
      
      let avatar = user.avatar;
      if (email === currentUserEmail) {
        avatar = localStorage.getItem('splitbug_userAvatar') || avatar;
      }
      
      const themeColor = user.themeColor || (email === currentUserEmail ? (localStorage.getItem('splitbug_userThemeColor') || 'special-art-1') : 'special-art-1');
      const gradientTheme = user.gradientTheme || (email === currentUserEmail ? (localStorage.getItem('splitbug_userGradientTheme') || '-1') : '-1');
      
      node.className = `${sizeClass} rounded-full shrink-0 overflow-hidden ring-1 ring-hairline/50`;
      
      if (avatar && avatar.includes('=s96-c')) {
        avatar = avatar.replace('=s96-c', '=s960-c');
      }

      if (gradientTheme !== '-1' && gradientTheme.startsWith('special-art-')) {
        node.innerHTML = renderAbstractArt(gradientTheme);
      } else if (avatar) {
        node.innerHTML = `<img src="${avatar}" alt="${displayName}" referrerpolicy="no-referrer" class="w-full h-full object-cover" />`;
      } else if (themeColor.startsWith('special-art-')) {
        node.innerHTML = renderAbstractArt(themeColor);
      } else {
        const parts = displayName.trim().split(' ').filter(Boolean);
        let initials = 'U';
        if (parts.length > 0 && parts[0]) {
          if (parts.length === 1) initials = parts[0].charAt(0).toUpperCase();
          else initials = (parts[0].charAt(0) + parts[parts.length - 1].charAt(0)).toUpperCase();
        }
        node.className = `${sizeClass} rounded-full ${themeColor} text-white flex items-center justify-center text-xs font-bold shrink-0 uppercase`;
        node.innerHTML = initials;
      }
    };

    (window as any).renderComments = function() {
      if (!commentsContainer || !groupData) return;
      
      const bgColors = ['bg-[#b2dfdb] text-ink', 'bg-success/20 text-success', 'bg-warning/20 text-warning', 'bg-danger/20 text-danger'];
      const usersStr = localStorage.getItem('splitbug_users');
      const allUsers = usersStr ? JSON.parse(usersStr) : {};
      
      // Update form avatar
      const myDisplayName = (window as any).getDisplayName(currentUserEmail);

      const commentAvatar = document.getElementById('commentAvatar');
      if (commentAvatar) {
        (window as any).updateAvatarNode(commentAvatar, currentUserEmail, myDisplayName, "w-7 h-7");
      }

      commentsContainer.innerHTML = '';
      if (!groupData.comments || groupData.comments.length === 0) {
        commentsContainer.innerHTML = '<div class="text-center text-mute text-sm mt-8">No comments yet. Start the conversation!</div>';
        return;
      }
      
      groupData.comments.forEach((c: any) => {
        const isMe = c.authorEmail === currentUserEmail;
        const displayName = isMe ? 'You' : (window as any).getDisplayName(c.authorEmail);
        const dateStr = new Date(c.timestamp).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
        
        const tempDiv = document.createElement('div');
        (window as any).updateAvatarNode(tempDiv, c.authorEmail, displayName, "w-7 h-7 mt-4");
        const avatarHtml = tempDiv.outerHTML;
        
        const item = document.createElement('div');
        item.className = `flex gap-2 w-full group ${isMe ? 'flex-row-reverse' : ''} mb-3`;
        
        const bubbleBg = isMe ? 'bg-brand text-white' : 'bg-canvas-soft border border-hairline text-ink';
        const bubbleRadius = isMe ? 'rounded-2xl rounded-tr-sm' : 'rounded-2xl rounded-tl-sm';
        const alignText = isMe ? 'items-end' : 'items-start';
        
        item.innerHTML = `
          ${avatarHtml}
          <div class="flex flex-col ${alignText} max-w-[80%]">
            <div class="flex items-baseline gap-2 mx-1 mb-1 ${isMe ? 'flex-row-reverse' : ''}">
              <span class="text-[11px] font-medium text-mute">${displayName}</span>
              <span class="text-[10px] text-mute/70">${dateStr}</span>
            </div>
            <div class="px-3.5 py-2 ${bubbleBg} ${bubbleRadius} shadow-sm relative">
              <p class="text-[13px] break-words leading-relaxed">${c.text}</p>
            </div>
          </div>
        `;
        commentsContainer.appendChild(item);
      });
      
      // Auto-scroll to bottom
      commentsContainer.scrollTop = commentsContainer.scrollHeight;
    };

    // Initial render for comments
    (window as any).renderComments();

    if (commentForm) {
      commentForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!groupData || !commentInput) return;
        const text = commentInput.value.trim();
        if (!text) return;

        const newComment = {
          id: 'cmt_' + Date.now(),
          authorEmail: currentUserEmail,
          authorName: (window as any).MY_DISPLAY_NAME || 'You',
          text: text,
          timestamp: Date.now()
        };

        const submitBtn = document.getElementById('commentSubmitBtn') as HTMLButtonElement;
        if (submitBtn) submitBtn.disabled = true;

        try {
          await updateDoc(groupDocRef, {
            comments: arrayUnion(newComment)
          });
          commentInput.value = '';
        } catch (error) {
          console.error("Error adding comment:", error);
          showToast("Failed to add comment.", true);
        } finally {
          // Wait for snapshot update or just re-enable immediately
        }
      });
      
      commentInput.addEventListener('input', () => {
        const submitBtn = document.getElementById('commentSubmitBtn') as HTMLButtonElement;
        if(submitBtn) {
          submitBtn.disabled = commentInput.value.trim().length === 0;
        }
      });
    }

    // Cross-tab syncing removed, Firebase handles real-time updates

    // Global Modal Scroll Lock
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.type === 'attributes' && mutation.attributeName === 'open') {
          const dialog = mutation.target as HTMLDialogElement;
          if (dialog.open) {
            document.body.style.overflow = 'hidden';
          } else {
            // Check if any other dialogs are open before restoring
            const anyOpen = document.querySelectorAll('dialog[open]').length > 0;
            if (!anyOpen) {
              document.body.style.overflow = '';
            }
          }
        }
      });
    });

    document.querySelectorAll('dialog').forEach(dialog => {
      observer.observe(dialog, { attributes: true });
    });
  </script>
</Layout>
