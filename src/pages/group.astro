        </div>

        <!-- Year View -->
        <div id="calYearView" class="hidden h-full overflow-y-auto no-scrollbar">
          <div id="calYearList" class="flex flex-col gap-1"></div>
        </div>
      </div>

      <!-- Footer Actions -->
      <div class="flex justify-end gap-2 p-3 border-t border-hairline">
        <button type="button" id="calCancelBtn" class="px-4 py-1.5 text-sm font-medium text-mute hover:text-ink transition-colors">Cancel</button>
        <button type="button" id="calOkBtn" class="px-4 py-1.5 text-sm font-medium text-white bg-brand rounded-full hover:opacity-90 transition-opacity">OK</button>
      </div>
    </dialog>

    <!-- Error Modal for Actions -->
    <dialog id="errorModal" class="bg-transparent p-0 m-auto backdrop:bg-black/50 text-ink open:flex flex-col items-center justify-center w-[92vw] sm:w-full max-w-sm z-[9999]">
      <div class="bg-canvas border border-hairline rounded-lg shadow-lg w-full p-6 text-center">
        <h2 class="text-lg font-bold mb-2 text-ink">Cannot Remove Member</h2>
        <p id="errorModalMsg" class="text-body text-sm mb-6 text-mute"></p>
        <button type="button" id="errorModalOkBtn" class="bg-primary text-on-primary px-6 py-2 rounded-pill font-medium hover:opacity-90 transition-opacity cursor-pointer w-full">OK</button>
      </div>
    </dialog>

  </div>

  <script>
    import { db, auth } from '../firebase';
    import { doc, getDoc, updateDoc, arrayUnion, arrayRemove, deleteField, setDoc, addDoc, collection, onSnapshot, query, where, getDocs } from 'firebase/firestore';

    const currentUserEmail = localStorage.getItem('splitbug_userEmail') || 'user@example.com';
    (window as any).MY_DISPLAY_NAME = localStorage.getItem('splitbug_userName') || 'You';
    const GLOBAL_GROUPS_KEY = 'splitsbug_global_groups';
    const DATA_KEY = GLOBAL_GROUPS_KEY;
    
    let groupDocRef: any = null;
    let isGroupLoaded = false;

    (window as any).getDisplayName = function(raw: string) {
      if (!raw) return '';
      if (!raw.includes('@')) return raw;
      if (raw === currentUserEmail) return (window as any).MY_DISPLAY_NAME || 'You';
      
      const usersStr = localStorage.getItem('splitbug_users');
      if (usersStr) {
        try {
          const users = JSON.parse(usersStr);
          if (users[raw] && users[raw].name) {
            return users[raw].name;
          }
        } catch(e) {}
      }
      
      return raw.split('@')[0];
    };
    const typeColorMap: Record<string, string> = {
      'Trip': 'border-[#2563eb] bg-[#2563eb] text-white',
      'Couple': 'border-[#db2777] bg-[#db2777] text-white',
      'Other': 'border-[#ea580c] bg-[#ea580c] text-white',
      'Home': 'border-[#65a30d] bg-[#65a30d] text-white'
    };

    const typeLightColorMap: Record<string, string> = {
      'Trip': 'bg-[#eff6ff] text-[#2563eb]',
      'Couple': 'bg-[#fdf2f8] text-[#db2777]',
      'Other': 'bg-[#fffbeb] text-[#d97706]',
      'Home': 'bg-[#f7fee7] text-[#65a30d]'
    };

    const alphabetMap: Record<string, {dark: string, light: string}> = {
      'A': { dark: '#e11d48', light: 'bg-[#fff1f2] text-[#e11d48]' },
      'B': { dark: '#2563eb', light: 'bg-[#eff6ff] text-[#2563eb]' },
      'C': { dark: '#9333ea', light: 'bg-[#faf5ff] text-[#9333ea]' },
      'D': { dark: '#4f46e5', light: 'bg-[#eef2ff] text-[#4f46e5]' },
      'E': { dark: '#db2777', light: 'bg-[#fdf2f8] text-[#db2777]' },
      'F': { dark: '#d97706', light: 'bg-[#fffbeb] text-[#d97706]' },
      'G': { dark: '#059669', light: 'bg-[#ecfdf5] text-[#059669]' },
      'H': { dark: '#0d9488', light: 'bg-[#f0fdfa] text-[#0d9488]' },
      'I': { dark: '#0891b2', light: 'bg-[#ecfeff] text-[#0891b2]' },
      'J': { dark: '#e11d48', light: 'bg-[#fff1f2] text-[#e11d48]' },
      'K': { dark: '#059669', light: 'bg-[#ecfdf5] text-[#059669]' },
      'L': { dark: '#65a30d', light: 'bg-[#f7fee7] text-[#65a30d]' },
      'M': { dark: '#e11d48', light: 'bg-[#fff1f2] text-[#e11d48]' },
      'N': { dark: '#059669', light: 'bg-[#ecfdf5] text-[#059669]' },
      'O': { dark: '#9333ea', light: 'bg-[#faf5ff] text-[#9333ea]' },
      'P': { dark: '#4f46e5', light: 'bg-[#eef2ff] text-[#4f46e5]' },
      'Q': { dark: '#db2777', light: 'bg-[#fdf2f8] text-[#db2777]' },
      'R': { dark: '#d97706', light: 'bg-[#fffbeb] text-[#d97706]' },
      'S': { dark: '#059669', light: 'bg-[#ecfdf5] text-[#059669]' },
      'T': { dark: '#0d9488', light: 'bg-[#f0fdfa] text-[#0d9488]' },
      'U': { dark: '#0891b2', light: 'bg-[#ecfeff] text-[#0891b2]' },
      'V': { dark: '#e11d48', light: 'bg-[#fff1f2] text-[#e11d48]' },
      'W': { dark: '#c026d3', light: 'bg-[#fdf4ff] text-[#c026d3]' },
      'X': { dark: '#65a30d', light: 'bg-[#f7fee7] text-[#65a30d]' },
      'Y': { dark: '#e11d48', light: 'bg-[#fff1f2] text-[#e11d48]' },
      'Z': { dark: '#2563eb', light: 'bg-[#eff6ff] text-[#2563eb]' },
    };

    function getGroupColor(type: string, name: string) {
      const validTypes = ['Trip', 'Couple', 'Home'];
      if (!type || !validTypes.includes(type)) {
        const firstLetter = (name || 'G').trim().charAt(0).toUpperCase();
        if (alphabetMap[firstLetter]) return alphabetMap[firstLetter];
        return { dark: '#d97706', light: 'bg-[#fffbeb] text-[#d97706]' };
      }
      return {
        dark: typeColorMap[type] ? typeColorMap[type].match(/bg-\[([^\]]+)\]/)?.[1] || '#2563eb' : '#2563eb',
        light: typeLightColorMap[type] || 'bg-[#eff6ff] text-[#2563eb]'
      };
    }
    function showErrorModal(message: string) {
      const modal = document.getElementById('errorModal') as HTMLDialogElement;
      const msg = document.getElementById('errorModalMsg');
      const btn = document.getElementById('errorModalOkBtn');
      if (modal && msg && btn) {
        msg.textContent = message;
        modal.showModal();
        btn.onclick = () => modal.close();
      }
    }

    function showToast(message: string, isError = false) {
      const toast = document.getElementById('toastNotification');
      const toastMsg = document.getElementById('toastMessage');
      const iconSuccess = document.getElementById('toastIconSuccess');
      const iconError = document.getElementById('toastIconError');
      if (toast && toastMsg && iconSuccess && iconError) {
        
        const activeDialog = document.querySelector('dialog[open]');
        if (activeDialog) {
          activeDialog.appendChild(toast);
        } else {
          document.body.appendChild(toast);
        }

        toastMsg.textContent = message;
        if (isError) {
          iconSuccess.classList.add('hidden');
          iconError.classList.remove('hidden');
        } else {
          iconError.classList.add('hidden');
          iconSuccess.classList.remove('hidden');
        }
        toast.classList.remove('translate-y-20', 'opacity-0');
        setTimeout(() => {
          toast.classList.add('translate-y-20', 'opacity-0');
        }, 3000);
      }
    }

    // Client-side UI wiring
    const addExpenseBtn = document.getElementById('addExpenseBtn');
    const addExpenseModal = document.getElementById('addExpenseModal') as HTMLDialogElement;
    const closeExpenseBtn = document.getElementById('closeExpenseBtn');
    const cancelExpenseBtn = document.getElementById('cancelExpenseBtn');

    function resetAddExpenseModal() {
      const desc = document.getElementById('expenseDescription') as HTMLInputElement;
      const amt = document.getElementById('expenseAmount') as HTMLInputElement;
      if (desc) desc.value = '';
      if (amt) amt.value = '';

      const expenseCategoryValue = document.getElementById('expenseCategoryValue') as HTMLInputElement;
      const expenseCategoryBtn = document.getElementById('expenseCategoryBtn');
      if (expenseCategoryValue) expenseCategoryValue.value = 'Uncategorized.General';
      if (expenseCategoryBtn) {
        expenseCategoryBtn.className = 'w-10 h-10 flex items-center justify-center border border-hairline rounded-sm flex-shrink-0 transition-colors bg-slate-100 text-slate-600';
        expenseCategoryBtn.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>`;
      }

      const paidByText = document.getElementById('paidByText');
      const paidByBtn = document.getElementById('paidByBtn');
      if (paidByText) {
        const defaultMember = groupData?.members[0] || currentUserEmail;
        paidByText.textContent = (window as any).getDisplayName(defaultMember);
        if (paidByBtn) paidByBtn.dataset.value = defaultMember;
      }
      const splitText = document.getElementById('splitText');
      if (splitText) splitText.textContent = 'Equally';

      const container = document.getElementById('splitParticipantsContainer');
      if (container) container.classList.add('is-equally');

      document.querySelectorAll('.split-participant-checkbox').forEach((cb: any) => cb.checked = true);
    }

    if (addExpenseBtn && addExpenseModal) {
      addExpenseBtn.addEventListener('click', () => {
        resetAddExpenseModal();
        addExpenseModal.showModal();
      });
      closeExpenseBtn?.addEventListener('click', () => {
        resetAddExpenseModal();
        addExpenseModal.close();
      });
      cancelExpenseBtn?.addEventListener('click', () => {
        resetAddExpenseModal();
        addExpenseModal.close();
      });
      addExpenseModal.addEventListener('click', (e) => {
        const d = addExpenseModal.getBoundingClientRect();
        if (e.clientX < d.left || e.clientX > d.right || e.clientY < d.top || e.clientY > d.bottom) {
          resetAddExpenseModal();
          addExpenseModal.close();
        }
      });
    }

    const settleUpBtn = document.getElementById('settleUpBtn');
    const settleUpModal = document.getElementById('settleUpModal') as HTMLDialogElement;
    const cancelSettleBtn = document.getElementById('cancelSettleBtn');
    const settleUpForm = document.getElementById('settleUpForm') as HTMLFormElement;

    if (settleUpBtn && settleUpModal) {
      settleUpBtn.addEventListener('click', () => settleUpModal.showModal());
      cancelSettleBtn?.addEventListener('click', () => settleUpModal.close());
      settleUpModal.addEventListener('click', (e) => {
        const d = settleUpModal.getBoundingClientRect();
        if (e.clientX < d.left || e.clientX > d.right || e.clientY < d.top || e.clientY > d.bottom) settleUpModal.close();
      });

      if (settleUpForm) {
        settleUpForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const checkedOptions = document.querySelectorAll('input[name="settleDebtOption"]:checked') as NodeListOf<HTMLInputElement>;
          if (checkedOptions.length === 0) {
            showToast('Please select at least one debt to settle.', true);
            return;
          }
          
          const curr = currencySymbol?.textContent || '$';
          
          const recordBtn = document.getElementById('recordSettleBtn') as HTMLButtonElement;
          if (recordBtn) {
            recordBtn.disabled = true;
            recordBtn.textContent = 'Recording...';
          }

          (async () => {
            try {
              let newExpenses: any[] = [];
              let newActivities: any[] = [];
              let newNotifs: {to: string, msg: string}[] = [];
              
              checkedOptions.forEach(opt => {
                const debt = JSON.parse(opt.value);
                const settlementExpense = {
                  id: Date.now().toString() + Math.random().toString(36).substring(7),
                  description: 'Payment',
                  amount: debt.amount,
                  paidBy: debt.from,
                  participants: [debt.to],
                  splitAmong: 1,
                  currency: curr,
                  timestamp: Date.now()
                };
                newExpenses.push(settlementExpense);
                
                const payerName = debt.from === currentUserEmail || debt.from === (window as any).MY_DISPLAY_NAME || debt.from === 'You' ? (window as any).MY_DISPLAY_NAME : (window as any).getDisplayName(debt.from);
                const p = debt.to;
                if (p !== currentUserEmail && p !== debt.from && p !== (window as any).MY_DISPLAY_NAME && p !== 'You') {
                  newNotifs.push({
                    to: p,
                    msg: `${payerName} paid you ${curr}${debt.amount.toFixed(2)}.`
                  });
                }
                
                newActivities.push({
                  groupId: groupId,
                  groupName: groupData.name,
                  type: 'debt_settled',
                  description: 'Payment',
                  amount: debt.amount,
                  currency: curr,
                  paidBy: debt.from,
                  participants: [debt.to],
                  timestamp: Date.now()
                });
              });
              
              if (newExpenses.length > 0) {
                // We use arrayUnion. Note: arrayUnion takes spread arguments, but for array of objects we must spread it
                await updateDoc(groupDocRef, {
                  expenses: arrayUnion(...newExpenses)
                });
              }
              
              for (const notif of newNotifs) {
                await addDoc(collection(db, "users", notif.to, "notifications"), {
                  groupId: groupId,
                  message: notif.msg,
                  timestamp: Date.now(),
                  read: false
                });
              }
              
              for (const act of newActivities) {
                await addDoc(collection(db, "activities"), act);
              }

          renderFeed();
          renderBalances();
          
          // Trigger Success Animation inside Modal
          const settleUpContent = document.getElementById('settleUpContent');
          const settleUpSuccess = document.getElementById('settleUpSuccess');
          const settleUpSuccessText = document.getElementById('settleUpSuccessText');
          const settleUpCard = document.getElementById('settleUpCard');
          
          if (settleUpContent && settleUpSuccess && settleUpCard && settleUpSuccessText) {
            if (checkedOptions.length === 1) {
              const debt = JSON.parse(checkedOptions[0].value);
              settleUpSuccessText.textContent = `Payment of ${curr}${debt.amount.toFixed(2)} recorded!`;
            } else {
              settleUpSuccessText.textContent = `${checkedOptions.length} payments recorded!`;
            }
            
            settleUpCard.style.height = settleUpCard.offsetHeight + 'px'; // Fix current height
            
            settleUpContent.classList.add('opacity-0');
            setTimeout(() => {
              settleUpContent.classList.add('hidden');
              settleUpSuccess.classList.remove('hidden');
              
              // Force reflow
              void settleUpCard.offsetHeight;
              
              settleUpCard.style.height = '192px'; // Height of success state (h-48)
              setTimeout(() => {
                settleUpSuccess.classList.remove('opacity-0');
                settleUpSuccess.classList.add('flex');
                
                // Wait 2 seconds, then close and reset
                setTimeout(() => {
                  settleUpModal.close();
                  // Reset modal state
                  setTimeout(() => {
                    settleUpSuccess.classList.add('hidden', 'opacity-0');
                    settleUpSuccess.classList.remove('flex');
                    settleUpContent.classList.remove('hidden', 'opacity-0');
                    settleUpCard.style.height = 'auto';
                  }, 300); // Wait for dialog close animation
                }, 2000);
              }, 300);
            }, 300);
          } else {
            settleUpModal.close();
          }

            } catch (error) {
              console.error("Error settling up:", error);
              showToast("Failed to settle up.", true);
            } finally {
              if (recordBtn) {
                recordBtn.disabled = false;
                recordBtn.textContent = 'Record Payments';
              }
            }
          })();
        });
      }
    }

    // Custom Currency Dropdown Logic
    const currencyBtn = document.getElementById('currencyBtn');
    const currencyMenu = document.getElementById('currencyMenu');
    const currencySymbol = document.getElementById('currencySymbol');
    const currencyOptions = document.querySelectorAll('.currency-option');

    if (currencyBtn && currencyMenu && currencySymbol) {
      // Load saved currency from local storage if exists
      const savedCurrency = localStorage.getItem('preferredCurrency');
      if (savedCurrency) {
        currencySymbol.textContent = savedCurrency;
      }

      currencyBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        currencyMenu.classList.toggle('hidden');
      });

      currencyOptions.forEach(option => {
        option.addEventListener('click', (e) => {
          const btn = e.target as HTMLButtonElement;
          const sym = btn.getAttribute('data-symbol');
          if (sym) {
            currencySymbol.textContent = sym;
            localStorage.setItem('preferredCurrency', sym);
          }
          currencyMenu.classList.add('hidden');
        });
      });
    }

    // Custom Paid By Dropdown Logic
    const paidByBtn = document.getElementById('paidByBtn');
    const paidByMenu = document.getElementById('paidByMenu');
    const paidByText = document.getElementById('paidByText');
    const paidByOptions = document.querySelectorAll('.paidby-option');

    if (paidByBtn && paidByMenu && paidByText) {
      paidByBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        paidByMenu.classList.toggle('hidden');
      });

      paidByOptions.forEach(option => {
        option.addEventListener('click', (e) => {
          const btn = e.target as HTMLButtonElement;
          const val = btn.getAttribute('data-value');
          if (val) paidByText.textContent = val;
          paidByMenu.classList.add('hidden');
        });
      });
    }

    // Custom Split Dropdown Logic
    const splitBtn = document.getElementById('splitBtn');
    const splitMenu = document.getElementById('splitMenu');
    const splitText = document.getElementById('splitText');
    const splitOptions = document.querySelectorAll('.split-option');

    if (splitBtn && splitMenu && splitText) {
      splitBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        splitMenu.classList.toggle('hidden');
      });

      splitOptions.forEach(option => {
        option.addEventListener('click', (e) => {
          const btn = e.target as HTMLButtonElement;
          const val = btn.getAttribute('data-value');
          if (val) {
            splitText.textContent = val;
            const container = document.getElementById('splitParticipantsContainer');
            if (val === 'Equally') {
              container?.classList.add('is-equally');
              // Auto-check everyone when set back to Equally
              document.querySelectorAll('.split-participant-checkbox').forEach((cb: any) => cb.checked = true);
            } else {
              container?.classList.remove('is-equally');
            }
          }
          splitMenu.classList.add('hidden');
        });
      });
    }

    // Close all custom dropdowns when clicking outside
    document.addEventListener('click', (e) => {
      if (currencyBtn && currencyMenu && !currencyBtn.contains(e.target as Node) && !currencyMenu.contains(e.target as Node)) {
        currencyMenu.classList.add('hidden');
      }
      if (paidByBtn && paidByMenu && !paidByBtn.contains(e.target as Node) && !paidByMenu.contains(e.target as Node)) {
        paidByMenu.classList.add('hidden');
      }
      if (splitBtn && splitMenu && !splitBtn.contains(e.target as Node) && !splitMenu.contains(e.target as Node)) {
        splitMenu.classList.add('hidden');
      }
    });

    // Handle Form Submission for Adding an Expense
    const addExpenseForm = document.getElementById('addExpenseForm') as HTMLFormElement;
    const activityFeed = document.getElementById('activityFeed');
    const balancesContainer = document.getElementById('balancesContainer');
    const expenseDescription = document.getElementById('expenseDescription') as HTMLInputElement;
    const expenseAmount = document.getElementById('expenseAmount') as HTMLInputElement;

    // --- Dynamic Setup based on localStorage ---
    const urlParams = new URLSearchParams(window.location.search);
    const groupId = urlParams.get('id');
    let groupData: any = null;

    function initGroupData() {
      // Data is loaded via Firebase onSnapshot

      if (!groupData) {
        const titleEl = document.getElementById('groupTitle')!;
        titleEl.textContent = "Group not found";
        titleEl.classList.remove('hidden');
        const titleSkel = document.getElementById('groupTitleSkeleton');
        if (titleSkel) titleSkel.style.display = 'none';
        return;
      }

      const myRole = groupData.roles ? groupData.roles[currentUserEmail] : 'editor';
      if (myRole === 'viewer') {
        const addExpenseBtn = document.getElementById('addExpenseBtn');
        const settleUpBtn = document.getElementById('settleUpBtn');
        const groupSettingsBtn = document.getElementById('groupSettingsBtn');
        const stickySettingsBtn = document.getElementById('stickySettingsBtn');
        if (addExpenseBtn) addExpenseBtn.style.display = 'none';
        if (settleUpBtn) settleUpBtn.style.display = 'none';
        if (groupSettingsBtn) groupSettingsBtn.style.display = 'none';
        if (stickySettingsBtn) stickySettingsBtn.style.display = 'none';
      }

      // Hide settings options if not Admin (owner or admin)
      const memberPermissionsSection = document.getElementById('memberPermissionsSection');
      if (memberPermissionsSection) {
        if (myRole === 'owner' || myRole === 'admin') {
          memberPermissionsSection.style.display = 'block';
        } else {
          memberPermissionsSection.style.display = 'none';
        }
      }
        
        const openInviteMemberBtn = document.getElementById('openInviteMemberBtn');
        if (openInviteMemberBtn) {
          if (groupData.memberPermissions === 'admins' && myRole !== 'owner' && myRole !== 'admin') {
            openInviteMemberBtn.style.display = 'none';
          } else {
            openInviteMemberBtn.style.display = 'flex';
          }
        }

        const deleteGroupBtn = document.getElementById('settingsDeleteGroupBtn');
        const editGroupBtn = document.getElementById('editGroupBtn');
        if (myRole !== 'owner' && myRole !== 'admin') {
          if (deleteGroupBtn) deleteGroupBtn.style.display = 'none';
          if (editGroupBtn) editGroupBtn.style.display = 'none';
        } else {
          if (deleteGroupBtn) deleteGroupBtn.style.display = 'flex';
          if (editGroupBtn) editGroupBtn.style.display = 'flex';
        }

      // Update UI Header
      const titleEl = document.getElementById('groupTitle')!;
      titleEl.textContent = groupData.name;
      titleEl.classList.remove('hidden');
      titleEl.classList.add('fade-in');
      const titleSkel = document.getElementById('groupTitleSkeleton');
      if (titleSkel) titleSkel.style.display = 'none';
      document.getElementById('memberCountText')!.textContent = `${groupData.members.length} people`;

      // Apply dynamic accent color to headers
      const strongColorMap: Record<string, string> = {
        'Trip': 'bg-[#2563eb]',
        'Couple': 'bg-[#db2777]',
        'Other': 'bg-[#ea580c]',
        'Home': 'bg-[#65a30d]'
      };

      const alphabetMap: Record<string, string> = {
        'A': 'bg-[#e11d48]', 'B': 'bg-[#2563eb]', 'C': 'bg-[#9333ea]', 'D': 'bg-[#4f46e5]',
        'E': 'bg-[#db2777]', 'F': 'bg-[#d97706]', 'G': 'bg-[#059669]', 'H': 'bg-[#0d9488]',
        'I': 'bg-[#0891b2]', 'J': 'bg-[#e11d48]', 'K': 'bg-[#059669]', 'L': 'bg-[#65a30d]',
        'M': 'bg-[#e11d48]', 'N': 'bg-[#059669]', 'O': 'bg-[#9333ea]', 'P': 'bg-[#4f46e5]',
        'Q': 'bg-[#db2777]', 'R': 'bg-[#d97706]', 'S': 'bg-[#059669]', 'T': 'bg-[#0d9488]',
        'U': 'bg-[#0891b2]', 'V': 'bg-[#e11d48]', 'W': 'bg-[#c026d3]', 'X': 'bg-[#65a30d]',
        'Y': 'bg-[#e11d48]', 'Z': 'bg-[#2563eb]'
      };

      let headerColorClass = strongColorMap[groupData.type] || 'bg-[#059669]';
      if (groupData.type === 'Other' || !groupData.type) {
        const firstLetter = (groupData.name || 'G').trim().charAt(0).toUpperCase();
        if (alphabetMap[firstLetter]) {
          headerColorClass = alphabetMap[firstLetter];
        } else {
          headerColorClass = 'bg-[#ea580c]';
        }
      }
      
      const mainHeader = document.getElementById('mainHeader');
      if (mainHeader) {
        mainHeader.classList.remove('bg-[#0a6c51]', 'bg-[#2563eb]', 'bg-[#db2777]', 'bg-[#ea580c]', 'bg-[#65a30d]');
        // Remove possible alphabet colors to ensure clean state
        Object.values(alphabetMap).forEach(c => mainHeader.classList.remove(c));
        mainHeader.classList.add(headerColorClass);
      }
      
      const stickyTopBar = document.getElementById('stickyTopBar');
      if (stickyTopBar) {
        stickyTopBar.classList.remove('bg-[#0a6c51]', 'bg-[#2563eb]', 'bg-[#db2777]', 'bg-[#ea580c]', 'bg-[#65a30d]');
        Object.values(alphabetMap).forEach(c => stickyTopBar.classList.remove(c));
        stickyTopBar.classList.add(headerColorClass);
      }

      // Update Date Pill if trip dates are set
      const datePill = document.getElementById('datePill');
      const dateText = document.getElementById('dateText');
      if (groupData.startDate && groupData.endDate && datePill && dateText) {
        try {
          const s = new Date(groupData.startDate);
          const e = new Date(groupData.endDate);
          const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
          
          let dateStr = `${monthNames[s.getMonth()]} ${s.getDate()}`;
          if (s.getMonth() === e.getMonth() && s.getFullYear() === e.getFullYear()) {
            dateStr += ` - ${e.getDate()}`; // Same month (e.g. Jul 1 - 31)
          } else {
            dateStr += ` - ${monthNames[e.getMonth()]} ${e.getDate()}`;
          }
          
          if (s.getFullYear() !== new Date().getFullYear()) {
             dateStr += `, ${s.getFullYear()}`;
          }

          dateText.textContent = dateStr;
