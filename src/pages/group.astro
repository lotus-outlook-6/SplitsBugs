          'Home': `<svg width="240" height="240" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
          'Couple': `<svg width="240" height="240" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`
        };
        
        if (groupData.type && typeIcons[groupData.type]) {
          watermark.innerHTML = typeIcons[groupData.type];
        } else {
          // If Other or unknown, use the first letter of group name
          const initial = (groupData.name || 'G').charAt(0).toUpperCase();
          watermark.innerHTML = `<span style="font-size: 240px; font-weight: bold; line-height: 1;">${initial}</span>`;
          // tweak positioning for text to align nicely
          watermark.className = 'absolute right-0 top-1/2 -translate-y-[60%] translate-x-1/4 opacity-10 pointer-events-none text-white font-bold select-none';
        }
      }

      // Populate Dropdowns & Checklists
      const paidByMenu = document.getElementById('paidByMenu');
      const paidByBtn = document.getElementById('paidByBtn');
      const splitChecklist = document.getElementById('splitParticipantsList');
      
      if (paidByMenu && splitChecklist) {
        paidByMenu.innerHTML = '';
        splitChecklist.innerHTML = '';
        groupData.members.forEach((member: string) => {
          const displayMember = (window as any).getDisplayName(member);
          // Paid By Dropdown
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'paid-by-option w-full text-left px-3 py-2 text-sm hover:bg-canvas-soft transition-colors';
          btn.textContent = displayMember;
          btn.addEventListener('click', () => {
            const span = document.getElementById('paidByText');
            if (span) span.textContent = displayMember;
            if (paidByBtn) paidByBtn.dataset.value = member;
