---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="min-h-screen flex flex-col bg-canvas-soft pb-32">
    <!-- Header -->
    <header
      class="h-16 px-4 lg:px-6 flex items-center gap-4 border-b border-hairline bg-canvas sticky top-0 z-40"
    >
      <a
        href="/account"
        class="w-10 h-10 flex items-center justify-center rounded-full bg-canvas-soft hover:bg-hairline transition-colors text-ink"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><line x1="19" y1="12" x2="5" y2="12"></line><polyline
            points="12 19 5 12 12 5"></polyline></svg
        >
      </a>
      <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-ink">
        Security
      </h1>
    </header>

    <style is:inline>
      .skeleton-danger {
        background: linear-gradient(
          90deg,
          rgba(239, 68, 68, 0.2) 25%,
          rgba(239, 68, 68, 0.45) 37%,
          rgba(239, 68, 68, 0.2) 63%
        );
        background-size: 400% 100%;
        animation: skeleton-shimmer 1.4s ease infinite;
      }
    </style>

    <main class="flex-1 w-full max-w-3xl mx-auto p-4 sm:p-6 lg:p-8 space-y-8">
      <!-- Skeleton Loader Container (Matches real content card heights 1:1) -->
      <div id="securitySkeleton" class="space-y-8">
        <!-- Password Section Skeleton -->
        <div
          class="bg-canvas p-6 sm:p-8 rounded-2xl shadow-sm border border-hairline"
        >
          <div class="skeleton h-7 w-44 mb-4 rounded-md"></div>
          <div class="flex flex-col gap-6">
            <div>
              <div class="skeleton h-5 w-32 mb-1 rounded-md"></div>
              <div class="skeleton h-[50px] w-full rounded-md"></div>
            </div>
            <div>
              <div class="skeleton h-5 w-28 mb-1 rounded-md"></div>
              <div class="skeleton h-[50px] w-full rounded-md"></div>
              <div class="mt-2.5 space-y-1.5">
                <div class="flex items-center gap-2 h-4">
                  <div class="skeleton w-4 h-4 rounded-full shrink-0"></div><div
                    class="skeleton h-3.5 w-36 rounded-md"
                  >
                  </div>
                </div>
                <div class="flex items-center gap-2 h-4">
                  <div class="skeleton w-4 h-4 rounded-full shrink-0"></div><div
                    class="skeleton h-3.5 w-48 rounded-md"
                  >
                  </div>
                </div>
                <div class="flex items-center gap-2 h-4">
                  <div class="skeleton w-4 h-4 rounded-full shrink-0"></div><div
                    class="skeleton h-3.5 w-28 rounded-md"
                  >
                  </div>
                </div>
                <div class="flex items-center gap-2 h-4">
                  <div class="skeleton w-4 h-4 rounded-full shrink-0"></div><div
                    class="skeleton h-3.5 w-40 rounded-md"
                  >
                  </div>
                </div>
              </div>
            </div>
            <div>
              <div class="skeleton h-5 w-40 mb-1 rounded-md"></div>
              <div class="skeleton h-[50px] w-full rounded-md"></div>
            </div>
            <div class="skeleton h-[50px] w-full rounded-md"></div>
          </div>
        </div>

        <!-- PIN Section Skeleton -->
        <div
          class="bg-canvas p-6 sm:p-8 rounded-2xl shadow-sm border border-hairline"
        >
          <div class="flex items-center justify-between gap-4">
            <div class="flex-1">
              <div class="skeleton h-7 w-48 sm:w-60 rounded-md mb-1.5"></div>
              <div class="skeleton h-4 sm:h-5 w-full max-w-[480px] rounded-md"></div>
            </div>
            <div class="skeleton w-11 h-6 rounded-full shrink-0"></div>
          </div>
        </div>

        <!-- Data & Export Skeleton -->
        <div
          class="bg-canvas p-6 sm:p-8 rounded-2xl shadow-sm border border-hairline"
        >
          <div class="skeleton h-7 w-44 rounded-md mb-2"></div>
          <div class="skeleton h-4 sm:h-5 w-full max-w-lg rounded-md mb-5">
          </div>
          <div class="skeleton h-[42px] w-full sm:w-max min-w-[180px] rounded-xl"></div>
        </div>

        <!-- Danger Zone Skeleton (Red Accent) -->
        <div
          class="bg-red-500/5 border border-red-500/20 p-6 sm:p-8 rounded-2xl"
        >
          <div class="skeleton-danger h-7 w-32 rounded-md mb-2"></div>
          <div
            class="skeleton-danger h-4 sm:h-5 w-full max-w-lg rounded-md mb-1.5"
          >
          </div>
          <div class="skeleton-danger h-4 sm:h-5 w-3/4 rounded-md mb-6"></div>
          <div class="skeleton-danger h-[42px] w-full sm:w-48 rounded-xl"></div>
        </div>
      </div>

      <!-- Real Security Content (Initially Hidden) -->
      <div id="securityContent" class="hidden space-y-8">
        <!-- Password Section -->
        <div
          class="bg-canvas p-6 sm:p-8 rounded-2xl shadow-sm border border-hairline"
        >
          <h2 class="text-lg font-bold text-ink mb-4">Change Password</h2>
          <form
            id="changePasswordForm"
            class="flex flex-col gap-6"
            autocomplete="off"
          >
            <div
              id="errorBox"
              class="hidden bg-danger/10 border border-danger/20 text-danger p-3 rounded-md text-sm font-medium"
            >
            </div>
            <div
              id="successBox"
              class="hidden bg-success/10 border border-success/20 text-success p-3 rounded-md text-sm font-medium"
            >
              Password updated successfully!
            </div>

            <div>
              <label class="block text-sm font-medium text-ink mb-1"
                >Current Password</label
              >
              <input
                type="password"
                required
                id="currentPassword"
                autocomplete="new-password"
                class="w-full p-3 rounded-md border border-hairline bg-canvas focus:outline-none focus:border-brand transition-colors text-ink placeholder:text-mute"
                placeholder="••••••••"
              />
            </div>

            <div>
              <label class="block text-sm font-medium text-ink mb-1"
                >New Password</label
              >
              <input
                type="password"
                required
                id="newPassword"
                autocomplete="new-password"
                class="w-full p-3 rounded-md border border-hairline bg-canvas focus:outline-none focus:border-brand transition-colors text-ink placeholder:text-mute"
                placeholder="••••••••"
              />
              <ul class="text-xs text-mute mt-2.5 space-y-1.5">
                <li
                  id="rule-length"
                  class="flex items-center gap-2 font-normal"
                >
                  <span
                    class="icon-placeholder w-4 h-4 flex items-center justify-center shrink-0"
                    ><div
                      class="w-4 h-4 rounded-full border border-hairline dark:border-hairline/80 bg-transparent shrink-0"
                    >
                    </div></span
                  > At least 8 characters
                </li>
                <li id="rule-upper" class="flex items-center gap-2 font-normal">
                  <span
                    class="icon-placeholder w-4 h-4 flex items-center justify-center shrink-0"
                    ><div
                      class="w-4 h-4 rounded-full border border-hairline dark:border-hairline/80 bg-transparent shrink-0"
                    >
                    </div></span
                  > 1 uppercase & 1 lowercase
                </li>
                <li id="rule-num" class="flex items-center gap-2 font-normal">
                  <span
                    class="icon-placeholder w-4 h-4 flex items-center justify-center shrink-0"
                    ><div
                      class="w-4 h-4 rounded-full border border-hairline dark:border-hairline/80 bg-transparent shrink-0"
                    >
                    </div></span
                  > 1 number
                </li>
                <li id="rule-spec" class="flex items-center gap-2 font-normal">
                  <span
                    class="icon-placeholder w-4 h-4 flex items-center justify-center shrink-0"
                    ><div
                      class="w-4 h-4 rounded-full border border-hairline dark:border-hairline/80 bg-transparent shrink-0"
                    >
                    </div></span
                  > 1 special character
                </li>
              </ul>
            </div>

            <div>
              <label class="block text-sm font-medium text-ink mb-1"
                >Confirm New Password</label
              >
              <input
                type="password"
                required
                id="confirmPassword"
                autocomplete="new-password"
                class="w-full p-3 rounded-md border border-hairline bg-canvas focus:outline-none focus:border-brand transition-colors text-ink placeholder:text-mute"
                placeholder="••••••••"
              />
            </div>

            <button
              type="submit"
              id="submitBtn"
              class="w-full py-3 bg-brand text-white rounded-md font-bold hover:bg-brand-deep transition-colors shadow-sm disabled:opacity-50 text-base cursor-pointer"
            >
              Update Password
            </button>
          </form>
        </div>

        <!-- App Lock / PIN Security -->
        <div
          class="bg-canvas p-6 sm:p-8 rounded-2xl shadow-sm border border-hairline space-y-1"
        >
          <div class="flex items-center justify-between gap-4">
            <div>
              <h2 class="text-lg font-bold text-ink">
                App PIN / Passcode Lock
              </h2>
              <p class="text-xs sm:text-sm text-mute mt-1">
                Protect your financial data with a 4-digit PIN lock prompt when
                opening the app
              </p>
            </div>
            <label
              class="relative inline-flex items-center cursor-pointer shrink-0"
            >
              <input type="checkbox" id="pinToggle" class="sr-only peer" />
              <div
                class="w-11 h-6 bg-mute/30 dark:bg-mute/20 border border-hairline peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-brand"
              >
              </div>
            </label>
          </div>

          <div
            id="autoLockContainer"
            class="hidden border-t border-hairline pt-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3"
          >
            <div>
              <label class="block text-sm font-medium text-ink"
                >Auto-Lock Timer</label
              >
              <p class="text-xs text-mute">
                Choose when SplitsBug automatically locks after inactivity
              </p>
            </div>

            <!-- Custom Web Dropdown (No native system dropdown) -->
            <div class="relative shrink-0" id="customAutoLockDropdown">
              <button
                type="button"
                id="autoLockDropdownBtn"
                class="flex items-center justify-between gap-3 px-4 py-2.5 rounded-xl border border-hairline bg-canvas-soft text-ink text-sm font-medium hover:bg-hairline transition-colors shrink-0 cursor-pointer min-w-[230px]"
              >
                <span id="autoLockSelectedLabel"
                  >Immediately (On refresh / load)</span
                >
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="text-mute transition-transform duration-200"
                  id="autoLockArrow"
                  ><polyline points="6 9 12 15 18 9"></polyline></svg
                >
              </button>

              <div
                id="autoLockMenu"
                class="absolute right-0 mt-2 w-64 bg-canvas border border-hairline rounded-2xl shadow-xl p-1.5 z-50 hidden animate-in fade-in zoom-in-95 duration-150"
              >
                <button
                  type="button"
                  data-val="0"
                  class="autolock-opt w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium text-ink hover:bg-canvas-soft transition-colors cursor-pointer"
                >
                  <span>Immediately (On refresh / load)</span>
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    class="text-brand opt-check hidden"
                    ><polyline points="20 6 9 17 4 12"></polyline></svg
                  >
                </button>
                <button
                  type="button"
                  data-val="5"
                  class="autolock-opt w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium text-ink hover:bg-canvas-soft transition-colors cursor-pointer"
                >
                  <span>After 5 minutes</span>
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    class="text-brand opt-check hidden"
                    ><polyline points="20 6 9 17 4 12"></polyline></svg
                  >
                </button>
                <button
                  type="button"
                  data-val="10"
                  class="autolock-opt w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium text-ink hover:bg-canvas-soft transition-colors cursor-pointer"
                >
                  <span>After 10 minutes</span>
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    class="text-brand opt-check hidden"
                    ><polyline points="20 6 9 17 4 12"></polyline></svg
                  >
                </button>
                <button
                  type="button"
                  data-val="30"
                  class="autolock-opt w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium text-ink hover:bg-canvas-soft transition-colors cursor-pointer"
                >
                  <span>After 30 minutes</span>
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    class="text-brand opt-check hidden"
                    ><polyline points="20 6 9 17 4 12"></polyline></svg
                  >
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Data & Export -->
        <div
          class="bg-canvas p-6 sm:p-8 rounded-2xl shadow-sm border border-hairline"
        >
          <h2 class="text-lg font-bold text-ink mb-2">Export Account Data</h2>
          <p class="text-xs sm:text-sm text-mute mb-5">
            Download a complete Excel archive of your personal profile, group
            memberships, and expense history.
          </p>
          <a
            href="/export-data"
            class="bg-canvas-soft border border-hairline hover:bg-hairline text-ink font-bold px-5 py-2.5 rounded-xl text-sm transition-colors cursor-pointer flex items-center justify-center gap-2 w-full sm:w-max"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
              ></path><polyline points="7 10 12 15 17 10"></polyline><line
                x1="12"
                y1="15"
                x2="12"
                y2="3"></line></svg
            >
            Go to Data Export
          </a>
        </div>

        <!-- Danger Zone: Permanent Delete Account -->
        <div
          class="bg-red-500/5 border border-red-500/20 p-6 sm:p-8 rounded-2xl"
        >
          <h2 class="text-lg font-bold text-red-600 dark:text-red-400 mb-2">
            Danger Zone
          </h2>
          <p class="text-xs sm:text-sm text-mute mb-6">
            Permanently delete your user profile and database records. This
            action cannot be undone and next login will be treated as a brand
            new account.
          </p>

          <button
            type="button"
            id="openDeleteModalBtn"
            class="bg-red-600 hover:bg-red-700 text-white font-bold px-5 py-2.5 rounded-xl text-sm transition-colors cursor-pointer flex items-center gap-2"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              ><path d="M3 6h18"></path><path
                d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
              ></path><line x1="10" y1="11" x2="10" y2="17"></line><line
                x1="14"
                y1="11"
                x2="14"
                y2="17"></line></svg
            >
            Delete Account & Data
          </button>
        </div>
      </div>
    </main>
  </div>

  <!-- Delete Account Confirmation Modal -->
  <dialog
    id="deleteModal"
    class="backdrop:bg-black/60 text-ink fixed inset-0 z-50 m-auto w-[90vw] max-w-md p-6 bg-canvas border border-hairline rounded-2xl shadow-2xl"
  >
    <div class="flex flex-col gap-4">
      <div
        class="w-12 h-12 rounded-full bg-red-500/10 text-red-600 dark:text-red-400 flex items-center justify-center mx-auto"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><path
            d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"
          ></path><line x1="12" y1="9" x2="12" y2="13"></line><line
            x1="12"
            y1="17"
            x2="12.01"
            y2="17"></line></svg
        >
      </div>
      <div class="text-center">
        <h3 class="text-xl font-bold text-ink">Delete Account & Data?</h3>
        <p class="text-xs text-mute mt-2">
          This will permanently erase your profile and all data. Type
          <strong class="text-red-500 font-mono">DELETE</strong> below and enter your password to confirm.
        </p>
      </div>

      <div>
        <input
          type="text"
          id="confirmDeleteInput"
          class="w-full p-3 rounded-xl border border-hairline bg-canvas-soft text-ink font-mono text-center uppercase tracking-widest focus:outline-none focus:border-red-500"
          placeholder="DELETE"
        />
      </div>

      <div>
        <input
          type="password"
          id="deletePasswordInput"
          class="w-full p-3 rounded-xl border border-hairline bg-canvas-soft text-ink text-sm focus:outline-none focus:border-red-500 transition-colors"
          placeholder="Enter your password to confirm"
          autocomplete="current-password"
        />
        <p id="deletePasswordError" class="text-xs text-red-500 mt-1.5 hidden">Incorrect password. Please try again.</p>
      </div>

      <div class="flex gap-3 mt-2">
        <button
          type="button"
          id="cancelDeleteBtn"
          class="flex-1 py-2.5 rounded-xl border border-hairline bg-canvas-soft text-ink font-medium hover:bg-hairline transition-colors cursor-pointer"
          >Cancel</button
        >
        <button
          type="button"
          id="confirmDeleteBtn"
          disabled
          class="flex-1 py-2.5 rounded-xl bg-red-600 text-white font-bold hover:bg-red-700 transition-colors disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer"
          >Delete Forever</button
        >
      </div>
    </div>
  </dialog>

  <!-- PIN Setup Modal (4 Square Digit Boxes) -->
  <dialog
    id="pinModal"
    class="backdrop:bg-black/60 text-ink fixed inset-0 z-50 m-auto w-[90vw] max-w-sm p-6 bg-canvas border border-hairline rounded-3xl shadow-2xl"
  >
    <div class="flex flex-col items-center gap-4 text-center">
      <div
        class="w-14 h-14 rounded-full bg-brand/10 text-brand flex items-center justify-center"
      >
        <svg
          width="26"
          height="26"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path
            d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg
        >
      </div>
      <div>
        <h3 class="text-lg font-bold text-ink">Set 4-Digit Passcode</h3>
        <p class="text-xs text-mute mt-1">
          Create a passcode to secure SplitsBug
        </p>
      </div>

      <!-- 4 Square Digit Boxes -->
      <div id="setPinBoxContainer" class="flex gap-3 justify-center my-2">
        <input
          type="password"
          maxlength="1"
          inputmode="numeric"
          pattern="[0-9]*"
          autocomplete="new-password"
          spellcheck="false"
          class="set-pin-digit w-12 h-14 text-center text-2xl font-bold rounded-2xl border border-hairline bg-canvas-soft focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none text-ink transition-all shadow-sm"
          autofocus
        />
        <input
          type="password"
          maxlength="1"
          inputmode="numeric"
          pattern="[0-9]*"
          autocomplete="new-password"
          spellcheck="false"
          class="set-pin-digit w-12 h-14 text-center text-2xl font-bold rounded-2xl border border-hairline bg-canvas-soft focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none text-ink transition-all shadow-sm"
        />
        <input
          type="password"
          maxlength="1"
          inputmode="numeric"
          pattern="[0-9]*"
          autocomplete="new-password"
          spellcheck="false"
          class="set-pin-digit w-12 h-14 text-center text-2xl font-bold rounded-2xl border border-hairline bg-canvas-soft focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none text-ink transition-all shadow-sm"
        />
        <input
          type="password"
          maxlength="1"
          inputmode="numeric"
          pattern="[0-9]*"
          autocomplete="new-password"
          spellcheck="false"
          class="set-pin-digit w-12 h-14 text-center text-2xl font-bold rounded-2xl border border-hairline bg-canvas-soft focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none text-ink transition-all shadow-sm"
        />
      </div>

      <div class="flex gap-3 w-full mt-2">
        <button
          type="button"
          id="cancelPinBtn"
          class="flex-1 py-2.5 rounded-xl border border-hairline text-xs font-semibold hover:bg-canvas-soft cursor-pointer"
          >Cancel</button
        >
        <button
          type="button"
          id="savePinBtn"
          class="flex-1 py-2.5 rounded-xl bg-brand text-white text-xs font-bold hover:bg-brand-deep cursor-pointer"
          >Save Passcode</button
        >
      </div>
    </div>
  </dialog>

  <!-- Turn Off PIN Verification Modal -->
  <dialog
    id="disablePinModal"
    class="backdrop:bg-black/60 text-ink fixed inset-0 z-50 m-auto w-[90vw] max-w-sm p-6 bg-canvas border border-hairline rounded-3xl shadow-2xl"
  >
    <div class="flex flex-col items-center gap-4 text-center">
      <div
        class="w-14 h-14 rounded-full bg-amber-500/10 text-amber-500 flex items-center justify-center"
      >
        <svg
          width="26"
          height="26"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path
            d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg
        >
      </div>
      <div>
        <h3 class="text-lg font-bold text-ink">Turn Off Passcode Lock</h3>
        <p class="text-xs text-mute mt-1">
          Enter your current 4-digit passcode to disable lock
        </p>
      </div>

      <!-- 4 Square Digit Boxes -->
      <div id="disablePinBoxContainer" class="flex gap-3 justify-center my-2">
        <input
          type="password"
          maxlength="1"
          inputmode="numeric"
          pattern="[0-9]*"
          autocomplete="new-password"
          spellcheck="false"
          class="disable-pin-digit w-12 h-14 text-center text-2xl font-bold rounded-2xl border border-hairline bg-canvas-soft focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none text-ink transition-all shadow-sm"
          autofocus
        />
        <input
          type="password"
          maxlength="1"
          inputmode="numeric"
          pattern="[0-9]*"
          autocomplete="new-password"
          spellcheck="false"
          class="disable-pin-digit w-12 h-14 text-center text-2xl font-bold rounded-2xl border border-hairline bg-canvas-soft focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none text-ink transition-all shadow-sm"
        />
        <input
          type="password"
          maxlength="1"
          inputmode="numeric"
          pattern="[0-9]*"
          autocomplete="new-password"
          spellcheck="false"
          class="disable-pin-digit w-12 h-14 text-center text-2xl font-bold rounded-2xl border border-hairline bg-canvas-soft focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none text-ink transition-all shadow-sm"
        />
        <input
          type="password"
          maxlength="1"
          inputmode="numeric"
          pattern="[0-9]*"
          autocomplete="new-password"
          spellcheck="false"
          class="disable-pin-digit w-12 h-14 text-center text-2xl font-bold rounded-2xl border border-hairline bg-canvas-soft focus:border-brand focus:ring-2 focus:ring-brand/20 outline-none text-ink transition-all shadow-sm"
        />
      </div>

      <p id="disablePinError" class="text-xs text-danger font-semibold hidden">
      </p>

      <div class="flex gap-3 w-full mt-2">
        <button
          type="button"
          id="cancelDisablePinBtn"
          class="flex-1 py-2.5 rounded-xl border border-hairline text-xs font-semibold hover:bg-canvas-soft cursor-pointer"
          >Cancel</button
        >
        <button
          type="button"
          id="confirmDisablePinBtn"
          class="flex-1 py-2.5 rounded-xl bg-danger text-white text-xs font-bold hover:opacity-90 cursor-pointer"
          >Turn Off</button
        >
      </div>
    </div>
  </dialog>

  <script>
    import { auth, db } from "../firebase";
    import { doc, deleteDoc } from "firebase/firestore";
    import {
      EmailAuthProvider,
      reauthenticateWithCredential,
      updatePassword,
      deleteUser,
    } from "firebase/auth";

    const form = document.getElementById(
      "changePasswordForm",
    ) as HTMLFormElement;
    const currentPassword = document.getElementById(
      "currentPassword",
    ) as HTMLInputElement;
    const newPassword = document.getElementById(
      "newPassword",
    ) as HTMLInputElement;
    const confirmPassword = document.getElementById(
      "confirmPassword",
    ) as HTMLInputElement;
    const errorBox = document.getElementById("errorBox") as HTMLDivElement;
    const successBox = document.getElementById("successBox") as HTMLDivElement;
    const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement;

    // PIN Lock & Custom Web Dropdown logic
    const pinToggle = document.getElementById("pinToggle") as HTMLInputElement;
    const autoLockContainer = document.getElementById("autoLockContainer");

    const autoLockDropdownBtn = document.getElementById("autoLockDropdownBtn");
    const autoLockMenu = document.getElementById("autoLockMenu");
    const autoLockSelectedLabel = document.getElementById(
      "autoLockSelectedLabel",
    );
    const autoLockArrow = document.getElementById("autoLockArrow");
    const autoLockOptions = Array.from(
      document.querySelectorAll(".autolock-opt"),
    );

    const pinModal = document.getElementById("pinModal") as HTMLDialogElement;
    const setPinDigits = Array.from(
      document.querySelectorAll(".set-pin-digit"),
    ) as HTMLInputElement[];
    const cancelPinBtn = document.getElementById("cancelPinBtn");
    const savePinBtn = document.getElementById("savePinBtn");

    const disablePinModal = document.getElementById(
      "disablePinModal",
    ) as HTMLDialogElement;
    const disablePinDigits = Array.from(
      document.querySelectorAll(".disable-pin-digit"),
    ) as HTMLInputElement[];
    const disablePinError = document.getElementById("disablePinError");
    const cancelDisablePinBtn = document.getElementById("cancelDisablePinBtn");
    const confirmDisablePinBtn = document.getElementById(
      "confirmDisablePinBtn",
    );

    // Labels map
    const labelsMap: Record<string, string> = {
      "0": "Immediately (On refresh / load)",
      "5": "After 5 minutes",
      "10": "After 10 minutes",
      "30": "After 30 minutes",
    };

    function updateDropdownUI(val: string) {
      if (autoLockSelectedLabel) {
        autoLockSelectedLabel.textContent = labelsMap[val] || labelsMap["0"];
      }
      autoLockOptions.forEach((opt) => {
        const optVal = opt.getAttribute("data-val");
        const check = opt.querySelector(".opt-check");
        if (optVal === val) {
          opt.classList.add("bg-brand/10", "text-brand");
          check?.classList.remove("hidden");
        } else {
          opt.classList.remove("bg-brand/10", "text-brand");
          check?.classList.add("hidden");
        }
      });
    }

    const currentInterval =
      localStorage.getItem("splitsbug_autolock_interval") || "0";
    updateDropdownUI(currentInterval);

    // Custom Web Dropdown toggle
    autoLockDropdownBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      const isOpen = !autoLockMenu?.classList.contains("hidden");
      if (isOpen) {
        autoLockMenu?.classList.add("hidden");
        autoLockArrow?.classList.remove("rotate-180");
      } else {
        autoLockMenu?.classList.remove("hidden");
        autoLockArrow?.classList.add("rotate-180");
      }
    });

    autoLockOptions.forEach((opt) => {
      opt.addEventListener("click", (e) => {
        e.stopPropagation();
        const val = opt.getAttribute("data-val") || "0";
        localStorage.setItem("splitsbug_autolock_interval", val);
        updateDropdownUI(val);
        autoLockMenu?.classList.add("hidden");
        autoLockArrow?.classList.remove("rotate-180");
      });
    });

    function revealSecurityPage() {
      const skeleton = document.getElementById("securitySkeleton");
      const content = document.getElementById("securityContent");
      if (skeleton) {
        skeleton.style.transition = "opacity 0.3s ease-out";
        skeleton.style.opacity = "0";
        setTimeout(() => {
          skeleton.style.display = "none";
          if (content) {
            content.classList.remove("hidden");
            content.classList.add("fade-in");
          }
        }, 300);
      }
    }

    document.addEventListener("DOMContentLoaded", () => {
      setTimeout(revealSecurityPage, 450);
    });

    document.addEventListener("click", (e) => {
      if (
        !document
          .getElementById("customAutoLockDropdown")
          ?.contains(e.target as Node)
      ) {
        autoLockMenu?.classList.add("hidden");
        autoLockArrow?.classList.remove("rotate-180");
      }
    });

    // Init PIN state
    if (localStorage.getItem("splitsbug_pin_enabled") === "true") {
      pinToggle.checked = true;
      autoLockContainer?.classList.remove("hidden");
    }

    const triggerSavePin = () => {
      const pinVal = setPinDigits.map((d) => d.value).join("");
      if (pinVal.length === 4) {
        localStorage.setItem("splitsbug_pin_enabled", "true");
        localStorage.setItem("splitsbug_pin_val", pinVal);
        pinToggle.checked = true;
        autoLockContainer?.classList.remove("hidden");
        pinModal.close();
      } else {
        alert("Please enter all 4 digits.");
      }
    };

    const triggerDisablePin = () => {
      const enteredPin = disablePinDigits.map((d) => d.value).join("");
      const savedPin = localStorage.getItem("splitsbug_pin_val");

      if (enteredPin === savedPin) {
        localStorage.removeItem("splitsbug_pin_enabled");
        localStorage.removeItem("splitsbug_pin_val");
        localStorage.removeItem("splitsbug_app_locked");
        pinToggle.checked = false;
        autoLockContainer?.classList.add("hidden");
        disablePinModal.close();
      } else if (disablePinError) {
        disablePinError.textContent = "Incorrect passcode. Please try again.";
        disablePinError.classList.remove("hidden");
        disablePinDigits.forEach((d) => (d.value = ""));
        disablePinDigits[0]?.focus();
      }
    };

    // Handle 4 square digit box input navigation and Enter key submit
    function setupDigitInputNav(
      digits: HTMLInputElement[],
      onSubmit: () => void,
    ) {
      digits.forEach((digit, idx) => {
        digit.addEventListener("input", () => {
          const val = digit.value.replace(/[^0-9]/g, "");
          digit.value = val ? val.slice(-1) : "";

          if (digit.value && idx < digits.length - 1) {
            digits[idx + 1].focus();
          }
        });

        digit.addEventListener("keydown", (e) => {
          if (e.key === "Backspace" && !digit.value && idx > 0) {
            digits[idx - 1].focus();
          } else if (e.key === "Enter") {
            onSubmit();
          }
        });
      });
    }

    setupDigitInputNav(setPinDigits, triggerSavePin);
    setupDigitInputNav(disablePinDigits, triggerDisablePin);

    pinToggle?.addEventListener("change", () => {
      if (pinToggle.checked) {
        setPinDigits.forEach((d) => (d.value = ""));
        pinModal.showModal();
        setTimeout(() => setPinDigits[0]?.focus(), 100);
      } else {
        pinToggle.checked = true;
        disablePinDigits.forEach((d) => (d.value = ""));
        if (disablePinError) disablePinError.classList.add("hidden");
        disablePinModal.showModal();
        setTimeout(() => disablePinDigits[0]?.focus(), 100);
      }
    });

    cancelPinBtn?.addEventListener("click", () => {
      pinModal.close();
      pinToggle.checked =
        localStorage.getItem("splitsbug_pin_enabled") === "true";
    });

    savePinBtn?.addEventListener("click", triggerSavePin);

    cancelDisablePinBtn?.addEventListener("click", () => {
      disablePinModal.close();
    });

    confirmDisablePinBtn?.addEventListener("click", triggerDisablePin);

    // Delete Account Logic
    const openDeleteModalBtn = document.getElementById("openDeleteModalBtn");
    const deleteModal = document.getElementById(
      "deleteModal",
    ) as HTMLDialogElement;
    const confirmDeleteInput = document.getElementById(
      "confirmDeleteInput",
    ) as HTMLInputElement;
    const cancelDeleteBtn = document.getElementById("cancelDeleteBtn");
    const confirmDeleteBtn = document.getElementById(
      "confirmDeleteBtn",
    ) as HTMLButtonElement;

    openDeleteModalBtn?.addEventListener("click", () => {
      confirmDeleteInput.value = "";
      confirmDeleteBtn.disabled = true;
      deleteModal.showModal();
    });

    cancelDeleteBtn?.addEventListener("click", () => {
      deleteModal.close();
      // Reset state on close
      const pwInput = document.getElementById('deletePasswordInput') as HTMLInputElement;
      const pwError = document.getElementById('deletePasswordError');
      if (pwInput) pwInput.value = '';
      if (pwError) pwError.classList.add('hidden');
    });

    const confirmDeleteInput = document.getElementById('confirmDeleteInput') as HTMLInputElement;
    const deletePasswordInput = document.getElementById('deletePasswordInput') as HTMLInputElement;
    const deletePasswordError = document.getElementById('deletePasswordError');

    function updateDeleteBtnState() {
      const confirmOk = confirmDeleteInput?.value.trim().toUpperCase() === 'DELETE';
      const passwordOk = (deletePasswordInput?.value || '').length > 0;
      confirmDeleteBtn.disabled = !(confirmOk && passwordOk);
    }

    confirmDeleteInput?.addEventListener('input', updateDeleteBtnState);
    deletePasswordInput?.addEventListener('input', () => {
      if (deletePasswordError) deletePasswordError.classList.add('hidden');
      updateDeleteBtnState();
    });

    confirmDeleteBtn?.addEventListener('click', async () => {
      const user = auth.currentUser;
      if (!user || !user.email) return;

      const password = deletePasswordInput?.value || '';

      confirmDeleteBtn.disabled = true;
      confirmDeleteBtn.textContent = 'Deleting...';

      try {
        // Re-authenticate first (Firebase requires recent login for deletion)
        const credential = EmailAuthProvider.credential(user.email, password);
        await reauthenticateWithCredential(user, credential);
      } catch (authErr: any) {
        console.error('Re-auth failed:', authErr);
        if (deletePasswordError) deletePasswordError.classList.remove('hidden');
        confirmDeleteBtn.disabled = false;
        confirmDeleteBtn.textContent = 'Delete Forever';
        return;
      }

      try {
        const userEmail = user.email;
        const uid = user.uid;

        // 1. Delete user documents from Firestore
        if (userEmail) {
          await deleteDoc(doc(db, 'users', userEmail)).catch((e) => console.warn(e));
        }
        await deleteDoc(doc(db, 'users', uid)).catch((e) => console.warn(e));

        // 2. Delete user from Firebase Auth
        await deleteUser(user);

        // 3. Clear storage
        localStorage.clear();
        sessionStorage.clear();

        // 4. Redirect to signup
        window.location.href = '/signup?deleted=true';
      } catch (err: any) {
        console.error('Account deletion error:', err);
        alert(err.message || 'Failed to delete account. Please try again.');
        confirmDeleteBtn.disabled = false;
        confirmDeleteBtn.textContent = 'Delete Forever';
      }
    });

    // Password validation logic
    const ruleLength = document.getElementById("rule-length");
    const ruleUpper = document.getElementById("rule-upper");
    const ruleNum = document.getElementById("rule-num");
    const ruleSpec = document.getElementById("rule-spec");

    function validatePassword(val: string) {
      const len = val.length >= 8;
      const upper = /[A-Z]/.test(val) && /[a-z]/.test(val);
      const num = /[0-9]/.test(val);
      const spec = /[^a-zA-Z0-9]/.test(val);

      const checkIcon = `<div class="w-4 h-4 rounded-full bg-emerald-500 text-white flex items-center justify-center shrink-0 transition-all"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>`;
      const circleIcon = `<div class="w-4 h-4 rounded-full border border-hairline dark:border-hairline/80 bg-transparent shrink-0"></div>`;

      if (ruleLength) {
        ruleLength.className = `flex items-center gap-2 ${len ? "text-ink font-normal" : "text-mute font-normal"}`;
        ruleLength.querySelector(".icon-placeholder")!.innerHTML = len
          ? checkIcon
          : circleIcon;
      }
      if (ruleUpper) {
        ruleUpper.className = `flex items-center gap-2 ${upper ? "text-ink font-normal" : "text-mute font-normal"}`;
        ruleUpper.querySelector(".icon-placeholder")!.innerHTML = upper
          ? checkIcon
          : circleIcon;
      }
      if (ruleNum) {
        ruleNum.className = `flex items-center gap-2 ${num ? "text-ink font-normal" : "text-mute font-normal"}`;
        ruleNum.querySelector(".icon-placeholder")!.innerHTML = num
          ? checkIcon
          : circleIcon;
      }
      if (ruleSpec) {
        ruleSpec.className = `flex items-center gap-2 ${spec ? "text-ink font-normal" : "text-mute font-normal"}`;
        ruleSpec.querySelector(".icon-placeholder")!.innerHTML = spec
          ? checkIcon
          : circleIcon;
      }

      return len && upper && num && spec;
    }

    newPassword.addEventListener("input", () => {
      validatePassword(newPassword.value);
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorBox.classList.add("hidden");
      successBox.classList.add("hidden");

      if (!validatePassword(newPassword.value)) {
        errorBox.textContent =
          "Please ensure the new password meets all requirements.";
        errorBox.classList.remove("hidden");
        return;
      }

      if (newPassword.value !== confirmPassword.value) {
        errorBox.textContent = "New passwords do not match.";
        errorBox.classList.remove("hidden");
        return;
      }

      if (currentPassword.value === newPassword.value) {
        errorBox.textContent =
          "New password cannot be the same as the old password.";
        errorBox.classList.remove("hidden");
        return;
      }

      const user = auth.currentUser;
      if (!user || !user.email) {
        errorBox.textContent = "You must be logged in to change your password.";
        errorBox.classList.remove("hidden");
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = "Updating...";

      try {
        const credential = EmailAuthProvider.credential(
          user.email,
          currentPassword.value,
        );
        await reauthenticateWithCredential(user, credential);

        await updatePassword(user, newPassword.value);

        try {
          await fetch("/api/send-email", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              to: user.email,
              subject: "Your SplitsBug Password Was Changed",
              templateId: "general",
              templateData: {
                title: "Password Updated 🔐",
                message:
                  "Your SplitsBug account password was successfully changed. If you did not make this change, please contact support and secure your account immediately.",
                actionUrl: window.location.origin + "/security",
              },
            }),
          });
        } catch (e) {
          console.error("Failed to send password update email", e);
        }

        successBox.classList.remove("hidden");
        form.reset();

        setTimeout(() => {
          window.location.href = "/account";
        }, 1500);
      } catch (error: any) {
        if (
          error.code === "auth/invalid-credential" ||
          error.code === "auth/wrong-password"
        ) {
          errorBox.textContent = "Incorrect current password.";
        } else {
          errorBox.textContent =
            error.message || "Failed to update password. Please try again.";
        }
        errorBox.classList.remove("hidden");
        submitBtn.disabled = false;
        submitBtn.textContent = "Update Password";
      }
    });
  </script>
</Layout>
