---
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <div class="min-h-screen flex flex-col bg-canvas-soft pb-32">
    <!-- Header -->
    <header class="h-16 px-4 lg:px-6 flex items-center gap-4 border-b border-hairline bg-canvas sticky top-0 z-40">
      <a href="/account" class="w-10 h-10 flex items-center justify-center rounded-full bg-canvas-soft hover:bg-hairline transition-colors text-ink">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      </a>
      <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-ink">Security</h1>
    </header>

    <main class="flex-1 w-full max-w-3xl mx-auto p-4 sm:p-6 lg:p-8 space-y-8">
      
      <!-- Password Section -->
      <div class="bg-canvas p-6 sm:p-8 rounded-2xl shadow-sm border border-hairline">
        <h2 class="text-lg font-bold text-ink mb-4">Change Password</h2>
        <form id="changePasswordForm" class="flex flex-col gap-6" autocomplete="off">
          <div id="errorBox" class="hidden bg-danger/10 border border-danger/20 text-danger p-3 rounded-md text-sm font-medium"></div>
          <div id="successBox" class="hidden bg-success/10 border border-success/20 text-success p-3 rounded-md text-sm font-medium">Password updated successfully!</div>

          <div>
            <label class="block text-sm font-medium text-ink mb-1">Current Password</label>
            <input type="password" required id="currentPassword" autocomplete="new-password" class="w-full p-3 rounded-md border border-hairline bg-canvas focus:outline-none focus:border-brand transition-colors text-ink placeholder:text-mute" placeholder="••••••••" />
          </div>

          <div>
            <label class="block text-sm font-medium text-ink mb-1">New Password</label>
            <input type="password" required id="newPassword" autocomplete="new-password" class="w-full p-3 rounded-md border border-hairline bg-canvas focus:outline-none focus:border-brand transition-colors text-ink placeholder:text-mute" placeholder="••••••••" />
            <ul class="text-xs text-mute mt-2 space-y-1">
              <li id="rule-length" class="flex items-center gap-1"><span class="icon-placeholder w-3 h-3"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg></span> At least 8 characters</li>
              <li id="rule-upper" class="flex items-center gap-1"><span class="icon-placeholder w-3 h-3"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg></span> 1 uppercase & 1 lowercase</li>
              <li id="rule-num" class="flex items-center gap-1"><span class="icon-placeholder w-3 h-3"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg></span> 1 number</li>
              <li id="rule-spec" class="flex items-center gap-1"><span class="icon-placeholder w-3 h-3"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg></span> 1 special character</li>
            </ul>
          </div>

          <div>
            <label class="block text-sm font-medium text-ink mb-1">Confirm New Password</label>
            <input type="password" required id="confirmPassword" autocomplete="new-password" class="w-full p-3 rounded-md border border-hairline bg-canvas focus:outline-none focus:border-brand transition-colors text-ink placeholder:text-mute" placeholder="••••••••" />
          </div>

          <button type="submit" id="submitBtn" class="w-full py-3 bg-brand text-white rounded-md font-bold hover:bg-brand-deep transition-colors shadow-sm disabled:opacity-50 text-base cursor-pointer">
            Update Password
          </button>
        </form>
      </div>

      <!-- App Lock / PIN Security -->
      <div class="bg-canvas p-6 sm:p-8 rounded-2xl shadow-sm border border-hairline">
        <div class="flex items-center justify-between gap-4">
          <div>
            <h2 class="text-lg font-bold text-ink">App PIN / Passcode Lock</h2>
            <p class="text-xs sm:text-sm text-mute mt-1">Protect your financial data with a 4-digit PIN lock prompt when opening the app</p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer shrink-0">
            <input type="checkbox" id="pinToggle" class="sr-only peer">
            <div class="w-11 h-6 bg-canvas-soft peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-brand"></div>
          </label>
        </div>
      </div>

      <!-- Danger Zone: Permanent Delete Account -->
      <div class="bg-red-500/5 border border-red-500/20 p-6 sm:p-8 rounded-2xl">
        <h2 class="text-lg font-bold text-red-600 dark:text-red-400 mb-2">Danger Zone</h2>
        <p class="text-xs sm:text-sm text-mute mb-6">Permanently delete your user profile and database records. This action cannot be undone and next login will be treated as a brand new account.</p>
        
        <button type="button" id="openDeleteModalBtn" class="bg-red-600 hover:bg-red-700 text-white font-bold px-5 py-2.5 rounded-xl text-sm transition-colors cursor-pointer flex items-center gap-2">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
          Delete Account & Data
        </button>
      </div>

    </main>
  </div>

  <!-- Delete Account Confirmation Modal -->
  <dialog id="deleteModal" class="backdrop:bg-black/60 text-ink fixed inset-0 z-50 m-auto w-[90vw] max-w-md p-6 bg-canvas border border-hairline rounded-2xl shadow-2xl">
    <div class="flex flex-col gap-4">
      <div class="w-12 h-12 rounded-full bg-red-500/10 text-red-600 dark:text-red-400 flex items-center justify-center mx-auto">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      </div>
      <div class="text-center">
        <h3 class="text-xl font-bold text-ink">Delete Account & Data?</h3>
        <p class="text-xs text-mute mt-2">This will permanently erase your Firestore user profile, sign you out, and delete your authentication account. Type <strong class="text-red-500 font-mono">DELETE</strong> below to confirm.</p>
      </div>

      <div>
        <input type="text" id="confirmDeleteInput" class="w-full p-3 rounded-xl border border-hairline bg-canvas-soft text-ink font-mono text-center uppercase tracking-widest focus:outline-none focus:border-red-500" placeholder="DELETE" />
      </div>

      <div class="flex gap-3 mt-2">
        <button type="button" id="cancelDeleteBtn" class="flex-1 py-2.5 rounded-xl border border-hairline bg-canvas-soft text-ink font-medium hover:bg-hairline transition-colors cursor-pointer">Cancel</button>
        <button type="button" id="confirmDeleteBtn" disabled class="flex-1 py-2.5 rounded-xl bg-red-600 text-white font-bold hover:bg-red-700 transition-colors disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer">Delete Forever</button>
      </div>
    </div>
  </dialog>

  <!-- PIN Setup Modal -->
  <dialog id="pinModal" class="backdrop:bg-black/60 text-ink fixed inset-0 z-50 m-auto w-[90vw] max-w-xs p-6 bg-canvas border border-hairline rounded-2xl shadow-2xl">
    <div class="flex flex-col items-center gap-4 text-center">
      <div class="w-12 h-12 rounded-full bg-brand/10 text-brand flex items-center justify-center">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      </div>
      <h3 class="text-lg font-bold text-ink">Set 4-Digit Passcode</h3>
      <input type="password" id="pinInput" maxlength="4" pattern="[0-9]*" inputmode="numeric" class="w-32 text-center text-2xl font-mono tracking-[0.5em] p-2.5 border border-hairline rounded-xl bg-canvas-soft focus:outline-none focus:border-brand" placeholder="••••" />
      <div class="flex gap-2 w-full mt-2">
        <button type="button" id="cancelPinBtn" class="flex-1 py-2 rounded-lg border border-hairline text-xs font-medium hover:bg-canvas-soft">Cancel</button>
        <button type="button" id="savePinBtn" class="flex-1 py-2 rounded-lg bg-brand text-white text-xs font-bold hover:bg-brand-deep">Save PIN</button>
      </div>
    </div>
  </dialog>

  <script>
    import { auth, db } from '../firebase';
    import { doc, deleteDoc } from 'firebase/firestore';
    import { EmailAuthProvider, reauthenticateWithCredential, updatePassword, deleteUser } from 'firebase/auth';

    const form = document.getElementById('changePasswordForm') as HTMLFormElement;
    const currentPassword = document.getElementById('currentPassword') as HTMLInputElement;
    const newPassword = document.getElementById('newPassword') as HTMLInputElement;
    const confirmPassword = document.getElementById('confirmPassword') as HTMLInputElement;
    const errorBox = document.getElementById('errorBox') as HTMLDivElement;
    const successBox = document.getElementById('successBox') as HTMLDivElement;
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;

    // PIN Lock setup logic
    const pinToggle = document.getElementById('pinToggle') as HTMLInputElement;
    const pinModal = document.getElementById('pinModal') as HTMLDialogElement;
    const pinInput = document.getElementById('pinInput') as HTMLInputElement;
    const cancelPinBtn = document.getElementById('cancelPinBtn');
    const savePinBtn = document.getElementById('savePinBtn');

    if (localStorage.getItem('splitsbug_pin_enabled') === 'true') {
      pinToggle.checked = true;
    }

    pinToggle?.addEventListener('change', () => {
      if (pinToggle.checked) {
        pinInput.value = '';
        pinModal.showModal();
      } else {
        localStorage.removeItem('splitsbug_pin_enabled');
        localStorage.removeItem('splitsbug_pin_val');
      }
    });

    cancelPinBtn?.addEventListener('click', () => {
      pinModal.close();
      pinToggle.checked = localStorage.getItem('splitsbug_pin_enabled') === 'true';
    });

    savePinBtn?.addEventListener('click', () => {
      if (pinInput.value.length === 4) {
        localStorage.setItem('splitsbug_pin_enabled', 'true');
        localStorage.setItem('splitsbug_pin_val', pinInput.value);
        pinModal.close();
      } else {
        alert('Passcode must be exactly 4 digits.');
      }
    });

    // Delete Account Logic
    const openDeleteModalBtn = document.getElementById('openDeleteModalBtn');
    const deleteModal = document.getElementById('deleteModal') as HTMLDialogElement;
    const confirmDeleteInput = document.getElementById('confirmDeleteInput') as HTMLInputElement;
    const cancelDeleteBtn = document.getElementById('cancelDeleteBtn');
    const confirmDeleteBtn = document.getElementById('confirmDeleteBtn') as HTMLButtonElement;

    openDeleteModalBtn?.addEventListener('click', () => {
      confirmDeleteInput.value = '';
      confirmDeleteBtn.disabled = true;
      deleteModal.showModal();
    });

    cancelDeleteBtn?.addEventListener('click', () => {
      deleteModal.close();
    });

    confirmDeleteInput?.addEventListener('input', () => {
      confirmDeleteBtn.disabled = confirmDeleteInput.value.trim().toUpperCase() !== 'DELETE';
    });

    confirmDeleteBtn?.addEventListener('click', async () => {
      const user = auth.currentUser;
      if (!user) return;

      confirmDeleteBtn.disabled = true;
      confirmDeleteBtn.textContent = 'Deleting...';

      try {
        const userEmail = user.email;
        const uid = user.uid;

        // 1. Delete user documents from Firestore
        if (userEmail) {
          await deleteDoc(doc(db, 'users', userEmail)).catch(e => console.warn(e));
        }
        await deleteDoc(doc(db, 'users', uid)).catch(e => console.warn(e));

        // 2. Delete user from Firebase Auth
        await deleteUser(user);

        // 3. Clear storage
        localStorage.clear();
        sessionStorage.clear();

        // 4. Redirect to signup as fresh account
        window.location.href = '/signup?deleted=true';
      } catch (err: any) {
        console.error('Account deletion error:', err);
        alert(err.message || 'Failed to delete account. You may need to log out and log back in to perform this action.');
        confirmDeleteBtn.disabled = false;
        confirmDeleteBtn.textContent = 'Delete Forever';
      }
    });

    // Password validation logic
    const ruleLength = document.getElementById('rule-length');
    const ruleUpper = document.getElementById('rule-upper');
    const ruleNum = document.getElementById('rule-num');
    const ruleSpec = document.getElementById('rule-spec');

    function validatePassword(val: string) {
      const len = val.length >= 8;
      const upper = /[A-Z]/.test(val) && /[a-z]/.test(val);
      const num = /[0-9]/.test(val);
      const spec = /[^a-zA-Z0-9]/.test(val);
      
      const checkIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`;
      const circleIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>`;
      
      if (ruleLength) {
        ruleLength.className = `flex items-center gap-1 ${len ? 'text-brand' : 'text-mute'}`;
        ruleLength.querySelector('.icon-placeholder')!.innerHTML = len ? checkIcon : circleIcon;
      }
      if (ruleUpper) {
        ruleUpper.className = `flex items-center gap-1 ${upper ? 'text-brand' : 'text-mute'}`;
        ruleUpper.querySelector('.icon-placeholder')!.innerHTML = upper ? checkIcon : circleIcon;
      }
      if (ruleNum) {
        ruleNum.className = `flex items-center gap-1 ${num ? 'text-brand' : 'text-mute'}`;
        ruleNum.querySelector('.icon-placeholder')!.innerHTML = num ? checkIcon : circleIcon;
      }
      if (ruleSpec) {
        ruleSpec.className = `flex items-center gap-1 ${spec ? 'text-brand' : 'text-mute'}`;
        ruleSpec.querySelector('.icon-placeholder')!.innerHTML = spec ? checkIcon : circleIcon;
      }
      
      return len && upper && num && spec;
    }

    newPassword.addEventListener('input', () => {
      validatePassword(newPassword.value);
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.classList.add('hidden');
      successBox.classList.add('hidden');

      if (!validatePassword(newPassword.value)) {
        errorBox.textContent = "Please ensure the new password meets all requirements.";
        errorBox.classList.remove('hidden');
        return;
      }

      if (newPassword.value !== confirmPassword.value) {
        errorBox.textContent = "New passwords do not match.";
        errorBox.classList.remove('hidden');
        return;
      }

      if (currentPassword.value === newPassword.value) {
        errorBox.textContent = "New password cannot be the same as the old password.";
        errorBox.classList.remove('hidden');
        return;
      }

      const user = auth.currentUser;
      if (!user || !user.email) {
        errorBox.textContent = "You must be logged in to change your password.";
        errorBox.classList.remove('hidden');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Updating...';

      try {
        const credential = EmailAuthProvider.credential(user.email, currentPassword.value);
        await reauthenticateWithCredential(user, credential);
        
        await updatePassword(user, newPassword.value);
        
        successBox.classList.remove('hidden');
        form.reset();
        
        setTimeout(() => {
          window.location.href = '/account';
        }, 1500);

      } catch (error: any) {
        if (error.code === 'auth/invalid-credential' || error.code === 'auth/wrong-password') {
          errorBox.textContent = "Incorrect current password.";
        } else {
          errorBox.textContent = error.message || "Failed to update password. Please try again.";
        }
        errorBox.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Update Password';
      }
    });
  </script>
</Layout>

