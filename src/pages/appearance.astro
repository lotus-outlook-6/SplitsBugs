---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="min-h-screen flex flex-col bg-canvas-soft pb-32">
    <!-- Header -->
    <header class="h-16 px-4 lg:px-6 flex items-center gap-4 border-b border-hairline bg-canvas sticky top-0 z-40">
      <a href="/account" class="w-10 h-10 flex items-center justify-center rounded-full bg-canvas-soft hover:bg-hairline transition-colors text-ink">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      </a>
      <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-ink">Appearance</h1>
    </header>

    <main class="flex-1 w-full max-w-5xl mx-auto p-4 sm:p-6 lg:p-8 pb-16">
      <p class="text-mute mb-4 text-sm sm:text-base">Customize how SplitBugs looks on this device.</p>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-3 gap-3 sm:gap-6" id="themeGrid">
        
        <!-- System Default -->
        <button type="button" class="theme-card relative group text-left rounded-2xl overflow-hidden border-2 border-hairline hover:border-brand transition-colors bg-canvas focus:outline-none" data-theme="system">
          <div class="absolute inset-0 bg-gradient-to-br from-transparent to-black/5 pointer-events-none"></div>
          <div class="p-4 border-b border-hairline bg-canvas flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-canvas-soft flex items-center justify-center text-ink border border-hairline">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
            </div>
            <div class="flex-1">
              <div class="h-2.5 w-24 bg-ink opacity-20 rounded-full mb-1.5"></div>
              <div class="h-2 w-16 bg-ink opacity-10 rounded-full"></div>
            </div>
          </div>
          <div class="p-3 sm:p-5 flex flex-col gap-2 sm:gap-3 bg-canvas-soft h-24 sm:h-32">
            <div class="self-end bg-brand text-white text-[10px] sm:text-xs px-2 py-1 sm:px-3 sm:py-2 rounded-xl sm:rounded-2xl rounded-tr-sm shadow-sm truncate max-w-full">Follows device settings</div>
            <div class="self-start bg-canvas border border-hairline text-ink text-[10px] sm:text-xs px-2 py-1 sm:px-3 sm:py-2 rounded-xl sm:rounded-2xl rounded-tl-sm shadow-sm truncate max-w-full">Matches your system</div>
          </div>
          <div class="p-4 border-t border-hairline bg-canvas flex items-center justify-between">
            <span class="font-bold text-ink">System Default</span>
            <div class="w-5 h-5 rounded-full border border-hairline flex items-center justify-center check-indicator">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-white hidden"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
          </div>
        </button>

        <!-- Light (White) -->
        <button type="button" class="theme-card relative group text-left rounded-2xl overflow-hidden border-2 border-[#ebebeb] hover:border-[#6366f1] transition-colors bg-[#ffffff] focus:outline-none" data-theme="light-white">
          <div class="p-4 border-b border-[#ebebeb] bg-[#ffffff] flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-[#f4f4f5] flex items-center justify-center text-[#171717] border border-[#ebebeb]">
              <span class="font-bold text-xs">W</span>
            </div>
            <div class="flex-1">
              <div class="h-2.5 w-24 bg-[#171717] opacity-20 rounded-full mb-1.5"></div>
              <div class="h-2 w-16 bg-[#171717] opacity-10 rounded-full"></div>
            </div>
          </div>
          <div class="p-3 sm:p-5 flex flex-col gap-2 sm:gap-3 bg-[#f4f4f5] h-24 sm:h-32">
            <div class="self-end bg-[#6366f1] text-white text-[10px] sm:text-xs px-2 py-1 sm:px-3 sm:py-2 rounded-xl sm:rounded-2xl rounded-tr-sm shadow-sm truncate max-w-full">Hello, White!</div>
            <div class="self-start bg-[#ffffff] border border-[#ebebeb] text-[#171717] text-[10px] sm:text-xs px-2 py-1 sm:px-3 sm:py-2 rounded-xl sm:rounded-2xl rounded-tl-sm shadow-sm truncate max-w-full">Clean and bright</div>
          </div>
          <div class="p-4 border-t border-[#ebebeb] bg-[#ffffff] flex items-center justify-between">
            <span class="font-bold text-[#171717]">Light (White)</span>
            <div class="w-5 h-5 rounded-full border border-[#ebebeb] flex items-center justify-center check-indicator">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-white hidden"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
          </div>
        </button>

        <!-- Light (Cream) -->
        <button type="button" class="theme-card relative group text-left rounded-2xl overflow-hidden border-2 border-[#e3d3b6] hover:border-[#6366f1] transition-colors bg-[#fffaed] focus:outline-none" data-theme="light-cream">
          <div class="p-4 border-b border-[#e3d3b6] bg-[#fffaed] flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-[#f4ead5] flex items-center justify-center text-[#2f271a] border border-[#e3d3b6]">
              <span class="font-bold text-xs">C</span>
            </div>
            <div class="flex-1">
              <div class="h-2.5 w-24 bg-[#2f271a] opacity-20 rounded-full mb-1.5"></div>
              <div class="h-2 w-16 bg-[#2f271a] opacity-10 rounded-full"></div>
            </div>
          </div>
          <div class="p-3 sm:p-5 flex flex-col gap-2 sm:gap-3 bg-[#f4ead5] h-24 sm:h-32">
            <div class="self-end bg-[#6366f1] text-white text-[10px] sm:text-xs px-2 py-1 sm:px-3 sm:py-2 rounded-xl sm:rounded-2xl rounded-tr-sm shadow-sm truncate max-w-full">Warm and cozy</div>
            <div class="self-start bg-[#fffaed] border border-[#e3d3b6] text-[#2f271a] text-[10px] sm:text-xs px-2 py-1 sm:px-3 sm:py-2 rounded-xl sm:rounded-2xl rounded-tl-sm shadow-sm truncate max-w-full">Easy on the eyes</div>
          </div>
          <div class="p-4 border-t border-[#e3d3b6] bg-[#fffaed] flex items-center justify-between">
            <span class="font-bold text-[#2f271a]">Light (Cream)</span>
            <div class="w-5 h-5 rounded-full border border-[#e3d3b6] flex items-center justify-center check-indicator">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-white hidden"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
          </div>
        </button>

        <!-- Dark (Grey) -->
        <button type="button" class="theme-card relative group text-left rounded-2xl overflow-hidden border-2 border-[#2e2e33] hover:border-[#818cf8] transition-colors bg-[#1a1a1c] focus:outline-none" data-theme="dark-grey">
          <div class="p-4 border-b border-[#2e2e33] bg-[#1a1a1c] flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-[#28282c] flex items-center justify-center text-[#f0f0f2] border border-[#2e2e33]">
              <span class="font-bold text-xs">G</span>
            </div>
            <div class="flex-1">
              <div class="h-2.5 w-24 bg-[#f0f0f2] opacity-20 rounded-full mb-1.5"></div>
              <div class="h-2 w-16 bg-[#f0f0f2] opacity-10 rounded-full"></div>
            </div>
          </div>
          <div class="p-3 sm:p-5 flex flex-col gap-2 sm:gap-3 bg-[#28282c] h-24 sm:h-32">
            <div class="self-end bg-[#818cf8] text-white text-[10px] sm:text-xs px-2 py-1 sm:px-3 sm:py-2 rounded-xl sm:rounded-2xl rounded-tr-sm shadow-sm truncate max-w-full">Hello, Darkness!</div>
            <div class="self-start bg-[#1a1a1c] border border-[#2e2e33] text-[#f0f0f2] text-[10px] sm:text-xs px-2 py-1 sm:px-3 sm:py-2 rounded-xl sm:rounded-2xl rounded-tl-sm shadow-sm truncate max-w-full">Sleek grey tones</div>
          </div>
          <div class="p-4 border-t border-[#2e2e33] bg-[#1a1a1c] flex items-center justify-between">
            <span class="font-bold text-[#f0f0f2]">Dark (Grey)</span>
            <div class="w-5 h-5 rounded-full border border-[#2e2e33] flex items-center justify-center check-indicator">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-white hidden"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
          </div>
        </button>

        <!-- Dark (AMOLED) -->
        <button type="button" class="theme-card relative group text-left rounded-2xl overflow-hidden border-2 border-[#2f2f2f] hover:border-[#818cf8] transition-colors bg-[#000000] focus:outline-none" data-theme="dark-amoled">
          <div class="p-4 border-b border-[#2f2f2f] bg-[#000000] flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-[#0a0a0a] flex items-center justify-center text-[#ffffff] border border-[#2f2f2f]">
              <span class="font-bold text-xs">A</span>
            </div>
            <div class="flex-1">
              <div class="h-2.5 w-24 bg-[#ffffff] opacity-20 rounded-full mb-1.5"></div>
              <div class="h-2 w-16 bg-[#ffffff] opacity-10 rounded-full"></div>
            </div>
          </div>
          <div class="p-3 sm:p-5 flex flex-col gap-2 sm:gap-3 bg-[#0a0a0a] h-24 sm:h-32">
            <div class="self-end bg-[#818cf8] text-white text-[10px] sm:text-xs px-2 py-1 sm:px-3 sm:py-2 rounded-xl sm:rounded-2xl rounded-tr-sm shadow-sm truncate max-w-full">Pitch Black</div>
            <div class="self-start bg-[#000000] border border-[#2f2f2f] text-[#ffffff] text-[10px] sm:text-xs px-2 py-1 sm:px-3 sm:py-2 rounded-xl sm:rounded-2xl rounded-tl-sm shadow-sm truncate max-w-full">Saves battery</div>
          </div>
          <div class="p-4 border-t border-[#2f2f2f] bg-[#000000] flex items-center justify-between">
            <span class="font-bold text-[#ffffff]">Dark (AMOLED)</span>
            <div class="w-5 h-5 rounded-full border border-[#2f2f2f] flex items-center justify-center check-indicator">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-white hidden"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
          </div>
        </button>

      </div>
    </main>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const savedTheme = localStorage.getItem('splitbug_theme') || 'system';
      const cards = document.querySelectorAll('.theme-card');

      function updateActiveState(activeTheme: string) {
        cards.forEach(card => {
          const isSelected = card.getAttribute('data-theme') === activeTheme;
          const indicator = card.querySelector('.check-indicator');
          const checkIcon = indicator?.querySelector('svg');
          
          if (isSelected) {
            // Apply selected styling
            card.classList.add('ring-2', 'ring-brand', 'ring-offset-2', 'ring-offset-canvas');
            if (indicator) {
              indicator.classList.remove('border-hairline', 'border-[#ebebeb]', 'border-[#e3d3b6]', 'border-[#2e2e33]', 'border-[#2f2f2f]');
              indicator.classList.add('bg-brand', 'border-brand');
            }
            if (checkIcon) checkIcon.classList.remove('hidden');
          } else {
            // Remove selected styling
            card.classList.remove('ring-2', 'ring-brand', 'ring-offset-2', 'ring-offset-canvas');
            if (indicator) {
              indicator.classList.remove('bg-brand', 'border-brand');
              // Restore original border color based on theme
              const t = card.getAttribute('data-theme');
              if (t === 'system') indicator.classList.add('border-hairline');
              else if (t === 'light-white') indicator.classList.add('border-[#ebebeb]');
              else if (t === 'light-cream') indicator.classList.add('border-[#e3d3b6]');
              else if (t === 'dark-grey') indicator.classList.add('border-[#2e2e33]');
              else if (t === 'dark-amoled') indicator.classList.add('border-[#2f2f2f]');
            }
            if (checkIcon) checkIcon.classList.add('hidden');
          }
        });
      }

      updateActiveState(savedTheme);

      cards.forEach(card => {
        card.addEventListener('click', () => {
          const themeName = card.getAttribute('data-theme');
          if (themeName) {
            localStorage.setItem('splitbug_theme', themeName);
            if (typeof (window as any).applyTheme === 'function') {
              (window as any).applyTheme(themeName);
            }
            updateActiveState(themeName);
          }
        });
      });
    });
  </script>
</Layout>
