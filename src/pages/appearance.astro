---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="min-h-screen flex flex-col bg-canvas-soft pb-32">
    <!-- Header -->
    <header class="h-16 px-4 lg:px-6 flex items-center gap-4 border-b border-hairline bg-canvas sticky top-0 z-40">
      <a href="/account" class="w-10 h-10 flex items-center justify-center rounded-full bg-canvas-soft hover:bg-hairline transition-colors text-ink">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      </a>
      <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-ink">Appearance</h1>
    </header>

    <main class="flex-1 w-full max-w-5xl mx-auto p-4 sm:p-6 lg:p-8">
      <p class="text-mute mb-4 text-sm sm:text-base">Customize how SplitBugs looks on this device.</p>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-3 gap-3 sm:gap-6" id="themeGrid">
        
        <!-- System Default -->
        <button id="card-system" type="button" class="theme-card preview-light-white relative group text-left rounded-2xl overflow-hidden border-2 border-[var(--p-border)] hover:border-[var(--p-brand)] transition-colors bg-[var(--p-canvas)] focus:outline-none" data-theme="system">
          <div class="absolute inset-0 bg-gradient-to-br from-transparent to-black/5 pointer-events-none"></div>
          <div class="p-4 border-b border-[var(--p-border)] bg-[var(--p-canvas)] flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-[var(--p-soft)] flex items-center justify-center text-[var(--p-ink)] border border-[var(--p-border)]">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
            </div>
            <div class="flex-1">
              <div class="h-2.5 w-24 bg-[var(--p-ink)] opacity-20 rounded-full mb-1.5"></div>
              <div class="h-2 w-16 bg-[var(--p-ink)] opacity-10 rounded-full"></div>
            </div>
          </div>
          <div class="p-3 sm:p-5 flex flex-col gap-2 sm:gap-3 bg-[var(--p-soft)] h-24 sm:h-32">
            <div class="self-end bg-[var(--p-brand)] text-white text-[10px] sm:text-xs px-2 py-1 sm:px-3 sm:py-2 rounded-xl sm:rounded-2xl rounded-tr-sm shadow-sm truncate max-w-full">Follows device</div>
            <div class="self-start bg-[var(--p-canvas)] border border-[var(--p-border)] text-[var(--p-ink)] text-[10px] sm:text-xs px-2 py-1 sm:px-3 sm:py-2 rounded-xl sm:rounded-2xl rounded-tl-sm shadow-sm truncate max-w-full">Auto light/dark</div>
          </div>
          <div class="p-4 border-t border-[var(--p-border)] bg-[var(--p-canvas)] flex items-center justify-between">
            <span class="font-bold text-[var(--p-ink)]">System Default</span>
            <div class="w-5 h-5 rounded-full border border-[var(--p-border)] flex items-center justify-center check-indicator">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-white hidden"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
          </div>
        </button>

        <!-- Light (White) -->
        <button type="button" class="theme-card preview-light-white relative group text-left rounded-2xl overflow-hidden border-2 border-[var(--p-border)] hover:border-[var(--p-brand)] transition-colors bg-[var(--p-canvas)] focus:outline-none" data-theme="light-white">
          <div class="p-4 border-b border-[var(--p-border)] bg-[var(--p-canvas)] flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-[var(--p-soft)] flex items-center justify-center text-[var(--p-ink)] border border-[var(--p-border)]">
              <span class="font-bold text-xs">W</span>
            </div>
            <div class="flex-1">
              <div class="h-2.5 w-24 bg-[var(--p-ink)] opacity-20 rounded-full mb-1.5"></div>
              <div class="h-2 w-16 bg-[var(--p-ink)] opacity-10 rounded-full"></div>
            </div>
          </div>
          <div class="p-3 sm:p-5 flex flex-col gap-2 sm:gap-3 bg-[var(--p-soft)] h-24 sm:h-32">
            <div class="self-end bg-[var(--p-brand)] text-white text-[10px] sm:text-xs px-2 py-1 sm:px-3 sm:py-2 rounded-xl sm:rounded-2xl rounded-tr-sm shadow-sm truncate max-w-full">Hello, White!</div>
            <div class="self-start bg-[var(--p-canvas)] border border-[var(--p-border)] text-[var(--p-ink)] text-[10px] sm:text-xs px-2 py-1 sm:px-3 sm:py-2 rounded-xl sm:rounded-2xl rounded-tl-sm shadow-sm truncate max-w-full">Clean and bright</div>
          </div>
          <div class="p-4 border-t border-[var(--p-border)] bg-[var(--p-canvas)] flex items-center justify-between">
            <span class="font-bold text-[var(--p-ink)]">Light (White)</span>
            <div class="w-5 h-5 rounded-full border border-[var(--p-border)] flex items-center justify-center check-indicator">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-white hidden"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
          </div>
        </button>

        <!-- Light (Cream) -->
        <button type="button" class="theme-card preview-light-cream relative group text-left rounded-2xl overflow-hidden border-2 border-[var(--p-border)] hover:border-[var(--p-brand)] transition-colors bg-[var(--p-canvas)] focus:outline-none" data-theme="light-cream">
          <div class="p-4 border-b border-[var(--p-border)] bg-[var(--p-canvas)] flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-[var(--p-soft)] flex items-center justify-center text-[var(--p-ink)] border border-[var(--p-border)]">
              <span class="font-bold text-xs">C</span>
            </div>
            <div class="flex-1">
              <div class="h-2.5 w-24 bg-[var(--p-ink)] opacity-20 rounded-full mb-1.5"></div>
              <div class="h-2 w-16 bg-[var(--p-ink)] opacity-10 rounded-full"></div>
            </div>
          </div>
          <div class="p-3 sm:p-5 flex flex-col gap-2 sm:gap-3 bg-[var(--p-soft)] h-24 sm:h-32">
            <div class="self-end bg-[var(--p-brand)] text-white text-[10px] sm:text-xs px-2 py-1 sm:px-3 sm:py-2 rounded-xl sm:rounded-2xl rounded-tr-sm shadow-sm truncate max-w-full">Warm and cozy</div>
            <div class="self-start bg-[var(--p-canvas)] border border-[var(--p-border)] text-[var(--p-ink)] text-[10px] sm:text-xs px-2 py-1 sm:px-3 sm:py-2 rounded-xl sm:rounded-2xl rounded-tl-sm shadow-sm truncate max-w-full">Easy on the eyes</div>
          </div>
          <div class="p-4 border-t border-[var(--p-border)] bg-[var(--p-canvas)] flex items-center justify-between">
            <span class="font-bold text-[var(--p-ink)]">Light (Cream)</span>
            <div class="w-5 h-5 rounded-full border border-[var(--p-border)] flex items-center justify-center check-indicator">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-white hidden"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
          </div>
        </button>

        <!-- Dark (Grey) -->
        <button type="button" class="theme-card preview-dark-grey relative group text-left rounded-2xl overflow-hidden border-2 border-[var(--p-border)] hover:border-[var(--p-brand)] transition-colors bg-[var(--p-canvas)] focus:outline-none" data-theme="dark-grey">
          <div class="p-4 border-b border-[var(--p-border)] bg-[var(--p-canvas)] flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-[var(--p-soft)] flex items-center justify-center text-[var(--p-ink)] border border-[var(--p-border)]">
              <span class="font-bold text-xs">G</span>
            </div>
            <div class="flex-1">
              <div class="h-2.5 w-24 bg-[var(--p-ink)] opacity-20 rounded-full mb-1.5"></div>
              <div class="h-2 w-16 bg-[var(--p-ink)] opacity-10 rounded-full"></div>
            </div>
          </div>
          <div class="p-3 sm:p-5 flex flex-col gap-2 sm:gap-3 bg-[var(--p-soft)] h-24 sm:h-32">
            <div class="self-end bg-[var(--p-brand)] text-white text-[10px] sm:text-xs px-2 py-1 sm:px-3 sm:py-2 rounded-xl sm:rounded-2xl rounded-tr-sm shadow-sm truncate max-w-full">Hello, Darkness!</div>
            <div class="self-start bg-[var(--p-canvas)] border border-[var(--p-border)] text-[var(--p-ink)] text-[10px] sm:text-xs px-2 py-1 sm:px-3 sm:py-2 rounded-xl sm:rounded-2xl rounded-tl-sm shadow-sm truncate max-w-full">Sleek grey tones</div>
          </div>
          <div class="p-4 border-t border-[var(--p-border)] bg-[var(--p-canvas)] flex items-center justify-between">
            <span class="font-bold text-[var(--p-ink)]">Dark (Grey)</span>
            <div class="w-5 h-5 rounded-full border border-[var(--p-border)] flex items-center justify-center check-indicator">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-white hidden"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
          </div>
        </button>

        <!-- Dark (AMOLED) -->
        <button type="button" class="theme-card preview-dark-amoled relative group text-left rounded-2xl overflow-hidden border-2 border-[var(--p-border)] hover:border-[var(--p-brand)] transition-colors bg-[var(--p-canvas)] focus:outline-none" data-theme="dark-amoled">
          <div class="p-4 border-b border-[var(--p-border)] bg-[var(--p-canvas)] flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-[var(--p-soft)] flex items-center justify-center text-[var(--p-ink)] border border-[var(--p-border)]">
              <span class="font-bold text-xs">A</span>
            </div>
            <div class="flex-1">
              <div class="h-2.5 w-24 bg-[var(--p-ink)] opacity-20 rounded-full mb-1.5"></div>
              <div class="h-2 w-16 bg-[var(--p-ink)] opacity-10 rounded-full"></div>
            </div>
          </div>
          <div class="p-3 sm:p-5 flex flex-col gap-2 sm:gap-3 bg-[var(--p-soft)] h-24 sm:h-32">
            <div class="self-end bg-[var(--p-brand)] text-white text-[10px] sm:text-xs px-2 py-1 sm:px-3 sm:py-2 rounded-xl sm:rounded-2xl rounded-tr-sm shadow-sm truncate max-w-full">Pitch Black</div>
            <div class="self-start bg-[var(--p-canvas)] border border-[var(--p-border)] text-[var(--p-ink)] text-[10px] sm:text-xs px-2 py-1 sm:px-3 sm:py-2 rounded-xl sm:rounded-2xl rounded-tl-sm shadow-sm truncate max-w-full">Saves battery</div>
          </div>
          <div class="p-4 border-t border-[var(--p-border)] bg-[var(--p-canvas)] flex items-center justify-between">
            <span class="font-bold text-[var(--p-ink)]">Dark (AMOLED)</span>
            <div class="w-5 h-5 rounded-full border border-[var(--p-border)] flex items-center justify-center check-indicator">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-white hidden"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
          </div>
        </button>

        <!-- Splitsbug Custom -->
        <button id="card-splitsbug" type="button" class="theme-card preview-light-white relative group text-left rounded-2xl overflow-hidden border-2 border-[var(--p-border)] hover:border-[var(--p-brand)] transition-colors bg-[var(--p-canvas)] focus:outline-none" data-theme="splitsbug">
          <div class="absolute inset-0 bg-brand/5 pointer-events-none"></div>
          <div class="p-4 border-b border-[var(--p-border)] bg-[var(--p-canvas)] flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-[var(--p-brand)] flex items-center justify-center text-white border border-brand/20">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            </div>
            <div class="flex-1">
              <div class="h-2.5 w-24 bg-[var(--p-ink)] opacity-20 rounded-full mb-1.5"></div>
              <div class="h-2 w-16 bg-[var(--p-ink)] opacity-10 rounded-full"></div>
            </div>
          </div>
          <div class="p-3 sm:p-5 flex flex-col gap-2 sm:gap-3 bg-[var(--p-soft)] h-24 sm:h-32">
            <div class="self-end bg-[var(--p-brand)] text-white text-[10px] sm:text-xs px-2 py-1 sm:px-3 sm:py-2 rounded-xl sm:rounded-2xl rounded-tr-sm shadow-sm truncate max-w-full">Changes automatically</div>
            <div class="self-start bg-[var(--p-canvas)] border border-[var(--p-border)] text-[var(--p-ink)] text-[10px] sm:text-xs px-2 py-1 sm:px-3 sm:py-2 rounded-xl sm:rounded-2xl rounded-tl-sm shadow-sm truncate max-w-full">Time based shifts</div>
          </div>
          <div class="p-4 border-t border-[var(--p-border)] bg-[var(--p-canvas)] flex items-center justify-between">
            <span class="font-bold text-[var(--p-ink)]">Splitsbug Theme</span>
            <div class="w-5 h-5 rounded-full border border-[var(--p-border)] flex items-center justify-center check-indicator">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-white hidden"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
          </div>
        </button>

      </div>
    </main>
  </div>

  <style>
    .preview-light-white { --p-canvas: #ffffff; --p-soft: #f4f4f5; --p-ink: #171717; --p-border: #ebebeb; --p-brand: #6366f1; }
    .preview-light-cream { --p-canvas: #fffaed; --p-soft: #f4ead5; --p-ink: #2f271a; --p-border: #e3d3b6; --p-brand: #6366f1; }
    .preview-dark-grey { --p-canvas: #1a1a1c; --p-soft: #28282c; --p-ink: #f0f0f2; --p-border: #2e2e33; --p-brand: #818cf8; }
    .preview-dark-amoled { --p-canvas: #000000; --p-soft: #0a0a0a; --p-ink: #ffffff; --p-border: #2f2f2f; --p-brand: #818cf8; }
  </style>
  <script>
    import { auth, db } from '../firebase';
    import { doc, getDoc, updateDoc } from 'firebase/firestore';
    import { onAuthStateChanged } from 'firebase/auth';

    document.addEventListener('DOMContentLoaded', () => {
      const savedTheme = localStorage.getItem('splitbug_theme') || 'system';
      const cards = document.querySelectorAll('.theme-card');
      const cardSystem = document.getElementById('card-system');
      const cardSplitsbug = document.getElementById('card-splitsbug');

      function updateDynamicPreviews() {
        if (cardSystem) {
          const isDarkOS = window.matchMedia('(prefers-color-scheme: dark)').matches;
          cardSystem.classList.remove('preview-light-white', 'preview-light-cream', 'preview-dark-grey', 'preview-dark-amoled');
          cardSystem.classList.add(isDarkOS ? 'preview-dark-grey' : 'preview-light-white');
        }
        if (cardSplitsbug) {
          const hour = new Date().getHours();
          let sbTheme = 'preview-light-white';
          if (hour >= 5 && hour < 7) sbTheme = 'preview-light-cream';
          else if (hour >= 7 && hour < 17) sbTheme = 'preview-light-white';
          else if (hour >= 17 && hour < 18) sbTheme = 'preview-light-cream';
          else if (hour >= 18 && hour < 21) sbTheme = 'preview-dark-grey';
          else sbTheme = 'preview-dark-amoled';
          
          cardSplitsbug.classList.remove('preview-light-white', 'preview-light-cream', 'preview-dark-grey', 'preview-dark-amoled');
          cardSplitsbug.classList.add(sbTheme);
        }
      }

      function updateActiveState(activeTheme: string) {
        cards.forEach(card => {
          const isSelected = card.getAttribute('data-theme') === activeTheme;
          const indicator = card.querySelector('.check-indicator');
          const checkIcon = indicator?.querySelector('svg');
          
          if (isSelected) {
            // Apply selected styling
            card.classList.add('ring-2', 'ring-[var(--p-brand)]', 'ring-offset-2', 'ring-offset-canvas');
            if (indicator) {
              indicator.classList.remove('border-[var(--p-border)]');
              indicator.classList.add('bg-[var(--p-brand)]', 'border-[var(--p-brand)]');
            }
            if (checkIcon) checkIcon.classList.remove('hidden');
          } else {
            // Remove selected styling
            card.classList.remove('ring-2', 'ring-[var(--p-brand)]', 'ring-offset-2', 'ring-offset-canvas');
            if (indicator) {
              indicator.classList.remove('bg-[var(--p-brand)]', 'border-[var(--p-brand)]');
              indicator.classList.add('border-[var(--p-border)]');
            }
            if (checkIcon) checkIcon.classList.add('hidden');
          }
        });
      }

      // Initial Update
      updateDynamicPreviews();
      updateActiveState(savedTheme);

      // Listeners for dynamic updates
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', updateDynamicPreviews);
      setInterval(updateDynamicPreviews, 60000); // update splitsbug preview every minute

      cards.forEach(card => {
        card.addEventListener('click', async () => {
          const themeName = card.getAttribute('data-theme');
          if (themeName) {
            localStorage.setItem('splitbug_theme', themeName);
            if (typeof (window as any).applyTheme === 'function') {
              (window as any).applyTheme(themeName);
            }
            updateActiveState(themeName);

            // Persist to Firestore
            try {
              const user = auth.currentUser;
              if (user) {
                await updateDoc(doc(db, 'users', user.uid), { appTheme: themeName });
              }
            } catch (e) {
              console.error('Failed to save theme to Firestore:', e);
            }
          }
        });
      });

      // On load: sync theme from Firestore in case user switched devices
      onAuthStateChanged(auth, async (user) => {
        if (user) {
          try {
            const userDoc = await getDoc(doc(db, 'users', user.uid));
            if (userDoc.exists()) {
              const appTheme = userDoc.data().appTheme;
              if (appTheme && appTheme !== savedTheme) {
                localStorage.setItem('splitbug_theme', appTheme);
                if (typeof (window as any).applyTheme === 'function') {
                  (window as any).applyTheme(appTheme);
                }
                updateActiveState(appTheme);
              }
            }
          } catch(e) {}
        }
      });
    });
  </script>
</Layout>
