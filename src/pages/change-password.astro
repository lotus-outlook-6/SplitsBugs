---
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <div class="min-h-screen flex flex-col bg-canvas-soft pb-32">
    <!-- Header -->
    <header class="h-16 px-4 lg:px-6 flex items-center gap-4 border-b border-hairline bg-canvas sticky top-0 z-40">
      <a href="/account" class="w-10 h-10 flex items-center justify-center rounded-full bg-canvas-soft hover:bg-hairline transition-colors text-ink">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      </a>
      <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-ink">Security</h1>
    </header>

    <main class="flex-1 w-full max-w-5xl mx-auto p-4 sm:p-6 lg:p-8">
      <div class="w-full max-w-xl mx-auto bg-canvas p-4 sm:p-8 sm:rounded-2xl sm:shadow-lg sm:border sm:border-hairline relative mb-20">
      <form id="changePasswordForm" class="flex flex-col gap-6">
        <div id="errorBox" class="hidden bg-danger/10 border border-danger/20 text-danger p-3 rounded-md text-sm font-medium"></div>

        <div>
          <label class="block text-sm font-medium text-ink mb-1">Current Password</label>
          <input type="password" required id="currentPassword" class="w-full p-3 rounded-md border border-hairline bg-canvas focus:outline-none focus:border-brand transition-colors text-ink placeholder:text-mute" placeholder="••••••••" />
        </div>

        <div>
          <label class="block text-sm font-medium text-ink mb-1">New Password</label>
          <input type="password" required id="newPassword" class="w-full p-3 rounded-md border border-hairline bg-canvas focus:outline-none focus:border-brand transition-colors text-ink placeholder:text-mute" placeholder="••••••••" />
          <ul class="text-xs text-mute mt-2 space-y-1">
            <li id="rule-length" class="flex items-center gap-1"><span class="icon-placeholder w-3 h-3"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg></span> At least 8 characters</li>
            <li id="rule-upper" class="flex items-center gap-1"><span class="icon-placeholder w-3 h-3"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg></span> 1 uppercase & 1 lowercase</li>
            <li id="rule-num" class="flex items-center gap-1"><span class="icon-placeholder w-3 h-3"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg></span> 1 number</li>
            <li id="rule-spec" class="flex items-center gap-1"><span class="icon-placeholder w-3 h-3"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg></span> 1 special character</li>
          </ul>
        </div>

        <div>
          <label class="block text-sm font-medium text-ink mb-1">Confirm New Password</label>
          <input type="password" required id="confirmPassword" class="w-full p-3 rounded-md border border-hairline bg-canvas focus:outline-none focus:border-brand transition-colors text-ink placeholder:text-mute" placeholder="••••••••" />
        </div>

        <button type="submit" id="submitBtn" class="w-full py-3 mt-4 bg-brand text-white rounded-md font-bold hover:bg-brand-deep transition-colors shadow-sm disabled:opacity-50 disabled:cursor-not-allowed text-lg">
          Update Password
        </button>
      </form>
    </div>
    </main>
  </div>

  <script>
    const form = document.getElementById('changePasswordForm') as HTMLFormElement;
    const currentPassword = document.getElementById('currentPassword') as HTMLInputElement;
    const newPassword = document.getElementById('newPassword') as HTMLInputElement;
    const confirmPassword = document.getElementById('confirmPassword') as HTMLInputElement;
    const errorBox = document.getElementById('errorBox') as HTMLDivElement;
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;

    // Password validation logic
    const ruleLength = document.getElementById('rule-length');
    const ruleUpper = document.getElementById('rule-upper');
    const ruleNum = document.getElementById('rule-num');
    const ruleSpec = document.getElementById('rule-spec');

    function validatePassword(val: string) {
      const len = val.length >= 8;
      const upper = /[A-Z]/.test(val) && /[a-z]/.test(val);
      const num = /[0-9]/.test(val);
      const spec = /[^a-zA-Z0-9]/.test(val);
      
      const checkIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`;
      const circleIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>`;
      
      if (ruleLength) {
        ruleLength.className = `flex items-center gap-1 ${len ? 'text-brand' : 'text-mute'}`;
        ruleLength.querySelector('.icon-placeholder')!.innerHTML = len ? checkIcon : circleIcon;
      }
      if (ruleUpper) {
        ruleUpper.className = `flex items-center gap-1 ${upper ? 'text-brand' : 'text-mute'}`;
        ruleUpper.querySelector('.icon-placeholder')!.innerHTML = upper ? checkIcon : circleIcon;
      }
      if (ruleNum) {
        ruleNum.className = `flex items-center gap-1 ${num ? 'text-brand' : 'text-mute'}`;
        ruleNum.querySelector('.icon-placeholder')!.innerHTML = num ? checkIcon : circleIcon;
      }
      if (ruleSpec) {
        ruleSpec.className = `flex items-center gap-1 ${spec ? 'text-brand' : 'text-mute'}`;
        ruleSpec.querySelector('.icon-placeholder')!.innerHTML = spec ? checkIcon : circleIcon;
      }
      
      return len && upper && num && spec;
    }

    newPassword.addEventListener('input', () => {
      validatePassword(newPassword.value);
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      errorBox.classList.add('hidden');

      if (!validatePassword(newPassword.value)) {
        errorBox.textContent = "Please ensure the new password meets all requirements.";
        errorBox.classList.remove('hidden');
        return;
      }

      if (newPassword.value !== confirmPassword.value) {
        errorBox.textContent = "New passwords do not match.";
        errorBox.classList.remove('hidden');
        return;
      }

      if (currentPassword.value === newPassword.value) {
        errorBox.textContent = "New password cannot be the same as the old password.";
        errorBox.classList.remove('hidden');
        return;
      }

      // Mock save success
      alert("Password updated successfully!");
      window.location.href = '/account';
    });
  </script>
</Layout>
