---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <script is:inline>
    window.renderAbstractArt = function(type) {
      if (type === 'special-art-1') return '<div class="w-full h-full" style="background: conic-gradient(from 45deg, #FF6B6B, #4ECDC4, #45B7D1, #FF6B6B);"></div>';
      if (type === 'special-art-2') return '<div class="w-full h-full" style="background: linear-gradient(135deg, #FF9A9E 0%, #FECFEF 99%, #FECFEF 100%);"><div class="w-1/2 h-1/2 bg-white/30 rounded-br-full backdrop-blur-md"></div></div>';
      if (type === 'special-art-3') return '<div class="w-full h-full flex"><div class="w-1/2 h-full bg-indigo-500"></div><div class="w-1/2 h-full bg-rose-400 rounded-tl-full"></div></div>';
      return '';
    }

    // Load cached user data and prepare profile elements
    document.addEventListener('DOMContentLoaded', () => {
      const email = localStorage.getItem('splitbug_userEmail');
      const name = localStorage.getItem('splitbug_userName');
      const avatar = localStorage.getItem('splitbug_userAvatar');
      const theme = localStorage.getItem('splitbug_userThemeColor') || 'special-art-1';
      
      function populateProfile(nameVal, emailVal) {
        const nameEl = document.getElementById('profileName');
        const emailEl = document.getElementById('profileEmail');
        
        if (nameVal && nameEl) {
          nameEl.textContent = nameVal;
        }
        if (emailVal && emailEl) {
          emailEl.textContent = emailVal;
        }
      }

      if (name || email) {
        populateProfile(name, email);
      }
      
      const avatarEl = document.getElementById('profileAvatar');
      if (avatarEl) {
        if (avatar && avatar !== 'undefined' && avatar !== 'null') {
          avatarEl.innerHTML = `<img src="${avatar}" loading="lazy" decoding="async" class="w-full h-full object-cover" />`;
          avatarEl.className = "w-24 h-24 sm:w-32 sm:h-32 rounded-full bg-transparent text-white flex items-center justify-center text-4xl sm:text-5xl font-bold mb-4 overflow-hidden object-cover ring-4 ring-canvas-soft group-hover:ring-brand/50 transition-all";
        } else if (theme.startsWith('special-art-')) {
          avatarEl.innerHTML = window.renderAbstractArt(theme);
          avatarEl.className = "w-24 h-24 sm:w-32 sm:h-32 rounded-full bg-transparent text-white mb-4 overflow-hidden object-cover ring-4 ring-canvas-soft group-hover:ring-brand/50 transition-all";
        } else if (name) {
          const parts = name.trim().split(' ').filter(Boolean);
          let initials = 'U';
          if (parts.length > 0 && parts[0]) {
            if (parts.length === 1) initials = parts[0].charAt(0).toUpperCase();
            else initials = (parts[0].charAt(0) + parts[parts.length - 1].charAt(0)).toUpperCase();
          }
          avatarEl.innerHTML = initials;
          avatarEl.className = `w-24 h-24 sm:w-32 sm:h-32 rounded-full ${theme} text-white flex items-center justify-center text-4xl sm:text-5xl font-bold mb-4 overflow-hidden object-cover ring-4 ring-canvas-soft group-hover:ring-brand/50 transition-all`;
        }
      }
      
      window._populateProfile = populateProfile;
    });
  </script>
  
  <style is:inline>
    @keyframes heartbeat {
      0%, 100% { transform: scale(1); }
      15% { transform: scale(1.15); }
      30% { transform: scale(1.04); }
      45% { transform: scale(1.2); }
      65% { transform: scale(1); }
    }
    .animate-heartbeat {
      animation: heartbeat 1.8s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
      display: inline-block;
      transform-origin: center;
    }

    @keyframes footerAppear {
      0% {
        opacity: 0;
        transform: translateY(20px) scale(0.96);
        filter: blur(4px);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
        filter: blur(0px);
      }
    }
    .animate-footer-appear {
      animation: footerAppear 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .skeleton-danger {
      background: linear-gradient(90deg,
        rgba(239, 68, 68, 0.2) 25%,
        rgba(239, 68, 68, 0.45) 37%,
        rgba(239, 68, 68, 0.2) 63%
      );
      background-size: 400% 100%;
      animation: skeleton-shimmer 1.4s ease infinite;
    }
  </style>

  <div class="min-h-screen flex flex-col bg-canvas-soft pb-32">
    <!-- Header -->
    <header class="h-16 px-4 lg:px-6 flex items-center border-b border-hairline bg-canvas sticky top-0 z-40">
      <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-ink">Account Settings</h1>
    </header>

    <main class="flex-1 w-full max-w-5xl mx-auto p-4 sm:p-6 lg:p-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Left Column: Profile -->
      <div class="md:col-span-1 flex flex-col items-center md:items-start text-center md:text-left border-b border-hairline md:border-b-0 pb-8 md:pb-0">
        
        <!-- Left Profile Skeleton -->
        <div id="profileSkeleton" class="flex flex-col items-center md:items-start text-center md:text-left w-full">
          <div class="w-24 h-24 sm:w-32 sm:h-32 rounded-full skeleton-circle mb-4"></div>
          <div class="skeleton h-7 w-40 mb-2 rounded-lg"></div>
          <div class="skeleton h-4 w-52 mb-4 rounded-md"></div>
          <div class="skeleton h-9 w-32 rounded-full mt-2"></div>
        </div>

        <!-- Left Profile Real Content -->
        <div id="profileContent" class="flex-col items-center md:items-start text-center md:text-left w-full hidden">
          <div class="relative group cursor-pointer" id="avatarContainer">
            <div id="profileAvatar" class="w-24 h-24 sm:w-32 sm:h-32 rounded-full mb-4 overflow-hidden ring-4 ring-canvas-soft group-hover:ring-brand/50 transition-all"></div>
          </div>
          <h2 id="profileName" class="text-2xl font-bold text-ink leading-tight mb-1"></h2>
          <p id="profileEmail" class="text-mute text-sm mb-4"></p>
          <a href="/edit-profile" id="editProfileBtn" class="bg-canvas-soft hover:bg-hairline transition-colors text-ink font-medium px-4 py-2 rounded-full text-sm border border-hairline w-full md:w-auto inline-block text-center mt-2">
            Edit Profile
          </a>
        </div>
      </div>

      <!-- Right Column: Settings Links -->
      <div class="md:col-span-2 flex flex-col gap-8 w-full">
        
        <!-- Right Settings Skeleton Loader -->
        <div id="settingsSkeleton" class="flex flex-col gap-8 w-full">
          <div>
            <div class="skeleton h-4 w-28 mb-3 rounded"></div>
            <div class="bg-canvas border border-hairline rounded-xl overflow-hidden shadow-sm">
              <div class="flex items-center gap-4 p-4 border-b border-hairline">
                <div class="w-8 h-8 rounded-full skeleton-circle shrink-0"></div>
                <div class="skeleton h-4 w-44 rounded-md"></div>
              </div>
              <div class="flex items-center gap-4 p-4 border-b border-hairline">
                <div class="w-8 h-8 rounded-full skeleton-circle shrink-0"></div>
                <div class="skeleton h-4 w-28 rounded-md"></div>
              </div>
              <div class="flex items-center gap-4 p-4">
                <div class="w-8 h-8 rounded-full skeleton-circle shrink-0"></div>
                <div class="skeleton h-4 w-36 rounded-md"></div>
              </div>
            </div>
          </div>
          <div>
            <div class="skeleton h-4 w-40 mb-3 rounded"></div>
            <div class="bg-canvas border border-hairline rounded-xl overflow-hidden shadow-sm">
              <div class="flex items-center gap-4 p-4 border-b border-hairline">
                <div class="w-8 h-8 rounded-full skeleton-circle shrink-0"></div>
                <div class="skeleton h-4 w-36 rounded-md"></div>
              </div>
              <div class="flex items-center gap-4 p-4">
                <div class="w-8 h-8 rounded-full skeleton-circle shrink-0"></div>
                <div class="skeleton h-4 w-40 rounded-md"></div>
              </div>
            </div>
          </div>
          <div>
            <div class="bg-red-500/5 dark:bg-red-500/10 border border-red-500/15 rounded-xl p-4 flex justify-center items-center">
              <div class="skeleton-danger h-6 w-20 rounded-md"></div>
            </div>
          </div>
        </div>

        <div id="settingsContent" class="flex-col gap-8 hidden w-full">
        <!-- Preferences -->
        <div>
          <h3 class="text-xs font-bold text-mute uppercase tracking-wider mb-3">Preferences</h3>
          <div class="bg-canvas border border-hairline rounded-xl overflow-hidden shadow-sm">
            <a href="/notification-settings" class="w-full flex items-center justify-between p-4 text-left hover:bg-canvas-soft transition-colors border-b border-hairline group">
              <div class="flex items-center gap-4">
                <div class="w-8 h-8 rounded-full bg-canvas-soft flex items-center justify-center text-mute group-hover:text-ink group-hover:bg-hairline transition-colors">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                </div>
                <span class="text-ink font-medium">Notification settings</span>
              </div>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-mute"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>


            <a href="/security" id="securityBtn" class="w-full flex items-center justify-between p-4 text-left hover:bg-canvas-soft transition-colors border-b border-hairline group">
              <div class="flex items-center gap-4">
                <div class="w-8 h-8 rounded-full bg-canvas-soft flex items-center justify-center text-mute group-hover:text-ink group-hover:bg-hairline transition-colors">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                </div>
                <span class="text-ink font-medium">Security</span>
              </div>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-mute"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
            <a href="/appearance" class="w-full flex items-center justify-between p-4 text-left hover:bg-canvas-soft transition-colors group">
              <div class="flex items-center gap-4">
                <div class="w-8 h-8 rounded-full bg-canvas-soft flex items-center justify-center text-mute group-hover:text-ink group-hover:bg-hairline transition-colors">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r=".5"/><circle cx="17.5" cy="10.5" r=".5"/><circle cx="8.5" cy="7.5" r=".5"/><circle cx="6.5" cy="12.5" r=".5"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/></svg>
                </div>
                <span class="text-ink font-medium">Appearance</span>
              </div>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-mute"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
          </div>
        </div>


        <!-- Feedback -->
        <div>
          <h3 class="text-xs font-bold text-mute uppercase tracking-wider mb-3">Feedback & Support</h3>
          <div class="bg-canvas border border-hairline rounded-xl overflow-hidden shadow-sm">
            <a href="https://play.google.com/store/apps/details?id=com.splitbugs.app" target="_blank" rel="noopener noreferrer" class="w-full flex items-center justify-between p-4 text-left hover:bg-canvas-soft transition-colors border-b border-hairline group">
              <div class="flex items-center gap-4">
                <div class="w-8 h-8 rounded-full bg-canvas-soft flex items-center justify-center text-mute group-hover:text-ink group-hover:bg-hairline transition-colors">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                </div>
                <span class="text-ink font-medium">Rate SplitBugs</span>
              </div>
            </a>
            <a href="/contact-support" class="w-full flex items-center justify-between p-4 text-left hover:bg-canvas-soft transition-colors group">
              <div class="flex items-center gap-4">
                <div class="w-8 h-8 rounded-full bg-canvas-soft flex items-center justify-center text-mute group-hover:text-ink group-hover:bg-hairline transition-colors">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                </div>
                <span class="text-ink font-medium">Contact Support</span>
              </div>
            </a>
          </div>
        </div>

        <!-- Log Out -->
        <div>
          <button id="logoutBtn" class="w-full bg-canvas border border-hairline rounded-xl p-4 text-center hover:bg-danger/5 transition-colors group">
            <span class="text-danger font-medium">Log out</span>
          </button>
        </div>

        </div> <!-- End settingsContent -->
      </div>
    </div>
    
    <!-- Footer Branding -->
    <div id="footerBranding" class="mt-16 text-center flex flex-col items-center opacity-0 select-none cursor-default">
      <p class="text-sm text-mute mb-1 flex items-center justify-center gap-1 font-medium select-none">
        Made with <span id="easterEggHeart" class="animate-heartbeat text-red-500 scale-110 hover:scale-130 transition-transform cursor-pointer select-none">❤️</span> by <span class="font-semibold text-ink select-none">Lotus Outlook 6</span>
      </p>
      <a href="/privacy-policy" class="text-xs font-semibold text-brand hover:underline mt-2 transition-all hover:scale-105">Privacy Policy</a>
      <p class="text-[10px] text-mute/80 mt-4 tracking-widest font-mono select-none">v1.0.0</p>
    </div>
    </main>
  </div>

  <!-- Easter Egg Toast (No tick mark) -->
  <div id="easterEggToast" class="fixed bottom-20 left-1/2 -translate-x-1/2 bg-ink text-canvas px-5 py-2.5 rounded-full shadow-lg text-sm font-medium transition-all duration-300 translate-y-10 opacity-0 pointer-events-none z-50 flex items-center justify-center">
    8th June 2026
  </div>

  <!-- Logout Confirmation Modal -->
  <dialog id="logoutConfirmModal" class="backdrop:bg-black/60 text-ink fixed inset-0 z-50 m-auto w-[90vw] max-w-sm p-6 sm:p-8 bg-canvas border border-hairline rounded-2xl shadow-2xl">
    <div class="flex flex-col gap-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-red-500/10 text-red-500 flex items-center justify-center shrink-0">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
        </div>
        <h3 class="text-xl font-bold text-ink">Confirm Log Out</h3>
      </div>
      
      <div class="bg-red-500/5 border border-red-500/20 p-4 rounded-xl mt-2">
        <p class="text-sm text-red-600 dark:text-red-400 font-medium">Warning: App Lock will be disabled.</p>
        <p class="text-xs text-mute mt-1 leading-relaxed">
          Logging out completely removes your session and resets your security PIN. You will need to set up App Lock again next time you log in.
        </p>
      </div>

      <div class="flex gap-3 mt-4">
        <button type="button" id="cancelLogoutBtn" class="flex-1 py-3 bg-canvas-soft hover:bg-hairline text-ink font-semibold rounded-xl text-sm transition-colors border border-hairline cursor-pointer">
          Cancel
        </button>
        <button type="button" id="confirmLogoutBtn" class="flex-1 py-3 bg-red-600 hover:bg-red-700 text-white font-semibold rounded-xl text-sm transition-colors shadow-sm cursor-pointer border border-red-600">
          Log Out
        </button>
      </div>
    </div>
  </dialog>

  <script>
    import { auth, db } from '../firebase';
    import { doc, getDoc } from 'firebase/firestore';
    import { onAuthStateChanged, signOut } from 'firebase/auth';



    function revealAccountPage() {
      const pSkeleton = document.getElementById('profileSkeleton');
      const sSkeleton = document.getElementById('settingsSkeleton');
      const pContent = document.getElementById('profileContent');
      const sContent = document.getElementById('settingsContent');
      const footer = document.getElementById('footerBranding');

      if (pSkeleton) pSkeleton.style.transition = 'opacity 0.3s ease-out';
      if (sSkeleton) sSkeleton.style.transition = 'opacity 0.3s ease-out';
      if (pSkeleton) pSkeleton.style.opacity = '0';
      if (sSkeleton) sSkeleton.style.opacity = '0';

      setTimeout(() => {
        if (pSkeleton) pSkeleton.style.display = 'none';
        if (sSkeleton) sSkeleton.style.display = 'none';
        
        if (pContent) {
          pContent.classList.remove('hidden');
          pContent.classList.add('flex', 'fade-in');
        }
        if (sContent) {
          sContent.classList.remove('hidden');
          sContent.classList.add('flex', 'fade-in');
        }

        // Setup scroll observer for mobile & desktop: reveal footer ONLY when scrolled into view at the bottom
        if (footer) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                footer.classList.remove('hidden');
                footer.classList.add('animate-footer-appear');
                observer.unobserve(entry.target);
              }
            });
          }, {
            threshold: 0.1,
            rootMargin: "0px"
          });
          observer.observe(footer);
        }
      }, 300);
    }

    onAuthStateChanged(auth, async (user) => {
      if (user) {
        // Reveal profile and settings content together after skeleton pulse delay
        setTimeout(revealAccountPage, 450);

        try {
          const userDoc = await getDoc(doc(db, "users", user.uid));
          if (userDoc.exists()) {
            const data = userDoc.data();
            const userName = data.name || user.displayName || 'User';
            
            const cachedName = localStorage.getItem('splitbug_userName') || '';
            if (userName !== cachedName) {
              if (window._populateProfile) {
                window._populateProfile(userName, user.email);
              } else {
                const pName = document.getElementById('profileName');
                const pEmail = document.getElementById('profileEmail');
                if (pName) pName.textContent = userName;
                if (pEmail) pEmail.textContent = user.email || '';
              }
            }
            
            if (userAvatar !== cachedAvatar || userThemeColor !== (localStorage.getItem('splitbug_userThemeColor') || 'special-art-1')) {
              const avatarEl = document.getElementById('profileAvatar');
              if (userAvatar && userAvatar !== 'undefined' && userAvatar !== 'null') {
                avatarEl!.innerHTML = `<img src="${userAvatar}" loading="lazy" decoding="async" class="w-full h-full object-cover fade-in" />`;
                avatarEl!.className = "w-24 h-24 sm:w-32 sm:h-32 rounded-full bg-transparent text-white flex items-center justify-center text-4xl sm:text-5xl font-bold mb-4 overflow-hidden object-cover ring-4 ring-canvas-soft group-hover:ring-brand/50 transition-all";
              } else if (userThemeColor.startsWith('special-art-')) {
                avatarEl!.innerHTML = window.renderAbstractArt(userThemeColor);
                avatarEl!.className = "w-24 h-24 sm:w-32 sm:h-32 rounded-full bg-transparent text-white mb-4 overflow-hidden object-cover ring-4 ring-canvas-soft group-hover:ring-brand/50 transition-all";
              } else {
                const parts = userName.trim().split(' ').filter(Boolean);
                let initials = 'U';
                if (parts.length > 0 && parts[0]) {
                  if (parts.length === 1) initials = parts[0].charAt(0).toUpperCase();
                  else initials = (parts[0].charAt(0) + parts[parts.length - 1].charAt(0)).toUpperCase();
                }
                avatarEl!.innerHTML = initials;
                avatarEl!.className = `w-24 h-24 sm:w-32 sm:h-32 rounded-full ${userThemeColor} text-white flex items-center justify-center text-4xl sm:text-5xl font-bold mb-4 overflow-hidden object-cover ring-4 ring-canvas-soft group-hover:ring-brand/50 transition-all`;
              }
            }
            
            // Sync cache with latest DB data
            localStorage.setItem('splitbug_userName', userName);
            if (user.email) localStorage.setItem('splitbug_userEmail', user.email);
            if (userAvatar) {
              localStorage.setItem('splitbug_userAvatar', userAvatar);
            } else {
              localStorage.removeItem('splitbug_userAvatar');
            }
            localStorage.setItem('splitbug_userThemeColor', userThemeColor);
          }
        } catch (error) {
          console.error("Error fetching user data:", error);
        }
      } else {
        window.location.href = '/login';
      }
    });

    // 8-click Heart Easter Egg Logic
    let heartClickCount = 0;
    let heartClickTimer: any = null;
    const heartEl = document.getElementById('easterEggHeart');
    const toastEl = document.getElementById('easterEggToast');

    heartEl?.addEventListener('click', (e) => {
      e.stopPropagation();
      heartClickCount++;

      // Pop animation on click
      heartEl.style.transform = 'scale(1.4)';
      setTimeout(() => {
        heartEl.style.transform = '';
      }, 150);

      if (heartClickCount === 8) {
        heartClickCount = 0;
        if (toastEl) {
          toastEl.classList.remove('translate-y-10', 'opacity-0', 'pointer-events-none');
          toastEl.classList.add('translate-y-0', 'opacity-100');

          setTimeout(() => {
            toastEl.classList.add('translate-y-10', 'opacity-0', 'pointer-events-none');
            toastEl.classList.remove('translate-y-0', 'opacity-100');
          }, 3000);
        }
      }

      clearTimeout(heartClickTimer);
      heartClickTimer = setTimeout(() => {
        heartClickCount = 0;
      }, 2500);
    });

    // Log Out
    const logoutConfirmModal = document.getElementById('logoutConfirmModal') as HTMLDialogElement;
    
    document.getElementById('logoutBtn')?.addEventListener('click', async () => {
      const hasAppLock = !!localStorage.getItem('splitsbug_app_pin');
      if (hasAppLock) {
        logoutConfirmModal?.showModal();
      } else {
        try {
          const btn = document.getElementById('logoutBtn') as HTMLButtonElement;
          if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<span class="text-sm font-semibold text-danger opacity-70">Logging out...</span>';
          }
          localStorage.removeItem('splitbug_loggedIn');
          localStorage.removeItem('splitbug_userEmail');
          await signOut(auth);
          window.location.href = '/login';
        } catch (error) {
          console.error("Error signing out:", error);
          alert('Failed to sign out. Please try again.');
          const btn = document.getElementById('logoutBtn') as HTMLButtonElement;
          if (btn) {
            btn.disabled = false;
            btn.innerHTML = '<span class="text-sm font-semibold text-danger">Log out</span>';
          }
        }
      }
    });

    document.getElementById('cancelLogoutBtn')?.addEventListener('click', () => {
      logoutConfirmModal?.close();
    });

    document.getElementById('confirmLogoutBtn')?.addEventListener('click', async () => {
      try {
        const confirmBtn = document.getElementById('confirmLogoutBtn') as HTMLButtonElement;
        if (confirmBtn) {
          confirmBtn.disabled = true;
          confirmBtn.textContent = 'Logging out...';
        }
        
        // Remove app lock PIN immediately upon confirmation
        localStorage.removeItem('splitsbug_app_pin');
        localStorage.removeItem('splitbug_loggedIn');
        localStorage.removeItem('splitbug_userEmail');
        
        await signOut(auth);
        window.location.href = '/login';
      } catch (error) {
        console.error("Error signing out:", error);
        alert('Failed to sign out. Please try again.');
        const confirmBtn = document.getElementById('confirmLogoutBtn') as HTMLButtonElement;
        if (confirmBtn) {
          confirmBtn.disabled = false;
          confirmBtn.textContent = 'Log Out';
        }
      }
    });

    // Export Expenses to CSV
    import { collection, query, where, getDocs } from 'firebase/firestore';

    const exportCsvBtn = document.getElementById('exportCsvBtn');
    const exportCsvStatus = document.getElementById('exportCsvStatus');

    exportCsvBtn?.addEventListener('click', async () => {
      if (!auth.currentUser || !auth.currentUser.email) return;
      if (exportCsvStatus) exportCsvStatus.textContent = 'Exporting...';

      try {
        const userEmail = auth.currentUser.email;
        const groupsQuery = query(collection(db, 'groups'), where('members', 'array-contains', userEmail));
        const groupSnaps = await getDocs(groupsQuery);

        const rows = [
          ['Date', 'Group Name', 'Description', 'Category', 'Paid By', 'Amount (INR)', 'Created At']
        ];

        groupSnaps.forEach(docSnap => {
          const group = docSnap.data();
          const groupName = group.name || 'Unnamed Group';
          const expenses = group.expenses || [];

          expenses.forEach((exp: any) => {
            const dateStr = exp.date ? new Date(exp.date).toLocaleDateString() : '';
            const desc = (exp.desc || '').replace(/"/g, '""');
            const category = exp.category || 'General';
            const paidBy = exp.paidBy || '';
            const amount = exp.amount || 0;
            const createdAt = exp.timestamp ? new Date(exp.timestamp).toISOString() : '';

            rows.push([
              `"${dateStr}"`,
              `"${groupName.replace(/"/g, '""')}"`,
              `"${desc}"`,
              `"${category}"`,
              `"${paidBy}"`,
              `${amount}`,
              `"${createdAt}"`
            ]);
          });
        });

        const csvContent = "data:text/csv;charset=utf-8," + rows.map(e => e.join(",")).join("\n");
        const encodedUri = encodeURI(csvContent);
        const link = document.createElement("a");
        link.setAttribute("href", encodedUri);
        link.setAttribute("download", `splitsbug_expenses_${new Date().toISOString().split('T')[0]}.csv`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);

        if (exportCsvStatus) exportCsvStatus.textContent = 'Downloaded!';
        setTimeout(() => { if (exportCsvStatus) exportCsvStatus.textContent = 'CSV'; }, 3000);
      } catch (err) {
        console.error('CSV Export Error:', err);
        if (exportCsvStatus) exportCsvStatus.textContent = 'Failed';
      }
    });
  </script>
</Layout>
