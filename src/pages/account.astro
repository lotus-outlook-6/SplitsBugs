---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="min-h-screen flex flex-col bg-canvas-soft pb-32">
    <!-- Header -->
    <header class="h-16 px-4 lg:px-6 flex items-center border-b border-hairline bg-canvas sticky top-0 z-40">
      <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-ink">Account Settings</h1>
    </header>

    <main class="flex-1 w-full max-w-5xl mx-auto p-4 sm:p-6 lg:p-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Left Column: Profile -->
      <div class="md:col-span-1 flex flex-col items-center md:items-start text-center md:text-left border-b border-hairline md:border-b-0 pb-8 md:pb-0">
        <div class="relative group cursor-pointer" id="avatarContainer">
          <div id="profileAvatar" class="w-24 h-24 sm:w-32 sm:h-32 rounded-full bg-brand text-white flex items-center justify-center text-4xl sm:text-5xl font-bold mb-4 overflow-hidden object-cover ring-4 ring-canvas-soft group-hover:ring-brand/50 transition-all">
            <!-- Initials or Image -->
          </div>
          <button class="absolute bottom-4 right-0 w-8 h-8 bg-canvas border border-hairline rounded-full flex items-center justify-center text-ink shadow-md group-hover:bg-brand group-hover:text-white group-hover:border-brand transition-colors">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
          </button>
        </div>
        
        <h2 id="profileName" class="text-2xl font-bold text-ink leading-tight mb-1">Name</h2>
        <p id="profileEmail" class="text-mute text-sm mb-4">email@example.com</p>
        
        <a href="/edit-profile" id="editProfileBtn" class="bg-canvas-soft hover:bg-hairline transition-colors text-ink font-medium px-4 py-2 rounded-full text-sm border border-hairline w-full md:w-auto inline-block text-center mt-2">
          Edit Profile
        </a>
      </div>

      <!-- Right Column: Settings Links -->
      <div class="md:col-span-2 flex flex-col gap-8">
        
        <!-- Preferences -->
        <div>
          <h3 class="text-xs font-bold text-mute uppercase tracking-wider mb-3">Preferences</h3>
          <div class="bg-canvas border border-hairline rounded-xl overflow-hidden shadow-sm">
            <a href="/email-settings" class="w-full flex items-center justify-between p-4 text-left hover:bg-canvas-soft transition-colors border-b border-hairline group">
              <div class="flex items-center gap-4">
                <div class="w-8 h-8 rounded-full bg-canvas-soft flex items-center justify-center text-mute group-hover:text-ink group-hover:bg-hairline transition-colors">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                </div>
                <span class="text-ink font-medium">Email settings</span>
              </div>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-mute"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
            <a href="/notification-settings" class="w-full flex items-center justify-between p-4 text-left hover:bg-canvas-soft transition-colors border-b border-hairline group">
              <div class="flex items-center gap-4">
                <div class="w-8 h-8 rounded-full bg-canvas-soft flex items-center justify-center text-mute group-hover:text-ink group-hover:bg-hairline transition-colors">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                </div>
                <span class="text-ink font-medium">Device & push notifications</span>
              </div>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-mute"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
            <a href="/change-password" id="securityBtn" class="w-full flex items-center justify-between p-4 text-left hover:bg-canvas-soft transition-colors border-b border-hairline group">
              <div class="flex items-center gap-4">
                <div class="w-8 h-8 rounded-full bg-canvas-soft flex items-center justify-center text-mute group-hover:text-ink group-hover:bg-hairline transition-colors">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                </div>
                <span class="text-ink font-medium">Security</span>
              </div>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-mute"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
            <a href="/appearance" class="w-full flex items-center justify-between p-4 text-left hover:bg-canvas-soft transition-colors group">
              <div class="flex items-center gap-4">
                <div class="w-8 h-8 rounded-full bg-canvas-soft flex items-center justify-center text-mute group-hover:text-ink group-hover:bg-hairline transition-colors">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r=".5"/><circle cx="17.5" cy="10.5" r=".5"/><circle cx="8.5" cy="7.5" r=".5"/><circle cx="6.5" cy="12.5" r=".5"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/></svg>
                </div>
                <span class="text-ink font-medium">Appearance</span>
              </div>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-mute"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
          </div>
        </div>

        <!-- Feedback -->
        <div>
          <h3 class="text-xs font-bold text-mute uppercase tracking-wider mb-3">Feedback & Support</h3>
          <div class="bg-canvas border border-hairline rounded-xl overflow-hidden shadow-sm">
            <button class="w-full flex items-center justify-between p-4 text-left hover:bg-canvas-soft transition-colors border-b border-hairline group">
              <div class="flex items-center gap-4">
                <div class="w-8 h-8 rounded-full bg-canvas-soft flex items-center justify-center text-mute group-hover:text-ink group-hover:bg-hairline transition-colors">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                </div>
                <span class="text-ink font-medium">Rate SplitBugs</span>
              </div>
            </button>
            <button class="w-full flex items-center justify-between p-4 text-left hover:bg-canvas-soft transition-colors group">
              <div class="flex items-center gap-4">
                <div class="w-8 h-8 rounded-full bg-canvas-soft flex items-center justify-center text-mute group-hover:text-ink group-hover:bg-hairline transition-colors">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                </div>
                <span class="text-ink font-medium">Contact Support</span>
              </div>
            </button>
          </div>
        </div>

        <!-- Log Out -->
        <div>
          <button id="logoutBtn" class="w-full bg-canvas border border-hairline rounded-xl p-4 text-center hover:bg-danger/5 transition-colors group">
            <span class="text-danger font-medium">Log out</span>
          </button>
        </div>

      </div>
    </div>
    
    <!-- Footer Branding -->
    <div class="mt-16 text-center flex flex-col items-center">
      <p class="text-sm text-mute mb-1">Made with ❤️ by Lotus Outlook 6</p>
      <a href="#" class="text-xs font-medium text-brand hover:underline mt-2">Privacy Policy</a>
      <p class="text-[10px] text-mute mt-4">v1.0.0</p>
    </div>
    </main>
  </div>

  <script>
    // Populate User Details
    function loadUserData() {
      const userName = localStorage.getItem('splitbug_userName') || 'User';
      const userEmail = localStorage.getItem('splitbug_userEmail') || 'user@example.com';
      const userAvatar = localStorage.getItem('splitbug_userAvatar');
      const userThemeColor = localStorage.getItem('splitbug_userThemeColor') || 'bg-[#6366f1]';
      
      document.getElementById('profileName')!.textContent = userName;
      document.getElementById('profileEmail')!.textContent = userEmail;
      
      const avatarEl = document.getElementById('profileAvatar');
      if (userAvatar) {
        avatarEl!.innerHTML = `<img src="${userAvatar}" class="w-full h-full object-cover" />`;
        avatarEl!.className = "w-24 h-24 sm:w-32 sm:h-32 rounded-full bg-transparent text-white flex items-center justify-center text-4xl sm:text-5xl font-bold mb-4 overflow-hidden object-cover ring-4 ring-canvas-soft group-hover:ring-brand/50 transition-all";
      } else {
        const parts = userName.trim().split(/\\s+/);
        let initials = 'U';
        if (parts.length > 0 && parts[0]) {
          if (parts.length === 1) initials = parts[0].charAt(0).toUpperCase();
          else initials = (parts[0].charAt(0) + parts[parts.length - 1].charAt(0)).toUpperCase();
        }
        avatarEl!.innerHTML = initials;
        avatarEl!.className = `w-24 h-24 sm:w-32 sm:h-32 rounded-full ${userThemeColor} text-white flex items-center justify-center text-4xl sm:text-5xl font-bold mb-4 overflow-hidden object-cover ring-4 ring-canvas-soft group-hover:ring-brand/50 transition-all`;
      }
    }
    
    loadUserData();

    // Log Out
    document.getElementById('logoutBtn')?.addEventListener('click', () => {
      localStorage.removeItem('splitbug_loggedIn');
      window.location.href = '/login';
    });
  </script>
</Layout>
