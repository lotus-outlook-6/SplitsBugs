---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="min-h-screen flex flex-col bg-canvas-soft pb-32">
    <!-- Header -->
    <header class="h-16 px-4 lg:px-6 flex items-center gap-4 border-b border-hairline bg-canvas sticky top-0 z-40">
      <a href="/account" class="w-10 h-10 flex items-center justify-center rounded-full bg-canvas-soft hover:bg-hairline transition-colors text-ink">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      </a>
      <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-ink">Notification Preferences</h1>
    </header>

    <main class="flex-1 w-full max-w-3xl mx-auto p-4 sm:p-6 lg:p-8">
      
      <!-- System / Permission Alert -->
      <div id="permissionAlert" class="bg-amber-500/10 border border-amber-500/20 rounded-xl p-4 mb-6 hidden flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <svg class="w-5 h-5 text-amber-600 dark:text-amber-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          <p class="text-xs sm:text-sm text-ink">Browser push notifications are currently disabled in your browser settings.</p>
        </div>
        <button id="enableBrowserNotifBtn" class="bg-brand text-white text-xs px-3 py-1.5 rounded-lg font-semibold hover:opacity-90 transition-opacity shrink-0">Enable</button>
      </div>

      <!-- General Delivery Channels -->
      <div class="bg-canvas border border-hairline rounded-xl p-6 shadow-sm mb-6">
        <h2 class="text-sm font-bold text-mute uppercase tracking-wider mb-4">Notification Channels</h2>
        
        <div class="space-y-4">
          <div class="flex items-center justify-between gap-4 py-2 border-b border-hairline/60">
            <div>
              <p class="font-medium text-ink">Browser & Push Notifications</p>
              <p class="text-xs text-mute">Receive instant notifications in your browser when away</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="browserNotifToggle" class="sr-only peer" checked>
              <div class="w-11 h-6 bg-canvas-soft peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-brand"></div>
            </label>
          </div>

          <div class="flex items-center justify-between gap-4 py-2">
            <div>
              <p class="font-medium text-ink">Email Notifications</p>
              <p class="text-xs text-mute">Receive an email whenever a notification is triggered</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="emailNotifToggle" class="sr-only peer" checked>
              <div class="w-11 h-6 bg-canvas-soft peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-brand"></div>
            </label>
          </div>
        </div>
      </div>

      <!-- Granular Categories -->
      <div class="bg-canvas border border-hairline rounded-xl p-6 shadow-sm">
        <h2 class="text-sm font-bold text-mute uppercase tracking-wider mb-4">Notification Events</h2>
        
        <div class="space-y-4">
          <div class="flex items-center justify-between gap-4 py-2 border-b border-hairline/60">
            <div>
              <p class="font-medium text-ink">Expenses Added / Edited</p>
              <p class="text-xs text-mute">When someone adds or edits an expense in your groups</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="expensesToggle" class="sr-only peer" checked>
              <div class="w-11 h-6 bg-canvas-soft peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-brand"></div>
            </label>
          </div>

          <div class="flex items-center justify-between gap-4 py-2 border-b border-hairline/60">
            <div>
              <p class="font-medium text-ink">Settlements Recorded</p>
              <p class="text-xs text-mute">When a group member records a payment or settlement</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="settlementsToggle" class="sr-only peer" checked>
              <div class="w-11 h-6 bg-canvas-soft peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-brand"></div>
            </label>
          </div>

          <div class="flex items-center justify-between gap-4 py-2">
            <div>
              <p class="font-medium text-ink">Group Invites & Activity</p>
              <p class="text-xs text-mute">When you are invited to a new group or member leaves</p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" id="invitesToggle" class="sr-only peer" checked>
              <div class="w-11 h-6 bg-canvas-soft peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-brand"></div>
            </label>
          </div>
        </div>
      </div>

    </main>
  </div>

  <!-- Save Toast -->
  <div id="saveToast" class="fixed bottom-20 left-1/2 -translate-x-1/2 bg-ink text-canvas px-4 py-2 rounded-full shadow-lg text-xs font-medium transition-all duration-300 translate-y-10 opacity-0 pointer-events-none z-50 flex items-center gap-2">
    <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
    Preferences saved
  </div>

  <script>
    import { auth, db } from '../firebase';
    import { onAuthStateChanged } from 'firebase/auth';
    import { doc, getDoc, updateDoc, setDoc } from 'firebase/firestore';

    const permissionAlert = document.getElementById('permissionAlert');
    const enableBrowserNotifBtn = document.getElementById('enableBrowserNotifBtn');
    
    const browserNotifToggle = document.getElementById('browserNotifToggle') as HTMLInputElement;
    const emailNotifToggle = document.getElementById('emailNotifToggle') as HTMLInputElement;
    const expensesToggle = document.getElementById('expensesToggle') as HTMLInputElement;
    const settlementsToggle = document.getElementById('settlementsToggle') as HTMLInputElement;
    const invitesToggle = document.getElementById('invitesToggle') as HTMLInputElement;
    const saveToast = document.getElementById('saveToast');

    // Check browser notification permission
    if ('Notification' in window && Notification.permission !== 'granted') {
      permissionAlert?.classList.remove('hidden');
    }

    enableBrowserNotifBtn?.addEventListener('click', async () => {
      if ('Notification' in window) {
        const res = await Notification.requestPermission();
        if (res === 'granted') {
          permissionAlert?.classList.add('hidden');
        }
      }
    });

    let currentEmail = '';

    function showSaveToast() {
      if (!saveToast) return;
      saveToast.classList.remove('translate-y-10', 'opacity-0', 'pointer-events-none');
      saveToast.classList.add('translate-y-0', 'opacity-100');
      setTimeout(() => {
        saveToast.classList.add('translate-y-10', 'opacity-0', 'pointer-events-none');
        saveToast.classList.remove('translate-y-0', 'opacity-100');
      }, 2000);
    }

    async function savePreferences() {
      const prefs = {
        browserNotifs: browserNotifToggle.checked,
        emailNotifs: emailNotifToggle.checked,
        expensesNotif: expensesToggle.checked,
        settlementsNotif: settlementsToggle.checked,
        invitesNotif: invitesToggle.checked
      };

      localStorage.setItem('splitsbug_notif_prefs', JSON.stringify(prefs));

      if (currentEmail) {
        try {
          const userDocRef = doc(db, 'users', currentEmail);
          await updateDoc(userDocRef, prefs).catch(async () => {
            await setDoc(userDocRef, prefs, { merge: true });
          });
        } catch (e) {
          console.error('Error saving notif prefs to Firestore:', e);
        }
      }
      showSaveToast();
    }

    // Load saved preferences
    onAuthStateChanged(auth, async (user) => {
      if (user && user.email) {
        currentEmail = user.email;
        try {
          const userSnap = await getDoc(doc(db, 'users', user.email));
          if (userSnap.exists()) {
            const data = userSnap.data();
            if (typeof data.browserNotifs === 'boolean') browserNotifToggle.checked = data.browserNotifs;
            if (typeof data.emailNotifs === 'boolean') emailNotifToggle.checked = data.emailNotifs;
            if (typeof data.expensesNotif === 'boolean') expensesToggle.checked = data.expensesNotif;
            if (typeof data.settlementsNotif === 'boolean') settlementsToggle.checked = data.settlementsNotif;
            if (typeof data.invitesNotif === 'boolean') invitesToggle.checked = data.invitesNotif;
          }
        } catch (e) {
          console.error('Error loading notif prefs:', e);
        }
      }
    });

    [browserNotifToggle, emailNotifToggle, expensesToggle, settlementsToggle, invitesToggle].forEach(t => {
      t?.addEventListener('change', savePreferences);
    });
  </script>
</Layout>

