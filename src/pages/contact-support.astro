---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="min-h-screen flex flex-col bg-canvas-soft pb-32">
    <!-- Header -->
    <header class="h-16 px-4 lg:px-6 flex items-center gap-4 border-b border-hairline bg-canvas sticky top-0 z-40">
      <a href="/account" class="w-10 h-10 flex items-center justify-center rounded-full bg-canvas-soft hover:bg-hairline transition-colors text-ink">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      </a>
      <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-ink">Contact Support</h1>
    </header>

    <main class="flex-1 w-full max-w-3xl mx-auto p-4 sm:p-6 lg:p-8">
      
      <!-- Company Info -->
      <div class="bg-canvas border border-hairline rounded-xl p-8 text-center shadow-sm mb-8">
        <div class="w-16 h-16 mx-auto rounded-full bg-brand/10 flex items-center justify-center text-brand mb-4">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15.05 5A5 5 0 0 1 19 8.95M15.05 1A9 9 0 0 1 23 8.94m-1 7.98v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        </div>
        <h2 class="text-2xl font-bold text-ink mb-2">We're here to help</h2>
        <p class="text-mute mb-8 max-w-md mx-auto">Get in touch with the SplitBugs support team. We generally reply within 24 hours.</p>
        
        <div class="flex flex-col gap-4 max-w-sm mx-auto">
          <a href="mailto:support@splitbugs.app" class="flex items-center gap-4 p-4 border border-hairline rounded-xl hover:bg-canvas-soft transition-colors text-left group">
            <svg class="text-mute group-hover:text-ink transition-colors" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            <div>
              <p class="font-medium text-ink">Email Us</p>
              <p class="text-sm text-mute">support@splitbugs.app</p>
            </div>
          </a>
          
          <a href="tel:+18005550199" class="flex items-center gap-4 p-4 border border-hairline rounded-xl hover:bg-canvas-soft transition-colors text-left group">
            <svg class="text-mute group-hover:text-ink transition-colors" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            <div>
              <p class="font-medium text-ink">Call Us</p>
              <p class="text-sm text-mute">+1 (800) 555-0199</p>
            </div>
          </a>
        </div>
      </div>

      <!-- User Contact Info (Dynamically Loaded) -->
      <div class="bg-canvas border border-hairline rounded-xl p-6 shadow-sm">
        <h3 class="text-sm font-bold text-mute uppercase tracking-wider mb-4">Developer's Contact Details</h3>
        
        <div class="space-y-4">
          <div>
            <p class="text-xs text-mute mb-1">Email ID</p>
            <p id="userEmailDisplay" class="font-medium text-ink">loading...</p>
          </div>
        </div>
        
        <p class="text-xs text-mute mt-6">To contact the developer of this site, please use this email address.</p>
      </div>

    </main>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const email = localStorage.getItem('splitbug_userEmail') || 'Not provided';
      document.getElementById('userEmailDisplay')!.textContent = email;
    });
  </script>
</Layout>
