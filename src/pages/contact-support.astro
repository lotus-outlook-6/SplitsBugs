---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="min-h-screen flex flex-col bg-canvas-soft pb-32">
    <!-- Header -->
    <header class="h-16 px-4 lg:px-6 flex items-center gap-4 border-b border-hairline bg-canvas sticky top-0 z-40">
      <a href="/account" class="w-10 h-10 flex items-center justify-center rounded-full bg-canvas-soft hover:bg-hairline transition-colors text-ink">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      </a>
      <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-ink">Contact Support</h1>
    </header>

    <style is:inline>
      .skeleton {
        background: linear-gradient(90deg,
          rgba(229, 231, 235, 0.4) 25%,
          rgba(229, 231, 235, 0.8) 37%,
          rgba(229, 231, 235, 0.4) 63%
        );
        background-size: 400% 100%;
        animation: skeleton-shimmer 1.4s ease infinite;
      }
      :global(.dark) .skeleton {
        background: linear-gradient(90deg,
          rgba(255, 255, 255, 0.03) 25%,
          rgba(255, 255, 255, 0.08) 37%,
          rgba(255, 255, 255, 0.03) 63%
        );
        background-size: 400% 100%;
        animation: skeleton-shimmer 1.4s ease infinite;
      }
      @keyframes skeleton-shimmer {
        0% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
      }
      .fade-in {
        animation: fadeIn 0.5s ease-out forwards;
      }
      @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
      }
    </style>

    <main class="flex-1 w-full max-w-3xl mx-auto p-4 sm:p-6 lg:p-8">
      
      <!-- Skeleton Loader Container (1:1 Match with Real Content) -->
      <div id="supportSkeleton" class="space-y-8">
        <!-- Company Info Skeleton -->
        <div class="bg-canvas border border-hairline rounded-xl p-8 text-center shadow-sm">
          <div class="skeleton w-16 h-16 mx-auto rounded-full mb-4"></div>
          <div class="skeleton h-8 w-48 mx-auto rounded-md mb-2"></div>
          <div class="skeleton h-4 sm:h-5 w-full max-w-md mx-auto rounded-md mb-1.5"></div>
          <div class="skeleton h-4 sm:h-5 w-3/4 max-w-sm mx-auto rounded-md mb-8"></div>
          
          <div class="flex flex-col gap-4 max-w-md mx-auto">
            <!-- Support Email Skeleton -->
            <div class="flex items-center justify-between gap-4 p-4 border border-hairline rounded-xl bg-canvas">
              <div class="flex items-center gap-4">
                <div class="skeleton w-10 h-10 rounded-full shrink-0"></div>
                <div class="text-left">
                  <div class="skeleton h-4 sm:h-5 w-28 rounded-md mb-1"></div>
                  <div class="skeleton h-3.5 sm:h-4 w-44 rounded-md"></div>
                </div>
              </div>
              <div class="skeleton w-12 h-6 rounded-full shrink-0"></div>
            </div>
            
            <!-- Support Phone Skeleton -->
            <div class="flex items-center justify-between gap-4 p-4 border border-hairline rounded-xl bg-canvas">
              <div class="flex items-center gap-4">
                <div class="skeleton w-10 h-10 rounded-full shrink-0"></div>
                <div class="text-left">
                  <div class="skeleton h-4 sm:h-5 w-20 rounded-md mb-1"></div>
                  <div class="skeleton h-3.5 sm:h-4 w-36 rounded-md"></div>
                </div>
              </div>
              <div class="skeleton w-12 h-6 rounded-full shrink-0"></div>
            </div>
          </div>
        </div>

        <!-- Developer Contact Details Card Box Skeleton -->
        <div class="bg-canvas border border-hairline rounded-xl p-6 sm:p-8 shadow-sm">
          <div class="skeleton h-4 w-48 rounded-md mb-4"></div>
          
          <div class="flex items-center justify-between gap-4 p-4 border border-hairline rounded-xl bg-canvas">
            <div class="flex items-center gap-4">
              <div class="skeleton w-10 h-10 rounded-full shrink-0"></div>
              <div class="text-left">
                <div class="skeleton h-4 sm:h-5 w-32 rounded-md mb-1"></div>
                <div class="skeleton h-3.5 sm:h-4 w-48 rounded-md"></div>
              </div>
            </div>
            <div class="skeleton w-12 h-6 rounded-full shrink-0"></div>
          </div>
          
          <div class="skeleton h-3.5 w-64 rounded-md mt-4"></div>
        </div>
      </div>

      <!-- Real Content Container (Initially Hidden) -->
      <div id="supportContent" class="hidden space-y-8">
        <!-- Company Info -->
        <div class="bg-canvas border border-hairline rounded-xl p-8 text-center shadow-sm">
          <div class="w-16 h-16 mx-auto rounded-full bg-brand/10 flex items-center justify-center text-brand mb-4">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15.05 5A5 5 0 0 1 19 8.95M15.05 1A9 9 0 0 1 23 8.94m-1 7.98v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          </div>
          <h2 class="text-2xl font-bold text-ink mb-2">We're here to help</h2>
          <p class="text-mute mb-8 max-w-md mx-auto">Click any card to copy contact details. Double-click to open your mail or phone app directly.</p>
          
          <div class="flex flex-col gap-4 max-w-md mx-auto">
            <!-- Support Email Card -->
            <div data-copy-value="splitsbug.app@gmail.com" data-action="mailto:splitsbug.app@gmail.com" class="contact-card flex items-center justify-between gap-4 p-4 border border-hairline rounded-xl hover:bg-canvas-soft transition-all text-left cursor-pointer group select-none relative overflow-hidden">
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-full bg-brand/10 flex items-center justify-center text-brand shrink-0">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                </div>
                <div>
                  <p class="font-medium text-ink">Email Support</p>
                  <p class="text-sm text-mute">splitsbug.app@gmail.com</p>
                </div>
              </div>
              <span class="badge text-xs font-semibold text-brand bg-brand/10 px-2.5 py-1 rounded-full opacity-80 sm:opacity-0 group-hover:opacity-100 transition-all shrink-0">
                Copy
              </span>
            </div>
            
            <!-- Support Phone Card -->
            <div data-copy-value="+18005550199" data-action="tel:+18005550199" class="contact-card flex items-center justify-between gap-4 p-4 border border-hairline rounded-xl hover:bg-canvas-soft transition-all text-left cursor-pointer group select-none relative overflow-hidden">
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-full bg-brand/10 flex items-center justify-center text-brand shrink-0">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                </div>
                <div>
                  <p class="font-medium text-ink">Call Us</p>
                  <p class="text-sm text-mute">+1 (800) 555-0199</p>
                </div>
              </div>
              <span class="badge text-xs font-semibold text-brand bg-brand/10 px-2.5 py-1 rounded-full opacity-80 sm:opacity-0 group-hover:opacity-100 transition-all shrink-0">
                Copy
              </span>
            </div>
          </div>
        </div>

        <!-- Developer Contact Details Card Box -->
        <div class="bg-canvas border border-hairline rounded-xl p-6 sm:p-8 shadow-sm">
          <h3 class="text-xs font-bold text-mute uppercase tracking-wider mb-4">Developer's Contact Details</h3>
          
          <div data-copy-value="kunalrabidas6@proton.me" data-action="mailto:kunalrabidas6@proton.me" class="contact-card flex items-center justify-between gap-4 p-4 border border-hairline rounded-xl hover:bg-canvas-soft transition-all text-left cursor-pointer group select-none relative overflow-hidden">
            <div class="flex items-center gap-4">
              <img src="https://lh3.googleusercontent.com/a/ACg8ocKnauYC7QPWSywNYZLeEdGNk2yMuI9oKTGJ3Ci07ItAugXEeCeV3Q=s400-c" alt="Developer Avatar" class="w-10 h-10 rounded-full object-cover shrink-0 border border-purple-500/20 shadow-sm" />
              <div>
                <p class="font-medium text-ink">Developer Email</p>
                <p class="text-sm text-mute">kunalrabidas6@proton.me</p>
              </div>
            </div>
            <span class="badge text-xs font-semibold text-purple-600 dark:text-purple-400 bg-purple-500/10 px-2.5 py-1 rounded-full opacity-80 sm:opacity-0 group-hover:opacity-100 transition-all shrink-0">
              Copy
            </span>
          </div>
          
          <p class="text-xs text-mute mt-4">Click to copy email address. Double-click to open your email client.</p>
        </div>
      </div>

    </main>
  </div>

  <!-- Copy Toast Notification -->
  <div id="copyToast" class="fixed bottom-20 left-1/2 -translate-x-1/2 bg-ink text-canvas px-4 py-2.5 rounded-full shadow-lg text-xs font-medium transition-all duration-300 translate-y-10 opacity-0 pointer-events-none z-50 flex items-center gap-2">
    <svg class="w-4 h-4 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
    <span id="copyToastMsg">Copied to clipboard!</span>
  </div>

  <script>
    function revealSupportPage() {
      const skeleton = document.getElementById('supportSkeleton');
      const content = document.getElementById('supportContent');
      if (skeleton) {
        skeleton.style.transition = 'opacity 0.3s ease-out';
        skeleton.style.opacity = '0';
        setTimeout(() => {
          skeleton.style.display = 'none';
          if (content) {
            content.classList.remove('hidden');
            content.classList.add('fade-in');
          }
        }, 300);
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      setTimeout(revealSupportPage, 450);
    });

    const cards = document.querySelectorAll('.contact-card');
    const toast = document.getElementById('copyToast');
    const toastMsg = document.getElementById('copyToastMsg');
    let toastTimeout: any = null;

    function showToast(msg: string) {
      if (!toast || !toastMsg) return;
      toastMsg.textContent = msg;
      toast.classList.remove('translate-y-10', 'opacity-0', 'pointer-events-none');
      toast.classList.add('translate-y-0', 'opacity-100');

      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.classList.add('translate-y-10', 'opacity-0', 'pointer-events-none');
        toast.classList.remove('translate-y-0', 'opacity-100');
      }, 2500);
    }

    cards.forEach((card) => {
      let clickTimer: any = null;
      let clickCount = 0;

      card.addEventListener('click', (e) => {
        e.preventDefault();
        clickCount++;
        const copyVal = card.getAttribute('data-copy-value') || '';
        const actionUrl = card.getAttribute('data-action') || '';
        const badge = card.querySelector('.badge');

        if (clickCount === 1) {
          clickTimer = setTimeout(async () => {
            clickCount = 0;
            // Single click: copy to clipboard
            try {
              await navigator.clipboard.writeText(copyVal);
              if (badge) {
                const origText = badge.textContent;
                badge.textContent = 'Copied!';
                setTimeout(() => { badge.textContent = origText; }, 1800);
              }
              showToast(`Copied "${copyVal}" (Double-click to open app)`);
            } catch (err) {
              showToast(`Copied "${copyVal}"`);
            }
          }, 250);
        } else if (clickCount >= 2) {
          clearTimeout(clickTimer);
          clickCount = 0;
          // Double click: launch mailto / tel action
          if (badge) badge.textContent = 'Opening...';
          window.location.href = actionUrl;
        }
      });
    });
  </script>

</Layout>
