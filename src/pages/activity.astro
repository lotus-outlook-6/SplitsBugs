---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="min-h-screen flex flex-col bg-canvas-soft pb-32">
    <!-- Header -->
    <header class="h-16 px-4 lg:px-6 flex items-center justify-between border-b border-hairline bg-canvas sticky top-0 z-40 relative">
      <!-- Left: Title -->
      <div class="flex items-center z-10">
        <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-ink shrink-0">Activity</h1>
      </div>
      
      <!-- Center: Search Bar -->
      <div id="searchContainer" class="absolute left-1/2 -translate-x-1/2 flex items-center w-full max-w-xl px-4 z-50 pointer-events-none hidden sm:flex">
        <div id="searchInner" class="flex items-center w-full pointer-events-auto shadow-sm rounded-full h-10">
          <input type="text" id="searchInput" placeholder="Search activity..." autocomplete="off" class="flex-1 h-full bg-canvas border border-hairline rounded-l-full py-2 pl-6 pr-4 text-sm focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand transition-colors z-10" />
          <button id="searchBtn" class="w-16 h-full flex items-center justify-center text-ink bg-canvas-soft border border-hairline border-l-0 rounded-r-full hover:bg-hairline transition-colors cursor-pointer shrink-0 z-0">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </button>
        </div>
      </div>
      
      <!-- Right: Search Icon (Mobile) -->
      <div class="flex items-center z-10 w-[36px] justify-end">
        <button id="mobileSearchBtn" class="sm:hidden bg-canvas-soft text-ink hover:bg-hairline p-2 rounded-full transition-colors cursor-pointer flex items-center justify-center border border-hairline shrink-0" title="Search">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </button>
      </div>
    </header>

    <!-- Activity Feed List -->
    <main class="w-full max-w-[800px] mx-auto sm:my-8">
      <div id="activityFeedContainer" class="flex flex-col">
        <!-- Skeleton activity items -->
        <div id="activitySkeleton">
          <div class="flex items-start gap-4 p-4 lg:p-5 border-b border-hairline bg-canvas">
            <div class="relative shrink-0 mt-1"><div class="skeleton w-12 h-12 rounded-lg"></div></div>
            <div class="flex-1"><div class="skeleton h-4 w-3/4 mb-3 mt-1"></div><div class="skeleton h-3 w-1/2 mb-3"></div><div class="skeleton h-2 w-1/4"></div></div>
          </div>
          <div class="flex items-start gap-4 p-4 lg:p-5 border-b border-hairline bg-canvas">
            <div class="relative shrink-0 mt-1"><div class="skeleton w-12 h-12 rounded-lg"></div></div>
            <div class="flex-1"><div class="skeleton h-4 w-2/3 mb-3 mt-1"></div><div class="skeleton h-3 w-1/3 mb-3"></div><div class="skeleton h-2 w-1/5"></div></div>
          </div>
          <div class="flex items-start gap-4 p-4 lg:p-5 border-b border-hairline bg-canvas">
            <div class="relative shrink-0 mt-1"><div class="skeleton w-12 h-12 rounded-lg"></div></div>
            <div class="flex-1"><div class="skeleton h-4 w-4/5 mb-3 mt-1"></div><div class="skeleton h-3 w-2/5 mb-3"></div><div class="skeleton h-2 w-1/4"></div></div>
          </div>
          <div class="flex items-start gap-4 p-4 lg:p-5 border-b border-hairline bg-canvas">
            <div class="relative shrink-0 mt-1"><div class="skeleton w-12 h-12 rounded-lg"></div></div>
            <div class="flex-1"><div class="skeleton h-4 w-1/2 mb-3 mt-1"></div><div class="skeleton h-3 w-1/4 mb-3"></div><div class="skeleton h-2 w-1/6"></div></div>
          </div>
        </div>
      </div>
    </main>

  </div>
  
  <style is:inline>
    .activity-item {
      transition: opacity 0.5s ease-out, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.2s ease;
    }
    .reveal-hidden {
      opacity: 0;
      transform: translateY(30px) scale(0.95);
    }
    .reveal-visible {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  </style>

  <script>
    import { auth, db } from '../firebase';
    import { onAuthStateChanged } from 'firebase/auth';
    import { collection, onSnapshot, query, where, getDoc, doc } from 'firebase/firestore';

    let currentUserEmail = 'user@example.com';
    let currentUserName = 'You';
    
    const feedContainer = document.getElementById('activityFeedContainer');

    (window as any).getDisplayName = async function(raw: string) {
      if (!raw) return '';
      if (!raw.includes('@')) return raw;
      if (raw === currentUserEmail) return currentUserName || 'You';
      
      try {
        const userDocRef = doc(db, "users", raw);
        const userDoc = await getDoc(userDocRef);
        if (userDoc.exists()) {
          const data = userDoc.data();
          if (data.name) return data.name;
        }
      } catch (e) {}
      
      return raw.split('@')[0];
    };

    function formatDate(ts: number) {
      const d = new Date(ts);
      const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
      let hours = d.getHours();
      const ampm = hours >= 12 ? 'pm' : 'am';
      hours = hours % 12;
      hours = hours ? hours : 12;
      const mins = d.getMinutes().toString().padStart(2, '0');
      return `${d.getDate()} ${months[d.getMonth()]}, ${hours}:${mins} ${ampm}`;
    }

    let allActivities: any[] = [];
    let groupsData: Record<string, any> = {};
    let currentSearchQuery = '';
    let isFirebaseLoaded = false;

    function renderActivity(searchQuery = '') {
      if (!feedContainer) return;

      if (!isFirebaseLoaded) {
        // HTML skeleton items are already visible
        return;
      }

      if (allActivities.length === 0) {
        feedContainer.className = "flex flex-col";
        feedContainer.innerHTML = `<div class="p-12 text-center border border-hairline border-dashed rounded-lg bg-canvas-soft text-mute">No activity to display.</div>`;
        return;
      }

      let activities = [...allActivities];

      // Filter by search query if provided
      if (searchQuery) {
        const query = searchQuery.toLowerCase();
        activities = activities.filter((act: any) => {
          return (act.groupName && act.groupName.toLowerCase().includes(query)) || 
                 (act.description && act.description.toLowerCase().includes(query)) || 
                 (act.paidBy && act.paidBy.toLowerCase().includes(query));
        });
      }

      // Sort chronological descending
      activities.sort((a: any, b: any) => b.timestamp - a.timestamp);

      if (activities.length === 0) {
        feedContainer.className = "flex flex-col";
        feedContainer.innerHTML = `<div class="p-12 text-center border border-hairline border-dashed rounded-lg bg-canvas-soft text-mute">No activity matching search.</div>`;
        return;
      }

      feedContainer.className = "flex flex-col bg-canvas border-x border-hairline sm:border sm:rounded-xl overflow-hidden sm:shadow-sm";
      feedContainer.innerHTML = '';
      activities.forEach((act: any) => {
        let avatarLetter = 'A';
        let mainText = '';
        let subTextHTML = '';

        const who = act.paidBy === 'You' || act.paidBy === (window as any).MY_DISPLAY_NAME || act.paidBy === currentUserEmail ? 'You' : (window as any).getDisplayName(act.paidBy);

        if (act.type === 'group_created') {
          avatarLetter = act.groupName.charAt(0).toUpperCase();
          mainText = `<span class="font-bold text-ink">${who}</span> created the group "<span class="font-bold text-ink">${act.groupName}</span>".`;
        } else if (act.type === 'group_deleted') {
          avatarLetter = act.groupName.charAt(0).toUpperCase();
          mainText = `<span class="font-bold text-ink">${who}</span> deleted the group "<span class="font-bold text-ink">${act.groupName}</span>".`;
        } else if (act.type === 'group_edited') {
          avatarLetter = act.groupName.charAt(0).toUpperCase();
          mainText = `<span class="font-bold text-ink">${who}</span> updated settings for "<span class="font-bold text-ink">${act.groupName}</span>".`;
        } else if (act.type === 'expense_added' || act.type === 'debt_settled') {
          avatarLetter = act.description.charAt(0).toUpperCase();
          if (act.type === 'debt_settled') {
             const toWho = act.participants[0] === currentUserEmail || act.participants[0] === (window as any).MY_DISPLAY_NAME ? 'you' : (window as any).getDisplayName(act.participants[0]);
             mainText = `<span class="font-bold text-ink">${who}</span> paid ${toWho} ${act.currency}${act.amount.toFixed(2)} in "<span class="font-bold text-ink">${act.groupName}</span>".`;
          } else {
             mainText = `<span class="font-bold text-ink">${who}</span> added "<span class="font-bold text-ink">${act.description}</span>" in "<span class="font-bold text-ink">${act.groupName}</span>".`;
          }
          
          const isParticipant = act.participants.includes('You') || act.participants.includes((window as any).MY_DISPLAY_NAME) || act.participants.includes(currentUserEmail);
          const isPayer = act.paidBy === 'You' || act.paidBy === (window as any).MY_DISPLAY_NAME || act.paidBy === currentUserEmail;
          const myShare = isParticipant ? (act.amount / act.participants.length) : 0;
          const curr = act.currency;

          if (isPayer) {
            const getBack = act.amount - myShare;
            if (getBack > 0.01) {
              subTextHTML = `<div class="text-success mt-0.5">You get back ${curr}${getBack.toFixed(2)}</div>`;
            } else {
              subTextHTML = `<div class="text-mute mt-0.5">You paid for yourself</div>`;
            }
          } else {
            if (isParticipant) {
              subTextHTML = `<div class="text-danger mt-0.5">You owe ${curr}${myShare.toFixed(2)}</div>`;
            } else {
              subTextHTML = `<div class="text-mute mt-0.5">Not involved</div>`;
            }
          }
        }

        const dateStr = formatDate(act.timestamp);
        const faviconPath = "/SplitBugs-Brand/favicon/favicon.svg";

        // Check if group is deleted based on realtime listener
        const isGroupDeleted = !groupsData[act.groupId];
        
        const itemTag = isGroupDeleted ? 'div' : 'a';
        const linkAttr = isGroupDeleted ? '' : `href="/group?id=${act.groupId}"`;
        const actionClasses = isGroupDeleted ? '' : 'hover:bg-canvas-soft cursor-pointer';
        const opacityClass = isGroupDeleted ? 'opacity-80' : '';

        const itemHTML = `
          <${itemTag} ${linkAttr} class="activity-item flex items-start gap-4 p-4 lg:p-5 border-b border-hairline block ${actionClasses} ${opacityClass} reveal-hidden">
            <div class="relative shrink-0 mt-1">
              <div class="w-12 h-12 rounded-lg bg-[#b2dfdb] border border-hairline flex items-center justify-center font-bold text-2xl text-ink">
                ${avatarLetter}
              </div>
              <img src="${faviconPath}" alt="SplitBugs" class="absolute -bottom-1.5 -right-1.5 w-6 h-6 rounded-full border-2 border-canvas bg-white object-cover" />
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm lg:text-base text-body leading-snug">${mainText}</p>
              ${subTextHTML}
              <p class="text-xs text-mute mt-1">${dateStr}</p>
            </div>
          </${itemTag}>
        `;
        feedContainer.insertAdjacentHTML('beforeend', itemHTML);
      });

      // Setup scroll reveal animation
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('reveal-visible');
            entry.target.classList.remove('reveal-hidden');
          } else {
            entry.target.classList.remove('reveal-visible');
            entry.target.classList.add('reveal-hidden');
          }
        });
      }, {
        threshold: 0.15,
        rootMargin: "0px"
      });

      document.querySelectorAll('.activity-item').forEach((el, index) => {
        // Stagger first few items for initial load
        if (index < 15) {
           (el as HTMLElement).style.transitionDelay = `${index * 30}ms`;
           setTimeout(() => {
              (el as HTMLElement).style.transitionDelay = '0ms';
           }, 1000);
        }
        observer.observe(el);
      });
    }

    // Set up Firebase Listeners
    function initFirebase() {
      if (currentUserEmail) {
        // 1. Listen for active groups to know if a group was deleted
        const qGroups = query(collection(db, "groups"), where("members", "array-contains", currentUserEmail));
        onSnapshot(qGroups, (snapshot) => {
          const newGroupsData: Record<string, any> = {};
          snapshot.forEach((doc) => {
            newGroupsData[doc.id] = doc.data();
          });
          groupsData = newGroupsData;
          isFirebaseLoaded = true;
          renderActivity(currentSearchQuery);
        });

        // 2. Listen for activities where user is a participant
        const qActivitiesParticipant = query(collection(db, "activities"), where("participants", "array-contains", currentUserEmail));
        onSnapshot(qActivitiesParticipant, (snapshot) => {
          const actsMap = new Map();
          snapshot.forEach((doc) => actsMap.set(doc.id, { id: doc.id, ...doc.data() }));
          
          // Merge with activities where user is payer
          allActivities = allActivities.filter(a => a.paidBy === currentUserEmail && !a.participants.includes(currentUserEmail)); 
          actsMap.forEach((val) => allActivities.push(val));
          
          isFirebaseLoaded = true;
          renderActivity(currentSearchQuery);
        });

        // 3. Listen for activities where user is payer (but not in participants array, e.g. some edge cases)
        const qActivitiesPayer = query(collection(db, "activities"), where("paidBy", "==", currentUserEmail));
        onSnapshot(qActivitiesPayer, (snapshot) => {
          const actsMap = new Map();
          snapshot.forEach((doc) => actsMap.set(doc.id, { id: doc.id, ...doc.data() }));
          
          // Merge with activities where user is participant
          allActivities = allActivities.filter(a => a.participants.includes(currentUserEmail)); 
          actsMap.forEach((val) => {
            if (!allActivities.find(a => a.id === val.id)) {
              allActivities.push(val);
            }
          });
          
          isFirebaseLoaded = true;
          renderActivity(currentSearchQuery);
        });
      }
    }

    onAuthStateChanged(auth, (user) => {
      if (user) {
        currentUserEmail = user.email || 'user@example.com';
        currentUserName = user.displayName || 'You';
        initFirebase();
      }
    });

    // Search Logic
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const searchBtn = document.getElementById('searchBtn');
    const mobileSearchBtn = document.getElementById('mobileSearchBtn');
    const searchContainer = document.getElementById('searchContainer');
    const searchInner = document.getElementById('searchInner');

    if (mobileSearchBtn && searchContainer && searchInput && searchInner) {
      mobileSearchBtn.addEventListener('click', () => {
        searchContainer.classList.remove('hidden', 'sm:flex', 'left-1/2', '-translate-x-1/2', 'pointer-events-none');
        searchContainer.classList.add('flex', 'inset-0', 'bg-canvas', 'pointer-events-auto');
        
        let cancelBtn = document.getElementById('cancelSearchBtn');
        if (!cancelBtn) {
          cancelBtn = document.createElement('button');
          cancelBtn.id = 'cancelSearchBtn';
          cancelBtn.className = 'ml-3 text-brand font-medium text-sm shrink-0 hover:text-brand-deep transition-colors';
          cancelBtn.textContent = 'Cancel';
          searchContainer.appendChild(cancelBtn);
          
          cancelBtn.addEventListener('click', () => {
            searchContainer.classList.add('hidden', 'sm:flex', 'left-1/2', '-translate-x-1/2', 'pointer-events-none');
            searchContainer.classList.remove('flex', 'inset-0', 'bg-canvas', 'pointer-events-auto');
            searchInput.value = '';
            currentSearchQuery = '';
            renderActivity(currentSearchQuery);
          });
        }
        searchInput.focus();
      });
    }

    if (searchInput && searchBtn) {
      const executeSearch = () => {
        currentSearchQuery = searchInput.value.toLowerCase();
        renderActivity(currentSearchQuery);
      };
      
      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          executeSearch();
        }
      });
      
      searchBtn.addEventListener('click', () => {
        executeSearch();
      });
      
      searchInput.addEventListener('input', () => {
         currentSearchQuery = searchInput.value.toLowerCase();
         renderActivity(currentSearchQuery);
      });
    }

    // Close search on click outside
    document.addEventListener('click', (e) => {
      if (window.innerWidth < 640 && searchContainer && !searchContainer.classList.contains('hidden')) {
        if (!searchContainer.contains(e.target as Node) && !mobileSearchBtn?.contains(e.target as Node)) {
          searchContainer.classList.add('hidden');
        }
      }
    });

    // Initial render to show loading spinner
    document.addEventListener('DOMContentLoaded', () => {
      renderActivity();
    });
  </script>
</Layout>
