---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="min-h-screen flex flex-col bg-canvas-soft pb-32">
    <!-- Header -->
    <header class="h-16 px-4 lg:px-6 flex items-center justify-between border-b border-hairline bg-canvas sticky top-0 z-40 relative">
      <!-- Left: Title -->
      <div class="flex items-center z-10">
        <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-ink shrink-0">Activity</h1>
      </div>
      
      <!-- Center: Search Bar -->
      <div id="searchContainer" class="absolute left-1/2 -translate-x-1/2 flex items-center w-full max-w-xl px-4 z-50 pointer-events-none hidden sm:flex">
        <div id="searchInner" class="flex items-center w-full pointer-events-auto shadow-sm rounded-full h-10">
          <input type="text" id="searchInput" placeholder="Search activity..." autocomplete="off" class="flex-1 h-full bg-canvas border border-hairline rounded-l-full py-2 pl-6 pr-4 text-sm focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand transition-colors z-10" />
          <button id="searchBtn" class="w-16 h-full flex items-center justify-center text-ink bg-canvas-soft border border-hairline border-l-0 rounded-r-full hover:bg-hairline transition-colors cursor-pointer shrink-0 z-0">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </button>
        </div>
      </div>
      
      <!-- Right: Search Icon (Mobile) -->
      <div class="flex items-center z-10 w-[36px] justify-end">
        <button id="mobileSearchBtn" class="sm:hidden bg-canvas-soft text-ink hover:bg-hairline p-2 rounded-full transition-colors cursor-pointer flex items-center justify-center border border-hairline shrink-0" title="Search">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </button>
      </div>
    </header>

    <!-- Activity Feed List -->
    <main class="w-full max-w-[800px] mx-auto bg-canvas border-x border-hairline sm:my-8 sm:border sm:rounded-xl overflow-hidden sm:shadow-sm">
      <div id="activityFeedContainer" class="flex flex-col">
        <!-- JS will populate this -->
      </div>
    </main>



  </div>

  <script>
    const currentUserEmail = localStorage.getItem('splitbug_userEmail') || 'user@example.com';
    const GLOBAL_GROUPS_KEY = 'splitsbug_global_groups';
    const DATA_KEY = GLOBAL_GROUPS_KEY;

    const feedContainer = document.getElementById('activityFeedContainer');
    
    (window as any).MY_DISPLAY_NAME = localStorage.getItem('splitbug_userName') || 'You';
    (window as any).getDisplayName = function(raw: string) {
      if (!raw) return '';
      if (!raw.includes('@')) return raw;
      if (raw === currentUserEmail) return (window as any).MY_DISPLAY_NAME || 'You';
      
      const usersStr = localStorage.getItem('splitbug_users');
      if (usersStr) {
        try {
          const users = JSON.parse(usersStr);
          if (users[raw] && users[raw].name) {
            return users[raw].name;
          }
        } catch(e) {}
      }
      
      return raw.split('@')[0];
    };

    function formatDate(ts: number) {
      const d = new Date(ts);
      const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
      let hours = d.getHours();
      const ampm = hours >= 12 ? 'pm' : 'am';
      hours = hours % 12;
      hours = hours ? hours : 12;
      const mins = d.getMinutes().toString().padStart(2, '0');
      return `${d.getDate()} ${months[d.getMonth()]}, ${hours}:${mins} ${ampm}`;
    }

    function renderActivity(searchQuery = '') {
      if (!feedContainer) return;
      const activitiesStr = localStorage.getItem('splitsbug_global_activities');
      if (!activitiesStr) {
        feedContainer.innerHTML = `<div class="p-8 text-center text-mute">No activity to display.</div>`;
        return;
      }

      let allActivities = JSON.parse(activitiesStr);
      
      // Filter activities for this user
      let activities = allActivities.filter((act: any) => {
        if (!act.participants) return false;
        return act.participants.includes(currentUserEmail) || 
               act.paidBy === currentUserEmail || 
               act.participants.includes('You') || 
               act.participants.includes((window as any).MY_DISPLAY_NAME);
      });

      // Filter by search query if provided
      if (searchQuery) {
        const query = searchQuery.toLowerCase();
        activities = activities.filter((act: any) => {
          return act.groupName.toLowerCase().includes(query) || 
                 (act.description && act.description.toLowerCase().includes(query)) || 
                 (act.paidBy && act.paidBy.toLowerCase().includes(query));
        });
      }

      // Sort chronological descending
      activities.sort((a: any, b: any) => b.timestamp - a.timestamp);

      if (activities.length === 0) {
        feedContainer.innerHTML = `<div class="p-8 text-center text-mute">No activity to display.</div>`;
        return;
      }

      const groupsDataStr = localStorage.getItem(GLOBAL_GROUPS_KEY);
      const groupsData = groupsDataStr ? JSON.parse(groupsDataStr) : { groups: {} };

      feedContainer.innerHTML = '';
      activities.forEach((act: any) => {
        let avatarLetter = 'A';
        let mainText = '';
        let subTextHTML = '';

        const who = act.paidBy === 'You' || act.paidBy === (window as any).MY_DISPLAY_NAME || act.paidBy === currentUserEmail ? 'You' : (window as any).getDisplayName(act.paidBy);

        if (act.type === 'group_created') {
          avatarLetter = act.groupName.charAt(0).toUpperCase();
          mainText = `<span class="font-bold text-ink">${who}</span> created the group "<span class="font-bold text-ink">${act.groupName}</span>".`;
        } else if (act.type === 'group_deleted') {
          avatarLetter = act.groupName.charAt(0).toUpperCase();
          mainText = `<span class="font-bold text-ink">${who}</span> deleted the group "<span class="font-bold text-ink">${act.groupName}</span>".`;
        } else if (act.type === 'group_settings_changed') {
          avatarLetter = act.groupName.charAt(0).toUpperCase();
          mainText = `<span class="font-bold text-ink">${who}</span> updated settings for "<span class="font-bold text-ink">${act.groupName}</span>".`;
        } else if (act.type === 'expense_added' || act.type === 'debt_settled') {
          avatarLetter = act.description.charAt(0).toUpperCase();
          if (act.type === 'debt_settled') {
             const toWho = act.participants[0] === currentUserEmail || act.participants[0] === (window as any).MY_DISPLAY_NAME ? 'you' : (window as any).getDisplayName(act.participants[0]);
             mainText = `<span class="font-bold text-ink">${who}</span> paid ${toWho} ${act.currency}${act.amount.toFixed(2)} in "<span class="font-bold text-ink">${act.groupName}</span>".`;
          } else {
             mainText = `<span class="font-bold text-ink">${who}</span> added "<span class="font-bold text-ink">${act.description}</span>" in "<span class="font-bold text-ink">${act.groupName}</span>".`;
          }
          
          const isParticipant = act.participants.includes('You') || act.participants.includes((window as any).MY_DISPLAY_NAME) || act.participants.includes(currentUserEmail);
          const isPayer = act.paidBy === 'You' || act.paidBy === (window as any).MY_DISPLAY_NAME || act.paidBy === currentUserEmail;
          const myShare = isParticipant ? (act.amount / act.participants.length) : 0;
          const curr = act.currency;

          if (isPayer) {
            const getBack = act.amount - myShare;
            if (getBack > 0.01) {
              subTextHTML = `<div class="text-success mt-0.5">You get back ${curr}${getBack.toFixed(2)}</div>`;
            } else {
              subTextHTML = `<div class="text-mute mt-0.5">You paid for yourself</div>`;
            }
          } else {
            if (isParticipant) {
              subTextHTML = `<div class="text-danger mt-0.5">You owe ${curr}${myShare.toFixed(2)}</div>`;
            } else {
              subTextHTML = `<div class="text-mute mt-0.5">Not involved</div>`;
            }
          }
        }

        const dateStr = formatDate(act.timestamp);
        const faviconPath = "/SplitBugs-Brand/favicon/favicon.svg";

        const isGroupDeleted = !groupsData.groups[act.groupId];

        const itemHTML = `
          <a ${isGroupDeleted ? 'data-deleted="true"' : `href="/group?id=${act.groupId}"`} class="activity-item flex items-start gap-4 p-4 lg:p-5 border-b border-hairline hover:bg-canvas-soft transition-colors block cursor-pointer">
            <div class="relative shrink-0 mt-1">
              <div class="w-12 h-12 rounded-lg bg-[#b2dfdb] border border-hairline flex items-center justify-center font-bold text-2xl text-ink">
                ${avatarLetter}
              </div>
              <img src="${faviconPath}" alt="SplitBugs" class="absolute -bottom-1.5 -right-1.5 w-6 h-6 rounded-full border-2 border-canvas bg-white object-cover" />
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm lg:text-base text-body leading-snug">${mainText}</p>
              ${subTextHTML}
              <p class="text-xs text-mute mt-1">${dateStr}</p>
            </div>
          </a>
        `;
        feedContainer.insertAdjacentHTML('beforeend', itemHTML);
      });

      // Add listeners for deleted groups
      document.querySelectorAll('.activity-item[data-deleted="true"]').forEach(el => {
        el.addEventListener('click', (e) => {
          e.preventDefault();
          alert('This group no longer exists and was deleted by the admin.');
        });
      });
    }

    // Initial render
    renderActivity();

    // Search Logic
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const searchBtn = document.getElementById('searchBtn');
    const mobileSearchBtn = document.getElementById('mobileSearchBtn');
    const searchContainer = document.getElementById('searchContainer');
    const searchInner = document.getElementById('searchInner');

    if (mobileSearchBtn && searchContainer && searchInput && searchInner) {
      mobileSearchBtn.addEventListener('click', () => {
        searchContainer.classList.remove('hidden', 'sm:flex', 'left-1/2', '-translate-x-1/2', 'pointer-events-none');
        searchContainer.classList.add('flex', 'inset-0', 'bg-canvas', 'pointer-events-auto');
        
        let cancelBtn = document.getElementById('cancelSearchBtn');
        if (!cancelBtn) {
          cancelBtn = document.createElement('button');
          cancelBtn.id = 'cancelSearchBtn';
          cancelBtn.className = 'ml-3 text-brand font-medium text-sm shrink-0 hover:text-brand-deep transition-colors';
          cancelBtn.textContent = 'Cancel';
          searchContainer.appendChild(cancelBtn);
          
          cancelBtn.addEventListener('click', () => {
            searchContainer.classList.add('hidden', 'sm:flex', 'left-1/2', '-translate-x-1/2', 'pointer-events-none');
            searchContainer.classList.remove('flex', 'inset-0', 'bg-canvas', 'pointer-events-auto');
            searchInput.value = '';
            searchInput.dispatchEvent(new Event('input'));
          });
        }
        searchInput.focus();
      });
    }

    if (searchInput && searchBtn) {
      const executeSearch = () => {
        const query = searchInput.value.toLowerCase();
        renderActivity(query);
      };
      
      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          executeSearch();
        }
      });
      
      searchBtn.addEventListener('click', () => {
        executeSearch();
      });
    }

    // Cross-tab syncing
    window.addEventListener('storage', (e) => {
      if (e.key === DATA_KEY) {
        const query = searchInput ? searchInput.value.toLowerCase() : '';
        renderActivity(query);
      }
    });
  </script>
</Layout>
